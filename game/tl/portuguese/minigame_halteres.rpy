# game/minigame_halteres.rpy:787
translate portuguese sport_event_007_fbcabca9:

    # "L’eau continue de ruisseler : sur son ventre contracté, le long des côtes, jusqu’à disparaître dans le creux de son nombril et plus bas."
    "A água continua escorrendo: pela barriga contraída, ao longo das costelas, até sumir no umbigo e mais abaixo."

# game/minigame_halteres.rpy:788
translate portuguese sport_event_007_5affe97c:

    # "Ses cuisses gainées de noir luisent maintenant. Quelques gouttes perlent sur le banc en dessous d’elle."
    "As coxas cobertas pelo tecido preto agora brilham. Algumas gotas se acumulam no banco sob ela."

# game/minigame_halteres.rpy:789
translate portuguese sport_event_007_b185a7f5:

    # "Elle rouvre les yeux, passe une main dans ses cheveux trempés pour les rejeter en arrière."
    "Ela abre os olhos de novo e passa a mão pelos cabelos encharcados, jogando-os para trás."

# game/minigame_halteres.rpy:790
translate portuguese sport_event_007_af145e0a:

    # "Un sourire paresseux, presque sensuel, apparaît sur ses lèvres."
    "Um sorriso preguiçoso, quase sensual, aparece nos lábios."

# game/minigame_halteres.rpy:792
translate portuguese sport_event_007_50c4ae91:

    # nyra "Bon… au moins je suis réveillée maintenant."
    nyra "Bom... pelo menos agora eu acordei."

# game/minigame_halteres.rpy:794
translate portuguese sport_event_007_58e3b1a3:

    # "Elle pose la bouteille vide à côté d’elle, s’étire légèrement, le tissu collant soulignant chaque courbe."
    "Ela coloca a garrafa vazia ao lado e se alonga de leve, com o tecido colado destacando cada curva."

# game/minigame_halteres.rpy:795
translate portuguese sport_event_007_88d90436:

    # "Tu ne bouges pas. Difficile de détourner le regard."
    "Você não se mexe. É difícil desviar o olhar."

# game/minigame_halteres.rpy:807
translate portuguese sport_event_008_64197d3a:

    # "Le tapis s’est enfin arrêté. Lysa descend, jambes encore tremblantes de l’effort."
    "A esteira finalmente para. Lysa desce, com as pernas ainda tremendo por causa do esforço."

# game/minigame_halteres.rpy:808
translate portuguese sport_event_008_6a49a15d:

    # "Elle pose les mains sur les hanches, inspire profondément, puis lève les bras haut au-dessus de la tête."
    "Ela apoia as mãos nos quadris, respira fundo e ergue os braços bem acima da cabeça."

# game/minigame_halteres.rpy:809
translate portuguese sport_event_008_834e803a:

    # "Dos cambré, poitrine qui se soulève, elle s’étire longuement comme pour évacuer toute la fatigue accumulée."
    "Com as costas arqueadas e o peito subindo a cada respiração, ela se alonga demoradamente, como se quisesse expulsar todo o cansaço acumulado."

# game/minigame_halteres.rpy:810
translate portuguese sport_event_008_17154a90:

    # "La sueur coule en filets réguliers : du front aux tempes, le long du cou, entre les seins, sur les abdos qui se contractent à chaque respiration."
    "O suor corre em filetes regulares: da testa às têmporas, pelo pescoço, entre os seios e sobre o abdômen que se contrai a cada respiração."

# game/minigame_halteres.rpy:811
translate portuguese sport_event_008_cedad81f:

    # "Elle penche la tête d’un côté, puis de l’autre, fait craquer sa nuque avec un petit soupir satisfait."
    "Ela inclina a cabeça para um lado, depois para o outro, e estala o pescoço com um pequeno suspiro satisfeito."

# game/minigame_halteres.rpy:813
translate portuguese sport_event_008_56b7b762:

    # lysa "…ouf. Ça faisait longtemps que j’avais pas poussé comme ça."
    lysa "...ufa. Fazia tempo que eu não me puxava desse jeito."

# game/minigame_halteres.rpy:815
translate portuguese sport_event_008_9ad97c9c:

    # "Bras toujours en l’air, elle roule lentement les épaules, fait passer le poids d’une jambe sur l’autre."
    "Ainda com os braços erguidos, ela gira os ombros lentamente e passa o peso de uma perna para a outra."

# game/minigame_halteres.rpy:816
translate portuguese sport_event_008_5b6e251a:

    # "Le tissu du crop top colle à sa peau, transparent par endroits. Les gouttes glissent sur son ventre, disparaissent sous la ceinture du short."
    "O tecido do cropped gruda na pele, transparente em alguns pontos. As gotas escorrem pela barriga e desaparecem sob o cós do short."

# game/minigame_halteres.rpy:817
translate portuguese sport_event_008_522686db:

    # "Elle descend les bras, attrape ses coudes derrière le dos et tire pour ouvrir la poitrine."
    "Ela abaixa os braços, segura os cotovelos atrás das costas e puxa para abrir o peito."

# game/minigame_halteres.rpy:818
translate portuguese sport_event_008_8894c196:

    # "Un sourire fatigué illumine son visage. Elle a l’air épuisée… mais heureuse."
    "Um sorriso cansado ilumina o rosto dela. Parece exausta... mas feliz."

# game/minigame_halteres.rpy:820
translate portuguese sport_event_008_bd533014:

    # lysa "Bon, je crois que j’ai mérité une bonne douche."
    lysa "Bom, acho que mereci um belo banho."

# game/minigame_halteres.rpy:822
translate portuguese sport_event_008_460dc1d7:

    # "Elle secoue légèrement la tête pour chasser les gouttes de ses cheveux, puis me jette un regard en coin."
    "Ela sacode levemente a cabeça para tirar as gotas do cabelo e lança um olhar de canto para mim."

# game/minigame_halteres.rpy:824
translate portuguese sport_event_008_6e67021b:

    # lysa "T’as couru combien de km toi aujourd’hui ? Ou t’as juste regardé ?"
    lysa "E você, correu quantos quilômetros hoje? Ou só ficou olhando?"

# game/minigame_halteres.rpy:837
translate portuguese sport_event_009_b48a0b59:

    # "La séance est finie. J'ai le corps lourd, muscles chauds. Je range les affaires en silence."
    "O treino acabou. Meu corpo está pesado, os músculos ainda quentes. Guardo tudo em silêncio."

# game/minigame_halteres.rpy:838
translate portuguese sport_event_009_77bcce9d:

    # "Direction les douches. Le couloir est désert, juste le bruit lointain de l’eau qui tombe."
    "Vou para os chuveiros. O corredor está vazio, com apenas o som distante da água caindo."

# game/minigame_halteres.rpy:839
translate portuguese sport_event_009_994b4dda:

    # "Je pousse la porte entrouverte. La vapeur flotte déjà dans l’air."
    "Empurro a porta entreaberta. O vapor já paira no ar."

# game/minigame_halteres.rpy:840
translate portuguese sport_event_009_8831ebe4:

    # "Et là, elle est là."
    "E aí eu vejo ela."

# game/minigame_halteres.rpy:844
translate portuguese sport_event_009_218c437a:

    # "De loin. Dos tourné. Sous le jet principal. L'eau cascade sur son dos, sur ses hanches, sur ses fesses rondes et luisantes."
    "Lá longe. De costas. Debaixo do chuveiro principal. A água cai em cascata pelas costas, pelos quadris e pelas nádegas arredondadas e brilhantes."

# game/minigame_halteres.rpy:845
translate portuguese sport_event_009_5cd36d97:

    # "Les cheveux blancs collés à la peau, les gouttes qui glissent le long de sa colonne et disparaissent dans le creux de ses reins."
    "Os cabelos brancos grudam na pele, enquanto as gotas escorrem pela coluna e desaparecem na curva da lombar."

# game/minigame_halteres.rpy:846
translate portuguese sport_event_009_115fdf65:

    # "Elle ne bouge presque pas. Juste les épaules qui se soulèvent doucement au rythme de sa respiration."
    "Ela quase não se mexe. Só os ombros sobem e descem suavemente no ritmo da respiração."

# game/minigame_halteres.rpy:847
translate portuguese sport_event_009_b457dc3a:

    # "L’eau ruisselle partout."
    "A água escorre por todo o corpo."

# game/minigame_halteres.rpy:848
translate portuguese sport_event_009_f2a50570:

    # "Je reste immobile. À l’entrée. Sans un bruit. Sans un mot."
    "Eu fico imóvel na entrada. Sem fazer barulho. Sem dizer nada."

# game/minigame_halteres.rpy:849
translate portuguese sport_event_009_f884362d:

    # "Mon cœur bat un peu plus fort. La vapeur rend tout ça un peu irréel."
    "Meu coração acelera um pouco. O vapor deixa tudo meio irreal."

# game/minigame_halteres.rpy:850
translate portuguese sport_event_009_e6869f05:

    # "Elle passe une main dans ses cheveux, rejette la tête en arrière un instant. Un soupir à peine audible."
    "Ela passa a mão pelos cabelos e inclina a cabeça para trás por um instante. Um suspiro quase inaudível."

# game/minigame_halteres.rpy:851
translate portuguese sport_event_009_1f3cc5b5:

    # "Puis l’eau ralentit. Le jet devient filet. Puis gouttes. Puis rien."
    "Então a água vai diminuindo. O jato vira um fio. Depois gotas. Depois nada."

# game/minigame_halteres.rpy:852
translate portuguese sport_event_009_8d8aa4c4:

    # "Elle tend la main vers le robinet, coupe le débit."
    "Ela estende a mão até o registro e fecha a água."

# game/minigame_halteres.rpy:853
translate portuguese sport_event_009_d7859333:

    # "On recule d’un pas. Puis d’un autre. La porte se referme doucement derrière nous sans un claquement."
    "A gente recua um passo. Depois outro. A porta se fecha devagar atrás de nós, sem bater."

# game/minigame_halteres.rpy:854
translate portuguese sport_event_009_c6e67a1b:

    # "Il ne faut pas qu'on me voit ici."
    "Não podem me ver aqui."

# game/minigame_halteres.rpy:855
translate portuguese sport_event_009_08bcaa65:

    # "On s’éloigne dans le couloir. Pouls encore rapide. Image gravée."
    "A gente se afasta pelo corredor. Pulso ainda acelerado. A imagem gravada na cabeça."

