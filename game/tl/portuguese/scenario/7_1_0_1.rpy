translate portuguese bd588c4e:

    # think "Kami nous convoque dans la salle du Conclave avant le dîner."
    think "Kami nos convoca à sala do Conclave antes do jantar."

# game/scenario/7_1_0_1.rpy:744
translate portuguese ecc87d4f:

    # think "Iris arrive la dernière. Elle confirme d'un signe que la jeune femme respire toujours, puis rejoint sa place."
    think "Iris chega por último. Confirma com um gesto que a jovem ainda respira e ocupa seu lugar."

# game/scenario/7_1_0_1.rpy:751
translate portuguese f9e49fd0:

    # kami "Mes chers représentants, les distractions de ce matin ont légèrement perturbé notre programme."
    kami "Meus queridos representantes, as distrações desta manhã atrapalharam um pouco nossa programação."

# game/scenario/7_1_0_1.rpy:755
translate portuguese bd61b3fd:

    # kami "Entre la passagère congelée, les menaces de perforation de coque et votre soudaine passion pour les subtilités juridiques, je n'ai même pas pu annoncer votre prochain vote."
    kami "Entre a clandestina congelada, as ameaças de perfurar o casco e sua súbita paixão por detalhes jurídicos, nem consegui anunciar a próxima votação."

# game/scenario/7_1_0_1.rpy:759
translate portuguese 47f7336d:

    # kami "Nous allons donc parler du Commandement IV, celui qui interdit les rassemblements et les organisations non autorisées."
    kami "Então vamos falar do Mandamento IV, aquele que proíbe reuniões e organizações não autorizadas."

# game/scenario/7_1_0_1.rpy:765
translate portuguese 4e4b2594:

    # kami "La proposition soumise au vote sera la suivante : autoriser les regroupements de plus de vingt personnes, sous réserve d'une demande d'autorisation préalable."
    kami "A proposta submetida à votação será a seguinte: autorizar reuniões de mais de vinte pessoas, desde que seja solicitada autorização prévia."

# game/scenario/7_1_0_1.rpy:769
translate portuguese eac2c6bd:

    # kami "Le lieu, la date, l'objet du rassemblement et l'identité des organisateurs devront être communiqués à Archive avant toute réunion."
    kami "O local, a data, o objetivo da reunião e a identidade dos organizadores deverão ser informados ao Archive antes de qualquer encontro."

# game/scenario/7_1_0_1.rpy:773
translate portuguese c42b3ea5:

    # kami "Une liberté sous formulaire. C'est presque poétique."
    kami "Liberdade mediante formulário. Quase poético."

# game/scenario/7_1_0_1.rpy:777
translate portuguese 65176637:

    # kami "Le vote aura lieu à la fin du jour neuf. Vous disposez donc de deux jours pour déterminer si vingt et une personnes constituent une communauté ou déjà une menace."
    kami "A votação acontecerá no fim do Dia 9. Portanto, vocês têm dois dias para decidir se vinte e uma pessoas formam uma comunidade ou já representam uma ameaça."

# game/scenario/7_1_0_1.rpy:781
translate portuguese 05a3e288:

    # kami "Et puisque vous avez réclamé l'application exacte des règles ce matin, j'attends de vous une rigueur exemplaire. Aucun argument improvisé, aucune interruption et, idéalement, aucun coup au visage."
    kami "E, já que exigiram a aplicação exata das regras esta manhã, espero um rigor exemplar. Nada de argumentos improvisados, nada de interrupções e, de preferência, nada de socos no rosto."

# game/scenario/7_1_0_1.rpy:804
translate portuguese 45f7b33b:

    # ryn determine "Des regroupements autorisés pourraient permettre aux familles séparées de se retrouver et de s'organiser."
    ryn determine "Reuniões autorizadas poderiam permitir que famílias separadas se reencontrassem e se organizassem."

# game/scenario/7_1_0_1.rpy:806
translate portuguese de856bc0:

    # sael mefiant "Ou aux réseaux qui utilisent les cargaisons de recruter plus facilement."
    sael mefiant "Ou facilitar o recrutamento pelas redes que usam as cargas."

# game/scenario/7_1_0_1.rpy:808
translate portuguese cb750430:

    # nyra raison "Nous ignorons encore si cette femme appartenait à un réseau."
    nyra raison "Ainda não sabemos se essa mulher pertencia a uma rede."

# game/scenario/7_1_0_1.rpy:810
translate portuguese 6fc662a5:

    # lysa blase "Attendez au moins qu'elle se réveille avant de transformer son coma en argument électoral."
    lysa blase "Esperem pelo menos ela acordar antes de transformar o coma dela em argumento eleitoral."

# game/scenario/7_1_0_1.rpy:812
translate portuguese 2c8d0a5e:

    # noam determine "Lysa a raison. On en parlera demain."
    noam determine "Lysa tem razão. Falamos disso amanhã."

# game/scenario/7_1_0_1.rpy:814
translate portuguese 15f262ee:

    # iris colere "Demain. Quand j'aurai dormi et qu'elle aura, avec un peu de chance, fait la même chose."
    iris colere "Amanhã. Quando eu tiver dormido e, com sorte, ela também."

# game/scenario/7_1_0_1.rpy:818
translate portuguese d228644c:

    # think "Nous quittons la salle sans commencer le débat. Pour une fois, personne ne cherche à retenir les autres."
    think "Saímos da sala sem iniciar o debate. Pela primeira vez, ninguém tenta segurar os outros."

# game/scenario/7_1_0_1.rpy:832
translate portuguese 50abf5b0:

    # think "Je retourne vers ma chambre. La porte de l'infirmerie reste fermée, mais sa lumière est encore allumée."
    think "Volto para o meu quarto. A porta da enfermaria continua fechada, mas a luz ainda está acesa."

# game/scenario/7_1_0_1.rpy:833
translate portuguese 307c335d:

    # think "La jeune femme n'a toujours pas ouvert les yeux. Pourtant, elle a déjà obtenu une semaine de sursis et changé le prochain débat."
    think "A jovem ainda não abriu os olhos. Mesmo assim, já ganhou uma semana de prazo e mudou o próximo debate."

# game/scenario/7_1_0_1.rpy:834
translate portuguese 2eac2fa6:

    # think "Au jour quatorze, Kami exigera qu'elle reparte. D'ici là, il faudra découvrir qui elle est et ce qu'elle fuyait."
    think "No Dia 14, Kami exigirá que ela vá embora. Até lá, teremos que descobrir quem ela é e do que estava fugindo."

