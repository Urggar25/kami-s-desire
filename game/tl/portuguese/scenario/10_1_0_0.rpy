# game/scenario/10_1_0_0.rpy:338
translate portuguese be5ea30a:

    # nyra "Évidemment que non."
    nyra "Claro que não."

# game/scenario/10_1_0_0.rpy:340
translate portuguese c554a01d:

    # "Elle soupire doucement."
    "Ela suspira baixinho."

# game/scenario/10_1_0_0.rpy:342
translate portuguese e1f23562:

    # nyra reflexion "Il va donc falloir les convaincre pour d'autres raisons."
    nyra reflexion "Então vai ser preciso convencer todos por outros motivos."

# game/scenario/10_1_0_0.rpy:344
translate portuguese 3291f691:

    # noam "Tu penses pouvoir le faire ?"
    noam "Você acha que consegue?"

# game/scenario/10_1_0_0.rpy:346
translate portuguese 3caaad89:

    # "Nyra me regarde avec une expression parfaitement neutre."
    "Nyra me olha com uma expressão perfeitamente neutra."

# game/scenario/10_1_0_0.rpy:348
translate portuguese 57900c69:

    # nyra taquin "Noam."
    nyra taquin "Noam."

# game/scenario/10_1_0_0.rpy:350
translate portuguese c1d43630:

    # noam "Oui ?"
    noam "Sim?"

# game/scenario/10_1_0_0.rpy:352
translate portuguese 73576b90:

    # nyra "C'est littéralement mon travail."
    nyra "Isso é literalmente o meu trabalho."

# game/scenario/10_1_0_0.rpy:356
translate portuguese faa78f1f:

    # noam sourire "Vu comme ça."
    noam sourire "Colocando assim..."

# game/scenario/10_1_0_0.rpy:358
translate portuguese 961c5dc0:

    # nyra raison "Pendant le débat, laisse-moi parler."
    nyra raison "Durante o debate, deixa eu falar."

# game/scenario/10_1_0_0.rpy:360
translate portuguese f3da6531:

    # noam surpris "C'est tout ?"
    noam surpris "Só isso?"

# game/scenario/10_1_0_0.rpy:362
translate portuguese 36c35e20:

    # nyra "Non. S'ils commencent à défendre la surveillance, ne les contredis pas."
    nyra "Não. Se eles começarem a defender a vigilância, não contradiz."

# game/scenario/10_1_0_0.rpy:366
translate portuguese 4dd6312c:

    # nyra taquin "Parce qu'ils feront une partie du travail à ma place."
    nyra taquin "Porque assim eles fazem parte do trabalho por mim."

# game/scenario/10_1_0_0.rpy:368
translate portuguese 5f4df94b:

    # "Elle tourne déjà les talons."
    "Ela já está se virando pra ir."

# game/scenario/10_1_0_0.rpy:370
translate portuguese f2d4882b:

    # noam reflexion "Je sens que je vais regretter de demander."
    noam reflexion "Sinto que vou me arrepender de ter perguntado."

# game/scenario/10_1_0_0.rpy:372
translate portuguese 851fc21b:

    # nyra "Probablement."
    nyra "Provavelmente."

# game/scenario/10_1_0_0.rpy:386
translate portuguese a7a3bc3b:

    # "Le reste de la matinée passe lentement et, à l'heure du déjeuner, les conversations tournent déjà presque toutes autour du prochain vote."
    "O resto da manhã passa devagar e, na hora do almoço, quase todas as conversas já giram em torno da próxima votação."

# game/scenario/10_1_0_0.rpy:388
translate portuguese 061075a6:

    # think "Pour une fois, je préférerais que personne n'y réfléchisse trop."
    think "Pela primeira vez, eu preferia que ninguém pensasse demais nisso."

# game/scenario/10_1_0_0.rpy:402
translate portuguese d764931d:

    # "En milieu d'après-midi, plusieurs représentants se retrouvent naturellement dans la salle commune. Personne n'avait réellement prévu de débat ; il commence simplement lorsque Tomas pose une question."
    "No meio da tarde, vários representantes acabam se juntando na sala comum. Ninguém tinha planejado um debate; ele simplesmente começa quando o Tomas faz uma pergunta."

# game/scenario/10_1_0_0.rpy:413
translate portuguese 2cd960e3:

    # tomas raison "Vous voulez vraiment autoriser n'importe qui à bloquer complètement les caméras ? Je comprends l'argument de la vie privée, mais on oublie un peu vite pourquoi elles ont été installées."
    tomas raison "Vocês querem mesmo autorizar qualquer um a bloquear completamente as câmeras? Eu entendo o argumento da privacidade, mas a gente esquece rápido demais por que elas foram instaladas."

# game/scenario/10_1_0_0.rpy:415
translate portuguese 6bf76084:

    # iris reflexion "Tu penses vraiment qu'elles empêchent tant de choses que ça ?"
    iris reflexion "Você acha mesmo que elas impedem tanta coisa assim?"

# game/scenario/10_1_0_0.rpy:417
translate portuguese ff9c2ec6:

    # tomas raison "Pas tout, évidemment. Mais une agression dans une rue, quelqu'un qui s'effondre, un incendie, un accident... Quand il y a des caméras, on peut comprendre plus vite ce qui s'est passé et parfois intervenir avant que ça empire."
    tomas raison "Nem tudo, claro. Mas uma agressão numa rua, alguém que desmaia, um incêndio, um acidente... Quando tem câmera, dá pra entender mais rápido o que aconteceu e às vezes intervir antes de piorar."

# game/scenario/10_1_0_0.rpy:419
translate portuguese 6fcd4f4a:

    # elias reflechit "Je suis assez d'accord avec lui. J'aime pas l'idée d'être observé en permanence, mais la surveillance, c'est pas seulement du contrôle. Ça peut aussi protéger les gens."
    elias reflechit "Eu concordo bastante com ele. Não gosto da ideia de ser observado o tempo todo, mas vigilância não é só controle. Também pode proteger as pessoas."

# game/scenario/10_1_0_0.rpy:421
translate portuguese 52cb5be3:

    # mara reflexion "Donc vous seriez contre les brouilleurs ?"
    mara reflexion "Então vocês seriam contra os bloqueadores?"

# game/scenario/10_1_0_0.rpy:423
translate portuguese aa08247c:

    # tomas inquiet "Je sais pas encore. Je dis juste qu'en les autorisant partout, on crée aussi des zones où quelqu'un peut faire n'importe quoi sans laisser de trace."
    tomas inquiet "Ainda não sei. Só estou dizendo que, autorizando em todo lugar, a gente também cria zonas onde alguém pode fazer qualquer coisa sem deixar rastro."

# game/scenario/10_1_0_0.rpy:425
translate portuguese 8d2cfcd4:

    # elias "C'est surtout ça qui me gêne."
    elias "É principalmente isso que me incomoda."

# game/scenario/10_1_0_0.rpy:427
translate portuguese 64649fc1:

    # nyra raison "Et vous avez raison sur ce point : les caméras sont utiles. Elles dissuadent certains crimes, facilitent les enquêtes et peuvent sauver des gens. Mais le vote ne porte pas sur leur suppression ; il porte sur la possibilité de s'y soustraire ponctuellement."
    nyra raison "E vocês têm razão nesse ponto: as câmeras são úteis. Elas inibem certos crimes, facilitam investigações e podem salvar gente. Mas a votação não é sobre eliminá-las; é sobre a possibilidade de escapar delas pontualmente."

# game/scenario/10_1_0_0.rpy:429
translate portuguese 4f82fa02:

    # "Tomas se redresse légèrement, déjà prêt à répondre, mais Nyra enchaîne avant qu'il puisse reprendre son argument."
    "Tomas se ajeita na cadeira, já pronto pra responder, mas a Nyra emenda antes que ele retome o argumento."

# game/scenario/10_1_0_0.rpy:431
translate portuguese 29aaa001:

    # nyra "Si je suis votre raisonnement jusqu'au bout, parce qu'une caméra peut protéger quelqu'un, personne ne devrait jamais pouvoir échapper à une caméra. Pourtant, j'imagine qu'aucun de vous n'accepterait d'en avoir une dans sa chambre, dans un vestiaire, pendant une consultation médicale ou au milieu d'une conversation privée."
    nyra "Se eu levar o raciocínio de vocês até o fim, como uma câmera pode proteger alguém, ninguém jamais deveria conseguir escapar de uma câmera. E, no entanto, imagino que nenhum de vocês aceitaria ter uma no quarto, num vestiário, durante uma consulta médica ou no meio de uma conversa privada."

# game/scenario/10_1_0_0.rpy:433
translate portuguese d2f47f59:

    # elias reflexion "Évidemment que non, mais ce sont des espaces privés. Une rue, c'est différent."
    elias reflexion "Claro que não, mas esses são espaços privados. Uma rua é diferente."

# game/scenario/10_1_0_0.rpy:435
translate portuguese 08b89cdf:

    # nyra raison "Justement. La vraie question est de savoir qui décide où commence la vie privée. Une réunion syndicale dans un local public ? Une discussion entre un avocat et son client ? Une réunion politique ? Un rendez-vous médical dans un bâtiment appartenant à l'État ? La frontière est beaucoup moins évidente qu'entre une chambre et une rue."
    nyra raison "Justamente. A verdadeira questão é saber quem decide onde começa a vida privada. Uma reunião sindical num prédio público? Uma conversa entre advogado e cliente? Uma reunião política? Uma consulta médica num prédio do Estado? A fronteira é bem menos óbvia do que entre um quarto e uma rua."

# game/scenario/10_1_0_0.rpy:437
translate portuguese f026cc08:

    # mara reflexion "Là-dessus, elle a raison. On ne peut pas simplement décréter que tout ce qui n'est pas chez toi appartient à la surveillance."
    mara reflexion "Nisso ela tem razão. Não dá pra simplesmente decretar que tudo que não é a sua casa pertence à vigilância."

# game/scenario/10_1_0_0.rpy:439
translate portuguese 702e8b86:

    # tomas raison "D'accord, mais un brouilleur peut aussi être utilisé volontairement dans la rue pour masquer un crime. Ce risque existe toujours."
    tomas raison "Tá, mas um bloqueador também pode ser usado de propósito na rua pra encobrir um crime. Esse risco continua existindo."

# game/scenario/10_1_0_0.rpy:441
translate portuguese 0ac5597c:

    # nyra "Bien sûr, et je ne cherche pas à prétendre le contraire. Une voiture peut servir à fuir après un crime, un médicament peut être détourné, un réseau informatique peut servir à voler des données. Le fait qu'un outil puisse être mal utilisé n'implique pas forcément qu'il faille l'interdire."
    nyra "Claro, e eu não vou fingir o contrário. Um carro pode servir pra fugir depois de um crime, um remédio pode ser desviado, uma rede de computadores pode servir pra roubar dados. O fato de uma ferramenta poder ser mal usada não implica necessariamente proibi-la."

# game/scenario/10_1_0_0.rpy:443
translate portuguese ef2d27ed:

    # mara "On réglemente son utilisation."
    mara "A gente regulamenta o uso."

# game/scenario/10_1_0_0.rpy:445
translate portuguese ed104d59:

    # nyra sourire "Exactement. Et c'est beaucoup plus facile de réglementer une filière légale que des appareils clandestins dont personne ne connaît ni le fabricant, ni la puissance, ni l'utilisateur."
    nyra sourire "Exatamente. E é muito mais fácil regulamentar uma cadeia legal do que aparelhos clandestinos dos quais ninguém sabe o fabricante, a potência nem o usuário."

# game/scenario/10_1_0_0.rpy:447
translate portuguese a67d8b59:

    # elias reflechit "Donc tu voudrais autoriser les brouilleurs mais définir des endroits où ils resteraient interdits."
    elias reflechit "Então você quer autorizar os bloqueadores, mas definir lugares onde continuariam proibidos."

# game/scenario/10_1_0_0.rpy:449
translate portuguese a949de41:

    # nyra raison "Oui. Hôpitaux, zones de sécurité, certains bâtiments administratifs, éventuellement certains événements. On protège les endroits où la surveillance est réellement nécessaire sans considérer que chaque citoyen doit être observable en permanence."
    nyra raison "Sim. Hospitais, zonas de segurança, alguns prédios administrativos, eventualmente certos eventos. A gente protege os lugares onde a vigilância é realmente necessária sem considerar que cada cidadão precisa ser observável o tempo todo."

# game/scenario/10_1_0_0.rpy:451
translate portuguese e85acf50:

    # tomas reflexion "Ça règle une partie du problème, mais si tu légalises ces appareils, tu vas forcément en multiplier le nombre."
    tomas reflexion "Isso resolve parte do problema, mas se você legaliza esses aparelhos, o número deles vai se multiplicar."

# game/scenario/10_1_0_0.rpy:453
translate portuguese 632dcd79:

    # nyra "Oui, et c'est aussi là que l'interdiction me semble économiquement absurde. Une filière légale signifie de l'extraction de matières premières, du transport, de la transformation, de l'assemblage, de la maintenance, de la certification et du développement logiciel."
    nyra "Vai, e é aí também que a proibição me parece economicamente absurda. Uma cadeia legal significa extração de matéria-prima, transporte, transformação, montagem, manutenção, certificação e desenvolvimento de software."

# game/scenario/10_1_0_0.rpy:455
translate portuguese 584bceed:

    # elias reflexion "Donc beaucoup d'emplois."
    elias reflexion "Ou seja, muitos empregos."

# game/scenario/10_1_0_0.rpy:457
translate portuguese ca3e15a0:

    # nyra "Exactement. Et surtout des appareils qu'on peut enregistrer, tester et limiter techniquement. Avec une interdiction totale, les brouilleurs ne disparaissent pas ; ils deviennent simplement un marché clandestin réservé à ceux qui savent où les trouver."
    nyra "Exatamente. E, principalmente, aparelhos que dá pra registrar, testar e limitar tecnicamente. Com uma proibição total, os bloqueadores não desaparecem; viram só um mercado clandestino reservado a quem sabe onde encontrar."

# game/scenario/10_1_0_0.rpy:459
translate portuguese 24cb986e:

    # iris taquin "Je crois que Nyra vient de transformer un débat sur la surveillance en politique industrielle."
    iris taquin "Acho que a Nyra acabou de transformar um debate sobre vigilância em política industrial."

# game/scenario/10_1_0_0.rpy:461
translate portuguese 7fe20d38:

    # julian sourire "Et personne n'a réussi à l'arrêter."
    julian sourire "E ninguém conseguiu parar ela."

# game/scenario/10_1_0_0.rpy:463
translate portuguese a9a7b725:

    # "Tomas soupire en regardant Nyra, plus amusé qu'agacé."
    "Tomas suspira olhando pra Nyra, mais divertido do que irritado."

# game/scenario/10_1_0_0.rpy:465
translate portuguese 5f7638ae:

    # tomas desaccord "J'ai quand même l'impression que tu nous fais dire ce qui t'arrange depuis dix minutes."
    tomas desaccord "Ainda assim tenho a impressão de que faz dez minutos você faz a gente dizer o que te convém."

# game/scenario/10_1_0_0.rpy:467
translate portuguese 42e518b1:

    # nyra taquin "Je vous pose des questions. Si vos réponses m'arrangent, je n'y peux rien."
    nyra taquin "Eu faço perguntas. Se as respostas de vocês me convêm, não é culpa minha."

# game/scenario/10_1_0_0.rpy:469
translate portuguese cb0b90a0:

    # noam sourire "C'est exactement ce qu'elle m'avait annoncé ce matin."
    noam sourire "Foi exatamente isso que ela me avisou hoje de manhã."

# game/scenario/10_1_0_0.rpy:471
translate portuguese 9eb19ded:

    # tomas reflexion "Je reste convaincu qu'on sous-estime le rôle protecteur des caméras."
    tomas reflexion "Continuo convencido de que a gente subestima o papel protetor das câmeras."

# game/scenario/10_1_0_0.rpy:473
translate portuguese 08e5d57f:

    # nyra raison "Et moi je pense que tu viens justement de donner le meilleur argument pour conserver les caméras là où elles sont utiles. Mais conserver la surveillance n'oblige pas à interdire toute possibilité d'intimité."
    nyra raison "E eu acho que você acabou de dar o melhor argumento pra manter as câmeras onde elas são úteis. Mas manter a vigilância não obriga a proibir qualquer possibilidade de intimidade."

# game/scenario/10_1_0_0.rpy:475
translate portuguese d43368b3:

    # "Elle marque une courte pause avant de regarder successivement Tomas puis Elias."
    "Ela faz uma pausa curta antes de olhar primeiro pro Tomas e depois pro Elias."

# game/scenario/10_1_0_0.rpy:477
translate portuguese f9be4583:

    # nyra "Le choix n'est pas entre surveillance totale et absence totale de surveillance. Il est entre un système où la caméra reste la règle mais où certaines personnes peuvent créer un espace privé, et un système où personne n'a jamais le droit de dire : ici, maintenant, je ne veux pas être observé."
    nyra "A escolha não é entre vigilância total e ausência total de vigilância. É entre um sistema em que a câmera continua sendo a regra, mas em que algumas pessoas podem criar um espaço privado, e um sistema em que ninguém nunca tem o direito de dizer: aqui, agora, eu não quero ser observado."

# game/scenario/10_1_0_0.rpy:479
translate portuguese 3600d8e2:

    # "Cette fois, Tomas ne répond pas immédiatement. Elias baisse les yeux, réfléchit quelques secondes puis se redresse."
    "Dessa vez, o Tomas não responde na hora. Elias baixa os olhos, pensa alguns segundos e endireita as costas."

# game/scenario/10_1_0_0.rpy:481
translate portuguese fd3723e1:

    # elias reflechit "Présenté comme ça, je voterais probablement pour l'autorisation, à condition qu'il y ait des restrictions claires sur certains lieux."
    elias reflechit "Colocado assim, eu provavelmente votaria pela autorização, desde que haja restrições claras pra certos lugares."

# game/scenario/10_1_0_0.rpy:483
translate portuguese c03efef4:

    # tomas reflexion "Moi, j'ai encore besoin d'y réfléchir. Mais je suis moins opposé qu'au début."
    tomas reflexion "Eu ainda preciso pensar. Mas estou menos contra do que no começo."

# game/scenario/10_1_0_0.rpy:485
translate portuguese 36653ab1:

    # iris sourire "Ça ressemble beaucoup à une victoire."
    iris sourire "Isso se parece muito com uma vitória."

# game/scenario/10_1_0_0.rpy:487
translate portuguese f88b886e:

    # nyra taquin "Pas encore. Il nous faut l'unanimité."
    nyra taquin "Ainda não. A gente precisa de unanimidade."

# game/scenario/10_1_0_0.rpy:489
translate portuguese 044b23af:

    # "La phrase paraît parfaitement innocente pour les autres. Pour moi, elle signifie tout autre chose."
    "A frase parece perfeitamente inocente pros outros. Pra mim, significa outra coisa bem diferente."

# game/scenario/10_1_0_0.rpy:491
translate portuguese 2a06ea80:

    # think "Et elle le sait très bien."
    think "E ela sabe muito bem disso."

# game/scenario/10_1_0_0.rpy:505
translate portuguese 06db21d6:

    # "En fin d'après-midi, je traverse les couloirs sans destination particulière."
    "No fim da tarde, atravesso os corredores sem destino nenhum."

# game/scenario/10_1_0_0.rpy:507
translate portuguese 1d6a265a:

    # "Le débat tourne encore dans ma tête."
    "O debate ainda está rodando na minha cabeça."

# game/scenario/10_1_0_0.rpy:509
translate portuguese adca4fbd:

    # think "Si Nyra arrive à convaincre Tomas, on devrait pouvoir faire passer le vote. Devrait."
    think "Se a Nyra conseguir convencer o Tomas, a gente deve conseguir aprovar a votação. Deve."

# game/scenario/10_1_0_0.rpy:511
translate portuguese e0d98f8c:

    # "Je ralentis devant la salle des archives."
    "Diminuo o passo na frente da sala de arquivos."

# game/scenario/10_1_0_0.rpy:513
translate portuguese 85dc157a:

    # think "Je ne viens pratiquement jamais ici."
    think "Eu praticamente nunca venho aqui."

# game/scenario/10_1_0_0.rpy:515
translate portuguese b63200c7:

    # "La porte est légèrement entrouverte et une lumière bleutée passe par l'ouverture."
    "A porta está entreaberta e uma luz azulada passa pela fresta."

# game/scenario/10_1_0_0.rpy:517
translate portuguese bc8f780c_1:

    # noam reflexion "..."
    noam reflexion "..."

# game/scenario/10_1_0_0.rpy:519
translate portuguese bc8abe05:

    # "Je m'approche."
    "Chego mais perto."

# game/scenario/10_1_0_0.rpy:526
translate portuguese eb9c2503:

    # "La salle est presque vide ; des rangées de terminaux longent les murs, mais un seul est allumé, celui devant lequel Ryn est assis."
    "A sala está quase vazia; fileiras de terminais margeiam as paredes, mas só um está ligado, aquele em que o Ryn está sentado."

# game/scenario/10_1_0_0.rpy:532
translate portuguese fc96c4fe:

    # "Il ne m'a pas entendu entrer."
    "Ele não me ouviu entrar."

# game/scenario/10_1_0_0.rpy:534
translate portuguese 93f17fd1:

    # "Son écran affiche plusieurs fenêtres disposées en mosaïque."
    "A tela dele mostra várias janelas dispostas em mosaico."

# game/scenario/10_1_0_0.rpy:536
translate portuguese 1887e94b:

    # "Des images de hangars."
    "Imagens de galpões."

# game/scenario/10_1_0_0.rpy:538
translate portuguese 75deae62:

    # "Des quais."
    "Docas."

# game/scenario/10_1_0_0.rpy:540
translate portuguese ee64fbfc:

    # "Des camions."
    "Caminhões."

# game/scenario/10_1_0_0.rpy:542
translate portuguese f3076006:

    # "Des conteneurs filmés depuis différents angles."
    "Contêineres filmados de ângulos diferentes."

# game/scenario/10_1_0_0.rpy:544
translate portuguese df0bf979:

    # think "Des caméras."
    think "Câmeras."

# game/scenario/10_1_0_0.rpy:546
translate portuguese 7d50c43c:

    # "Je reste près de l'entrée."
    "Fico perto da entrada."

# game/scenario/10_1_0_0.rpy:548
translate portuguese f0313f0d:

    # "Ryn ouvre une fiche."
    "Ryn abre uma ficha."

# game/scenario/10_1_0_0.rpy:550
translate portuguese 778379cc:

    # "Numéro de conteneur."
    "Número do contêiner."

# game/scenario/10_1_0_0.rpy:552
translate portuguese 3f8eec82:

    # "Origine."
    "Origem."

# game/scenario/10_1_0_0.rpy:554
translate portuguese c98ee839:

    # "Destination."
    "Destino."

# game/scenario/10_1_0_0.rpy:556
translate portuguese d10c766d:

    # "Scellé."
    "Lacre."

# game/scenario/10_1_0_0.rpy:558
translate portuguese 9029de8d:

    # "Statut."
    "Status."

# game/scenario/10_1_0_0.rpy:560
translate portuguese 8467134e:

    # "Il fait défiler plusieurs images, puis clique sur une option."
    "Ele passa por várias imagens e depois clica numa opção."

# game/scenario/10_1_0_0.rpy:562
translate portuguese e907d34e:

    # "\"CONTRÔLE NON PRIORITAIRE\""
    "\"FISCALIZAÇÃO NÃO PRIORITÁRIA\""

# game/scenario/10_1_0_0.rpy:564
translate portuguese 371f81a6:

    # "Une nouvelle fiche apparaît."
    "Uma nova ficha aparece."

# game/scenario/10_1_0_0.rpy:566
