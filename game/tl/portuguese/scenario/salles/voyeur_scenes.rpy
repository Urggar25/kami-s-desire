# game/scenario/salles/voyeur_scenes.rpy:17
translate portuguese temps_libre_salle_repos_252337a3:

    # "La salle de repos est calme, faiblement éclairée par les veilleuses bleues. Des bancs, des distributeurs, un paravent à moitié ouvert dans le coin du fond."
    "A sala de descanso está calma, iluminada apenas pelo brilho fraco das luzes azuis de emergência. Há bancos, máquinas de venda e um biombo meio aberto no canto mais ao fundo."

# game/scenario/salles/voyeur_scenes.rpy:18
translate portuguese temps_libre_salle_repos_b9cfb2f7:

    # "J'entends un rire étouffé venant de derrière le paravent. je m'approche sans bruit et regarde ce qu'il se passe."
    "Ouço uma risada abafada vindo de trás do biombo. Me aproximo sem fazer barulho e espio o que está acontecendo."

# game/scenario/salles/voyeur_scenes.rpy:23
translate portuguese temps_libre_salle_repos_8bcf7ecf:

    # iris "Pff… t’es sérieux là ? Ici ?"
    iris "Pff… tá falando sério? Aqui?"

# game/scenario/salles/voyeur_scenes.rpy:24
translate portuguese temps_libre_salle_repos_2f546948:

    # iris "Si quelqu’un entre…"
    iris "Se alguém entrar…"

# game/scenario/salles/voyeur_scenes.rpy:26
translate portuguese temps_libre_salle_repos_644ceb72:

    # julian "Justement, c’est ça qui rend ça excitant."
    julian "É justamente isso que deixa tudo mais excitante."

# game/scenario/salles/voyeur_scenes.rpy:27
translate portuguese temps_libre_salle_repos_7c1ff7f4:

    # julian "Allez, Iris… détends-toi un peu. Personne ne viendra à cette heure."
    julian "Vai, Iris… relaxa um pouco. Ninguém vai aparecer a essa hora."

# game/scenario/salles/voyeur_scenes.rpy:29
translate portuguese temps_libre_salle_repos_e0d9ab49:

    # iris "T’es vraiment un crâneur…"
    iris "Você se acha demais…"

# game/scenario/salles/voyeur_scenes.rpy:31
translate portuguese temps_libre_salle_repos_3341b05d:

    # "Julian se penche vers elle, glisse une main sous sa chemise entrouverte. Iris sursaute légèrement, mais ne le repousse pas."
    "Julian se inclina até ela e desliza uma mão por baixo da camisa entreaberta. Iris se assusta de leve, mas não o afasta."

# game/scenario/salles/voyeur_scenes.rpy:32
translate portuguese temps_libre_salle_repos_7efb0075:

    # "Elle râle encore, mais sa voix tremble :"
    "Ela ainda reclama, mas a voz treme:"

# game/scenario/salles/voyeur_scenes.rpy:34
translate portuguese temps_libre_salle_repos_d6d0af3e:

    # iris "Arrête… ou continue, je sais plus…"
    iris "Para… ou continua, eu nem sei mais…"

# game/scenario/salles/voyeur_scenes.rpy:36
translate portuguese temps_libre_salle_repos_2c070d0e:

    # julian "Chut…"
    julian "Shh…"

# game/scenario/salles/voyeur_scenes.rpy:38
translate portuguese temps_libre_salle_repos_aba5de48:

    # "Il l’embrasse dans le cou, lentement. Sa main remonte sur sa poitrine, effleure sans déshabiller. Iris ferme les yeux, mord sa lèvre, un petit gémissement lui échappe malgré elle."
    "Ele beija o pescoço dela devagar. A mão sobe até o peito, roçando sem tirar a roupa. Iris fecha os olhos, morde o lábio e deixa escapar um gemido baixinho sem querer."

# game/scenario/salles/voyeur_scenes.rpy:39
translate portuguese temps_libre_salle_repos_45d1245d:

    # "Elle pose sa main sur celle de Julian pour la guider, mais garde son haut en place – comme si elle voulait garder le contrôle."
    "Ela põe a mão sobre a de Julian para guiá-la, mas mantém a blusa no lugar — como se quisesse continuar no controle."

# game/scenario/salles/voyeur_scenes.rpy:41
translate portuguese temps_libre_salle_repos_edd5442f:

    # iris "T’es… insupportable…"
    iris "Você é… insuportável…"

# game/scenario/salles/voyeur_scenes.rpy:43
translate portuguese temps_libre_salle_repos_0e44d8c7:

    # julian "Et toi, t’es adorable quand tu râles."
    julian "E você fica uma graça quando reclama."

# game/scenario/salles/voyeur_scenes.rpy:45
translate portuguese temps_libre_salle_repos_ef5041e7:

    # "Ils s’embrassent doucement, puis plus profondément. Les mains de Julian descendent sur ses hanches, sous sa jupe, mais sans aller trop loin – juste des caresses légères sur la peau."
    "Eles se beijam de leve, depois com mais intensidade. As mãos de Julian descem até os quadris dela, por baixo da saia, mas sem ir longe demais — apenas carícias leves na pele."

# game/scenario/salles/voyeur_scenes.rpy:46
translate portuguese temps_libre_salle_repos_abb71c0d:

    # "Iris respire plus fort, ses doigts s’agrippent à la chemise de Julian."
    "Iris começa a respirar mais forte, os dedos agarrados à camisa de Julian."

# game/scenario/salles/voyeur_scenes.rpy:48
translate portuguese temps_libre_salle_repos_dc70ebcb:

    # iris "Si quelqu’un nous voit… je te tue."
    iris "Se alguém vir a gente… eu te mato."

# game/scenario/salles/voyeur_scenes.rpy:50
translate portuguese temps_libre_salle_repos_d8a1e91c:

    # julian "Alors sois plus discrète…"
    julian "Então faz menos barulho…"

# game/scenario/salles/voyeur_scenes.rpy:52
translate portuguese temps_libre_salle_repos_66e6f2c6:

    # "Ils rient tout bas, complices. Julian murmure quelque chose à son oreille qui la fait rougir encore plus."
    "Eles riem baixinho, cúmplices. Julian sussurra alguma coisa no ouvido dela que a faz corar ainda mais."

# game/scenario/salles/voyeur_scenes.rpy:54
translate portuguese temps_libre_salle_repos_3a899032:

    # "Tu recules lentement dans l’ombre, le cœur battant. Ils ne t’ont pas vu. Tu sors de la salle sans un bruit."
    "Você recua devagar para as sombras, com o coração acelerado. Eles não te viram. Você sai da sala sem fazer nenhum barulho."

# game/scenario/salles/voyeur_scenes.rpy:68
translate portuguese temps_libre_salle_archive_2e5ce0d5:

    # "Je pousse la porte de la salle des archives. C’est sombre, poussiéreux, rempli d’étagères métalliques et de vieux terminaux. L’odeur de métal froid et de papier ancien me prend à la gorge."
    "Empurro a porta da sala de arquivos. Está escuro, empoeirado, cheio de estantes metálicas e terminais antigos. O cheiro de metal frio e papel velho quase fecha minha garganta."

# game/scenario/salles/voyeur_scenes.rpy:69
translate portuguese temps_libre_salle_archive_878813cf:

    # "Je m’avance doucement, quand un rire bas et provocateur me parvient du fond, derrière une rangée de casiers. Je m’approche sans bruit, restant dans l’ombre d’une pile de boîtes."
    "Avanço devagar quando ouço, lá do fundo, uma risada baixa e provocadora atrás de uma fileira de armários. Me aproximo sem fazer barulho, ficando escondido na sombra de uma pilha de caixas."

# game/scenario/salles/voyeur_scenes.rpy:74
translate portuguese temps_libre_salle_archive_f5e49fc5:

    # mara "Attends… t’es sérieux là ?"
    mara "Espera… você tá falando sério?"

# game/scenario/salles/voyeur_scenes.rpy:75
translate portuguese temps_libre_salle_archive_62683252:

    # mara "T’as jamais rien fait avec une fille ? Jamais ?"
    mara "Você nunca fez nada com uma garota? Nunca mesmo?"

# game/scenario/salles/voyeur_scenes.rpy:77
translate portuguese temps_libre_salle_archive_04a01f6b:

    # tomas "Euh… non… je… j’ai jamais eu l’occasion…"
    tomas "Ah… não… eu… nunca tive a oportunidade…"

# game/scenario/salles/voyeur_scenes.rpy:78
translate portuguese temps_libre_salle_archive_41afae6e:

    # tomas "C’est… c’est pas que je voulais pas, hein… c’est juste…"
    tomas "Não é… não é que eu não quisesse, tá? É só que…"

# game/scenario/salles/voyeur_scenes.rpy:80
translate portuguese temps_libre_salle_archive_00a4d48f:

    # mara "Oh mon dieu, c’est trop mignon."
    mara "Meu Deus, isso é fofo demais."

# game/scenario/salles/voyeur_scenes.rpy:81
translate portuguese temps_libre_salle_archive_a1339731:

    # mara "Le petit intello qui rougit dès qu’on parle de cul."
    mara "O nerdzinho fica vermelho só de ouvir falar de sexo."

# game/scenario/salles/voyeur_scenes.rpy:82
translate portuguese temps_libre_salle_archive_4bd6d1a1:

    # mara "Viens là, approche."
    mara "Vem cá, chega mais."

# game/scenario/salles/voyeur_scenes.rpy:84
translate portuguese temps_libre_salle_archive_71df315a:

    # "Je me fige derrière les boîtes. Mara s’adosse à une chaise, croise les bras sous sa poitrine pour la faire remonter légèrement, elle sourit en coin."
    "Fico imóvel atrás das caixas. Mara se encosta numa cadeira, cruza os braços sob o peito, realçando-o de leve, e dá um sorriso de canto."

# game/scenario/salles/voyeur_scenes.rpy:85
translate portuguese temps_libre_salle_archive_3e7d776e:

    # "Tomas avance d’un pas hésitant, rouge jusqu’aux oreilles."
    "Tomas dá um passo hesitante, vermelho até as orelhas."

# game/scenario/salles/voyeur_scenes.rpy:87
translate portuguese temps_libre_salle_archive_87388a5c:

    # mara "Allez, touche."
    mara "Vai, toca."

# game/scenario/salles/voyeur_scenes.rpy:88
translate portuguese temps_libre_salle_archive_33f9b618:

    # mara "Je te jure que je mords pas… enfin, pas trop."
    mara "Juro que não mordo… quer dizer, não muito."

# game/scenario/salles/voyeur_scenes.rpy:90
translate portuguese temps_libre_salle_archive_ed6df2d1:

    # tomas "M-Mara… si quelqu’un arrive…"
    tomas "M-Mara… e se alguém aparecer…"

# game/scenario/salles/voyeur_scenes.rpy:92
translate portuguese temps_libre_salle_archive_93130762:

    # mara "Personne vient ici. Et puis, c’est juste pour te dépuceler un peu les mains."
    mara "Ninguém vem aqui. E é só pra tirar um pouco a virgindade dessas suas mãos."

# game/scenario/salles/voyeur_scenes.rpy:93
translate portuguese temps_libre_salle_archive_5b1543f0:

    # mara "Vas-y. Tu peux toucher où tu veux. Doucement."
    mara "Vai. Pode tocar onde quiser. Devagar."

# game/scenario/salles/voyeur_scenes.rpy:95
translate portuguese temps_libre_salle_archive_85758d7a:

    # "Je retiens mon souffle. Tomas tremble, mais pose une main hésitante sur sa cuisse tandis que l'autre attrape son flanc. Mara rit doucement, prend sa main et la guide lentement plus haut, sous sa jupe, sans jamais la soulever complètement."
    "Prendo a respiração. Tomas treme, mas põe uma mão hesitante na coxa dela enquanto a outra segura sua lateral. Mara ri baixinho, pega a mão dele e a guia devagar para cima, por baixo da saia, sem levantá-la por completo."

# game/scenario/salles/voyeur_scenes.rpy:96
translate portuguese temps_libre_salle_archive_aa70605e:

    # "Elle garde les yeux dans les siens, provocante."
    "Ela mantém os olhos fixos nos dele, provocadora."

# game/scenario/salles/voyeur_scenes.rpy:98
translate portuguese temps_libre_salle_archive_22f84b4b:

    # mara "Tu sens ?"
    mara "Tá sentindo?"

# game/scenario/salles/voyeur_scenes.rpy:99
translate portuguese temps_libre_salle_archive_d580f731:

    # mara "C’est pas sorcier. Juste… explore un peu."
    mara "Não tem mistério. Só… explora um pouco."

# game/scenario/salles/voyeur_scenes.rpy:101
translate portuguese temps_libre_salle_archive_683725ab:

    # "Tomas respire fort, ses doigts effleurent timidement ses vêtements, puis un peu plus haut. Mara soupire de plaisir, mais garde le contrôle."
    "Tomas respira pesado, os dedos roçando timidamente a roupa dela, depois subindo um pouco mais. Mara solta um suspiro de prazer, mas continua no controle."

# game/scenario/salles/voyeur_scenes.rpy:102
translate portuguese temps_libre_salle_archive_b0059535:

    # "Elle ne se déshabille pas – juste une main guidée, des caresses légères, un jeu de pouvoir."
    "Ela não tira a roupa — é só uma mão sendo guiada, carícias leves, um jogo de poder."

# game/scenario/salles/voyeur_scenes.rpy:104
translate portuguese temps_libre_salle_archive_87eec86d:

    # mara "Pas mal pour un débutant…"
    mara "Nada mal pra um iniciante…"

# game/scenario/salles/voyeur_scenes.rpy:105
translate portuguese temps_libre_salle_archive_e2aa462c:

    # mara "Tu vois ? C’est pas si terrifiant."
    mara "Viu? Não é tão assustador assim."

# game/scenario/salles/voyeur_scenes.rpy:107
translate portuguese temps_libre_salle_archive_6a956605:

    # tomas "Je… je sais pas quoi faire…"
    tomas "Eu… eu não sei o que fazer…"

# game/scenario/salles/voyeur_scenes.rpy:109
translate portuguese temps_libre_salle_archive_7a0277a1:

    # mara "Continue comme ça. T’es pas mal du tout."
    mara "Continua assim. Você tá indo muito bem."

# game/scenario/salles/voyeur_scenes.rpy:111
translate portuguese temps_libre_salle_archive_b435a6f0:

    # "Elle rit encore, un rire bas et taquin, tandis que Tomas continue timidement, comme hypnotisé."
    "Ela ri de novo, uma risada baixa e provocadora, enquanto Tomas continua timidamente, como se estivesse hipnotizado."

# game/scenario/salles/voyeur_scenes.rpy:112
translate portuguese temps_libre_salle_archive_5071f4ce:

    # "Je recule lentement dans l’ombre, le cœur battant. Ils ne m’ont pas vu. Je sors de la salle sans un bruit."
    "Recuo devagar para as sombras, com o coração acelerado. Eles não me viram. Saio da sala sem fazer nenhum barulho."

# game/scenario/salles/voyeur_scenes.rpy:127
translate portuguese temps_libre_salle_dortoir_1cb0c7a8:

    # "Je décide de passer par le dortoir. Les couloirs sont silencieux à cette heure. Seule la lueur bleue des veilleuses éclaire les portes des chambres."
    "Decido passar pelo dormitório. Os corredores estão silenciosos a essa hora. Só o brilho azul das luzes de emergência ilumina as portas dos quartos."

# game/scenario/salles/voyeur_scenes.rpy:128
translate portuguese temps_libre_salle_dortoir_e85ed1ba:

    # "Soudain, un bruit étouffé me parvient : un bourdonnement discret, suivi d’un soupir bas et contrôlé."
    "De repente, ouço um som abafado: um zumbido discreto, seguido por um suspiro baixo e controlado."

# game/scenario/salles/voyeur_scenes.rpy:129
translate portuguese temps_libre_salle_dortoir_43f0c205:

    # "Ça vient de la chambre de Nyra. La porte est légèrement entrouverte, juste une fine fente."
    "Vem do quarto da Nyra. A porta está ligeiramente aberta, deixando só uma fresta fina."

# game/scenario/salles/voyeur_scenes.rpy:130
translate portuguese temps_libre_salle_dortoir_53a4a4e5:

    # "Je m’approche sans un bruit, le cœur qui cogne. Je jette un œil prudent par l’interstice."
    "Me aproximo sem fazer barulho, com o coração batendo forte. Espio com cuidado pela fresta."

# game/scenario/salles/voyeur_scenes.rpy:135
translate portuguese temps_libre_salle_dortoir_ffd4b697:

    # "Nyra est allongée sur son lit, dos légèrement cambré, jupe relevée jusqu’aux hanches, haut déboutonné jusqu’à la taille."
    "Nyra está deitada na cama, com as costas levemente arqueadas, a saia levantada até os quadris e a blusa desabotoada até a cintura."

# game/scenario/salles/voyeur_scenes.rpy:136
translate portuguese temps_libre_salle_dortoir_5979c676:

    # "Entre ses cuisses écartées, un petit appareil artisanal – un vibromasseur qu’elle a dû fabriquer elle-même – vibre doucement contre elle."
    "Entre as pernas afastadas, um pequeno aparelho improvisado — um vibrador que ela mesma deve ter montado — vibra suavemente contra ela."

# game/scenario/salles/voyeur_scenes.rpy:137
translate portuguese temps_libre_salle_dortoir_98582a18:

    # "Elle le tient fermement d’une main, l’autre main sur sa poitrine, doigts pinçant un téton à travers le tissu."
    "Ela o segura firme com uma mão; a outra está sobre o peito, os dedos apertando um mamilo por cima do tecido."

# game/scenario/salles/voyeur_scenes.rpy:138
translate portuguese temps_libre_salle_dortoir_79d90d86:

    # "Ses mouvements sont précis, autoritaires : elle dirige l’objet avec assurance, comme si elle donnait des ordres à son propre corps."
    "Os movimentos dela são precisos, autoritários: controla o objeto com segurança, como se desse ordens ao próprio corpo."

# game/scenario/salles/voyeur_scenes.rpy:139
translate portuguese temps_libre_salle_dortoir_60d29977:

    # "Un soupir rauque lui échappe. Elle murmure pour elle-même :"
    "Um suspiro rouco escapa de seus lábios. Ela murmura para si mesma:"

# game/scenario/salles/voyeur_scenes.rpy:141
translate portuguese temps_libre_salle_dortoir_83e7e2d8:

    # nyra "Plus fort… oui… comme ça…"
    nyra "Mais forte… isso… assim…"

# game/scenario/salles/voyeur_scenes.rpy:143
translate portuguese temps_libre_salle_dortoir_5dd885fc:

    # "Elle accélère légèrement le rythme, les hanches se soulèvent par intermittence, cherchant le point parfait."
    "Ela acelera um pouco o ritmo, erguendo os quadris de vez em quando enquanto procura o ponto perfeito."

# game/scenario/salles/voyeur_scenes.rpy:144
translate portuguese temps_libre_salle_dortoir_0698bee7:

    # "Sa respiration devient saccadée, mais elle garde un contrôle absolu : pas de gémissements incontrôlés, juste des souffles profonds et maîtrisés."
    "A respiração fica entrecortada, mas ela mantém controle absoluto: nada de gemidos descontrolados, apenas respirações profundas e contidas."

# game/scenario/salles/voyeur_scenes.rpy:145
translate portuguese temps_libre_salle_dortoir_0a5aace9:

    # "Ses yeux sont mi-clos, concentrés sur son plaisir, comme si elle analysait chaque sensation."
    "Os olhos estão semicerrados, focados no próprio prazer, como se ela analisasse cada sensação."

# game/scenario/salles/voyeur_scenes.rpy:147
translate portuguese temps_libre_salle_dortoir_142b619d:

    # "Je reste figé derrière la porte, incapable de détourner le regard. Le bourdonnement continue, régulier, hypnotique."
    "Fico parado atrás da porta, incapaz de desviar o olhar. O zumbido continua, regular, hipnótico."

# game/scenario/salles/voyeur_scenes.rpy:148
translate portuguese temps_libre_salle_dortoir_34301f37:

    # "Nyra rejette la tête en arrière, un petit spasme la traverse. Elle murmure encore :"
    "Nyra joga a cabeça para trás quando um pequeno espasmo percorre seu corpo. Ela murmura de novo:"

# game/scenario/salles/voyeur_scenes.rpy:150
translate portuguese temps_libre_salle_dortoir_a7239b23:

    # nyra "C’est ça… parfait…"
    nyra "Isso… perfeito…"

# game/scenario/salles/voyeur_scenes.rpy:152
translate portuguese temps_libre_salle_dortoir_f13103fb:

    # "Elle ralentit enfin, retire doucement l’appareil, le pose sur le côté. Son souffle se calme, mais son sourire satisfait reste."
    "Por fim, ela diminui o ritmo, afasta o aparelho com cuidado e o coloca de lado. A respiração se acalma, mas o sorriso satisfeito continua ali."

# game/scenario/salles/voyeur_scenes.rpy:153
translate portuguese temps_libre_salle_dortoir_57be4586:

    # "Je recule lentement, le cœur battant à tout rompre. Elle ne m’a pas vu. Je m’éloigne sans un bruit, l’image gravée dans ma tête."
    "Recuo devagar, com o coração disparado. Ela não me viu. Me afasto sem fazer barulho, com aquela imagem gravada na cabeça."

# game/scenario/salles/voyeur_scenes.rpy:163
translate portuguese temps_libre_salle_stockage_argument_1f61864a:

    # "Au fond de la salle de stockage, deux silhouettes parlent à voix basse entre les caisses."
    "No fundo da sala de armazenamento, duas silhuetas conversam em voz baixa entre as caixas."

# game/scenario/salles/voyeur_scenes.rpy:164
translate portuguese temps_libre_salle_stockage_argument_bbc509f3:

    # "Sael tend un filtre à air. Nyra lui passe une pochette de joints d'étanchéité en échange."
    "Sael estende um filtro de ar. Em troca, Nyra lhe entrega um saquinho com juntas de vedação."

# game/scenario/salles/voyeur_scenes.rpy:171
translate portuguese temps_libre_salle_stockage_argument_ea96696b:

    # sael neutre "Filtre propre. Deux semaines si tu le ménages."
    sael neutre "Filtro limpo. Dura duas semanas se você não forçar."

# game/scenario/salles/voyeur_scenes.rpy:172
translate portuguese temps_libre_salle_stockage_argument_72fac0f3:

    # nyra neutre "Parfait. Ces joints éviteront une fuite sur la ligne secondaire."
    nyra neutre "Perfeito. Essas juntas vão evitar um vazamento na linha secundária."

# game/scenario/salles/voyeur_scenes.rpy:174
translate portuguese temps_libre_salle_stockage_argument_2cdbbb5a:

    # sael raison "Chez nous, je troquais déjà ça contre des repas chauds."
    sael raison "Lá onde eu vivia, eu já trocava isso por comida quente."

# game/scenario/salles/voyeur_scenes.rpy:175
translate portuguese temps_libre_salle_stockage_argument_d2f8697c:

    # sael raison "Quand je retournais en ville. Juste nécessaire."
