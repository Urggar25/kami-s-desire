# game/scenario/temps_libres.rpy:4
translate portuguese lysa_link_1_2cfe63d6:

    # "En passant devant la salle de repos, j'aperçois Lysa seule. Elle ne me remarque pas, alors je poursuis discrètement jusqu'à la cafétéria."
    "Ao passar pela sala de descanso, vejo Lysa sozinha. Ela não percebe minha presença, então sigo discretamente até a cafeteria."

# game/scenario/temps_libres.rpy:5
translate portuguese lysa_link_1_cc5ef8cd:

    # think "Elle regrettait tellement son café lors de notre rencontre... Autant réparer cette tragédie."
    think "Ela lamentou tanto não ter terminado o café quando nos conhecemos... Melhor reparar essa tragédia."

# game/scenario/temps_libres.rpy:11
translate portuguese lysa_link_1_4d3c2a5e:

    # noam neutre "Goumi, prépare-moi deux cafés. Du café ordinaire, sans supplément. Pas d'expérience bizarre avec. Je pense qu'elle le préfère comme ça."
    noam neutre "Goumi, prepara dois cafés pra mim. Café normal, sem adicional. Nada de experiência estranha. Acho que ela prefere assim."

# game/scenario/temps_libres.rpy:12
translate portuguese lysa_link_1_5e0e1494:

    # goumi vide "Votre méfiance est injustifiée. Mes préparations expérimentales respectent toutes un protocole rigoureux."
    goumi vide "Sua desconfiança é injustificada. Todas as minhas preparações experimentais seguem um protocolo rigoroso."

# game/scenario/temps_libres.rpy:13
translate portuguese lysa_link_1_41a3bc55:

    # noam inquiet "C'est précisément le mot « expérimental » qui m'inquiète. Deux cafés simples suffiront."
    noam inquiet "É justamente a palavra “experimental” que me preocupa. Dois cafés simples já bastam."

# game/scenario/temps_libres.rpy:14
translate portuguese lysa_link_1_2fdb576b:

    # goumi vide "Demande acceptée. Deux boissons chaudes, amères et terriblement simples."
    goumi vide "Pedido aceito. Duas bebidas quentes, amargas e terrivelmente simples."

# game/scenario/temps_libres.rpy:15
translate portuguese lysa_link_1_5b831195:

    # noam sourire "Parfait. Tu vois, quand tu veux, tu sais vendre tes produits."
    noam sourire "Perfeito. Viu só? Quando quer, você sabe vender bem os seus produtos."

# game/scenario/temps_libres.rpy:16
translate portuguese lysa_link_1_0b79da6c:

    # "Je récupère les deux gobelets et retourne dans la salle de repos."
    "Pego os dois copos e volto para a sala de descanso."

# game/scenario/temps_libres.rpy:23
translate portuguese lysa_link_1_0b4b7a36:

    # noam sourire "J'espère que je n'interromps pas une activité passionnante, parce que je t'ai apporté quelque chose."
    noam sourire "Espero não estar interrompendo nenhuma atividade fascinante, porque eu trouxe uma coisa pra você."

# game/scenario/temps_libres.rpy:24
translate portuguese lysa_link_1_bd60daec:

    # lysa surpris "Un café ? Attends... Tu es vraiment venu jusqu'ici uniquement pour m'en donner un ?"
    lysa surpris "Um café? Espera... Você veio até aqui só pra me dar um?"

# game/scenario/temps_libres.rpy:25
translate portuguese lysa_link_1_d3ccca02:

    # noam taquin "Ne t'emballe pas. J'en ai pris deux et je n'ai que deux mains, il fallait bien me débarrasser du second."
    noam taquin "Não se empolga. Peguei dois e só tenho duas mãos, então precisava me livrar do segundo."

# game/scenario/temps_libres.rpy:26
translate portuguese lysa_link_1_07025acb:

    # lysa blase "Évidemment. Pendant une seconde, j'ai failli croire que tu avais eu une attention gentille."
    lysa blase "Claro. Por um segundo, quase achei que você tinha feito uma gentileza."

# game/scenario/temps_libres.rpy:27
translate portuguese lysa_link_1_4d356f5e:

    # noam sourire "Lors de notre rencontre, tu râlais parce qu'on t'avait enlevée avant que tu puisses finir ton café. Je m'en suis souvenu."
    noam sourire "Quando a gente se conheceu, você ficou reclamando porque te levaram antes de conseguir terminar o café. Eu lembrei."

# game/scenario/temps_libres.rpy:28
translate portuguese lysa_link_1_963c2325:

    # lysa surpris "Parmi tout ce que j'ai dit ce jour-là, c'est vraiment cette plainte ridicule que tu as retenue ?"
    lysa surpris "De tudo o que eu falei naquele dia, foi mesmo essa reclamação ridícula que ficou na sua cabeça?"

# game/scenario/temps_libres.rpy:29
translate portuguese lysa_link_1_d40ea5e2:

    # noam reflexion "T'étais toute secouée, enfermée avec des inconnus, et pourtant ce café semblait rester une affaire capitale."
    noam reflexion "Você estava toda abalada, presa com um monte de desconhecidos, e ainda assim aquele café parecia uma questão de vida ou morte."

# game/scenario/temps_libres.rpy:30
translate portuguese lysa_link_1_bf5a53c9:

    # lysa taquin "Parce que c'en était une. On ne devrait jamais commencer une catastrophe avant que les gens aient terminé leur boisson."
    lysa taquin "Porque era. Nunca se começa uma catástrofe antes de as pessoas terminarem a bebida."

# game/scenario/temps_libres.rpy:31
translate portuguese lysa_link_1_a8d0831e:

    # noam sourire "Considère donc celui-ci comme une réparation officielle, avec seulement quelques jours de retard."
    noam sourire "Então considera este aqui uma reparação oficial, só com alguns dias de atraso."

# game/scenario/temps_libres.rpy:32
translate portuguese lysa_link_1_7a6b263d:

    # lysa sourire "Le service laisse à désirer, mais je reconnais l'effort. Merci, Noam."
    lysa sourire "O atendimento deixa a desejar, mas eu reconheço o esforço. Obrigada, Noam."

# game/scenario/temps_libres.rpy:33
translate portuguese lysa_link_1_bf1e7f6a:

    # noam taquin "Tu viens vraiment de me remercier ? Je devrais peut-être demander à Kami de noter la date."
    noam taquin "Você acabou mesmo de me agradecer? Talvez eu devesse pedir pra Kami anotar a data."

# game/scenario/temps_libres.rpy:34
translate portuguese lysa_link_1_e8a77840:

    # lysa blase "Continue et je reprends mon remerciement. Je peux même te piquer ton café si tu veux."
    lysa blase "Continua e eu retiro o agradecimento. Posso até roubar o seu café, se quiser."

# game/scenario/temps_libres.rpy:35
translate portuguese lysa_link_1_aeafb55e:

    # noam sourire "Non, eh ! C'est le mien !"
    noam sourire "Ei, não! Esse é meu!"

# game/scenario/temps_libres.rpy:36
translate portuguese lysa_link_1_d6bc78aa:

    # lysa content "Assieds-toi plutôt. On va essayer de les finir avant la prochaine catastrophe."
    lysa content "Melhor sentar. Vamos tentar terminar os dois antes da próxima catástrofe."

# game/scenario/temps_libres.rpy:37
translate portuguese lysa_link_1_39ed6868:

    # noam sourire "Pour une fois, je pense que ça devrait le faire."
    noam sourire "Pela primeira vez, acho que vai dar."

# game/scenario/temps_libres.rpy:38
translate portuguese lysa_link_1_7feec750:

    # lysa sourire "Ne sois pas trop optimiste. Mais oui... pour une fois, ça devrait aller."
    lysa sourire "Não seja otimista demais. Mas é... pela primeira vez, acho que vai dar."

# game/scenario/temps_libres.rpy:48
translate portuguese lysa_link_2_cc9adc5d:

    # "Dans la salle d'observation, Lysa garde le visage si près de la baie vitrée qu'elle semble vouloir passer au travers."
    "Na sala de observação, Lysa mantém o rosto tão perto da janela panorâmica que parece querer atravessar o vidro."

# game/scenario/temps_libres.rpy:53
translate portuguese lysa_link_2_6d6d649c:

    # noam taquin "Si ton objectif est de fusionner avec la vitre, je préfère te prévenir : ça risque de prendre un moment."
    noam taquin "Se a sua intenção é se fundir com o vidro, já vou avisando: isso pode demorar um pouco."

# game/scenario/temps_libres.rpy:54
translate portuguese lysa_link_2_de0b459e:

    # lysa blase "Je me demandais justement combien de secondes tu mettrais avant de faire une remarque inutile."
    lysa blase "Eu estava justamente me perguntando quantos segundos você levaria pra fazer um comentário inútil."

# game/scenario/temps_libres.rpy:55
translate portuguese lysa_link_2_d74a7e57:

    # noam sourire "Mais sinon, qu'est-ce que tu essaies de voir en te collant comme ça ?"
    noam sourire "Mas falando sério, o que você está tentando ver se grudando desse jeito no vidro?"

# game/scenario/temps_libres.rpy:56
translate portuguese lysa_link_2_7be94bd6:

    # lysa reflexion "La tour d'Archive. Elle est immense, alors je me dis qu'avec le bon angle, je pourrais peut-être la voir."
    lysa reflexion "A torre do Arquivo. Ela é enorme, então pensei que, do ângulo certo, talvez eu conseguisse enxergar."

# game/scenario/temps_libres.rpy:57
translate portuguese lysa_link_2_0d588c9f:

    # noam surpris "Tu essaies de repérer un bâtiment précis depuis une station en orbite ? Tu es devenue folle ?"
    noam surpris "Você está tentando encontrar um prédio específico de uma estação em órbita? Ficou maluca?"

# game/scenario/temps_libres.rpy:58
translate portuguese lysa_link_2_ca539d49:

    # lysa colere "Je sais que les chances sont faibles. Si tu comptes seulement te moquer, tu sais où est la sortie."
    lysa colere "Eu sei que as chances são pequenas. Se você só veio pra debochar, sabe onde fica a saída."

# game/scenario/temps_libres.rpy:59
translate portuguese lysa_link_2_4c971043:

    # noam neutre "Mais nan, je me moque pas. Pourquoi est-ce si important de trouver la tour ?"
    noam neutre "Que nada, não tô debochando. Por que é tão importante achar essa torre?"

# game/scenario/temps_libres.rpy:60
translate portuguese lysa_link_2_e7684499:

    # lysa reflexion "Archive est enclavée dans Harmonie. Si je repère la tour, je saurai exactement quelle partie de la planète regarder."
    lysa reflexion "O Arquivo fica encravado em Harmonia. Se eu localizar a torre, vou saber exatamente que parte do planeta olhar."

# game/scenario/temps_libres.rpy:61
translate portuguese lysa_link_2_9731f8f2:

    # noam reflexion "Et si elle est vraiment impossible à distinguer au milieu de toutes ces lumières ?"
    noam reflexion "E se for realmente impossível distinguir ela no meio de todas essas luzes?"

# game/scenario/temps_libres.rpy:62
translate portuguese lysa_link_2_5421c78c:

    # lysa neutre "Alors je regarderai simplement Harmonie. Ce sera déjà un peu comme regarder l'endroit d'où nous venons."
    lysa neutre "Então eu olho só pra Harmonia. Já vai ser um pouco como olhar para o lugar de onde viemos."

# game/scenario/temps_libres.rpy:63
translate portuguese lysa_link_2_c62204df:

    # noam neutre "Vu d'ici, tout paraît étrangement calme. On ne distingue même plus les frontières entre les territoires."
    noam neutre "Daqui, tudo parece estranhamente calmo. Nem dá mais pra distinguir as fronteiras entre os territórios."

# game/scenario/temps_libres.rpy:64
translate portuguese lysa_link_2_3de7acb1:

    # lysa triste "C'est ce qui me dérange. On voit les villes briller, mais pas ce que les gens subissent."
    lysa triste "É isso que me incomoda. A gente vê as cidades brilhando, mas não vê o que as pessoas estão sofrendo."

# game/scenario/temps_libres.rpy:65
translate portuguese lysa_link_2_cfa0f154:

    # noam raison "Pour ça, y'a la télévision de la cafétéria, ça permet au moins d'avoir une sorte de lien avec l'extérieur."
    noam raison "Pra isso tem a televisão da cafeteria. Pelo menos dá pra manter algum tipo de contato com o mundo lá fora."

# game/scenario/temps_libres.rpy:66
translate portuguese lysa_link_2_03a3be84:

    # lysa reflexion "Tu arrives parfois à dire quelque chose de pertinent. C'est rare, mais suffisamment troublant pour être signalé."
    lysa reflexion "Às vezes você consegue dizer alguma coisa sensata. É raro, mas perturbador o bastante pra merecer registro."

# game/scenario/temps_libres.rpy:67
translate portuguese lysa_link_2_6bdac47e:

    # noam taquin "Je vais prendre ça pour un compliment."
    noam taquin "Vou considerar isso um elogio."

# game/scenario/temps_libres.rpy:68
translate portuguese lysa_link_2_dfe0902b:

    # lysa sourire "Prends-le comme tu veux. Maintenant, aide-moi à chercher au lieu de me déranger."
    lysa sourire "Considere como quiser. Agora me ajuda a procurar em vez de ficar me atrapalhando."

# game/scenario/temps_libres.rpy:69
translate portuguese lysa_link_2_dcbc8b1f:

    # noam sourire "D'accord. Montre-moi au moins la zone, que je puisse prétendre savoir ce que je regarde."
    noam sourire "Tá. Pelo menos me mostra a região, pra eu poder fingir que sei o que estou olhando."

# game/scenario/temps_libres.rpy:70
translate portuguese lysa_link_2_6f8d8af4:

    # lysa reflexion "Je crois que c'est par là-bas, près de cette zone de lumières. La tour devrait se trouver quelque part au centre."
    lysa reflexion "Acho que é praquele lado, perto daquela concentração de luzes. A torre deve estar em algum lugar no centro."

# game/scenario/temps_libres.rpy:71
translate portuguese lysa_link_2_b7456189:

    # noam taquin "Attends, par là ? Mais y'a rien ?!."
    noam taquin "Espera, ali? Mas não tem nada?!"

# game/scenario/temps_libres.rpy:72
translate portuguese lysa_link_2_9352e3aa:

    # lysa blase "Mais non, bêta ! Par là !"
    lysa blase "Não, seu tonto! Pra lá!"

# game/scenario/temps_libres.rpy:73
translate portuguese lysa_link_2_80fcf323:

    # "Elle attrape ma main et réoriente mon doigt vers une autre zone."
    "Ela agarra minha mão e redireciona meu dedo para outra região."

# game/scenario/temps_libres.rpy:74
translate portuguese lysa_link_2_1b651379:

    # noam sourire "Bon. Message reçu. Cherchons cette tour."
    noam sourire "Tá bom. Recado entendido. Vamos procurar essa torre."

# game/scenario/temps_libres.rpy:75
translate portuguese lysa_link_2_9c5cf1c2:

    # lysa sourire "On ne la trouvera probablement pas... Au moins, tu me tiens compagnie."
    lysa sourire "Provavelmente a gente não vai achar... Pelo menos você me faz companhia."

# game/scenario/temps_libres.rpy:85
translate portuguese lysa_link_3_496cb7d9:

    # "Un choc sourd traverse le couloir de la cafétéria. Lorsque j'entre dans la salle du canon, l'air y est encore brûlant."
    "Um baque surdo percorre o corredor da cafeteria. Quando entro na sala do canhão, o ar ainda está escaldante."

# game/scenario/temps_libres.rpy:88
translate portuguese lysa_link_3_f7dd30e1:

    # think "Qu'est-ce qui s'est passé ici ?!"
    think "O que aconteceu aqui?!"

# game/scenario/temps_libres.rpy:89
translate portuguese lysa_link_3_fe8adc2b:

    # "Je regarde autour de moi. Personne."
    "Olho ao redor. Ninguém."

# game/scenario/temps_libres.rpy:95
translate portuguese lysa_link_3_7ef1fd92:

    # lysa reflexion "Je me doutais que le bruit venait d'ici. On sent encore la chaleur jusque dans le couloir."
    lysa reflexion "Eu já imaginava que o barulho vinha daqui. Dá pra sentir o calor até no corredor."

# game/scenario/temps_libres.rpy:96
translate portuguese lysa_link_3_dcf37941:

    # noam inquiet "Le canon vient de tirer, je crois. Les consoles défilent encore, mais tout est verrouillé."
    noam inquiet "O canhão acabou de disparar, eu acho. Os consoles ainda estão processando coisas, mas está tudo bloqueado."

# game/scenario/temps_libres.rpy:97
translate portuguese lysa_link_3_80c5f40a:

    # lysa triste "Raah ! Ça me saoule d'être si impuissante ! On peut rien faire contre ça !"
    lysa triste "Argh! Eu odeio me sentir tão impotente! A gente não pode fazer nada contra isso!"

# game/scenario/temps_libres.rpy:98
translate portuguese lysa_link_3_879c6a89:

    # noam reflexion "Nos votes ont quand même des conséquences. On peut influencer une partie de ce qui arrive."
    noam reflexion "Mesmo assim, nossos votos têm consequências. Dá pra influenciar uma parte do que acontece."

# game/scenario/temps_libres.rpy:99
translate portuguese lysa_link_3_4d15e4bd:

    # lysa blase "Influencer une partie... pendant que le canon tire quand elle le décide. Tu trouves vraiment ça encourageant ?"
    lysa blase "Influenciar uma parte... enquanto o canhão dispara quando ela decide. Você acha mesmo isso animador?"

# game/scenario/temps_libres.rpy:100
translate portuguese lysa_link_3_8033bad8:

    # noam neutre "Non. Mais ça prouve qu'on est pas complètement inutile."
    noam neutre "Não. Mas prova que a gente não é completamente inútil."

# game/scenario/temps_libres.rpy:101
translate portuguese lysa_link_3_cea34e43:

    # lysa reflexion "Et si nous ne pouvions rien changer d'important ? Si tout ce cirque servait seulement à nous donner cette impression ?"
    lysa reflexion "E se a gente não pudesse mudar nada que realmente importa? E se todo esse circo só servisse pra dar essa impressão?"

# game/scenario/temps_libres.rpy:102
translate portuguese lysa_link_3_00def431:

    # noam raison "C'est possible. J'en sais rien, on comprend à peine les règles."
    noam raison "É possível. Eu não sei, a gente mal entende as regras."

# game/scenario/temps_libres.rpy:103
translate portuguese lysa_link_3_a9e90cf6:

    # lysa blase "Ta carapace se fissure. T'as plus l'air aussi sûr de toi qu'à notre arrivée."
    lysa blase "Sua carapaça está rachando. Você já não parece tão seguro de si quanto quando chegou."

# game/scenario/temps_libres.rpy:104
translate portuguese lysa_link_3_7cdb00c0:

    # noam taquin "J'essaie d'être honnête. Et puis, j'ai jamais été franchement optimiste non plus."
    noam taquin "Eu tô tentando ser sincero. E também nunca fui exatamente um otimista."

# game/scenario/temps_libres.rpy:105
translate portuguese lysa_link_3_56ae2d76:

    # lysa triste "Alors honnêtement, Noam : tu crois vraiment que nous pouvons changer quelque chose ?"
    lysa triste "Então fala a verdade, Noam: você acredita mesmo que a gente consegue mudar alguma coisa?"

# game/scenario/temps_libres.rpy:106
translate portuguese lysa_link_3_e1b86c0b:

    # noam determine "Je crois que ça sera très difficile. Mais je crois que c'est pas impossible."
    noam determine "Acho que vai ser muito difícil. Mas não acho que seja impossível."

# game/scenario/temps_libres.rpy:107
translate portuguese lysa_link_3_3cc07883:

    # lysa blase "C'est presque un discours héroïque. Encore quelques phrases et Julian va surgir pour réclamer des droits d'auteur."
    lysa blase "Isso quase parece um discurso heroico. Mais algumas frases e Julian aparece exigindo direitos autorais."

# game/scenario/temps_libres.rpy:108
translate portuguese lysa_link_3_e1a82b36:

    # noam sourire "Oh, par pitié, pas lui ! Sinon, tout espoir sera anéanti !"
    noam sourire "Ah, pelo amor de Deus, ele não! Aí qualquer esperança vai por água abaixo!"

# game/scenario/temps_libres.rpy:109
translate portuguese lysa_link_3_96e73320:

    # lysa triste "Je suis pas certaine qu'il m'en reste encore beaucoup, de l'espoir. Chaque tir de ce canon en emporte un peu plus."
    lysa triste "Nem sei se ainda me resta muita esperança. Cada disparo desse canhão leva um pouco mais embora."

# game/scenario/temps_libres.rpy:110
translate portuguese lysa_link_3_68fa1a33:

    # noam neutre "Alors garde seulement ce qu'il en reste. Si ça ne suffit plus, je partagerai le mien avec toi."
    noam neutre "Então guarda o que ainda sobrou. Se um dia não for suficiente, eu divido a minha com você."

# game/scenario/temps_libres.rpy:111
translate portuguese lysa_link_3_65e48d89:

    # lysa surpris "T'essayes de faire ton charmeur ou quoi ?!"
    lysa surpris "Tá tentando me seduzir agora, é isso?!"

# game/scenario/temps_libres.rpy:112
translate portuguese lysa_link_3_eda39084:

    # lysa taquin "Sur ce point-là, Julian te surpasse largement !"
    lysa taquin "Nesse quesito, o Julian ganha de você de lavada!"

# game/scenario/temps_libres.rpy:113
translate portuguese lysa_link_3_976eabc1:

    # noam hesitation "Ah, t'es sérieuse ? Je vais VRAIMENT mal le prendre, hein."
    noam hesitation "Ah, você tá falando sério? Vou ficar MUITO ofendido com isso, hein."

# game/scenario/temps_libres.rpy:114
translate portuguese lysa_link_3_47eab483:

    # noam sourire "Tu rigoles, mais tu verras que tu peux compter sur moi."
    noam sourire "Você tá rindo, mas vai ver que pode contar comigo."

# game/scenario/temps_libres.rpy:115
translate portuguese lysa_link_3_f7a71f28:

    # lysa sourire "Et si ce jour arrive, je ferai semblant de ne pas me souvenir que tu avais raison."
    lysa sourire "E se esse dia chegar, eu vou fingir que não lembro que você tinha razão."

# game/scenario/temps_libres.rpy:116
translate portuguese lysa_link_3_3b90db66:

    # noam taquin "Je n'en attendais pas moins de toi."
    noam taquin "Não esperava menos de você."

# game/scenario/temps_libres.rpy:117
translate portuguese lysa_link_3_f38e8277:

    # lysa neutre "Allons-nous-en. Cette pièce commence à refroidir, mais je n'ai aucune envie de rester ici pour le prochain tir."
    lysa neutre "Vamos embora. Esta sala está começando a esfriar, mas eu não tenho a menor vontade de ficar aqui pro próximo disparo."

# game/scenario/temps_libres.rpy:129
translate portuguese julian_link_1_5181c30d:

    # "Julian attend devant le baby-foot, une main posée sur les poignées."
    "Julian está esperando diante do pebolim, com uma das mãos apoiada nas manoplas."

# game/scenario/temps_libres.rpy:134
translate portuguese julian_link_1_a85699c9:

    # julian sourire "Enfin un adversaire convenable. J'allais finir par croire que cette merveille avait été installée uniquement pour décorer la pièce."
    julian sourire "Finalmente um adversário à altura. Eu já estava começando a achar que essa maravilha tinha sido instalada só pra decorar a sala."

# game/scenario/temps_libres.rpy:135
translate portuguese julian_link_1_1e32dfc5:

