    think "Por que o Ryn está saindo do quarto da Iris?"

# game/scenario/8_1_0_0.rpy:772
translate portuguese 526bea77:

    # "Il lève les yeux et nos regards se croisent."
    "Ele levanta os olhos e nossos olhares se cruzam."

# game/scenario/8_1_0_0.rpy:774
translate portuguese 75a7f8c4:

    # ryn reflexion "Noam."
    ryn reflexion "Noam."

# game/scenario/8_1_0_0.rpy:776
translate portuguese cd568648:

    # noam hesitation "Ryn."
    noam hesitation "Ryn."

# game/scenario/8_1_0_0.rpy:778
translate portuguese 6e0db5fd:

    # "Il ne semble pas particulièrement nerveux, ni même surpris."
    "Ele não parece particularmente nervoso, nem surpreso."

# game/scenario/8_1_0_0.rpy:780
translate portuguese 54516b27:

    # ryn "Bonne nuit."
    ryn "Boa noite."

# game/scenario/8_1_0_0.rpy:782
translate portuguese b2925777:

    # noam hesitation "... Ouais. Bonne nuit."
    noam hesitation "... É. Boa noite."

# game/scenario/8_1_0_0.rpy:784
translate portuguese d4633951:

    # "Il passe à côté de moi et je me décale légèrement pour le laisser passer."
    "Ele passa do meu lado e eu me desloco um pouco pra deixar ele passar."

# game/scenario/8_1_0_0.rpy:788
translate portuguese 96c8cc4c:

    # "Ses pas s’éloignent progressivement dans le couloir tandis que je reste immobile."
    "Os passos dele vão sumindo pelo corredor enquanto eu fico parado."

# game/scenario/8_1_0_0.rpy:790
translate portuguese daf4fff8_7:

    # think "..."
    think "..."

# game/scenario/8_1_0_0.rpy:792
translate portuguese 2aa50cc8:

    # "Je regarde la porte d’Iris."
    "Olho pra porta da Iris."

# game/scenario/8_1_0_0.rpy:794
translate portuguese d1af98c2_5:

    # think "Non."
    think "Não."

# game/scenario/8_1_0_0.rpy:796
translate portuguese fd6fe629_2:

    # "Mon ventre se noue."
    "Meu estômago embrulha."

# game/scenario/8_1_0_0.rpy:798
translate portuguese f1fd2592:

    # think "Ryn n’est pas au courant. Il n’est PAS au courant."
    think "O Ryn não sabe. Ele NÃO sabe."

# game/scenario/8_1_0_0.rpy:800
translate portuguese 90a080fb:

    # "Je recompte machinalement."
    "Reconto mecanicamente."

# game/scenario/8_1_0_0.rpy:802
translate portuguese 7c90a880:

    # think "Iris, Nyra, Tomas et moi. C’est tout."
    think "Iris, Nyra, Tomas e eu. É só."

# game/scenario/8_1_0_0.rpy:804
translate portuguese 75ae1c3f:

    # "Je fixe encore la porte."
    "Continuo encarando a porta."

# game/scenario/8_1_0_0.rpy:806
translate portuguese 990b03f8:

    # think "Alors qu’est-ce qu’il foutait là-dedans ?"
    think "Então o que diabos ele estava fazendo lá dentro?"

# game/scenario/8_1_0_0.rpy:808
translate portuguese de8e8b53:

    # "Ma première impulsion est d’entrer. Je fais même un pas vers la chambre, puis je m’arrête."
    "Meu primeiro impulso é entrar. Chego a dar um passo na direção do quarto, e então paro."

# game/scenario/8_1_0_0.rpy:810
translate portuguese c8228f99:

    # think "Attends. Peut-être qu’Anya était cachée, qu’Iris l’a fait sortir avant et qu’il n’a rien vu."
    think "Espera. Talvez a Anya estivesse escondida, talvez a Iris tenha tirado ela antes e ele não tenha visto nada."

# game/scenario/8_1_0_0.rpy:812
translate portuguese a20cefa7:

    # "..."
    "..."

# game/scenario/8_1_0_0.rpy:814
translate portuguese f481b983:

    # think "Ou peut-être qu’il a tout vu."
    think "Ou talvez ele tenha visto tudo."

# game/scenario/8_1_0_0.rpy:816
translate portuguese 51b1b51a:

    # "Je serre légèrement les poings."
    "Aperto um pouco os punhos."

# game/scenario/8_1_0_0.rpy:818
translate portuguese d6a16d21:

    # think "Et si j’entre maintenant en paniquant, je risque surtout d’aggraver les choses."
    think "E se eu entrar agora em pânico, o mais provável é eu piorar as coisas."

# game/scenario/8_1_0_0.rpy:820
translate portuguese ff70ff13:

    # "Je regarde derrière moi, mais Ryn a déjà disparu au bout du couloir."
    "Olho pra trás, mas o Ryn já sumiu no fim do corredor."

# game/scenario/8_1_0_0.rpy:822
translate portuguese bc8f780c_6:

    # noam reflexion "..."
    noam reflexion "..."

# game/scenario/8_1_0_0.rpy:824
translate portuguese f062b5cd:

    # think "Je pourrais demander directement à Iris."
    think "Eu podia perguntar direto pra Iris."

# game/scenario/8_1_0_0.rpy:826
translate portuguese 785bb180:

    # "Je tends la main vers la porte."
    "Estendo a mão na direção da porta."

# game/scenario/8_1_0_0.rpy:830
translate portuguese bf69137a:

    # "Puis je la retire."
    "Depois recuo."

# game/scenario/8_1_0_0.rpy:832
translate portuguese 2aeb9f58:

    # think "Non, pas maintenant. Si Ryn a découvert Anya, il faut réfléchir avant de faire quoi que ce soit."
    think "Não, agora não. Se o Ryn descobriu a Anya, a gente precisa pensar antes de fazer qualquer coisa."

# game/scenario/8_1_0_0.rpy:834
translate portuguese 562efcca:

    # "Et pour ça, il y a quelqu’un de bien plus doué que moi."
    "E pra isso, tem alguém bem melhor nisso do que eu."

# game/scenario/8_1_0_0.rpy:836
translate portuguese 42238765:

    # think "Nyra."
    think "Nyra."

# game/scenario/8_1_0_0.rpy:838
translate portuguese a6ecc2d1:

    # "Je souffle lentement."
    "Solto o ar devagar."

# game/scenario/8_1_0_0.rpy:840
translate portuguese 8a1f8712:

    # think "Je lui en parlerai demain matin. Elle saura quoi faire."
    think "Falo com ela amanhã de manhã. Ela vai saber o que fazer."

# game/scenario/8_1_0_0.rpy:842
translate portuguese caaf9170:

    # "Je reste encore quelques secondes devant la porte d’Iris, mais aucun bruit ne vient de l’intérieur."
    "Fico mais alguns segundos na frente da porta da Iris, mas nenhum barulho vem de dentro."

# game/scenario/8_1_0_0.rpy:844
translate portuguese 8a397e23:

    # think "... Enfin, j’espère."
    think "... Pelo menos eu espero."

# game/scenario/8_1_0_0.rpy:849
translate portuguese f80a48e0:

    # "Je rentre finalement dans ma chambre et m’allonge sur mon lit. La journée avait été presque normale et, pendant quelques heures, j’avais même réussi à croire que nous pouvions réellement cacher Anya ici."
    "Acabo entrando no meu quarto e me deito na cama. O dia tinha sido quase normal e, por algumas horas, eu até tinha conseguido acreditar que a gente podia mesmo esconder a Anya aqui."

# game/scenario/8_1_0_0.rpy:851
translate portuguese 621c6923_1:

    # think "Ryn."
    think "Ryn."

# game/scenario/8_1_0_0.rpy:853
translate portuguese cdba5b76:

    # "Je fixe le plafond."
    "Encaro o teto."

# game/scenario/8_1_0_0.rpy:855
translate portuguese d7f95c22:

    # think "Pourquoi tu étais dans cette chambre ?"
    think "O que você estava fazendo naquele quarto?"

