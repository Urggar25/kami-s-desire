    # mara colere_noire "Tu as frappé Noam avant un vote décisif et ton résumé, c'est que tu as déconné ?"
    mara colere_noire "Você bateu no Noam antes de uma votação decisiva e seu resumo é que fez merda?"

# game/scenario/6_1_0.rpy:590
translate portuguese cc6c98f8:

    # elias colere "Il a menacé Sael aussi."
    elias colere "Ele também ameaçou Sael."

# game/scenario/6_1_0.rpy:592
translate portuguese 62bb4cfe:

    # elen colere "Mais qu'est-ce qui te prend ?! On est tous tendus, ça te donne pas le droit de taper les gens !"
    elen colere "Mas o que deu em você?! Estamos todos tensos, mas isso não te dá o direito de bater nos outros!"

# game/scenario/6_1_0.rpy:594
translate portuguese 5ec22353:

    # ryn colere "Je sais ! Vous voulez que je dise quoi de plus ?"
    ryn colere "Eu sei! O que mais vocês querem que eu diga?"

# game/scenario/6_1_0.rpy:596
translate portuguese ff3d9a85:

    # iris colere "Commence par arrêter de gueuler comme si c'était encore nous le problème."
    iris colere "Para começar, pare de gritar como se nós ainda fôssemos o problema."

# game/scenario/6_1_0.rpy:598
translate portuguese 70bdeae8:

    # kael inquietude "Le vote était déjà compromis. Cette violence ne pouvait rien améliorer."
    kael inquietude "A votação já estava comprometida. Essa violência não tinha como melhorar a situação."

# game/scenario/6_1_0.rpy:600
translate portuguese ebc6d7a6:

    # ryn colere2 "Merci, Kael. Vraiment. J'avais besoin de ton analyse."
    ryn colere2 "Obrigado, Kael. Sério. Eu precisava muito da sua análise."

# game/scenario/6_1_0.rpy:602
translate portuguese cc80f42d:

    # nyra colere "Tu recommences."
    nyra colere "Você está começando de novo."

# game/scenario/6_1_0.rpy:604
translate portuguese ccc1b97a:

    # tomas inquiet "On devrait peut-être... enfin... laisser Noam s'asseoir avant de continuer."
    tomas inquiet "Talvez a gente devesse... bem... deixar Noam sentar antes de continuar."

# game/scenario/6_1_0.rpy:606
translate portuguese 759ddc16:

    # lysa opposition "On devrait surtout arrêter cette séance avant que quelqu'un décide de terminer le travail."
    lysa opposition "O que a gente deveria fazer é encerrar esta sessão antes que alguém resolva terminar o serviço."

# game/scenario/6_1_0.rpy:608
translate portuguese 992e426d:

    # noam determine "Ça suffit. Je vais bien."
    noam determine "Já chega. Estou bem."

# game/scenario/6_1_0.rpy:610
translate portuguese 90a97f31:

    # iris desaccord "Non, tu ne vas pas bien."
    iris desaccord "Não, você não está."

# game/scenario/6_1_0.rpy:612
translate portuguese 7e3fe9ef:

    # noam inquiet "Je peux voter. C'est ce qui compte pour le moment."
    noam inquiet "Eu consigo votar. É isso que importa agora."

# game/scenario/6_1_0.rpy:616
translate portuguese e060b7a5:

    # think "Ryn garde les yeux baissés. Sael regarde la salle, puis le siège vide devant elle."
    think "Ryn mantém os olhos baixos. Sael olha ao redor da sala, depois para o assento vazio à sua frente."

# game/scenario/6_1_0.rpy:618
translate portuguese 0214f5d2:

    # sael determine "Je vote contre. J'assume mes choix."
    sael determine "Eu voto contra. Assumo as minhas escolhas."

# game/scenario/6_1_0.rpy:620
translate portuguese 2e0dd9d6:

    # "Sael nous regarde tous droit dans les yeux."
    "Sael olha cada um de nós diretamente nos olhos."

# game/scenario/6_1_0.rpy:626
translate portuguese 0efcbc27:

    # think "Le silence tombe d'un seul coup."
    think "O silêncio toma conta da sala de uma só vez."

# game/scenario/6_1_0.rpy:628
translate portuguese 90617c5d:

    # noam surpris "Sael..."
    noam surpris "Sael..."

# game/scenario/6_1_0.rpy:630
translate portuguese e661f47a:

    # sael neutre "Le débat est terminé. Une voix contre suffit. Il n'y a plus rien à obtenir ici."
    sael neutre "O debate acabou. Um voto contra basta. Não há mais nada a obter aqui."

# game/scenario/6_1_0.rpy:632
translate portuguese 7cc77225:

    # ryn inquiet "Tu fais ça à cause de moi ?"
    ryn inquiet "Você está fazendo isso por minha causa?"

# game/scenario/6_1_0.rpy:634
translate portuguese f51e1247:

    # sael triste "Ma décision était prise avant aujourd'hui."
    sael triste "Minha decisão já estava tomada antes de hoje."

# game/scenario/6_1_0.rpy:638
translate portuguese f52ff4e7:

    # sael determine "Ne lui en voulez pas. Ryn a juste voulu faire de son mieux. Si vous avez quelqu'un à qui vous en prendre, c'est moi."
    sael determine "Não culpem ele. Ryn só quis fazer o melhor que podia. Se precisam culpar alguém, culpem a mim."

# game/scenario/6_1_0.rpy:640
translate portuguese 63abe1b5:

    # noam desaccord "Tu n'es pas responsable de ce qu'il a fait."
    noam desaccord "Você não é responsável pelo que ele fez."

# game/scenario/6_1_0.rpy:642
translate portuguese 4653fd41:

    # sael fatigue "Je sais."
    sael fatigue "Eu sei."

# game/scenario/6_1_0.rpy:644
translate portuguese 772225b2:

    # think "Sael valide son vote sur le terminal, puis quitte son siège."
    think "Sael confirma seu voto no terminal e depois se levanta."

# game/scenario/6_1_0.rpy:646
translate portuguese 051af713:

    # sael neutre "Je n'ai plus rien à dire."
    sael neutre "Não tenho mais nada a dizer."

# game/scenario/6_1_0.rpy:650
translate portuguese e5b54343:

    # think "La porte se referme derrière elle. Le vote est déjà perdu."
    think "A porta se fecha atrás dela. A votação já está perdida."

# game/scenario/6_1_0.rpy:659
translate portuguese 0d202e0a:

    # kami "Quoi ?! C'est tout ?!"
    kami "O quê?! Só isso?!"

# game/scenario/6_1_0.rpy:663
translate portuguese dd916e5c:

    # kami "Une menace, un coup au visage, une salle entière prête à s'étriper... et vous interrompez déjà le débat ?"
    kami "Uma ameaça, um soco no rosto, uma sala inteira pronta para se matar... e vocês já estão encerrando o debate?"

# game/scenario/6_1_0.rpy:664
translate portuguese 331eb4de:

    # kami "J'avais préparé plusieurs angles de caméra. J'espérais des arguments, des larmes, peut-être même une seconde droite !"
    kami "Eu tinha preparado vários ângulos de câmera. Esperava argumentos, lágrimas, talvez até um segundo cruzado de direita!"

# game/scenario/6_1_0.rpy:668
translate portuguese bc5d4658:

    # kami "Vous pourriez faire un effort ! La démocratie mérite de meilleurs débats que cette catastrophe expédiée en quelques minutes."
    kami "Vocês podiam ao menos se esforçar! A democracia merece debates melhores do que esse desastre resolvido às pressas em poucos minutos."

# game/scenario/6_1_0.rpy:672
translate portuguese 96055b9a:

    # kami "Mais soit. Une représentante s'est exprimée. La démocratie a parlé !"
    kami "Mas tudo bem. Uma representante se manifestou. A democracia falou!"

# game/scenario/6_1_0.rpy:673
translate portuguese 8c50cc0d:

    # kami "Son vote contre condamne déjà la proposition, mais les autres représentants doivent encore enregistrer leur choix."
    kami "O voto dela contra já condenou a proposta, mas os outros representantes ainda precisam registrar suas escolhas."

# game/scenario/6_1_0.rpy:674
translate portuguese 44563a5b:

    # kami "Allez. Faites au moins semblant de prendre cette partie au sérieux."
    kami "Vamos. Pelo menos finjam que estão levando esta parte a sério."

# game/scenario/6_1_0.rpy:682
translate portuguese 99491448:

    # think "Mon terminal s'allume. Le résultat est déjà décidé, mais mon vote m'appartient encore."
    think "Meu terminal se acende. O resultado já está decidido, mas meu voto ainda me pertence."

# game/scenario/6_1_0.rpy:698
translate portuguese b0ebc3f5:

    # noam determine "Je vote pour."
    noam determine "Eu voto a favor."

# game/scenario/6_1_0.rpy:703
translate portuguese eb88e9ea:

    # noam raison "Je vote contre."
    noam raison "Eu voto contra."

# game/scenario/6_1_0.rpy:708
translate portuguese 2be7bab3:

    # noam hesitation "Je m'abstiens."
    noam hesitation "Eu me abstenho."

# game/scenario/6_1_0.rpy:743
translate portuguese 255b8ac9:

    # kami "Résultat définitif : huit voix pour, deux abstentions et deux voix contre."
    kami "Resultado final: oito votos a favor, duas abstenções e dois votos contra."

# game/scenario/6_1_0.rpy:745
translate portuguese e2078cc8:

    # kami "Deux refus ! Sael n'était donc pas la seule à vouloir refermer la porte. Comme c'est intéressant."
    kami "Dois votos contra! Então Sael não era a única que queria fechar a porta novamente. Que interessante."

# game/scenario/6_1_0.rpy:747
translate portuguese baf6abce:

    # kami "Résultat définitif : huit voix pour, trois abstentions et une voix contre."
    kami "Resultado final: oito votos a favor, três abstenções e um voto contra."

# game/scenario/6_1_0.rpy:749
translate portuguese 457df45d:

    # kami "Une seule voix contre. Une toute petite voix, et pourtant des frontières bien solides."
    kami "Um único voto contra. Uma voz tão pequenininha e, mesmo assim, fronteiras tão sólidas."

# game/scenario/6_1_0.rpy:751
translate portuguese 6051d68a:

    # kami "Résultat définitif : neuf voix pour, deux abstentions et une voix contre."
    kami "Resultado final: nove votos a favor, duas abstenções e um voto contra."

# game/scenario/6_1_0.rpy:753
translate portuguese 86c24db1:

    # kami "Neuf voix favorables contre une seule opposition. Presque une victoire... ce qui signifie exactement un échec."
    kami "Nove votos a favor contra uma única oposição. Quase uma vitória... o que significa, com toda precisão, um fracasso."

# game/scenario/6_1_0.rpy:757
translate portuguese 09505d2a:

    # kami "La proposition est rejetée. Les déplacements entre les districts restent soumis à une autorisation stricte."
    kami "A proposta foi rejeitada. Os deslocamentos entre os distritos continuarão sujeitos a uma autorização rigorosa."

# game/scenario/6_1_0.rpy:758
translate portuguese 11f3e2c1:

    # kami "Les marchandises continueront de circuler. Les habitants, eux, resteront gentiment à leur place."
    kami "As mercadorias continuarão circulando. Já os moradores vão ficar comportadinhos em seus lugares."

# game/scenario/6_1_0.rpy:762
translate portuguese 9fe790c7:

    # kami "Félicitations pour cette magnifique démonstration démocratique ! Essayez seulement de ne pas vous frapper avant le prochain vote."
    kami "Parabéns por esta magnífica demonstração de democracia! Só tentem não bater uns nos outros antes da próxima votação."

# game/scenario/6_1_0.rpy:775
translate portuguese 7d7e4bf3:

    # think "Je retourne vers ma chambre. Ma lèvre me brûle et ma mâchoire lance à chacun de mes pas."
    think "Volto para o meu quarto. Meu lábio arde, e minha mandíbula lateja a cada passo."

# game/scenario/6_1_0.rpy:776
translate portuguese bc9c9f75:

    # think "Les marchandises pourront franchir les frontières. Les personnes, non."
    think "As mercadorias poderão atravessar as fronteiras. As pessoas, não."

# game/scenario/6_1_0.rpy:777
translate portuguese 5a208b69:

    # think "Ryn a frappé pour ouvrir une porte. Sael l'a refermée pour empêcher Limen de se vider."
    think "Ryn deu um soco para abrir uma porta. Sael a fechou para impedir que Limen fosse esvaziada."

# game/scenario/6_1_0.rpy:778
translate portuguese 43b31ba3:

    # think "Et moi, je ne sais même plus lequel des deux avait le plus peur."
    think "E eu já nem sei qual dos dois estava com mais medo."

# game/scenario/6_1_0.rpy:782
translate portuguese 84fbb120:

    # think "Demain matin, une nouvelle livraison doit atteindre le Conclave."
    think "Uma nova entrega deve chegar ao Conclave amanhã de manhã."

# game/scenario/6_1_0.rpy:783
translate portuguese 8e9d8597:

    # think "De la nourriture, des médicaments, du matériel. Rien qui soit censé respirer."
    think "Comida, medicamentos, equipamentos. Nada que deveria estar respirando."

