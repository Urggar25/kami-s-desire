    iris determine "把她放这里，侧躺。"

# game/scenario/7_1_0_0.rpy:671
translate chinese 4df980e8:

    # think "Tomas et moi déposons la jeune femme sur le matelas. Iris la recouvre aussitôt de plusieurs couettes."
    think "Tomas 和我把年轻女子放到床垫上。Iris 立刻用好几床被子盖住她。"

# game/scenario/7_1_0_0.rpy:673
translate chinese b6ff0a22:

    # tomas inquiet "Elle ne bouge pas."
    tomas inquiet "她一点反应都没有。"

# game/scenario/7_1_0_0.rpy:677
translate chinese 0fea4360:

    # iris colere "Parce qu'elle est inconsciente. Donne-moi l'oreiller."
    iris colere "因为她昏迷了。把枕头给我。"

# game/scenario/7_1_0_0.rpy:679
translate chinese ee247e57:

    # noam inquiet "Nyra, la porte."
    noam inquiet "Nyra，门。"

# game/scenario/7_1_0_0.rpy:681
translate chinese 07cafb8e:

    # nyra determine "Je l'ai. Sortez. Il ne faut pas qu'on nous voie tous ici quand les caméras reviennent."
    nyra determine "我来关。你们快出去，不能让监控恢复时看到我们全挤在这里。"

# game/scenario/7_1_0_0.rpy:683
translate chinese 9bc4d41a:

    # iris determine "Je reste avec elle."
    iris determine "我留下陪她。"

# game/scenario/7_1_0_0.rpy:685
translate chinese 71ef2186:

    # noam inquiet "Tu es sûre ?"
    noam inquiet "你确定？"

# game/scenario/7_1_0_0.rpy:687
translate chinese 5b0abe97:

    # iris colere "Non. Mais je suis la seule ici à savoir vérifier si elle meurt."
    iris colere "不确定。但这里至少只有我知道该怎么判断她是不是要死了。"

# game/scenario/7_1_0_0.rpy:689
translate chinese af63aee9:

    # think "Tomas et moi quittons la chambre. Nyra referme derrière nous."
    think "Tomas 和我离开房间，Nyra 在我们身后关上了门。"

# game/scenario/7_1_0_0.rpy:697
translate chinese ec61d1aa:

    # think "Nous nous éloignons les uns des autres et reprenons une allure normale."
    think "我们各自散开，重新用正常的速度行走。"

# game/scenario/7_1_0_0.rpy:703
translate chinese 1b9a2507:

    # think "Les plafonniers se rallument brutalement. Les ventilations repartent dans un grondement sourd."
    think "顶灯猛地重新亮起，通风系统也伴着低沉的轰鸣恢复运转。"

# game/scenario/7_1_0_0.rpy:707
translate chinese 09ec1a2f:

    # centered "{size=34}ALIMENTATION PRINCIPALE RÉTABLIE — REDÉMARRAGE PROGRESSIF DES SYSTÈMES{/size}"
    centered "{size=34}主电源已恢复——各系统正在逐步重启{/size}"

# game/scenario/7_1_0_0.rpy:717
translate chinese d3b75051:

    # tomas inquiet "On l'a fait ?"
    tomas inquiet "我们成功了？"

# game/scenario/7_1_0_0.rpy:719
translate chinese f96f8484:

    # nyra raison "Ne regarde pas la porte d'Iris."
    nyra raison "别看 Iris 的房门。"

# game/scenario/7_1_0_0.rpy:721
translate chinese 2dcc5c74:

    # tomas inquiet "Je ne la regardais pas."
    tomas inquiet "我没看。"

# game/scenario/7_1_0_0.rpy:723
translate chinese 907a0735:

    # nyra raison "Tu la fixes depuis que les lumières sont revenues."
    nyra raison "从灯亮起那一刻，你就一直盯着它。"

# game/scenario/7_1_0_0.rpy:725
translate chinese d0702df2:

    # noam determine "On se sépare. On agit normalement."
    noam determine "分头走，表现得正常一点。"

# game/scenario/7_1_0_0.rpy:727
translate chinese 898b326b:

    # tomas panne "Normalement. Oui. Je suis parfaitement normal."
    tomas panne "正常。对，我正常得不能再正常了。"

# game/scenario/7_1_0_0.rpy:729
translate chinese c31a86c1:

    # nyra taquin "Tu ressembles à quelqu'un qui vient de cacher un cadavre."
    nyra taquin "你看起来像刚藏完一具尸体。"

# game/scenario/7_1_0_0.rpy:731
translate chinese a288d229:

    # tomas inquiet "Ce n'est pas un cadavre !"
    tomas inquiet "她不是尸体！"

# game/scenario/7_1_0_0.rpy:733
translate chinese 4230f120:

    # nyra colere "Moins fort."
    nyra colere "小声点。"

# game/scenario/7_1_0_0.rpy:737
translate chinese 7e0f3601:

    # noam inquiet "Kael est encore dans le sas."
    noam inquiet "Kael 还在气闸舱。"

# game/scenario/7_1_0_0.rpy:739
translate chinese 360d0f38:

    # nyra raison "Il nous rejoindra. Si tu retournes le chercher maintenant, tu attireras l'attention."
    nyra raison "他会来找我们。你现在回去找他，只会引人注意。"

# game/scenario/7_1_0_0.rpy:741
translate chinese b08f4888:

    # think "Elle a raison. Pourtant, quelque chose me dérange dans le silence du sas."
    think "她说得对。可气闸舱里的寂静还是让我隐隐不安。"

# game/scenario/7_1_0_0.rpy:753
translate chinese 0d93d9f1:

    # think "La couverture glisse et son épaule heurte le bord du conteneur."
    think "毯子滑了下去，她的肩膀撞上了集装箱边缘。"

# game/scenario/7_1_0_0.rpy:755
translate chinese c38554bb:

    # iris colere "Arrêtez. Reprenez-la sous les omoplates."
    iris colere "停下，重新从她肩胛骨下面托住。"

# game/scenario/7_1_0_0.rpy:757
translate chinese af6b2925:

    # tomas panne "Je n'ai plus de prise, le tissu est gelé !"
    tomas panne "我抓不住了，布都冻硬了！"

# game/scenario/7_1_0_0.rpy:759
translate chinese 5adb8d6e:

    # noam determine "Passe ton bras dessous. Je maintiens ses jambes."
    noam determine "把手臂伸到下面，我来托住她的腿。"

# game/scenario/7_1_0_0.rpy:761
translate chinese 39cba4ee:

    # think "Nous la soulevons de nouveau. Plusieurs secondes viennent de disparaître."
    think "我们重新把她抬起来，又白白浪费了好几秒。"

# game/scenario/7_1_0_0.rpy:763
translate chinese 88ee8c77:

    # think "Mon pied accroche le rail d'une porte et je bascule contre le mur."
    think "我的脚被门轨绊住，整个人撞向墙壁。"

# game/scenario/7_1_0_0.rpy:765
translate chinese 921c583e:

    # tomas peur "Noam ! Sa tête !"
    tomas peur "Noam！她的头！"

# game/scenario/7_1_0_0.rpy:767
translate chinese 05f8dcc1:

    # iris colere "Ne la posez pas. Stabilisez-la contre vous."
    iris colere "别放下她，让她靠在你们身上稳住。"

# game/scenario/7_1_0_0.rpy:769
translate chinese 957d0291:

    # noam inquiet "Ça va. Je l'ai encore. Avance."
    noam inquiet "没事，我还托得住。继续走。"

# game/scenario/7_1_0_0.rpy:771
translate chinese d216bc79:

    # think "Nous retrouvons notre équilibre, beaucoup moins vite que le compteur ne descend."
    think "我们重新站稳，可倒计时下降的速度远比我们快。"

# game/scenario/7_1_0_0.rpy:773
translate chinese 9d286aea:

    # think "Le chariot bloque mal le passage et revient dans nos jambes."
    think "推车没能挡稳通道，反而滑回来撞上了我们的腿。"

# game/scenario/7_1_0_0.rpy:775
translate chinese 9955b43b:

    # nyra colere "Attendez. Je le dégage."
    nyra colere "等等，我把它推开。"

# game/scenario/7_1_0_0.rpy:777
translate chinese a8f5af3d:

    # iris inquiet "Sa respiration vient de changer. Dépêchez-vous."
    iris inquiet "她的呼吸变了，快点。"

# game/scenario/7_1_0_0.rpy:779
translate chinese d06ca095:

    # tomas determine "Je tiens. Je tiens encore."
    tomas determine "我撑得住，还撑得住。"

# game/scenario/7_1_0_0.rpy:781
translate chinese 80863dc7:

    # think "Nyra libère enfin le passage. La porte d'Iris paraît toujours trop loin."
    think "Nyra 终于清出通道，Iris 的房门却依然远得不像话。"

# game/scenario/7_1_0_0.rpy:798
translate chinese 8e87fcc4:

    # kami "Vous aviez une minute. Une minute entière."
    kami "你们有一分钟，整整一分钟。"

# game/scenario/7_1_0_0.rpy:800
translate chinese 208c0e58:

    # kami "Les caméras sont revenues avant vous. Elles ont donc eu le temps d'admirer votre livraison très personnelle."
    kami "监控都比你们先恢复，所以它们有足够的时间好好欣赏你们这份私人补给。"

# game/scenario/7_1_0_0.rpy:802
translate chinese 368c59dd:

    # kami "Une clandestine, quatre complices et un itinéraire improvisé. Vous rendez les infractions si laborieuses."
    kami "一个偷渡者、四名同谋，再加一条临时拼凑的路线。你们连违规都能搞得这么费劲。"

# game/scenario/7_1_0_0.rpy:803
translate chinese 2b9a0a7e:

    # kami "Le Commandement VI ne laisse malheureusement aucune place à votre retard."
    kami "可惜，第六戒律容不下你们这点迟到。"

# game/scenario/7_1_0_0.rpy:805
translate chinese 13edc0f5:

    # kami "La prochaine fois, courez plus vite. Enfin... il n'y aura pas de prochaine fois."
    kami "下次记得跑快点。哦……不会有下次了。"

# game/scenario/7_1_0_0.rpy:811
translate chinese ce26afe4:

    # centered "{size=78}{color=#FF334F}GAME OVER{/color}{/size}"
    centered "{size=78}{color=#FF334F}游戏结束{/color}{/size}"

# game/scenario/7_1_0_0.rpy:843
translate chinese 1f411c41:

    # think "À midi, nous nous retrouvons presque tous à la cafétéria."
    think "中午，我们几乎所有人都在餐厅碰面。"

# game/scenario/7_1_0_0.rpy:844
translate chinese 91e2cd19:

    # think "Iris prétend être fatiguée. Kael n'est pas là non plus."
    think "Iris 声称自己累了，Kael 也没来。"

# game/scenario/7_1_0_0.rpy:845
translate chinese 70cc8e13:

    # think "Personne ne doit regarder trop souvent leurs places vides. Personne ne doit se montrer inquiet."
    think "谁都不能频繁看向他们的空座位，也不能表现出担心。"

# game/scenario/7_1_0_0.rpy:847
translate chinese 520a1edb:

    # elen content "Je savais que le commerce changerait tout, mais pas au point de couper l'électricité !"
    elen content "我就知道恢复贸易会改变一切，可没想到连电都给改没了！"

# game/scenario/7_1_0_0.rpy:849
translate chinese 0e6e6ea0:

    # julian taquin "Le cacao a peut-être demandé trop de puissance."
    julian taquin "也许可可需要的功率太大了。"

# game/scenario/7_1_0_0.rpy:851
translate chinese d053eb35:

    # elias ecoute "C'était le serveur central. Les machines de la maintenance ont redémarré avant le réseau."
    elias ecoute "是中央服务器的问题。维修区的机器比网络更早重启。"

# game/scenario/7_1_0_0.rpy:853
translate chinese b62defc3:

    # mara mefiant "Et notre spécialiste d'Orbite a disparu juste après. Quelle coïncidence."
    mara mefiant "而我们的 Orbite 专家刚好在那之后消失了，真巧啊。"

# game/scenario/7_1_0_0.rpy:855
translate chinese 09b6e3bc:

    # nyra neutre "Kael aime les systèmes. Une panne lui donne probablement l'impression d'avoir été personnellement invité."
    nyra neutre "Kael 喜欢研究系统。发生故障，大概让他觉得自己收到了私人邀请。"

# game/scenario/7_1_0_0.rpy:857
translate chinese 373312b8:

    # tomas panne "Oui. Voilà. C'est exactement ça."
    tomas panne "对，就是这样。完全没错。"

# game/scenario/7_1_0_0.rpy:859
translate chinese 15e01f30:

    # lysa taquin "Tomas, personne ne t'accusait de quoi que ce soit."
    lysa taquin "Tomas，根本没人指控你。"

# game/scenario/7_1_0_0.rpy:861
translate chinese 869d52aa:

    # tomas inquiet "Je sais."
    tomas inquiet "我知道。"

# game/scenario/7_1_0_0.rpy:863
translate chinese 16d8cea0:

    # lysa blase "Tu rends la situation extrêmement rassurante."
    lysa blase "你这副样子真让人安心得不得了。"

# game/scenario/7_1_0_0.rpy:865
translate chinese 2f6ac219:

    # noam sourire "On devrait profiter de l'après-midi. Kami n'a encore rien annoncé."
    noam sourire "我们应该好好享受下午，Kami 还什么都没宣布。"

# game/scenario/7_1_0_0.rpy:867
translate chinese 6d14219d:

    # ryn fatigue "Pour une fois qu'elle nous fout la paix."
    ryn fatigue "难得她肯让我们清静一会儿。"

# game/scenario/7_1_0_0.rpy:869
translate chinese d0b8aabc:

    # sael mefiant "Elle ne nous laisse jamais tranquilles. Elle attend."
    sael mefiant "她从不会让我们清静，她只是在等。"

# game/scenario/7_1_0_0.rpy:873
translate chinese 73fff772:

    # think "Je force mes épaules à se détendre. Agir normalement est beaucoup plus difficile quand on essaie de le faire consciemment."
    think "我强迫自己放松肩膀。刻意装正常的时候，表现正常反而难得多。"

# game/scenario/7_1_0_0.rpy:877
translate chinese 30b5f2ec:

    # think "J'ai encore du temps avant le soir. Le mieux est de suivre la routine prévue et de ne pas retourner immédiatement voir Iris."
    think "离晚上还有时间。最好按计划照常行动，不要马上回去找 Iris。"

# game/scenario/7_1_0_0.rpy:891
translate chinese 80e55311:

    # think "Mon premier temps libre terminé, je repasse par le dortoir."
    think "第一次自由活动结束后，我再次经过宿舍区。"

# game/scenario/7_1_0_0.rpy:892
translate chinese 56bcc6c0:

    # think "Je ralentis devant la chambre d'Iris, puis continue sans frapper. Une caméra se trouve à l'autre extrémité du couloir."
    think "走到 Iris 房门前，我放慢了脚步，却没有敲门，继续往前走。走廊另一头就有摄像机。"

# game/scenario/7_1_0_0.rpy:893
translate chinese c4889008:

    # think "Nous avons décidé d'agir normalement. Alors je dois encore attendre."
    think "我们已经决定表现得和平常一样，所以我还得继续等。"

# game/scenario/7_1_0_0.rpy:907
translate chinese 0d62fc8e:

    # think "Après mon deuxième temps libre, le couloir est enfin vide."
    think "第二次自由活动结束后，走廊终于空了。"

# game/scenario/7_1_0_0.rpy:908
translate chinese 85f59036:

    # think "Je frappe doucement à la porte d'Iris : deux coups, une pause, puis un troisième. Le signal convenu."
    think "我轻轻敲响 Iris 的房门：两下，停顿，再敲第三下。这是约好的暗号。"

# game/scenario/7_1_0_0.rpy:916
translate chinese b8555e4c:

    # iris "Entre."
    iris "进来。"

# game/scenario/7_1_0_0.rpy:932
translate chinese 298333b5:

    # think "La chambre est plus chaude que le reste du dortoir. Iris a poussé le chauffage au maximum."
    think "房间比宿舍其他地方暖和，Iris 已经把暖气开到了最大。"

# game/scenario/7_1_0_0.rpy:933
translate chinese 8032972b:

    # think "La jeune femme est presque entièrement dissimulée sous les couettes. Seule une partie de son visage reste visible."
    think "年轻女子几乎完全被被子盖住，只露出一小部分脸。"

# game/scenario/7_1_0_0.rpy:935
translate chinese f743f116:

    # noam inquiet "Elle s'est réveillée ?"
    noam inquiet "她醒过吗？"

# game/scenario/7_1_0_0.rpy:937
translate chinese 0b295ac3_1:

    # iris fatigue "Non."
    iris fatigue "没有。"

# game/scenario/7_1_0_0.rpy:939
translate chinese 9046b6b8:

    # noam inquiet "Son état s'améliore ?"
    noam inquiet "情况好转了吗？"

# game/scenario/7_1_0_0.rpy:941
translate chinese 2ded2520:

    # iris reflexion "Sa température remonte lentement. Sa respiration est moins irrégulière, mais elle reste beaucoup trop faible."
    iris reflexion "体温正在缓慢回升，呼吸也没那么紊乱了，但还是太微弱。"

# game/scenario/7_1_0_0.rpy:943
translate chinese cfbedfbd:

    # noam neutre "Tu as besoin de quelque chose ?"
    noam neutre "你需要什么吗？"

# game/scenario/7_1_0_0.rpy:945
translate chinese b6de2e8a:

    # iris inquiet "De matériel médical. D'une perfusion. D'un vrai thermomètre. De savoir combien de temps elle est restée dans le froid."
    iris inquiet "医疗器材、输液、真正的体温计，还有知道她究竟在寒冷里待了多久。"

# game/scenario/7_1_0_0.rpy:946
translate chinese 688b7cbc:

    # iris colere "Bref, de tout ce que je ne peux pas prendre à l'infirmerie sans laisser une trace."
    iris colere "总之，我需要的每一样东西，只要从医务室拿走就会留下记录。"

# game/scenario/7_1_0_0.rpy:948
translate chinese 08b5dff5:

    # noam raison "On peut répartir les prélèvements. Une personne prend des compresses, une autre une poche chauffante..."
    noam raison "我们可以分开拿。一个人拿纱布，另一个人拿热敷袋……"

# game/scenario/7_1_0_0.rpy:950
translate chinese cd95b613:

    # iris desaccord "Et demain Kami demandera pourquoi onze représentants ont soudain développé la même maladie."
    iris desaccord "然后明天 Kami 就会问，为什么十一名代表突然得了同一种病。"

# game/scenario/7_1_0_0.rpy:954
translate chinese 994ce0d8:

    # think "La jeune femme bouge légèrement sous les couvertures. Un son faible sort de sa gorge, mais ses yeux restent fermés."
    think "年轻女子在被子下微微动了一下，喉咙里发出一声轻响，眼睛却仍然闭着。"

# game/scenario/7_1_0_0.rpy:956
translate chinese a17f17de:

    # noam surpris "Elle a réagi."
    noam surpris "她有反应了。"

# game/scenario/7_1_0_0.rpy:958
translate chinese aff9038f:

    # iris determine "C'est bon signe. Pas suffisant, mais bon signe."
    iris determine "是个好兆头。还远远不够，但至少是好兆头。"

# game/scenario/7_1_0_0.rpy:960
translate chinese d4cd0620:

    # noam inquiet "Tu as trouvé quelque chose sur elle ? Un nom ?"
    noam inquiet "你在她身上找到什么了吗？比如名字？"

# game/scenario/7_1_0_0.rpy:962
translate chinese 8862235a:

    # iris neutre "Rien que je puisse vérifier. Ses poches étaient vides. Pas de tablette, pas de badge actif."
    iris neutre "没有任何能确认身份的东西。她的口袋是空的，没有平板，也没有启用的徽章。"

# game/scenario/7_1_0_0.rpy:964
translate chinese 84f1f4b4:

    # noam reflechit "Elle a dû tout abandonner avant de monter dans le conteneur."
    noam reflechit "她肯定在钻进集装箱前把一切都丢掉了。"

# game/scenario/7_1_0_0.rpy:966
translate chinese e93a2d88:

    # iris triste "Ou quelqu'un l'a dépouillée avant de l'y mettre."
    iris triste "也可能是有人把她塞进去前，先拿走了她身上的东西。"

# game/scenario/7_1_0_0.rpy:968
translate chinese f87f1eff:

    # noam inquiet "Tu crois qu'elle a été forcée ?"
    noam inquiet "你觉得她是被逼进去的？"

# game/scenario/7_1_0_0.rpy:970
translate chinese f0656beb:

    # iris reflexion "Je ne crois rien tant qu'elle ne peut pas répondre."
    iris reflexion "在她能亲口回答之前，我不会妄下结论。"

# game/scenario/7_1_0_0.rpy:974
translate chinese ae26babf:

    # iris inquiet "Kael est revenu ?"
    iris inquiet "Kael 回来了吗？"

# game/scenario/7_1_0_0.rpy:976
translate chinese 24cf56d0:

    # noam neutre "Non. Je pensais qu'il était avec toi."
    noam neutre "没有，我还以为他在你这里。"

# game/scenario/7_1_0_0.rpy:978
translate chinese c9c4fa77:

    # iris colere "Il devait quitter le système après le redémarrage."
    iris colere "服务器重启后，他就该退出系统了。"

# game/scenario/7_1_0_0.rpy:980
translate chinese a1a9c451:

    # noam inquiet "Il voulait chercher des informations sur sa sœur."
    noam inquiet "他想查找妹妹的消息。"

# game/scenario/7_1_0_0.rpy:982
translate chinese 0c32cfa1:

    # iris desaccord "Et tu l'as laissé faire ?"
    iris desaccord "你就让他查了？"

# game/scenario/7_1_0_0.rpy:984
translate chinese 3820bb93:

    # noam colere "Je lui ai dit d'arrêter dès que les générateurs reviendraient."
    noam colere "我告诉过他，发电机一恢复就立刻停手。"

# game/scenario/7_1_0_0.rpy:986
translate chinese d879a51c:

    # iris colere "Donc tu l'as laissé faire."
    iris colere "所以你确实让他查了。"

# game/scenario/7_1_0_0.rpy:990
translate chinese 0197be9b:

    # think "Avant que je puisse répondre, tous les écrans de la chambre s'allument simultanément."
    think "我还没来得及回答，房间里所有屏幕就同时亮了起来。"

# game/scenario/7_1_0_0.rpy:994
translate chinese 0dd6af7c:

    # iris peur "Éloigne-toi du lit."
    iris peur "离床远一点。"

# game/scenario/7_1_0_0.rpy:996
translate chinese 66eeb75b:

    # think "Iris remonte la couverture sur le visage de la jeune femme. Je me place devant, autant que possible."
    think "Iris 把被子拉高，盖住年轻女子的脸。我则尽可能挡在床前。"

# game/scenario/7_1_0_0.rpy:1011
translate chinese d3630628:

    # kami "Mes chers représentants ! J'aimerais attirer votre attention sur un concept révolutionnaire : l'éducation !"
    kami "我亲爱的代表们！我想请你们关注一个革命性的概念：教养！"

# game/scenario/7_1_0_0.rpy:1015
translate chinese 5b5cc18b:

    # kami "Lorsque vous êtes invités quelque part, vous ne fouillez pas dans les tiroirs. Vous ne démontez pas les serrures."
    kami "受邀去别人家时，不该翻人家的抽屉，也不该拆人家的锁。"

# game/scenario/7_1_0_0.rpy:1016
translate chinese d65ed979:

    # kami "Et surtout, vous n'essayez pas d'explorer les serveurs de votre hôte pendant qu'ils redémarrent !"
    kami "更不应该趁主人的服务器重启时，试图进去到处探索！"

# game/scenario/7_1_0_0.rpy:1020
translate chinese 58d9c2a2:

    # kami "Kael ! Tu veux expliquer aux autres pourquoi je viens de te trouver dans un relais administratif qui ne te concernait absolument pas ?"
    kami "Kael！要不要向其他人解释一下，为什么我刚刚在一个与你毫无关系的行政中继站里发现了你？"

# game/scenario/7_1_0_0.rpy:1022
translate chinese d1fff5b4:

    # kael "Je cherchais des informations sur ma sœur."
    kael "我在找我妹妹的消息。"

# game/scenario/7_1_0_0.rpy:1026
translate chinese 26de5ba7:

    # kami "Oh ! Une réponse directe ! Presque touchante !"
    kami "哦！回答得真直接！都快把我感动了！"

# game/scenario/7_1_0_0.rpy:1028
translate chinese 5d10d07d:

    # kael "Elle s'appelle Léa. Je voulais seulement savoir si elle allait bien."
    kael "她叫 Léa。我只是想知道她是否平安。"

# game/scenario/7_1_0_0.rpy:1032
translate chinese a5021eeb:

    # kami "Seulement ? Tu as ouvert six registres, tenté trois requêtes extérieures et parcouru une partie de mon architecture réseau."
    kami "只是？你打开了六份记录，尝试了三次外部查询，还翻过了我一部分网络架构。"

# game/scenario/7_1_0_0.rpy:1034
translate chinese 69b8a478:

    # kael "Aucune règle du Conclave ne l'interdit."
    kael "议会的规则没有禁止这么做。"

# game/scenario/7_1_0_0.rpy:1040
translate chinese 30b1a8b0:

    # kami "Je le sais ! C'est précisément ce qui rend cette conversation insupportable !"
    kami "我知道！正因为这样，这场谈话才烦人得要命！"

# game/scenario/7_1_0_0.rpy:1044
translate chinese ba6f90e1:

    # kami "Techniquement, Kael n'a enfreint aucune règle. Il n'a détruit aucune donnée et n'a franchi aucun accès explicitement interdit."
    kami "严格来说，Kael 没有违反任何规则。他没有毁坏数据，也没有闯入任何明令禁止的访问区域。"

# game/scenario/7_1_0_0.rpy:1045
translate chinese 616322f7:

    # kami "Il ne sera donc pas puni."
    kami "所以，他不会受到惩罚。"

# game/scenario/7_1_0_0.rpy:1049
translate chinese 0fdba595:

    # kami "Mais est-ce trop demander que vous vous comportiez comme des invités correctement élevés ?!"
    kami "但让你们表现得像一群有教养的客人，难道要求太高了吗？！"

# game/scenario/7_1_0_0.rpy:1050
translate chinese 86571e9b:

    # kami "On ne touche pas aux serveurs. On ne branche pas ses câbles partout. On ne profite pas d'une panne pour fouiller chez les autres !"
    kami "不许碰服务器，不许把自己的线缆到处乱插，也不许趁停电翻别人的东西！"

# game/scenario/7_1_0_0.rpy:1054
translate chinese b80f52df:

    # kami "Vos familles seraient-elles fières de votre manque absolu de savoir-vivre ?"
    kami "你们的家人要是看到你们这么没规矩，会为你们感到骄傲吗？"

# game/scenario/7_1_0_0.rpy:1056
translate chinese 2e7dd999:

    # kael "Tu as des informations sur Léa ?"
    kael "你有 Léa 的消息吗？"

# game/scenario/7_1_0_0.rpy:1060
translate chinese 326fcb9f:

    # kami "Ce n'est pas le sujet !"
    kami "这不是重点！"

# game/scenario/7_1_0_0.rpy:1066
translate chinese 000845cc:

    # kami "Pour les autres : considérez ceci comme un rappel collectif. Le fait qu'une action ne soit pas interdite ne la rend pas polie."
    kami "至于其他人：把这当成一次集体提醒。没有被明令禁止，不代表这么做有礼貌。"

# game/scenario/7_1_0_0.rpy:1070
translate chinese ac737f95:

    # kami "Et maintenant, retournez à vos activités. Je dois réparer ce que votre curiosité adolescente a dérangé."
    kami "现在，回去做你们自己的事。我得修好被你们青春期式的好奇心弄乱的东西。"

# game/scenario/7_1_0_0.rpy:1087
translate chinese 016f5cd5:

    # noam inquiet "Il nous a couverts."
    noam inquiet "他替我们打了掩护。"

# game/scenario/7_1_0_0.rpy:1089
translate chinese 6eff2073:

    # iris reflexion "Ou il a réellement oublié de partir parce qu'il cherchait sa sœur."
    iris reflexion "也可能他真是为了找妹妹，忘了及时退出。"

# game/scenario/7_1_0_0.rpy:1091
translate chinese eb5edb49:

    # noam triste "Les deux peuvent être vrais."
    noam triste "两件事可以同时成立。"

# game/scenario/7_1_0_0.rpy:1093
translate chinese 5ec8c35c:

    # iris inquiet "Kami va surveiller les accès plus attentivement maintenant."
    iris inquiet "Kami 现在会更严密地监控所有访问记录。"

# game/scenario/7_1_0_0.rpy:1095
translate chinese 211fc715:

    # noam inquiet "Mais elle n'a rien dit sur le redémarrage volontaire."
    noam inquiet "但她没提服务器是被人为重启的。"

# game/scenario/7_1_0_0.rpy:1097
translate chinese 9c4a3772:

    # iris reflexion "Kael lui a donné une explication suffisamment crédible. Pour le moment."
    iris reflexion "Kael 给了她一个足够可信的解释，至少暂时如此。"

# game/scenario/7_1_0_0.rpy:1099
translate chinese 4fc40a25:

    # think "Nous regardons le lit. La jeune femme respire toujours, invisible sous les couettes."
    think "我们看向床铺。年轻女子仍在呼吸，完全藏在被子下面。"

# game/scenario/7_1_0_0.rpy:1101
translate chinese 0dd97aec:

    # iris determine "Retourne dans le couloir. Si quelqu'un vérifie où nous sommes, il ne faut pas nous trouver ensemble."
    iris determine "回到走廊去。如果有人检查我们的位置，不能让他们发现我们待在一起。"

# game/scenario/7_1_0_0.rpy:1103
translate chinese b5337992:

    # noam neutre "Tu m'appelles si elle se réveille."
    noam neutre "她醒了就通知我。"

# game/scenario/7_1_0_0.rpy:1105
translate chinese 8c251664:

    # iris determine "Je trouverai un moyen."
    iris determine "我会想办法。"

# game/scenario/7_1_0_0.rpy:1109
translate chinese c6a2bcbb:

    # think "Je quitte la chambre en vérifiant que personne ne se trouve derrière la porte."
    think "我离开房间前，先确认门外没有人。"

# game/scenario/7_1_0_0.rpy:1123
translate chinese 53b24d69:

    # think "La soirée arrive sans que la jeune femme se réveille."
    think "直到晚上，年轻女子仍然没有醒来。"

# game/scenario/7_1_0_0.rpy:1124
translate chinese 502e7129:

    # think "Je croise Kael une seule fois. Il me fait un signe bref, sans s'arrêter. Kami doit encore observer chacun de ses gestes."
    think "我只遇见过 Kael 一次。他没停下，只朝我简短地示意了一下。Kami 肯定还在监视他的一举一动。"

# game/scenario/7_1_0_0.rpy:1125
translate chinese 6e1e1e19:

    # think "J'espère que son histoire sur Léa suffira à masquer ce qu'il a réellement fait dans le sas."
    think "希望他拿 Léa 当借口的说辞，足以掩盖他在气闸舱里真正做过的事。"

# game/scenario/7_1_0_0.rpy:1131
translate chinese e4eb9984:

    # think "Tous les écrans du couloir s'allument en même temps."
    think "走廊里所有屏幕同时亮起。"

# game/scenario/7_1_0_0.rpy:1137
translate chinese ccecd2d8:

    # kami "Bonsoir, mes chers représentants !"
    kami "晚上好，我亲爱的代表们！"

# game/scenario/7_1_0_0.rpy:1141
translate chinese 3b140dcd:

    # kami "Entre la livraison, cette adorable panne générale et les explorations éducatives de Kael, ma matinée a été légèrement chargée."
    kami "今天又是补给，又是可爱的全区停电，还有 Kael 那场寓教于乐的探险，我的早上稍微有那么一点忙。"

# game/scenario/7_1_0_0.rpy:1142
translate chinese 5b5fae23:

    # kami "J'en ai presque oublié de vous annoncer le thème de votre prochain vote. Presque !"
    kami "我差点忘了宣布下一次投票的主题。差点！"

# game/scenario/7_1_0_0.rpy:1146
translate chinese be24f09a:

    # kami "Votre prochaine décision concernera le Commandement IV relatif aux rassemblements et à l'organisation."
    kami "你们的下一项决定，将涉及关于集会和组织活动的第四戒律。"

# game/scenario/7_1_0_0.rpy:1152
translate chinese aa0092c5:

    # kami "La proposition est la suivante : autoriser les regroupements de plus de vingt personnes, sous réserve d'une demande d'autorisation préalable."
    kami "提案如下：允许二十人以上的集会，但必须提前申请许可。"

# game/scenario/7_1_0_0.rpy:1156
translate chinese f110a99c:

    # kami "Autrement dit : plus de vingt personnes pourront se réunir, à condition d'annoncer à l'avance qui, où, quand et pourquoi."
    kami "换句话说：二十人以上可以聚集，条件是提前说明谁、在哪里、何时，以及为什么。"

# game/scenario/7_1_0_0.rpy:1157
translate chinese 6db2a9b9:

    # kami "Une liberté parfaitement encadrée ! Le compromis préféré de ceux qui veulent ouvrir une porte tout en gardant la clé."
    kami "受到完美管控的自由！这可是既想开门、又不肯交出钥匙的人最喜欢的折中方案。"

# game/scenario/7_1_0_0.rpy:1161
translate chinese 9fb8b80c:

    # kami "Le vote aura lieu à la fin du jour 9."
    kami "投票将在第九天结束时举行。"

# game/scenario/7_1_0_0.rpy:1162
translate chinese ca2509f7:

    # kami "Vous avez donc deux jours pour décider si les habitants peuvent se retrouver en groupe sans devenir de dangereux conspirateurs."
    kami "所以你们有两天时间，决定居民能不能成群见面，而不被当成危险的阴谋分子。"

# game/scenario/7_1_0_0.rpy:1166
translate chinese 40af24de:

    # kami "Et cette fois, essayez d'offrir un débat un peu plus long que le précédent. Je refuse de préparer autant de caméras pour rien !"
    kami "还有，这次尽量让辩论比上一次长一点。我可不想白白准备那么多机位！"

# game/scenario/7_1_0_0.rpy:1174
translate chinese 92bcbc55:

    # think "Les écrans s'éteignent."
    think "屏幕熄灭了。"

# game/scenario/7_1_0_0.rpy:1175
translate chinese 786d7bbd:

    # think "Plus de vingt personnes réunies avec une autorisation. Sur le papier, la proposition paraît presque raisonnable."
    think "二十人以上，只要获得许可就能聚集。纸面上看，这项提案甚至还算合理。"

# game/scenario/7_1_0_0.rpy:1176
translate chinese 1cafc546:

    # think "Mais dans la chambre d'Iris, une seule personne suffit déjà à nous faire risquer la mort."
    think "可在 Iris 的房间里，仅仅一个人就足以让我们冒上生命危险。"

# game/scenario/7_1_0_0.rpy:1180
translate chinese b0d8ea9a:

    # think "Je retourne vers ma chambre sans m'arrêter devant celle d'Iris."
    think "我朝自己的房间走去，没有在 Iris 门前停下。"

# game/scenario/7_1_0_0.rpy:1181
translate chinese dff34358:

    # think "Demain, il faudra continuer à agir normalement. Et espérer que la jeune femme finisse par ouvrir les yeux."
    think "明天，我们还得继续装作一切正常，并祈祷那名年轻女子终于睁开眼睛。"

translate chinese strings:

    # game/scenario/7_1_0_0.rpy:321
    old "Que faire de la jeune femme ?"
    new "该怎么处置这名年轻女子？"

    # game/scenario/7_1_0_0.rpy:321
    old "La cacher."
    new "把她藏起来。"

    # game/scenario/7_1_0_0.rpy:321
    old "Prévenir Kami."
    new "通知 Kami。"

