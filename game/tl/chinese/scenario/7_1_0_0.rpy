    think "我睁开眼，一时没反应过来自己在哪。下巴刚一动，脸颊就抽痛起来。"

# game/scenario/7_1_0_0.rpy:112
translate chinese feb48003:

    # think "Le coup de Ryn a laissé une marque plus douloureuse que prévu."
    think "Ryn 那一拳留下的伤，比我预想中还要疼。"

# game/scenario/7_1_0_0.rpy:116
translate chinese 7eec9626:

    # nyra "Noam ? Ouvre. Vite."
    nyra "Noam？开门，快点。"

# game/scenario/7_1_0_0.rpy:118
translate chinese 9ed1436c:

    # think "Nyra. Sa voix est basse, mais elle ne cherche même pas à cacher son impatience."
    think "是 Nyra。她压低了声音，却丝毫没想掩饰自己的急躁。"

# game/scenario/7_1_0_0.rpy:120
translate chinese b4b7f0e0:

    # noam inquiet "J'arrive."
    noam inquiet "来了。"

# game/scenario/7_1_0_0.rpy:122
translate chinese fd8e97f2:

    # think "J'enfile le premier vêtement à portée de main et traverse la chambre."
    think "我随手套上离我最近的一件衣服，穿过房间。"

# game/scenario/7_1_0_0.rpy:143
translate chinese 21c66d6e:

    # think "Lorsque j'ouvre, Nyra entre presque sans attendre mon autorisation. Tomas et Iris se tiennent derrière elle."
    think "我刚开门，Nyra 几乎没等我同意就挤了进来。Tomas 和 Iris 站在她身后。"

# game/scenario/7_1_0_0.rpy:144
translate chinese 2225091a:

    # think "Ils sont habillés à la hâte. Iris tient encore sa veste contre elle au lieu de l'avoir correctement enfilée."
    think "他们显然是匆忙穿好衣服赶来的。Iris 甚至还抱着外套，根本没来得及穿好。"

# game/scenario/7_1_0_0.rpy:146
translate chinese 2a07744c:

    # noam surpris "Qu'est-ce qui se passe ?"
    noam surpris "出什么事了？"

# game/scenario/7_1_0_0.rpy:148
translate chinese e504890a:

    # nyra inquiet "Laisse-nous entrer."
    nyra inquiet "先让我们进去。"

# game/scenario/7_1_0_0.rpy:150
translate chinese 5470dcd2:

    # noam inquiet "Vous êtes déjà pratiquement dedans."
    noam inquiet "你们都已经快进完了。"

# game/scenario/7_1_0_0.rpy:152
translate chinese c4283604:

    # iris colere "Noam, ferme la porte."
    iris colere "Noam，把门关上。"

# game/scenario/7_1_0_0.rpy:156
translate chinese 70c59517:

    # think "Je m'exécute. Nyra vérifie l'écran du brouilleur fixé près du lit."
    think "我照做了。Nyra 检查了一眼床边干扰器的屏幕。"

# game/scenario/7_1_0_0.rpy:158
translate chinese ffffc597:

    # nyra raison "Il fonctionne ?"
    nyra raison "它在运行吗？"

# game/scenario/7_1_0_0.rpy:160
translate chinese 5bc3a84c:

    # noam neutre "Oui. Pourquoi ?"
    noam neutre "在。怎么了？"

# game/scenario/7_1_0_0.rpy:162
translate chinese 382dfbd4:

    # tomas inquiet "P-Parle moins fort."
    tomas inquiet "小、小声点。"

# game/scenario/7_1_0_0.rpy:164
translate chinese 38c56177:

    # noam surpris "Vous venez de me réveiller en frappant comme si la station brûlait et maintenant vous me demandez de chuchoter ?"
    noam surpris "你们刚才敲得像空间站着火了一样，把我从床上叫醒，现在又让我说悄悄话？"

# game/scenario/7_1_0_0.rpy:166
translate chinese 13833bd6:

    # iris desaccord "Approche."
    iris desaccord "靠近点。"

# game/scenario/7_1_0_0.rpy:168
translate chinese 1dffbefb:

    # think "Iris m'attrape par la manche. Tous les trois se rapprochent au point que la scène devient presque ridicule."
    think "Iris 抓住我的袖子。三个人全凑到我身边，场面甚至有些滑稽。"

# game/scenario/7_1_0_0.rpy:170
translate chinese ba84ff74:

    # noam inquiet "Vous me faites peur."
    noam inquiet "你们这样让我有点害怕。"

# game/scenario/7_1_0_0.rpy:172
translate chinese 5abe706e:

    # nyra inquiet "C'est préférable. Tu comprendras plus vite."
    nyra inquiet "怕一点更好，这样你能理解得快些。"

# game/scenario/7_1_0_0.rpy:174
translate chinese a8d0a667:

    # think "Nyra se penche jusqu'à mon oreille."
    think "Nyra 凑到我耳边。"

# game/scenario/7_1_0_0.rpy:176
translate chinese e34444f1:

    # nyra raison "Il y a quelqu'un dans la livraison."
    nyra raison "补给里藏着一个人。"

# game/scenario/7_1_0_0.rpy:180
translate chinese 7941b899:

    # noam surpris "Quelqu'un ?"
    noam surpris "一个人？"

# game/scenario/7_1_0_0.rpy:182
translate chinese 91452df6:

    # iris colere "Moins fort !"
    iris colere "小声点！"

# game/scenario/7_1_0_0.rpy:184
translate chinese ca1d2554:

    # noam inquiet "Quelqu'un comment ?"
    noam inquiet "什么叫藏着一个人？"

# game/scenario/7_1_0_0.rpy:186
translate chinese e06f0665:

    # tomas panne "Une... une personne. Dans un conteneur."
    tomas panne "就……一个活人。在集装箱里。"

# game/scenario/7_1_0_0.rpy:188
translate chinese 9ce11921:

    # noam surpris "Vous êtes sûrs ?"
    noam surpris "你们确定？"

# game/scenario/7_1_0_0.rpy:190
translate chinese 3772edca:

    # nyra raison "Nous avons vu une main entre deux caisses. Iris l'a touchée."
    nyra raison "我们在两个箱子中间看到了一只手，Iris 还碰过她。"

# game/scenario/7_1_0_0.rpy:192
translate chinese abf93d24:

    # iris inquiet "Elle est glacée. Je ne sais même pas si elle est encore consciente."
    iris inquiet "她浑身冰冷。我甚至不知道她还有没有意识。"

# game/scenario/7_1_0_0.rpy:194
translate chinese b42d6184:

    # noam determine "Pourquoi vous ne l'avez pas sortie ?"
    noam determine "你们为什么没把她弄出来？"

# game/scenario/7_1_0_0.rpy:196
translate chinese 1e97f5d9:

    # nyra colere "Parce qu'il y a trois caméras dans le sas et que nous ignorons si Kami l'a déjà repérée."
    nyra colere "因为气闸舱里有三台摄像机，而且我们不知道 Kami 是不是已经发现她了。"

# game/scenario/7_1_0_0.rpy:198
translate chinese cefb8d46:

    # tomas inquiet "On a replacé la bâche exactement comme elle était. Enfin... je crois."
    tomas inquiet "我们把防水布原样盖回去了。应该……应该是吧。"

# game/scenario/7_1_0_0.rpy:200
translate chinese e3627000:

    # iris colere "Tu crois ?"
    iris colere "应该？"

# game/scenario/7_1_0_0.rpy:202
translate chinese 9af46a3a:

    # tomas panne "J'ai fait au mieux !"
    tomas panne "我已经尽力了！"

# game/scenario/7_1_0_0.rpy:204
translate chinese 66f386f5:

    # noam inquiet "Qui d'autre est au courant ?"
    noam inquiet "还有谁知道？"

# game/scenario/7_1_0_0.rpy:206
translate chinese 586181bd:

    # nyra neutre "Personne. La livraison est arrivée plus tôt que prévu. Nous étions les premiers dans le sas."
    nyra neutre "没人。补给比预定时间早到了，我们是最先进入气闸舱的。"

# game/scenario/7_1_0_0.rpy:208
translate chinese 69beba6f:

    # iris determine "Mais elle ne tiendra pas longtemps dans cet état. Il faut y retourner maintenant."
    iris determine "可她那个状态撑不了多久。我们必须马上回去。"

# game/scenario/7_1_0_0.rpy:210
translate chinese fb13261a:

    # noam determine "Alors on y va."
    noam determine "那就走。"

# game/scenario/7_1_0_0.rpy:214
translate chinese 74e1d29d:

    # think "Nyra rouvre la porte avec précaution. Nous quittons la chambre séparément, à quelques secondes d'intervalle."
    think "Nyra 小心翼翼地重新开门。我们每隔几秒离开一个，分头走出房间。"

# game/scenario/7_1_0_0.rpy:215
translate chinese 24515d9f:

    # think "Dès que nous atteignons l'angle mort du couloir, nous cessons de marcher et nous courons."
    think "一走到走廊的监控死角，我们便不再慢慢走，直接跑了起来。"

# game/scenario/7_1_0_0.rpy:235
translate chinese 94d0d09e:

    # think "L'air du sas est nettement plus froid que celui des autres pièces. Les conteneurs occupent presque tout l'espace."
    think "气闸舱里的空气明显比其他房间冷，集装箱几乎占满了整个空间。"

# game/scenario/7_1_0_0.rpy:236
translate chinese c2fd8042:

    # think "Des caisses de nourriture, de médicaments et de matériel s'empilent jusqu'aux parois."
    think "装着食物、药品和器材的箱子一直堆到墙边。"

# game/scenario/7_1_0_0.rpy:238
translate chinese bbab69ae:

    # nyra raison "Regarde ici. Sous la bâche grise."
    nyra raison "看这里，灰色防水布下面。"

# game/scenario/7_1_0_0.rpy:239
translate chinese b0071151:

    # nyra colere "Mais ne l'enlève pas, il ne faut pas que Kami voit ça aux caméras."
    nyra colere "但别把它整个掀开，不能让 Kami 从监控里看到。"

# game/scenario/7_1_0_0.rpy:244
translate chinese 2fe17432:

    # think "Nous avançons entre les palettes. Une main dépasse d'un drap recouvrant une palette."
    think "我们从托盘之间穿过去。一只手从盖在托盘上的布单下伸了出来。"

# game/scenario/7_1_0_0.rpy:246
translate chinese 39f546c2:

    # noam peur "Merde..."
    noam peur "该死……"

# game/scenario/7_1_0_0.rpy:248
translate chinese 27e98258:

    # iris determine "Aide-moi à la dégager. Doucement."
    iris determine "帮我把她弄出来，轻一点。"

# game/scenario/7_1_0_0.rpy:250
translate chinese 40066477:

    # think "Je soulève la bâche pendant que Tomas écarte une caisse légère."
    think "我掀起防水布，Tomas 则挪开一个不太重的箱子。"

# game/scenario/7_1_0_0.rpy:251
translate chinese e970d0e1:

    # think "Une jeune femme est recroquevillée dans l'espace laissé entre deux conteneurs. Ses vêtements sont couverts de givre."
    think "一名年轻女子蜷缩在两个集装箱之间的空隙里，衣服上结满了霜。"

# game/scenario/7_1_0_0.rpy:252
translate chinese f7a08f3b:

    # think "Ses lèvres ont perdu leur couleur. Ses cheveux sont collés contre son visage par l'humidité."
    think "她的嘴唇毫无血色，头发被湿气粘在脸上。"

# game/scenario/7_1_0_0.rpy:254
translate chinese 0f50e13f:

    # tomas inquiet "Elle est morte ?!"
    tomas inquiet "她死了吗？！"

# game/scenario/7_1_0_0.rpy:256
translate chinese b57b394b:

    # iris colere "Ne dis pas ça."
    iris colere "别这么说。"

# game/scenario/7_1_0_0.rpy:258
translate chinese 3e6c98bc:

    # think "Iris pose deux doigts contre son cou. Elle attend. Une seconde. Deux secondes."
    think "Iris 把两根手指按在她的颈侧，静静等待。一秒，两秒。"

# game/scenario/7_1_0_0.rpy:260
translate chinese b2458548:

    # iris inquiet "J'ai un pouls. Mais il est très lent. Elle en a plus pour longtemps."
    iris inquiet "还有脉搏，但非常慢。她撑不了多久了。"

# game/scenario/7_1_0_0.rpy:262
translate chinese 422b5887:

    # noam inquiet "Elle respire ?"
    noam inquiet "她还在呼吸吗？"

# game/scenario/7_1_0_0.rpy:264
translate chinese 46da63d0:

    # iris determine "Difficilement. Aide-moi à la tourner un peu."
    iris determine "很勉强。帮我把她稍微翻过来一点。"

# game/scenario/7_1_0_0.rpy:266
translate chinese 999cf1c0:

    # think "Nous dégageons son visage. Un souffle faible passe entre ses lèvres, suivi d'un bruit rauque."
    think "我们露出她的脸。一丝微弱的气息从她唇间逸出，接着是一声沙哑的喘息。"

# game/scenario/7_1_0_0.rpy:268
translate chinese c205d119:

    # nyra inquiet "Combien de temps peut-elle tenir ?"
    nyra inquiet "她还能撑多久？"

# game/scenario/7_1_0_0.rpy:270
translate chinese 95f2696f:

    # iris colere "Je ne sais pas. Pas longtemps si on la laisse ici."
    iris colere "不知道。但要是继续留在这里，肯定撑不了多久。"

# game/scenario/7_1_0_0.rpy:281
translate chinese 5fed92ba:

    # tomas inquiet "On pourrait l'emmener à l'infirmerie."
    tomas inquiet "我们可以把她送去医务室。"

# game/scenario/7_1_0_0.rpy:283
translate chinese 4395a578:

    # nyra raison "L'infirmerie est surveillée. Les entrées, le matériel utilisé, les stocks médicaux. Tout."
    nyra raison "医务室受到监控。谁进出、用了什么器材、药品库存，全都有记录。"

# game/scenario/7_1_0_0.rpy:285
translate chinese f8282b52:

    # noam reflechit "Et si Kami la voit ?"
    noam reflechit "要是 Kami 看见她呢？"

# game/scenario/7_1_0_0.rpy:287
translate chinese a99f6b3a:

    # nyra raison "Elle a franchi une frontière sans autorisation. Tu connais la sanction."
    nyra raison "她未经许可跨越了边界。你知道惩罚是什么。"

# game/scenario/7_1_0_0.rpy:289
translate chinese bdf04dd7:

    # tomas inquiet "L'exécution immédiate."
    tomas inquiet "立即处决。"

# game/scenario/7_1_0_0.rpy:291
translate chinese 1e9bf4dd:

    # iris desaccord "Pas ici. Les Commandements ne s'appliquent pas dans le Conclave."
    iris desaccord "这里不一样。戒律在议会里不生效。"

# game/scenario/7_1_0_0.rpy:293
translate chinese f465bad1:

    # nyra raison "Nous l'espérons. Elle n'est pas représentante et Kami adore les interprétations qui l'arrangent."
    nyra raison "但愿如此。她不是代表，而 Kami 最喜欢做对自己有利的解释。"

# game/scenario/7_1_0_0.rpy:297
translate chinese 604e67d1:

    # think "La jeune femme laisse échapper un souffle irrégulier. Iris retire sa veste et la pose sur elle."
    think "年轻女子的呼吸变得紊乱。Iris 脱下外套，盖在她身上。"

# game/scenario/7_1_0_0.rpy:299
translate chinese 8e1aea68:

    # noam reflechit "Et si... Si on la cachait ?"
    noam reflechit "要不……我们把她藏起来？"

# game/scenario/7_1_0_0.rpy:301
translate chinese ac305d54:

    # iris colere "La cacher ?! Mais tu veux là cacher où ?"
    iris colere "藏起来？！你想把她藏哪儿？"

# game/scenario/7_1_0_0.rpy:303
translate chinese b66abbf2:

    # nyra colere "Chut, parle moins fort ! Si les caméras nous entendent on est foutu !"
    nyra colere "嘘，小声点！要是摄像机能听见，我们就完了！"

# game/scenario/7_1_0_0.rpy:305
translate chinese 1b6d941e:

    # noam reflechit "Il y a des caméras partout..."
    noam reflechit "到处都是摄像机……"

# game/scenario/7_1_0_0.rpy:306
translate chinese cdc55285:

    # noam reflechit "Dans une chambre ! On a les brouilleurs, ça devrait le faire, non ?"
    noam reflechit "藏进一间卧室！我们有干扰器，应该行得通吧？"

# game/scenario/7_1_0_0.rpy:308
translate chinese 2a97fcf6:

    # iris reflechit "Dans la chambre de qui tu veux mettre un corps à moitié congelé ?"
    iris reflechit "你想把一具冻得半死的身体塞进谁的房间？"

# game/scenario/7_1_0_0.rpy:310
translate chinese e6bc7c9c:

    # "Je ne dis rien. Je la regarde simplement dans le fond des yeux."
    "我没有说话，只是直直地盯着她的眼睛。"

# game/scenario/7_1_0_0.rpy:312
translate chinese 03465ffe:

    # iris colere "Raaah ! Ok, je peux m'en occuper si tu veux la garder."
    iris colere "啊——！好吧，你真想留下她的话，我可以照顾她。"

# game/scenario/7_1_0_0.rpy:313
translate chinese 257c9bff:

    # iris determine "Mais il faut décider maintenant. Soit nous prévenons Kami, soit nous la cachons."
    iris determine "但必须马上决定。要么告诉 Kami，要么把她藏起来。"

# game/scenario/7_1_0_0.rpy:315
translate chinese 25aba66f:

    # tomas inquiet "Tu crois vraiment qu'on peut la cacher ? Parce que ça signifie mentir à Kami. Et manipuler les caméras. Et les registres de livraison."
    tomas inquiet "你真觉得能把她藏住？那就意味着要对 Kami 撒谎，还得篡改监控和补给记录。"

# game/scenario/7_1_0_0.rpy:317
translate chinese 5e4562af:

    # nyra raison "Et si on la prévient on sait très bien comment elle va finir..."
    nyra raison "可要是告诉 Kami，我们都知道她会有什么下场……"

# game/scenario/7_1_0_0.rpy:319
translate chinese 7fc94e58:

    # iris colere "Pendant que nous discutons, cette fille gèle. On a pas le temps de débattre."
    iris colere "我们每多说一句，这女孩就多冻一会儿。没时间辩论了。"

# game/scenario/7_1_0_0.rpy:341
translate chinese c00d4971:

    # noam determine "On la cache."
    noam determine "把她藏起来。"

# game/scenario/7_1_0_0.rpy:343
translate chinese f8556e0e:

    # tomas inquiet "D'accord. Enfin non, pas d'accord, mais... qu'est-ce qu'on fait ?"
    tomas inquiet "好。也不对，我一点也不好……我们现在该怎么办？"

# game/scenario/7_1_0_0.rpy:345
translate chinese 9df4e5d8:

    # iris determine "Il faut d'abord la réchauffer. Ma chambre est la plus proche et j'ai un brouilleur."
    iris determine "首先得让她暖和起来。我的房间最近，而且有干扰器。"

# game/scenario/7_1_0_0.rpy:347
translate chinese 26cf36e1:

    # nyra raison "Le problème n'est pas la destination. C'est le trajet."
    nyra raison "问题不在目的地，而在怎么把她送过去。"

# game/scenario/7_1_0_0.rpy:349
translate chinese 56a8c699:

    # noam reflechit "Les caméras couvrent le sas, le couloir et l'entrée du dortoir."
    noam reflechit "摄像机覆盖了气闸舱、走廊和宿舍入口。"

# game/scenario/7_1_0_0.rpy:351
translate chinese c1b72252:

    # tomas panne "Donc c'est impossible."
    tomas panne "所以根本不可能。"

# game/scenario/7_1_0_0.rpy:353
translate chinese cc191659:

    # nyra colere "Si tu répètes ça assez souvent, elle finira effectivement par mourir."
    nyra colere "你要是再多说几遍，她还真会死在这里。"

# game/scenario/7_1_0_0.rpy:355
translate chinese f025e046:

    # tomas inquiet "Je cherche seulement à être réaliste."
    tomas inquiet "我只是想现实一点。"

# game/scenario/7_1_0_0.rpy:357
translate chinese 863fd93d:

    # iris colere "Alors sois réaliste plus vite."
    iris colere "那就现实得快一点。"

# game/scenario/7_1_0_0.rpy:361
translate chinese 14a840a7:

    # think "Je regarde les caméras. Puis le terminal logistique fixé contre la paroi."
    think "我看向摄像机，又看向墙上的物流终端。"

