translate chinese day3_collect_vote_argument_040161a0:

    # kami "Ce serait dommage. Les chaises vides, ça déprime l'audience."
    kami "真要少一把空椅子，观众可会伤心的。"

# game/scenario/3_canon.rpy:1004
translate chinese day3_collect_vote_argument_03106f94:

    # kami "Et je vois des visages émus ! Il y a eu de la tendresse dans les couloirs, on dirait."
    kami "而且我还看到了几张感动的小脸！看来走廊里刚刚发生了点温情戏码呀。"

# game/scenario/3_canon.rpy:1005
translate chinese day3_collect_vote_argument_8d3b59dd:

    # kami "Cameraman, un gros plan sur ces petites âmes fragiles."
    kami "摄像师，来，给这些脆弱的小灵魂一个特写。"

# game/scenario/3_canon.rpy:1008
translate chinese day3_collect_vote_argument_beda0b89:

    # kami "Installez-vous. On commence dans un instant."
    kami "都坐好。马上开始。"

# game/scenario/3_canon.rpy:1015
translate chinese day3_collect_vote_argument_bf4d301e:

    # "Les portes se referment. Un déclic net résonne derrière nous."
    "门在身后关上。一声干脆的咔哒响起。"

# game/scenario/3_canon.rpy:1019
translate chinese day3_collect_vote_argument_98d1e56e:

    # think "…C'était un verrou ? Ils nous ont enfermés."
    think "……那是锁？他们把我们关起来了。"

# game/scenario/3_canon.rpy:1020
translate chinese day3_collect_vote_argument_de05fdd2:

    # think "Pas de sortie tant qu'il n'y a pas de décision. Kami veut un vote, ou un cadavre. Pas d'entre-deux."
    think "不做出决定就别想出去。Kami要么要一场投票，要么要一具尸体。没有中间选项。"

# game/scenario/3_canon.rpy:1037
translate chinese day3_collect_vote_argument_56aface1:

    # kami "Avant de débattre, encore faut-il savoir de quoi on parle."
    kami "辩论之前，总得先知道你们到底在辩什么。"

# game/scenario/3_canon.rpy:1038
translate chinese day3_collect_vote_argument_e7584a50:

    # kami "Alors soyons rigoureux. Voici le texte officiel de l'amendement."
    kami "所以严谨一点。下面是修正案的正式文本。"

# game/scenario/3_canon.rpy:1041
translate chinese day3_collect_vote_argument_16d755ec:

    # kami "Enfin… « officiel ». [codex_dialogue_link('archive', 'ARCHIVE')] l'a harmonisé avec les Commandements existants."
    kami "当然啦……所谓“正式”。[codex_dialogue_link('archive', 'ARCHIVE')]已经按照现有戒律帮你们统一过格式。"

# game/scenario/3_canon.rpy:1042
translate chinese day3_collect_vote_argument_a03aa61f:

    # kami "Vos petites phrases d'amateurs, seules, ne valent rien en droit. Il a fallu les traduire."
    kami "你们那些业余小句子，单独拿出来在法律上根本不算数。总得翻译一下嘛。"

# game/scenario/3_canon.rpy:1045
translate chinese day3_collect_vote_argument_e8142606:

    # nyra "Traduire. Ou réécrire ?"
    nyra "翻译。还是重写？"

# game/scenario/3_canon.rpy:1049
translate chinese day3_collect_vote_argument_b4699d4b:

    # kami "Réécrire est un vilain mot. Disons que j'ai rendu vos intentions… exécutables."
    kami "“重写”这个词多难听。就说我把你们的意图变得……可执行了。"

# game/scenario/3_canon.rpy:1050
translate chinese day3_collect_vote_argument_7e8907fd:

    # kami "Le texte est là. Compilé, dense, juridique. Exactement comme les lois que vous adoriez ignorer avant moi."
    kami "文本就在这里。编译过、密密麻麻、法律味十足。就跟你们以前最爱装作没看见的那些法律一模一样。"

# game/scenario/3_canon.rpy:1053
translate chinese day3_collect_vote_argument_20be108a:

    # kami "À vous de le remettre en ordre et de le lire. Vraiment le lire."
    kami "现在轮到你们把它重新拼好，再读一遍。真正地读。"

# game/scenario/3_canon.rpy:1054
translate chinese day3_collect_vote_argument_ec9f60a3:

    # kami "Le diable se cache dans les détails. Moi, je me contente de l'y ranger."
    kami "魔鬼藏在细节里。而我只负责把它好好塞进去。"

# game/scenario/3_canon.rpy:1074
translate chinese day3_collect_vote_argument_355fb5ca:

    # ryn colere "Un texte juridique compilé ?! On voulait juste autoriser le commerce !"
    ryn colere "一份编译过的法律文本？！我们只是想允许贸易而已！"

# game/scenario/3_canon.rpy:1076
translate chinese day3_collect_vote_argument_f6570784:

    # tomas hesitation "C'est… c'est exactement là qu'il faut se méfier. Un texte de loi, c'est jamais neutre."
    tomas hesitation "这、这正是最该小心的地方。法律文本从来都不是中性的。"

# game/scenario/3_canon.rpy:1077
translate chinese day3_collect_vote_argument_9b63ea82:

    # tomas raison "Chaque mot ajouté peut changer tout le sens. Faut le reconstruire proprement avant d'en juger."
    tomas raison "每多一个词，都可能改变整个意思。得先把它完整重构出来，才能判断。"

# game/scenario/3_canon.rpy:1079
translate chinese day3_collect_vote_argument_acbd809e:

    # nyra "On fait ça vite et bien. Cherchez la ponctuation et les majuscules, ça situe les fragments."
    nyra "快一点，也做准确。看标点和大写字母，它们能帮你判断片段位置。"

# game/scenario/3_canon.rpy:1080
translate chinese day3_collect_vote_argument_72f20f3c:

    # nyra "Chacun prend un morceau. Personne ne conclut avant qu'on ait la phrase entière."
    nyra "每个人拿一段。在整句话拼出来之前，谁都别先下结论。"

# game/scenario/3_canon.rpy:1082
translate chinese day3_collect_vote_argument_41aa9bca:

    # noam "D'accord. On assemble, on lit, ensuite on discute."
    noam "好。先拼起来，读完，再讨论。"

# game/scenario/3_canon.rpy:1083
translate chinese day3_collect_vote_argument_f66d0dc0:

    # noam "Et on garde les yeux ouverts sur ce qu'elle a pu glisser dedans."
    noam "还得盯紧她有没有偷偷塞东西进去。"

# game/scenario/3_canon.rpy:1112
translate chinese day3_collect_vote_argument_c141e4af:

    # lysa "« Autoriser le transport, la vente et l'échange de marchandises. »"
    lysa "“允许商品的运输、销售与交换。”"

# game/scenario/3_canon.rpy:1113
translate chinese day3_collect_vote_argument_c1366bad:

    # lysa colere "« En conséquence, le système de distribution de denrées est aboli. »"
    lysa colere "“因此，食品配给制度予以废除。”"

# game/scenario/3_canon.rpy:1115
translate chinese day3_collect_vote_argument_cab1b812:

    # elen surpris "Attendez… « aboli » ? C'était pas dans l'idée de départ, ça !"
    elen surpris "等等……“废除”？原来的提案里根本没这句！"

# game/scenario/3_canon.rpy:1117
translate chinese day3_collect_vote_argument_b8b491e5:

    # tomas "M-Maintenant, le vrai débat peut commencer. Et il est plus grave qu'on croyait."
    tomas "现、现在真正的辩论才开始。而且比我们想的严重得多。"

# game/scenario/3_canon.rpy:1144
translate chinese day3_collect_vote_argument_f38265a7:

    # mara surpris "Donc voilà le piège. Autoriser le commerce, ça supprime les rations. En un seul texte."
    mara surpris "所以陷阱在这儿。允许贸易，就等于取消配给。一份文本一次全做了。"

# game/scenario/3_canon.rpy:1146
translate chinese day3_collect_vote_argument_d85695fb:

    # noam "Du calme. On sait tous que ce n'est pas ce qui avait été proposé au départ."
    noam "冷静。我们都知道，一开始提出的并不是这个。"

# game/scenario/3_canon.rpy:1147
translate chinese day3_collect_vote_argument_ec453925:

    # noam "C'est l'habillage qu'en a fait Kami. La question, c'est : est-ce qu'on peut vivre avec ?"
    noam "这是Kami包装后的版本。真正的问题是：我们能不能接受它？"

# game/scenario/3_canon.rpy:1149
translate chinese day3_collect_vote_argument_636855d6:

    # nyra reflechit "Si on vote ce texte, demain il n'y a plus une seule distribution gratuite. Nulle part."
    nyra reflechit "如果投赞成，明天起，全世界不会再有任何免费配给。"

# game/scenario/3_canon.rpy:1151
translate chinese day3_collect_vote_argument_66a009d4:

    # kael inquiet "Supprimer les rations… ça change tout."
    kael inquiet "取消配给……那就完全不一样了。"

# game/scenario/3_canon.rpy:1153
translate chinese day3_collect_vote_argument_1ffc6070:

    # ryn colere "Ça supprime la seule sécurité qu'on avait ! À Limen, c'est ce qui tient les gens en vie."
    ryn colere "这会把我们唯一的保障也取消掉！在Limen，配给就是人们活下去的命根子。"

# game/scenario/3_canon.rpy:1155
translate chinese day3_collect_vote_argument_851e2bc3:

    # lysa reflechit "Et pourtant, c'est logique."
    lysa reflechit "但逻辑上倒说得通。"

# game/scenario/3_canon.rpy:1157
translate chinese day3_collect_vote_argument_50e41c99:

    # noam "…Comment ça ?"
    noam "……什么意思？"

# game/scenario/3_canon.rpy:1159
translate chinese day3_collect_vote_argument_d9fa808c:

    # lysa blase "On disait hier : rétablir le commerce, c'est rétablir la monnaie."
    lysa blase "我们昨天不是说过吗：恢复贸易，也就是恢复货币。"

# game/scenario/3_canon.rpy:1160
translate chinese day3_collect_vote_argument_16c03972:

    # lysa reflechit "Pour gagner de la monnaie, il faut travailler. Et pour pousser les gens à travailler…"
    lysa reflechit "要赚到钱，就得工作。要让人愿意工作……"

# game/scenario/3_canon.rpy:1161
translate chinese day3_collect_vote_argument_a3c5d7b2:

    # lysa blase "…on arrête de leur donner de quoi vivre gratuitement. Kami n'a rien inventé. Elle a juste écrit tout haut ce qu'on pensait tout bas."
    lysa blase "……就不能继续免费发活命的东西。Kami没发明什么新东西。她只是把大家心里没说出口的东西写了出来。"

# game/scenario/3_canon.rpy:1163
translate chinese day3_collect_vote_argument_9e89db84:

    # nyra reflechit "Sauf que supprimer une structure mondiale, ça ne se décide pas sur un coup de tête."
    nyra reflechit "可一个全球性的制度，不能一拍脑袋就直接取消。"

# game/scenario/3_canon.rpy:1165
translate chinese day3_collect_vote_argument_8bccfb42:

    # sael triste "Les morts de Limen n'ont pas besoin d'un nouveau responsable."
    sael triste "Limen死掉的人不需要换一个新的负责人。"

# game/scenario/3_canon.rpy:1166
translate chinese day3_collect_vote_argument_0e4e3168:

    # sael reflechit "Kami. Dis-nous seulement une chose : ce texte vient-il vraiment de l'un de nous ?"
    sael reflechit "Kami。只回答一件事：这份文本真的来自我们其中一人吗？"

# game/scenario/3_canon.rpy:1168
translate chinese day3_collect_vote_argument_5bda5e56:

    # think "Les regards se croisent. L'écran central reste figé. Kami ne répond pas."
    think "大家互相看了一眼。中央屏幕一动不动。Kami没有回答。"

# game/scenario/3_canon.rpy:1169
translate chinese day3_collect_vote_argument_61bd4090:

    # think "Le silence dure trop longtemps pour être innocent."
    think "沉默持续得太久，不可能是无辜的。"

# game/scenario/3_canon.rpy:1171
translate chinese day3_collect_vote_argument_976ecf4c:

    # lysa blase "Elle ne répondra pas. Dix votes pour douze textes, le tour de passe-passe est parfait."
    lysa blase "她不会回答。十二份文本只投十次票，这个障眼法太完美了。"

# game/scenario/3_canon.rpy:1172
translate chinese day3_collect_vote_argument_d6919757:

    # lysa colere "Elle peut ajouter, couper, tordre ce qu'elle veut. On ne le saura jamais."
    lysa colere "她可以加、删、扭曲任何内容。我们永远没法确认。"

# game/scenario/3_canon.rpy:1174
translate chinese day3_collect_vote_argument_938e9eb7:

    # ryn reflechit "Attends… tu dis quoi, là ?"
    ryn reflechit "等等……你到底在说什么？"

# game/scenario/3_canon.rpy:1176
translate chinese day3_collect_vote_argument_9901e792:

    # lysa salut "Que peut-être aucun de ces textes n'est de nous. Que la manipulation est invérifiable. Bienvenue."
    lysa salut "也许这些文本根本没有一份来自我们。也许整个操纵过程根本无法验证。欢迎来到现实。"

# game/scenario/3_canon.rpy:1178
translate chinese day3_collect_vote_argument_6d1743dc:

    # noam "Manipulation ou pas, il faudra voter. Alors autant décider en connaissance de cause."
    noam "无论有没有操纵，我们最后都得投票。那就至少先弄清楚自己在投什么。"

# game/scenario/3_canon.rpy:1179
translate chinese day3_collect_vote_argument_11812dee:

    # noam reflexion "Concentrons-nous sur ce qu'on peut vérifier : ce que ce texte fait, concrètement, à chacun de nos districts."
    noam reflexion "专注于能验证的东西：这份文本具体会对每个区域造成什么影响。"

# game/scenario/3_canon.rpy:1186
translate chinese day3_collect_vote_argument_69b27004:

    # kami "On m'informe que l'audience décroche. Trop de blabla, pas assez de sang."
    kami "有人告诉我，收视率正在掉。废话太多，血太少。"

# game/scenario/3_canon.rpy:1187
translate chinese day3_collect_vote_argument_dd8dcba6:

    # kami "Je reprends la main. À partir de maintenant, un seul parle à la fois."
    kami "我来接管。现在开始，一次只能有一个人说话。"

# game/scenario/3_canon.rpy:1189
translate chinese day3_collect_vote_argument_5c06c94f:

    # "Les pupitres se transforment. Un micro et un buzzer émergent devant chacun de nous."
    "每个人面前的台面开始变形。一个麦克风和一个蜂鸣器升了出来。"

# game/scenario/3_canon.rpy:1192
translate chinese day3_collect_vote_argument_c62ef0a6:

    # kami "Vous ne parlez que quand votre buzzer passe au vert. Vous voulez contredire ? Vous appuyez."
    kami "只有你的蜂鸣器变绿时才能说话。想反驳？按下去。"

# game/scenario/3_canon.rpy:1193
translate chinese day3_collect_vote_argument_d69b35eb:

    # kami "On appellera ça un débat. Moi, j'appelle ça du divertissement."
    kami "你们可以叫这“辩论”。我更喜欢叫它“娱乐”。"

# game/scenario/3_canon.rpy:1196
translate chinese day3_collect_vote_argument_2240534a:

    # kami "Montrez-moi qui sait viser. C'est parti."
    kami "让我看看谁最会瞄准。开始。"

# game/scenario/3_canon.rpy:1211
translate chinese day3_before_objection_protocol_minigame_c2b3caae:

    # ryn colere "On tourne en rond depuis une heure ! Pendant qu'on parle, eux, ils attendent."
    ryn colere "我们绕着同一个问题转了整整一小时！我们在这里说，他们可一直在等！"

# game/scenario/3_canon.rpy:1213
translate chinese day3_before_objection_protocol_minigame_2191ab6c:

    # think "Il a raison. Et Kami adore avoir raison à notre place."
    think "他说得没错。而Kami最喜欢替我们“说得没错”。"

# game/scenario/3_canon.rpy:1218
translate chinese day3_before_objection_protocol_minigame_5101debe:

    # kami "« Ils attendent. » Oh, Ryn. Quelle jolie transition."
    kami "“他们在等。”哦，Ryn。多漂亮的转场啊。"

# game/scenario/3_canon.rpy:1219
translate chinese day3_before_objection_protocol_minigame_27a655fc:

    # kami "Justement. J'ai pensé que vous débattiez un peu trop dans le vide."
    kami "正好。我也觉得你们有点太像在对着空气辩论了。"

# game/scenario/3_canon.rpy:1220
translate chinese day3_before_objection_protocol_minigame_064f17fd:

    # kami "Alors regardez. En direct. Ce n'est pas une rediffusion."
    kami "所以看看吧。直播。不是重播。"

# game/scenario/3_canon.rpy:1223
translate chinese day3_before_objection_protocol_minigame_95297f00:

    # "Les écrans du Conclave basculent sur un plan de Limen. Une file devant un centre de distribution. Des gens qui poussent. Des cartons vides."
    "议事厅的屏幕切到Limen。一家配给中心前排着长队。有人推搡，纸箱已经空了。"

# game/scenario/3_canon.rpy:1226
translate chinese day3_before_objection_protocol_minigame_e804d823:

    # kami "Vos districts vous écoutent depuis ce matin. Ils savent qu'aujourd'hui, vous touchez aux rations."
    kami "你们的区域从早上起就一直在听。大家都知道，你们今天正在碰配给制度。"

# game/scenario/3_canon.rpy:1227
translate chinese day3_before_objection_protocol_minigame_d1f495e5:

    # kami "Alors certains ont commencé à faire des réserves. À se battre pour un carton. Par anticipation."
    kami "所以有些人已经开始囤东西。为了一个纸箱大打出手。只是提前预防而已。"

# game/scenario/3_canon.rpy:1230
translate chinese day3_before_objection_protocol_minigame_11d26095:

    # ryn "Ce sont… ce sont des gens de chez moi."
    ryn "那是……那是我那里的人。"

# game/scenario/3_canon.rpy:1234
translate chinese day3_before_objection_protocol_minigame_59038473:

    # kami "Douze mille trois cent quarante et un."
    kami "一万二千三百四十一。"

# game/scenario/3_canon.rpy:1235
translate chinese day3_before_objection_protocol_minigame_3e5c5534:

    # kami "C'est le nombre de foyers de Limen sans ration complète à cette heure précise. Le chiffre monte pendant que vous hésitez."
    kami "这是此时此刻Limen没有拿到完整配给的家庭数量。你们每犹豫一分钟，这个数字都在往上爬。"

# game/scenario/3_canon.rpy:1238
translate chinese day3_before_objection_protocol_minigame_dcf7dd29:

    # kami "Alors dépêchez-vous de décider. Ils comptent sur vous."
    kami "所以赶紧决定吧。他们可都指望你们。"

# game/scenario/3_canon.rpy:1239
translate chinese day3_before_objection_protocol_minigame_98b9f563:

    # kami "Enfin… sur l'un de vous. Il en suffit d'un pour tout faire capoter, souvenez-vous."
    kami "或者说……指望你们当中的某一个。别忘了，只要一个人，就能把一切搞砸。"

# game/scenario/3_canon.rpy:1258
translate chinese day3_before_objection_protocol_minigame_5f9fa0ce:

    # ryn triste "Elle nous met le couteau sous la gorge avec des vrais visages."
    ryn triste "她拿真实的人脸架在我们脖子上逼我们选。"

# game/scenario/3_canon.rpy:1260
translate chinese day3_before_objection_protocol_minigame_6c2d26fa:

    # elen inquiet "Mais… du coup, c'est pire de ne rien faire, non ? Ils souffrent déjà."
    elen inquiet "可是……那这样什么都不做不是更糟吗？他们现在就已经在受苦。"

# game/scenario/3_canon.rpy:1262
translate chinese day3_before_objection_protocol_minigame_76890bc4:

    # mara colere "Ou alors c'est exactement ce qu'elle veut qu'on pense. Paniquer, voter vite, se planter."
    mara colere "或者这正是她想让我们这么想。慌起来，赶紧投，然后选错。"

# game/scenario/3_canon.rpy:1264
translate chinese day3_before_objection_protocol_minigame_ae7c4b2c:

    # noam reflexion "Elle nous montre le prix de l'attente. Pas celui de l'erreur. Ne la laissons pas choisir pour nous."
    noam reflexion "她只让我们看见等待的代价，却不让我们看见犯错的代价。别让她替我们选。"

# game/scenario/3_canon.rpy:1265
translate chinese day3_before_objection_protocol_minigame_5704ede8:

    # noam "On garde la tête froide. On finit ce qu'on a commencé, mais on le finit lucides."
    noam "保持冷静。把已经开始的事情做完，但要清醒地做完。"

# game/scenario/3_canon.rpy:1360
translate chinese day3_choose_debate_argument_64fa398c:

    # noam "[selected_argument_noam_line]"
    noam "[selected_argument_noam_line]"

# game/scenario/3_canon.rpy:1515
translate chinese day3_choose_debate_argument_7fb83f71:

    # noam "Bon. On a le vrai texte, on a le chiffre de Kami. Il nous reste à décider avec la tête, pas avec la peur."
    noam "好。我们有真正的文本，也有Kami给出的数字。现在该用脑子做决定，而不是用恐惧。"

# game/scenario/3_canon.rpy:1517
translate chinese day3_choose_debate_argument_ca2f0c1d:

    # julian "La tête ? On est en train de crever à petit feu, Noam."
    julian "用脑子？Noam，我们现在是在慢慢等死。"

# game/scenario/3_canon.rpy:1518
translate chinese day3_choose_debate_argument_5ff84e73:

    # julian "Le statu quo, c'est une tombe collective avec des bons de pain rassi. Tu appelles ça la sécurité ?"
    julian "现状就是一座集体坟墓，只不过每个人手里还捏着几张换发霉面包的票。你管这叫安全？"

# game/scenario/3_canon.rpy:1520
translate chinese day3_choose_debate_argument_363fb5c3:

    # ryn colere "Et ton grand soir, c'est quoi ? On sacrifie Limen pour que Nexus se paie du luxe ?"
    ryn colere "那你的“伟大新世界”是什么？牺牲Limen，好让Nexus继续买奢侈品？"

# game/scenario/3_canon.rpy:1522
translate chinese day3_choose_debate_argument_df20c570:

    # julian surpris "Nexus ? Je te rappelle que j'en viens, de Nexus. Et je ne roule pas sur l'or, figure-toi."
    julian surpris "Nexus？提醒你一句，我就是Nexus来的。而且我可没富得流油。"

# game/scenario/3_canon.rpy:1524
translate chinese day3_choose_debate_argument_52c27a02:

    # ryn "…Ouais. Bref. Ça change rien au fond !"
    ryn "……行。反正本质没变！"

# game/scenario/3_canon.rpy:1526
translate chinese day3_choose_debate_argument_d8b31950:

    # mara colere "Ryn. Respire. On avance mieux sans hurler."
    mara colere "Ryn。呼吸。少吼两句，我们反而能往前走。"

# game/scenario/3_canon.rpy:1528
translate chinese day3_choose_debate_argument_6aee5fff:

    # elen joie "Mais c'est ça qui est beau ! Choisir ce qu'on mange sans demander la permission !"
    elen joie "可这才是最美的地方啊！想吃什么就能自己选，不用先申请许可！"

# game/scenario/3_canon.rpy:1531
translate chinese day3_choose_debate_argument_2da2048a:

    # lysa raison "Pour choisir, il faut de l'argent, Elen. Midas transformait tout en or, et il est quand même mort de faim."
    lysa raison "想选东西，得先有钱，Elen。迈达斯把一切都变成了金子，最后照样饿死。"

# game/scenario/3_canon.rpy:1533
translate chinese day3_choose_debate_argument_04edcae1:

    # tomas "Euh… il faut dire que la production mondiale s'est effondrée depuis Kami."
    tomas "呃……得承认，Kami出现以后，全球产量确实崩得很厉害。"

# game/scenario/3_canon.rpy:1534
translate chinese day3_choose_debate_argument_5568282e:

    # tomas "On fabrique presque quatre fois moins qu'avant. C'est… c'est pas rien."
    tomas "现在的产量差不多只有以前的四分之一。这个……真的不算小事。"

# game/scenario/3_canon.rpy:1536
translate chinese day3_choose_debate_argument_861d8301:

    # nyra "Rien d'étonnant. Sans récompense, personne ne se donne la peine de produire."
    nyra "也不奇怪。没有回报，谁还愿意费劲生产。"

# game/scenario/3_canon.rpy:1541
translate chinese day3_choose_debate_argument_6f174663:

    # kami "Voilà. Enfin une vraie question sous le vernis."
    kami "很好。终于有人把真正的问题从表面底下挖出来了。"

# game/scenario/3_canon.rpy:1542
translate chinese day3_choose_debate_argument_260616fb:

    # kami "Je vous rappelle que ce texte est né de VOTRE imagination. Ne me regardez pas comme la coupable."
    kami "提醒一下，这份文本可是从你们自己的想象里诞生的。别一副我是罪魁祸首的样子看我。"

# game/scenario/3_canon.rpy:1543
translate chinese day3_choose_debate_argument_72d1dd0f:

    # kami "Continuez. Vous êtes bien plus intéressants quand vous avez peur."
    kami "继续。你们害怕的时候，可比平时有意思多了。"

# game/scenario/3_canon.rpy:1555
translate chinese day3_choose_debate_argument_b39ab71f:

    # elias "Le vrai problème, c'est qu'on évite la vraie question. Le système actuel, il marche pas. Point."
    elias "真正的问题是，我们一直在绕开真正的问题。现在这套制度根本不行。就这么简单。"

# game/scenario/3_canon.rpy:1557
translate chinese day3_choose_debate_argument_49117aef:

    # sael "…Vous dépendez trop de ce système."
    sael "……你们太依赖这个制度了。"

# game/scenario/3_canon.rpy:1558
translate chinese day3_choose_debate_argument_563cc88f:

    # sael colere "Les gens ne veulent plus travailler, plus faire d'effort, mais ils veulent être libres."
    sael colere "人们不想工作，不想付出，却又想要自由。"

# game/scenario/3_canon.rpy:1559
translate chinese day3_choose_debate_argument_afa9cad5:

    # sael colere "Il va falloir choisir. Entre la liberté et la sécurité. On ne peut pas garder les deux entières."
    sael colere "那就必须选。自由和安全之间，总得舍掉一点。两样都完整保住，不可能。"

# game/scenario/3_canon.rpy:1561
translate chinese day3_choose_debate_argument_995bdcab:

    # lysa blase "Même en votant pour, il reste un trou béant dans le texte."
    lysa blase "就算投赞成，文本里还是有个巨大的洞。"

# game/scenario/3_canon.rpy:1562
translate chinese day3_choose_debate_argument_9008efb7:

    # lysa reflechit "Avec quoi les gens gagnent leur premier argent ? Si personne n'a rien, personne ne peut rien acheter à personne."
    lysa reflechit "大家第一笔钱怎么来？如果所有人一开始都什么都没有，就没人能从别人那里买任何东西。"

# game/scenario/3_canon.rpy:1564
translate chinese day3_choose_debate_argument_a6c44033:

    # noam "Elle a raison. C'est le point noir de toute la proposition."
    noam "她说得对。这是整个提案最大的问题。"

# game/scenario/3_canon.rpy:1565
translate chinese day3_choose_debate_argument_3dc1747d:

    # noam "Kami. Tu peux nous éclairer, ou tu comptes rester muette encore une heure ?"
    noam "Kami。你能解释一下，还是打算再沉默一个小时？"

# game/scenario/3_canon.rpy:1569
translate chinese day3_choose_debate_argument_68afe41a:

    # kami "Oh. Une question pratique ? On progresse."
    kami "哦。终于有个实际问题了。进步。"

# game/scenario/3_canon.rpy:1572
translate chinese day3_choose_debate_argument_0f7a2fa2:

    # kami "Si ce texte passe, j'ouvrirai des contrats de travail rémunérés. Des tâches assignées, des objectifs, un salaire à la clé."
    kami "如果文本通过，我会开放带薪工作合同。分配任务、设定目标，完成后拿工资。"

# game/scenario/3_canon.rpy:1573
translate chinese day3_choose_debate_argument_6d682ad1:

    # kami "Vous fabriquez, vous récoltez, vous livrez. Vous êtes payés. Simple."
    kami "你们生产、采集、配送，然后拿钱。简单。"

# game/scenario/3_canon.rpy:1576
translate chinese day3_choose_debate_argument_df587286:

    # kami "Libre à vous de travailler. Ou pas. Mais ne comptez plus sur la générosité des rations."
    kami "工不工作随你们。但以后别再指望配给制度的“慷慨”了。"

# game/scenario/3_canon.rpy:1577
translate chinese day3_choose_debate_argument_93f2393a:

    # kami "La faim est une motivation remarquablement efficace. Je l'ai observé sur vous mille fois."
    kami "饥饿可是非常高效的动力。我已经在你们身上观察过上千次了。"

# game/scenario/3_canon.rpy:1596
translate chinese day3_choose_debate_argument_4568b126:

    # lysa reflechit "Un système de contrats. C'est… viable. Au moins pour amorcer l'économie."
    lysa reflechit "合同制……这个方案能运转。至少足够让经济先启动起来。"

# game/scenario/3_canon.rpy:1598
translate chinese day3_choose_debate_argument_5f42e796:

    # nyra reflechit "Et avec le commerce, des structures plus grosses finiront par émerger. Des entreprises. Un vrai tissu."
    nyra reflechit "有了贸易，更大的组织迟早会出现。企业。真正的经济网络。"

# game/scenario/3_canon.rpy:1600
translate chinese day3_choose_debate_argument_214f9b4a:

    # ryn reflechit "Ouais, sur le papier. Mais qui décide des contrats ? Elle. Toujours elle."
    ryn reflechit "纸面上是这样。可谁来决定合同？还是她。永远是她。"

# game/scenario/3_canon.rpy:1614
translate chinese day3_choose_debate_argument_1675cbdb:

    # noam "Bon. Je crois qu'on a fait le tour."
    noam "好。我觉得差不多都讨论到了。"

# game/scenario/3_canon.rpy:1615
translate chinese day3_choose_debate_argument_19033264:

    # noam "Le monde d'avant, le texte brut, les trocs qui existent déjà, les contrats de Kami…"
    noam "旧世界、原始文本、已经存在的以物易物、Kami的合同……"

# game/scenario/3_canon.rpy:1616
translate chinese day3_choose_debate_argument_1123ecdf:

    # noam "On sait tout ce qu'on peut savoir. Le reste, c'est un pari."
    noam "能知道的我们都知道了。剩下的，就是赌。"

# game/scenario/3_canon.rpy:1619
translate chinese day3_choose_debate_argument_64b589f7:

    # think "Je regarde autour de la table. Les visages se sont figés. Chacun a choisi. Ou presque."
    think "我扫了一圈桌边的脸。所有人的表情都已经定下来。每个人都做出了选择。或者差不多。"

# game/scenario/3_canon.rpy:1620
translate chinese day3_choose_debate_argument_a3a2b2bf:

    # think "Presque."
    think "差不多。"

# game/scenario/3_canon.rpy:1628
translate chinese day3_choose_debate_argument_62ea799d:

    # noam "Il ne manque plus que… vous deux. Ceux de qui tout dépend."
    noam "现在只剩……你们两个。最后就看你们了。"

# game/scenario/3_canon.rpy:1630
translate chinese day3_choose_debate_argument_30434ab6:

    # ryn triste "…Moi, je sais. Que je le veuille ou non. Limen, c'est écrit là. Alors je porterai mon choix."
    ryn triste "……我已经知道了。不管我愿不愿意。Limen的答案就写在那儿。所以我会承担自己的选择。"

# game/scenario/3_canon.rpy:1632
translate chinese day3_choose_debate_argument_54d278f7:

    # think "Reste Kael. Celui qui déciderait « au moment de voter ». Le moment, c'est maintenant."
    think "只剩Kael。那个说要“到投票时再决定”的人。现在，就是投票时。"

# game/scenario/3_canon.rpy:1634
translate chinese day3_choose_debate_argument_fa6327d2:

    # kael inquiet "Je…"
    kael inquiet "我……"

# game/scenario/3_canon.rpy:1636
translate chinese day3_choose_debate_argument_0120770f:

    # kael triste "Sur Orbite, une erreur ne pardonne pas. Et là, je n'arrive pas à voir si on ouvre une porte…"
    kael triste "在Orbite，一次错误就可能要命。可现在我看不出来，我们是在打开一扇门……"

# game/scenario/3_canon.rpy:1637
translate chinese day3_choose_debate_argument_871185d6:

    # kael peur "…ou si on retire le dernier filet sous nos pieds."
    kael peur "……还是在把脚下最后一张安全网撤掉。"

# game/scenario/3_canon.rpy:1639
translate chinese day3_choose_debate_argument_ca6b3230:

    # noam "Kael. Regarde-moi. Pour ou contre ?"
    noam "Kael。看着我。赞成还是反对？"

# game/scenario/3_canon.rpy:1641
translate chinese day3_choose_debate_argument_8e97ba8d:

    # think "Il ouvre la bouche."
    think "他张开嘴。"

# game/scenario/3_canon.rpy:1646
translate chinese day3_choose_debate_argument_7658ed14:

    # kami "STOP !"
    kami "停——！"

# game/scenario/3_canon.rpy:1647
translate chinese day3_choose_debate_argument_4763d4d4:

    # kami "Non, non, non. Ne me gâchez pas le suspense en le disant tout haut."
    kami "不不不。别把悬念这么早说破。"

# game/scenario/3_canon.rpy:1648
translate chinese day3_choose_debate_argument_a01a8ac2:

    # kami "L'audimat est à son sommet. Un cœur qui hésite en direct, ça n'a pas de prix."
    kami "现在收视率正到顶峰。直播一个犹豫的心，可是无价之宝。"

# game/scenario/3_canon.rpy:1651
translate chinese day3_choose_debate_argument_8ad8206b:

    # kami "Vous garderez vos réponses pour le bulletin. C'est plus honnête. Et tellement plus cruel."
    kami "把答案留到投票里吧。这样更诚实。也更残忍。"

# game/scenario/3_canon.rpy:1652
translate chinese day3_choose_debate_argument_e3d384e7:

    # kami "Rappel des règles : il suffit d'un « contre ». Un seul. Et tout s'effondre."
    kami "再提醒一次规则：只要一个“反对”。一个。然后一切都没了。"

# game/scenario/3_canon.rpy:1655
translate chinese day3_choose_debate_argument_b6707dd6:

    # kami "Alors… on vote. Maintenant. POUR, ou CONTRE."
    kami "所以……投票。现在。赞成，或者反对。"

# game/scenario/3_canon.rpy:1656
translate chinese day3_choose_debate_argument_801fd906:

    # kami "Je meurs d'envie de compter."
    kami "我已经迫不及待要数票了。"

# game/scenario/3_canon.rpy:1682
translate chinese day3_choose_debate_argument_3e809022:

    # noam "Même avec les bons, les rayons sont vides. On distribue des droits sur des étagères qui n'existent pas."
    noam "就算有票券，货架也是空的。我们发的是一张张通往不存在货架的权利。"

# game/scenario/3_canon.rpy:1684
translate chinese day3_choose_debate_argument_2a497220:

    # elias determine "Ça, c'est la vérité vraie. Un bon pour du riz, et pas de riz au bout. On appelle ça la sécurité ?"
    elias determine "这才是真话。一张换米的票，结果根本没有米。你管这叫安全？"

# game/scenario/3_canon.rpy:1686
translate chinese day3_choose_debate_argument_cd55aae6:

    # julian sourire "Le commerce remplit les rayons. Un producteur qui peut vendre produit davantage. C'est mécanique."
    julian sourire "贸易会把货架填满。能卖出去的生产者，自然就会多生产。这是机械规律。"

# game/scenario/3_canon.rpy:1688
translate chinese day3_choose_debate_argument_c64c045b:

    # mara doute "Ou alors les rayons se remplissent là où il y a de l'argent. Et Limen regarde par la fenêtre."
    mara doute "或者只是有钱的地方货架会被填满。然后Limen站在窗外看。"

# game/scenario/3_canon.rpy:1690
translate chinese day3_choose_debate_argument_e49c5703:

    # ryn colere "Voilà ! Nexus déborde, nous on ramasse les miettes. Comme aujourd'hui, mais en pire."
    ryn colere "就是！Nexus堆得满满当当，我们只能捡碎屑。和现在一样，只会更糟。"

# game/scenario/3_canon.rpy:1692
translate chinese day3_choose_debate_argument_156cab59:

    # kael reflechit "…Sauf que Limen est le plus peuplé. La demande y sera énorme. Un marché suit la demande, non ?"
    kael reflechit "……可Limen人口最多。需求也会最大。市场不是会跟着需求走吗？"

# game/scenario/3_canon.rpy:1694
translate chinese day3_choose_debate_argument_2faecf5b:

    # ryn reflechit "…Mouais. Peut-être. Si on a de quoi payer, déjà."
    ryn reflechit "……也许吧。前提是我们得先有钱付。"

# game/scenario/3_canon.rpy:1696
translate chinese day3_choose_debate_argument_fc0aa1ab:

    # sael neutre "Chez nous, on fabrique ce qu'il nous faut. Le manque, on le connaît. On lui survit."
    sael neutre "我们那里一直都是自己做需要的东西。匮乏，我们很熟。也一直活过来了。"

# game/scenario/3_canon.rpy:1698
translate chinese day3_choose_debate_argument_02ad06b3:

    # elen joie "Et avec les échanges, on n'aura plus à seulement survivre. On pourra vivre !"
    elen joie "有了交换，我们就不用只求活下去。我们可以真正生活！"

# game/scenario/3_canon.rpy:1714
translate chinese day3_choose_debate_argument_4221b42d:

    # noam "On répète que les bons donnent droit à tout. En vrai, ils donnent droit à quoi ?"
    noam "大家总说票券能换到一切。可实际上，它到底能换到什么？"

# game/scenario/3_canon.rpy:1716
translate chinese day3_choose_debate_argument_b6b988be:

    # tomas raison "Euh… 62 %% des références listées sont en rupture permanente en périphérie. C'est… c'est pas rien."
    tomas raison "呃……外围地区列出的物资里，有62 %%长期处于断货状态。这个……真的很严重。"

# game/scenario/3_canon.rpy:1718
translate chinese day3_choose_debate_argument_b1e9b988:

    # iris colere "Un bon, c'est un ticket pour faire la queue. Point. Le produit correct part en deux jours."
    iris colere "一张票券，就是一张排队券。就这样。真正像样的东西，两天内就没了。"

# game/scenario/3_canon.rpy:1720
translate chinese day3_choose_debate_argument_a1f82ac1:

    # ryn colere "À Limen, on a des bons pour du lait qui arrive caillé. Des médocs périmés avant même la livraison."
    ryn colere "在Limen，我们拿着牛奶票，最后收到的是已经坏掉的牛奶。药还没送到，就已经过期。"

# game/scenario/3_canon.rpy:1721
translate chinese day3_choose_debate_argument_116f53c8:

    # ryn triste "Ça, c'est votre « sécurité » ? Un papier qui promet ce qui n'arrive jamais ?"
    ryn triste "这就是你们所谓的“安全”？一张承诺有东西、最后什么都拿不到的纸？"

# game/scenario/3_canon.rpy:1723
translate chinese day3_choose_debate_argument_57c9a789:

    # mara reflexion "…D'accord. Là, tu marques un point. Défendre ce système-là, c'est défendre du vide."
    mara reflexion "……好吧。这点你说得对。替这种制度辩护，确实是在替空壳辩护。"

# game/scenario/3_canon.rpy:1725
translate chinese day3_choose_debate_argument_67c83c04:

    # elias determine "Le même ticket pour rien, qu'on se crève au boulot ou qu'on dorme toute la journée. Faut que ça change."
    elias determine "干活干到累死也好，睡一整天也好，拿到的都是同一张什么都换不到的票。必须改变。"

# game/scenario/3_canon.rpy:1727
translate chinese day3_choose_debate_argument_2b36ccd9:

    # elen joie "Plus de fournisseurs, plus de concurrence, plus de choix. On mérite mieux qu'un ticket vide !"
    elen joie "更多供应商、更多竞争、更多选择。我们值得的不该只是一张空票！"

# game/scenario/3_canon.rpy:1744
translate chinese day3_choose_debate_argument_41222181:

    # nyra raison "Vous parlez de Limen. Mais que savez-vous du prix d'une erreur sur Orbite ?"
    nyra raison "你们一直在说Limen。可你们知道Orbite一次错误的代价吗？"

# game/scenario/3_canon.rpy:1746
translate chinese day3_choose_debate_argument_49fc62ec:

    # kael mefiant "Un écart de flux. Un module dépressurisé. Là-haut, une erreur logistique, ça tue en silence."
    kael mefiant "一次流量偏差。一个舱段失压。上面那里，物流出错，是会悄无声息死人的。"

# game/scenario/3_canon.rpy:1747
translate chinese day3_choose_debate_argument_9d3128e0:

    # kael triste "On ne peut pas se permettre l'imprévu. Jamais."
    kael triste "我们承受不起意外。一次都不行。"

# game/scenario/3_canon.rpy:1749
translate chinese day3_choose_debate_argument_a8b2e40a:

    # noam "Et le commerce, c'est de l'imprévu par définition."
    noam "而贸易，本质上就是不可预测。"

# game/scenario/3_canon.rpy:1751
translate chinese day3_choose_debate_argument_4da38469:

    # iris inquiet "…Ok. Là, même moi je tique. On met des vies en balance contre des étals mieux garnis ?"
    iris inquiet "……行。这次连我都得犹豫。我们真的要拿人命去换货架更充足？"

# game/scenario/3_canon.rpy:1753
translate chinese day3_choose_debate_argument_f015915d:

    # tomas raison "P-Paradoxalement, c'est sur Orbite qu'il y a le moins de morts par an. Le carcan actuel les protège."
    tomas raison "讽、讽刺的是，Orbite每年的死亡人数反而最低。现有的严密制度确实保护了他们。"

# game/scenario/3_canon.rpy:1755
translate chinese day3_choose_debate_argument_2b6854f8:

    # julian hesitation "On n'interdit rien de plus, pourtant… Enfin. Je vois l'idée. Mais je vois aussi le vide sous nos pieds."
    julian hesitation "可我们也没有额外禁止什么……呃。我明白你的意思。但我也看得见脚下那个洞。"

# game/scenario/3_canon.rpy:1757
translate chinese day3_choose_debate_argument_59a9327b:

    # lysa blase "Un grain de sable dans un système sous pression, et tout saute. Kael et Nyra le savent mieux que nous."
    lysa blase "一个高压系统里掉进一粒沙子，整个东西都可能炸掉。Kael和Nyra比我们谁都懂。"

# game/scenario/3_canon.rpy:1759
translate chinese day3_choose_debate_argument_a69d23eb:

    # nyra stress "Sur Orbite, la perte de contrôle se paie dans la seconde. Pas au prochain vote."
    nyra stress "在Orbite，失控的代价是立刻支付。不是等到下次投票。"

# game/scenario/3_canon.rpy:1761
translate chinese day3_choose_debate_argument_8ff9f46f:

    # mara stress "…Super. Donc en votant pour, on joue avec la vie de gens qu'on ne verra jamais."
    mara stress "……太好了。所以投赞成，就等于拿我们永远见不到的人的命去赌。"

# game/scenario/3_canon.rpy:1763
translate chinese day3_choose_debate_argument_11782fbf:

    # think "Nyra et Kael échangent un regard bref, tendu. Personne n'insiste."
    think "Nyra和Kael短暂地对视了一眼，紧张得像一根绷紧的线。没人继续逼问。"

# game/scenario/3_canon.rpy:1786
translate chinese day3_choose_debate_argument_0e0b9278:

    # iris reflechit "Le monde d'avant… vous en parlez comme d'un paradis perdu. Moi, je me souviens des files et des prix qui doublaient sans raison."
    iris reflechit "你们说起旧世界，好像那是失落的天堂。我记得的却是排队，还有毫无理由突然翻倍的价格。"

# game/scenario/3_canon.rpy:1787
translate chinese day3_choose_debate_argument_e307b7c7:

    # iris reflechit "…Mais au moins, ça bougeait. On pouvait râler ET agir. Aujourd'hui, on ne fait plus que râler."
    iris reflechit "……但至少那时候事情还会动。我们可以抱怨，也可以行动。现在只剩抱怨。"

# game/scenario/3_canon.rpy:1789
translate chinese day3_choose_debate_argument_97831756:

    # elen joie "Voilà ! Tu bossais, tu achetais. Personne pour juger si tes chaussures étaient assez trouées."
    elen joie "对啊！你工作，然后你买东西。没人来判断你的鞋是不是破得“够严重”。"

# game/scenario/3_canon.rpy:1791
translate chinese day3_choose_debate_argument_6b8b216c:

    # julian sourire "Ce monde n'était pas parfait. Il était vivant. Je préfère le mouvement à une égalité dans l'attente."
    julian sourire "那个世界不完美。但它是活的。比起所有人一起平等地等待，我更喜欢它在流动。"

# game/scenario/3_canon.rpy:1793
translate chinese day3_choose_debate_argument_109b34e2:

    # mara reflexion "« Choisir »… c'est un joli mot, Elen."
    mara reflexion "“选择”……这词真好听，Elen。"

# game/scenario/3_canon.rpy:1794
translate chinese day3_choose_debate_argument_447c350f:

    # mara reflexion "Moi, je me souviens surtout des sourires obligatoires. Des portes qui se ferment si tu n'es pas… parfaite."
    mara reflexion "我更记得那些被迫挂在脸上的笑。还有当你不够……完美时，一扇扇关上的门。"

# game/scenario/3_canon.rpy:1795
translate chinese day3_choose_debate_argument_cb2e0377:

    # mara triste "La liberté d'avant, certains l'ont payée très cher. J'en fais partie."
    mara triste "以前的自由，有些人付过很高的代价。我就是其中之一。"

# game/scenario/3_canon.rpy:1797
translate chinese day3_choose_debate_argument_042c178b:

    # tomas raison "Faut dire… ce qui pourrissait tout, avant, c'était la guerre. Elle est interdite maintenant. Techniquement, ça pourrait mieux tourner."
    tomas raison "也得说……以前真正把一切拖烂的是战争。现在战争被禁止了。理论上，这套东西也许反而能运转得更好。"

# game/scenario/3_canon.rpy:1799
translate chinese day3_choose_debate_argument_ca58ec19:

    # ryn colere "« Techniquement ». Dis ça aux gamins de Limen qui bouffaient les restes des riches."
    ryn colere "“理论上”。你去跟Limen那些吃富人剩饭的小孩说这三个字。"

# game/scenario/3_canon.rpy:1801
translate chinese day3_choose_debate_argument_67047c5d:

    # noam "Le monde d'avant offrait la liberté à ceux qui avaient déjà les moyens. Aux autres, la loi de la jungle."
    noam "旧世界给了本来就有资本的人自由。剩下的人，面对的是丛林法则。"

# game/scenario/3_canon.rpy:1803
translate chinese day3_choose_debate_argument_1562d113:

    # elen joie "Alors gardons le meilleur ! L'essentiel pour tous, la liberté pour le reste. Comme avant, mais sans la guerre !"
    elen joie "那就保留最好的一部分！所有人都有基本保障，其他部分保留自由。像以前一样，但没有战争！"

# game/scenario/3_canon.rpy:1805
translate chinese day3_choose_debate_argument_57d3573f:

    # think "Mara détourne le regard, comme si elle regrettait déjà d'avoir livré quelque chose de vrai."
    think "Mara移开目光，像是已经后悔刚刚说出了某件太真实的事。"

# game/scenario/3_canon.rpy:1821
translate chinese day3_choose_debate_argument_2c724556:

    # ryn colere "Lisez le texte, bon sang ! « Suppression des bons. Fin de la distribution. » Point."
    ryn colere "看清文本，行不行！“取消票券。终止配给。”句号。"

# game/scenario/3_canon.rpy:1822
translate chinese day3_choose_debate_argument_f5337392:

    # ryn colere "Pas de « minimum vital ». Pas de « transition ». Rien."
    ryn colere "没有“最低保障”。没有“过渡期”。什么都没有。"

# game/scenario/3_canon.rpy:1824
translate chinese day3_choose_debate_argument_6298c1ec:

    # elias determine "C'est ça qui libère ! Plus de bons, plus de laisse. On produit, on échange, on vit."
    elias determine "这才叫解放！没有票券，没有牵绳。我们生产，我们交换，我们生活。"

# game/scenario/3_canon.rpy:1826
translate chinese day3_choose_debate_argument_995e3d2c:

    # noam "Le texte est binaire. Pour : suppression totale, tout de suite. Contre : rien ne change. Aucun entre-deux."
    noam "文本就是二选一。赞成：立刻彻底取消。反对：什么都不变。没有中间方案。"

# game/scenario/3_canon.rpy:1828
translate chinese day3_choose_debate_argument_e47e6759:

    # kael triste "Aucune transition. On saute sans corde. Sur Orbite, ça, c'est un arrêt de mort."
    kael triste "没有过渡。就是直接跳下去，连绳子都没有。在Orbite，这就是死刑。"

# game/scenario/3_canon.rpy:1830
translate chinese day3_choose_debate_argument_fc6e52cb:

    # lysa blase "« Suppression » veut dire suppression. Pas « réduction ». Icare aussi croyait pouvoir négocier avec la gravité."
    lysa blase "“取消”就是取消。不是“减少”。伊卡洛斯当年大概也以为自己能跟重力讨价还价。"

# game/scenario/3_canon.rpy:1832
translate chinese day3_choose_debate_argument_f346a7f0:

    # ryn colere "Sans bons, à Limen, on meurt en silence pendant que vous « produisez » vos rêves."
    ryn colere "没了票券，Limen的人会在你们“生产梦想”的时候悄无声息地死掉。"

# game/scenario/3_canon.rpy:1833
translate chinese day3_choose_debate_argument_c4fb6991:

    # ryn colere "Le texte condamne les faibles. C'est écrit noir sur blanc !"
    ryn colere "这份文本就是在判弱者死刑。白纸黑字写着！"

# game/scenario/3_canon.rpy:1835
translate chinese day3_choose_debate_argument_147861e7:

    # mara stress "…Et il l'écrit noir sur blanc. On ne pourra pas dire qu'on ne savait pas."
    mara stress "……而且确实写得明明白白。以后我们不能说自己不知道。"

# game/scenario/3_canon.rpy:1837
translate chinese day3_choose_debate_argument_a6559878:

    # sael determine "Les Limenois échangent déjà pour survivre. Ce texte ne les condamne pas. Il les libère du mensonge."
    sael determine "Limen的人本来就在靠交换活命。这份文本不是判他们死，而是让他们不用再活在谎言里。"

# game/scenario/3_canon.rpy:1839
translate chinese day3_choose_debate_argument_1e4f88d1:

    # think "Ryn frappe du poing. Sael ne cille pas."
    think "Ryn一拳砸在桌上。Sael连眼都没眨。"

# game/scenario/3_canon.rpy:1855
translate chinese day3_choose_debate_argument_10ca5a83:

    # ryn surpris "Attends… tu dis que ça se fait déjà ? Des trocs en douce, à Limen ?"
    ryn surpris "等等……你是说Limen本来就一直有人偷偷以物易物？"

# game/scenario/3_canon.rpy:1857
translate chinese day3_choose_debate_argument_773040d8:

    # sael reflechit "Depuis toujours. Un sac contre une réparation. Un service contre du tissu. Ça tient les gens debout entre deux rations."
    sael reflechit "一直都有。一袋东西换一次维修，一次帮忙换一块布。两次配给之间，就是这些交换把人撑住。"

# game/scenario/3_canon.rpy:1859
translate chinese day3_choose_debate_argument_5e76631f:

    # noam "Ça marche en petit. Mais à grande échelle, officiel : est-ce que ça reste sous contrôle ?"
    noam "小范围能运转。可一旦正式扩大到整个社会，还能控制得住吗？"

# game/scenario/3_canon.rpy:1861
translate chinese day3_choose_debate_argument_88d79c68:

    # kael doute "…Si ça existe déjà sans provoquer le chaos, alors peut-être que sur Orbite aussi, ça pourrait tenir."
    kael doute "……既然它已经存在，而且没有把一切弄成混乱，那Orbite也许……也能撑得住。"

# game/scenario/3_canon.rpy:1863
translate chinese day3_choose_debate_argument_33cdd537:

    # julian sourire "Exactement ! Les gens s'organisent déjà. Supprimer les bons, c'est cesser de nier ce qu'ils font en cachette."
    julian sourire "没错！人们本来就在自己组织。取消票券，不过是停止假装这些秘密交换不存在。"

# game/scenario/3_canon.rpy:1865
translate chinese day3_choose_debate_argument_7ffa2e92:

    # lysa blase "S'organiser… ou couronner des petits rois. Les marchés noirs finissent toujours par sacrer quelqu'un."
    lysa blase "组织起来……或者给几个小国王加冕。黑市最后总会让某个人坐上王位。"

# game/scenario/3_canon.rpy:1867
translate chinese day3_choose_debate_argument_3ede299a:

    # ryn reflechit "…Mais si c'est déjà là, et que ça sauve des familles… alors on pourrait faire pareil. En mieux. Sans crever en attendant Kami."
    ryn reflechit "……可既然它已经存在，而且确实救了家庭，那我们也许可以做得更好。总比一边等Kami、一边饿死强。"

# game/scenario/3_canon.rpy:1869
translate chinese day3_choose_debate_argument_e5c94913:

    # mara reflexion "Tiens. Pour une fois, un plan qui ne sort pas de nulle part. Ça existe, ça marche. C'est déjà ça."
    mara reflexion "有意思。终于有个不是凭空想出来的方案。它已经存在，也确实有效。至少这是事实。"

# game/scenario/3_canon.rpy:1871
translate chinese day3_choose_debate_argument_7aa38408:

    # sael determine "On survit déjà. On peut faire plus que survivre."
    sael determine "我们已经能活下来。那就可以做到不只是活下来。"

# game/scenario/3_canon.rpy:1873
translate chinese day3_choose_debate_argument_efb3afc4:

    # think "Ryn baisse les yeux. Kael recalcule. Le troc existe déjà — l'idée trouve enfin une prise."
    think "Ryn低下头。Kael重新开始计算。以物易物本来就存在——这个想法终于有了真正的落脚点。"

# game/scenario/3_canon.rpy:1898
translate chinese day3_choose_debate_argument_bf687d50:

    # kami "VERT."
    kami "绿色。"

# game/scenario/3_canon.rpy:1899
translate chinese day3_choose_debate_argument_96029010:

    # kami "Le vote est POUR. À l'unanimité. Pas un seul « contre ». Je suis presque émue."
    kami "投票结果：赞成。全票通过。一个“反对”都没有。我都快感动了。"

# game/scenario/3_canon.rpy:1900
translate chinese day3_choose_debate_argument_17e86c96:

    # kami "Suppression totale des bons de rationnement. Fin de la distribution gratuite."
    kami "配给票券全面取消。免费配给制度终止。"

# game/scenario/3_canon.rpy:1901
translate chinese day3_choose_debate_argument_20522c48:

    # kami "Le commerce, le transport et le stockage de marchandises sont désormais autorisés."
    kami "商品的贸易、运输与储存现已全部合法。"

# game/scenario/3_canon.rpy:1904
translate chinese day3_choose_debate_argument_9d0493f7:

    # kami "Félicitations, mes petits rebelles. Vous avez coupé la laisse."
    kami "恭喜你们，我亲爱的小叛逆们。你们亲手剪断了牵绳。"

# game/scenario/3_canon.rpy:1905
translate chinese day3_choose_debate_argument_0aef29d3:

    # kami "Mais la laisse, c'était aussi ce qui vous retenait de tomber."
    kami "不过嘛，那根绳子也是用来防止你们掉下去的。"

# game/scenario/3_canon.rpy:1906
translate chinese day3_choose_debate_argument_f1b7b99d:

    # kami "On va voir ce que ça donne sans filet. J'ai hâte du spectacle."
    kami "现在就来看看，没有安全网会变成什么样吧。我可太期待这场表演了。"

# game/scenario/3_canon.rpy:1911
translate chinese day3_choose_debate_argument_b15ef1f7:

    # think "L'écran s'éteint. Aucun cri de joie. On n'a pas gagné. On a changé les règles, c'est tout."
    think "屏幕熄灭。没有人欢呼。我们没有赢。我们只是改了规则，仅此而已。"

# game/scenario/3_canon.rpy:1920
translate chinese day3_choose_debate_argument_28b48e2a:

    # julian sourire "C'est fait. Le collectif vient de créer une chance réelle."
    julian sourire "成了。我们这个集体刚刚真正创造了一个机会。"

# game/scenario/3_canon.rpy:1922
translate chinese day3_choose_debate_argument_2a0fb256:

    # ryn jaloux "Ouais."
    ryn jaloux "嗯。"

# game/scenario/3_canon.rpy:1923
translate chinese day3_choose_debate_argument_e7f16a88:

    # ryn inquiet "Mais sans les bons, Limen va morfler au début. Faut pas se mentir."
    ryn inquiet "但没了票券，Limen一开始肯定会很惨。别自己骗自己。"

# game/scenario/3_canon.rpy:1925
translate chinese day3_choose_debate_argument_4184f6bb:

    # noam "Je me demande si on savait vraiment ce qu'on faisait."
    noam "我开始怀疑，我们真的知道自己在做什么吗。"

# game/scenario/3_canon.rpy:1926
translate chinese day3_choose_debate_argument_06a6a614:

    # noam "On ne pouvait plus rester comme avant. Mais… est-ce que c'était vraiment un choix ?"
    noam "我们不能永远停在原地。但……这真的算是我们自己的选择吗？"

# game/scenario/3_canon.rpy:1928
translate chinese day3_choose_debate_argument_7b25bc29:

    # mara rire_profond "Génial. On va enfin pouvoir acheter des trucs."
    mara rire_profond "太棒了。终于可以买东西了。"

# game/scenario/3_canon.rpy:1929
translate chinese day3_choose_debate_argument_200cd113:

    # mara taquin "Et crever avec le choix de la sauce. Le luxe."
    mara taquin "然后还能自己选酱料再去死。奢华。"

# game/scenario/3_canon.rpy:1936
translate chinese day3_choose_debate_argument_7edb7c64:

    # kael mefiant "Orbite tiendra. Si les protocoles de sécurité restent intacts."
    kael mefiant "Orbite能撑住。只要安全协议还保持完整。"

# game/scenario/3_canon.rpy:1937
translate chinese day3_choose_debate_argument_bb7b4896:

    # kael triste "Si."
    kael triste "只要。"

# game/scenario/3_canon.rpy:1939
translate chinese day3_choose_debate_argument_7584533f:

    # think "Julian souriait trop fort. Elen rayonne et tremble. Ryn fixe le sol. Kael compte ses respirations."
    think "Julian笑得太用力。Elen整个人都在发光，却也在发抖。Ryn盯着地面。Kael在数自己的呼吸。"

# game/scenario/3_canon.rpy:1940
translate chinese day3_choose_debate_argument_6d580c74:

    # think "Personne n'exulte. Le plus dur commence maintenant."
    think "没人真正兴奋。最难的部分，现在才开始。"

# game/scenario/3_canon.rpy:1944
translate chinese day3_choose_debate_argument_4dfd8ca4:

    # think "Dix-sept heures dix. On se lève en silence."
    think "17点10分。我们沉默着起身。"

# game/scenario/3_canon.rpy:1947
translate chinese day3_choose_debate_argument_9d9934f8:

    # think "Mes pas résonnent jusqu'à ma chambre."
    think "我的脚步声一路回响到房间。"

# game/scenario/3_canon.rpy:1950
translate chinese day3_choose_debate_argument_1a6a5dd5:

    # think "On a voté pour le changement. J'ignore encore si on est prêts à le vivre."
    think "我们投票选择了改变。可我还不知道，我们到底准备好承受它没有。"

# game/scenario/3_canon.rpy:1953
translate chinese day3_choose_debate_argument_f1e4061c:

    # think "Je m'effondre sur le lit. Demain sera différent. Pas forcément meilleur."
    think "我倒在床上。明天会不一样。却未必会更好。"

# game/scenario/3_canon.rpy:1981
translate chinese day3_choose_debate_argument_e7bf6dae:

    # kami "ROUGE."
    kami "红色。"

# game/scenario/3_canon.rpy:1982
translate chinese day3_choose_debate_argument_b1fb4b6a:

    # kami "Le vote est CONTRE. Il a suffi d'une voix. Une seule."
    kami "投票结果：反对。只需要一票。就一票。"

# game/scenario/3_canon.rpy:1983
translate chinese day3_choose_debate_argument_948bc9de:

    # kami "Le statu quo est maintenu. Les bons de rationnement restent. La distribution continue."
    kami "现状维持。配给票券保留。免费配给继续。"

# game/scenario/3_canon.rpy:1986
translate chinese day3_choose_debate_argument_ebeab9be:

    # kami "Alors, que je n'entende plus personne pleurer sur ces bons."
    kami "所以从今以后，我可不想再听到谁抱怨这些票券。"

# game/scenario/3_canon.rpy:1987
translate chinese day3_choose_debate_argument_981b5cf1:

    # kami "Vous aviez la possibilité de tout changer. Quelqu'un, à cette table, a dit non."
    kami "你们有机会把一切改掉。可这张桌子上，有一个人说了“不”。"

# game/scenario/3_canon.rpy:1990
translate chinese day3_choose_debate_argument_80ff29a5:

    # kami "Félicitations, mes petits rats sages. Vous avez choisi la sécurité."
    kami "恭喜你们，我亲爱的小乖老鼠们。你们选择了安全。"

# game/scenario/3_canon.rpy:1991
translate chinese day3_choose_debate_argument_07656117:

    # kami "C'est plus ennuyeux. J'espérais un peu plus de sang. Ce sera pour une autre fois."
    kami "真无聊啊。我本来还期待多见点血呢。算了，下次吧。"

# game/scenario/3_canon.rpy:1997
translate chinese day3_choose_debate_argument_3fa22650:

    # think "L'écran s'éteint. Le rejet retombe sur nos épaules comme une couverture mouillée."
    think "屏幕熄灭。被否决的结果像一条湿透的毯子压在所有人肩上。"

# game/scenario/3_canon.rpy:2008
translate chinese day3_choose_debate_argument_c7f1d94b:

    # julian colere "Non. On avait une chance réelle. Une vraie."
    julian colere "不。我们明明真的有机会。是真的。"

# game/scenario/3_canon.rpy:2010
translate chinese day3_choose_debate_argument_df49e95d:

    # ryn fatigue "C'est pas si simple. D'autres auraient pu en crever."
    ryn fatigue "没那么简单。也可能会有人因此死掉。"

# game/scenario/3_canon.rpy:2012
