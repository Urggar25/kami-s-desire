# game/scenario/6_0_1.rpy:15
translate chinese c1fa8b35:

    # think "J'ouvre les yeux après une longue nuit de sommeil."
    think "我在漫长的一夜睡眠后睁开眼睛。"

# game/scenario/6_0_1.rpy:16
translate chinese af11d4b7:

    # think "J'ai enfin pu dormir convenablement. Peut-être parce que je sais déjà ce que cette journée nous réserve."
    think "总算好好睡了一觉。也许是因为我已经知道今天会发生什么。"

# game/scenario/6_0_1.rpy:17
translate chinese a704626b:

    # think "Finalement, ça ne sert à rien de se prendre la tête pour un vote déjà perdu d'avance."
    think "反正这场投票从一开始就注定要输，再纠结也没用。"

# game/scenario/6_0_1.rpy:29
translate chinese 1461481c:

    # kami "Et bien bonjouur à tous ! Aujourd'hui est le jour que vous attendez tant ! C'est jour de vote !"
    kami "那么——大家早上好呀！今天可是你们盼了很久的日子！投票日到啦！"

# game/scenario/6_0_1.rpy:32
translate chinese c31db4cb:

    # kami "Le vote sur la libre circulation entre districts aura lieu aujourd'hui à qu-quatorze heure, dans le conclave."
    kami "关于地区之间自由通行的投票，将在今天十、十四点，于议会举行。"

# game/scenario/6_0_1.rpy:39
translate chinese 8ff12407:

    # kami "Mais vous commencez déjà à avoir l'habitude de cette petite routine, n-n-'est-ce pas ?."
    kami "不过你们应该已经开始习惯这套小流程了，对、对吧？"

# game/scenario/6_0_1.rpy:41
translate chinese 65c19ef5:

    # "La voix grésille, elle est étrange. Presque comme modifiée."
    "声音里夹着电流杂音，很奇怪。像是被处理过一样。"

# game/scenario/6_0_1.rpy:50
translate chinese b9fdcf97:

    # kami "Votre présence est-est... Recommandée."
    kami "建议……你们到场。"

# game/scenario/6_0_1.rpy:56
translate chinese a80ffbc3:

    # kami "Vous avez l'air fatigués. Enfin... J'imagine."
    kami "你们看起来很累。嗯……大概吧。"

# game/scenario/6_0_1.rpy:61
translate chinese 31b935d3:

    # kami "Vous me semblez, bi-bien moins intéréssant que ces derniers jours.."
    kami "你们看起来比前几天无、无聊多了……"

# game/scenario/6_0_1.rpy:62
translate chinese 6ee7c152:

    # kami "C'est très contrariant."
    kami "真让人扫兴。"

# game/scenario/6_0_1.rpy:73
translate chinese 2f3093a2:

    # kami "Les jouets se cassent toujours plus vite une fois qu'on commence à jouer sérieusement avec eux."
    kami "玩具一旦开始认真玩，总是坏得特别快。"

# game/scenario/6_0_1.rpy:81
translate chinese 0dde1b8d:

    # think "L'écran s'éteint rapidement. Sans l'éclat de rire désormais habituel de Kami."
    think "屏幕很快熄灭。这次没有Kami如今已经习以为常的那阵大笑。"

# game/scenario/6_0_1.rpy:82
translate chinese ef4795bf:

    # think "Qu'est-ce qui a bien pu se passer ? Elle n'était pas comme d'habitude..."
    think "到底发生什么了？她今天完全不像平时……"

# game/scenario/6_0_1.rpy:84
translate chinese f343bea7:

    # noam "C'est quoi ce bordel, encore..."
    noam "这他妈又是什么情况……"

# game/scenario/6_0_1.rpy:88
translate chinese d7213fb0:

    # think "Kami simule tout : joie, tendresse, colère, même ses silences. Mais... Pas là. Du moins j'en ai pas eu l'impression."
    think "Kami什么都在演：开心、温柔、愤怒，甚至连沉默都在演。可是……刚才不是。至少我没觉得那是在演。"

# game/scenario/6_0_1.rpy:96
translate chinese 1e1fcc02:

    # think "Je me lève. Mes jambes répondent avec un léger retard."
    think "我站起来。双腿慢了半拍才跟上。"

# game/scenario/6_0_1.rpy:100
translate chinese d6341101:

    # think "Ma veste est par terre, beaucoup trop loin. Je la ramasse, l'enfile et gagne la porte."
    think "外套扔在地上，离我远得离谱。我把它捡起来穿上，朝门口走去。"

# game/scenario/6_0_1.rpy:103
translate chinese 21cfac7c:

    # think "Je me relève rapidement. Je n'ai pas vraiment envie d'aller à la cafétéria."
    think "我很快站起身。说真的，我一点都不想去食堂。"

# game/scenario/6_0_1.rpy:105
translate chinese 6c937cf2:

    # think "Mes jambes sont encore endormies. J'ai franchement la flemme de me lever."
    think "腿还没醒。我是真的懒得起来。"

# game/scenario/6_0_1.rpy:107
translate chinese 305cbd31:

    # think "Mais bon, faut y aller. C'est tout."
    think "不过算了，还是得去。就这样。"

# game/scenario/6_0_1.rpy:120
translate chinese d68cc1be:

    # think "Ils sont presque tous là. Ils parlent un peu tous dans leur coin, mais pas vraiment ensemble."
    think "人基本都到了。大家各自零零散散地聊着，却算不上真正在一起说话。"

# game/scenario/6_0_1.rpy:133
translate chinese 8195e3db:

    # "CLAC. Encore."
    "咔哒。又来。"

# game/scenario/6_0_1.rpy:135
translate chinese 68068eb0:

    # elias "Putain—"
    elias "Elias骂了一句。"

# game/scenario/6_0_1.rpy:141
translate chinese 0378cbcc:

    # think "Ma main part avant ma tête. Je redresse le verre ; quelques gouttes seulement tombent sur le sol."
    think "手比脑子先动。我把杯子扶正，只有几滴水落到地上。"

# game/scenario/6_0_1.rpy:142
translate chinese c50c81d5:

    # elias inquiet "Oh putain. Merci. C'était chaud, là. Encore..."
    elias inquiet "操。谢了。刚才真险。又来一次……"

# game/scenario/6_0_1.rpy:144
translate chinese bfc76289:

    # think "Trop tard. Le verre frappe la table ; ma manche arrête l'eau avant Mara."
    think "太晚了。杯子撞上桌面；我的袖子在水泼到Mara之前挡住了大半。"

# game/scenario/6_0_1.rpy:145
translate chinese 8e121e66:

    # elias inquiet "Merde, merde. J'ai fait quoi, là ? C'est chaud."
    elias inquiet "妈的，妈的。我刚干了什么？这下麻烦了。"

# game/scenario/6_0_1.rpy:146
translate chinese b9682e1d:

    # mara agace "Putain, je suis trempée Elias ! Tu pourrais faire gaffe un peu non ?!"
    mara agace "操，我全湿了，Elias！你能不能稍微小心一点？！"

# game/scenario/6_0_1.rpy:148
translate chinese 13340ff8:

    # think "Je tends le bras trop lentement. Le verre bascule entièrement."
    think "我伸手太慢。杯子整个翻了。"

# game/scenario/6_0_1.rpy:149
translate chinese f5543e6c:

    # elias inquiet "Et merde. Fait chier, c'est chaud."
    elias inquiet "操。真他妈烦，完了。"

# game/scenario/6_0_1.rpy:150
translate chinese a8fb6605:

    # mara colere "... J'ai tout pris sur la tronche ! Je vais finir par te tuer !"
    mara colere "……全泼我脸上了！你再这样我真会弄死你！"

# game/scenario/6_0_1.rpy:152
translate chinese b28615c9:

    # mara agace "Mais tu n'arrêtes pas de faire tout le temps tomber des trucs, c'est maladif ou quoi ?!"
    mara agace "你怎么老是在掉东西？这已经是病了吧？！"

# game/scenario/6_0_1.rpy:153
translate chinese 45335259:

    # elias triste "J’ai pas—"
    elias triste "我没——"

# game/scenario/6_0_1.rpy:155
translate chinese 434664fe:

    # mara "Kael m'a dit qu'hier ta maladresse t'a enfermé dans une salle. Aujourd'hui, tu viens directement m'agresser avec elle."
    mara "Kael跟我说你昨天笨手笨脚，把自己锁在一个房间里。今天你干脆直接拿这毛病来袭击我。"

# game/scenario/6_0_1.rpy:157
translate chinese 6518074a:

    # elen inquiet "... C'est pas drôle. Il a pas fait exprès, enfin je crois pas..."
    elen inquiet "……这不好笑。他不是故意的吧，至少我觉得不是……"

# game/scenario/6_0_1.rpy:158
translate chinese a8653725:

    # elen joie "Faudrait être fou pour te rendre de mauvaise humeur dès le matin."
    elen joie "得疯成什么样，才会一大早就故意惹你生气。"

# game/scenario/6_0_1.rpy:160
translate chinese d80ff0cd:

    # mara "Je confirme. Faudrait être fou."
    mara "确实。得是疯了。"

# game/scenario/6_0_1.rpy:162
translate chinese 6bbb88bd:

    # elias inquiet "J'ai glissé. Je suis vraiment désolé Mara ! Vraimen désolé."
    elias inquiet "我滑了一下。真的对不起，Mara！真的很对不起。"

# game/scenario/6_0_1.rpy:164
translate chinese 4dde8e2f:

    # mara neutre "Comme d'habitude : je suis toujours au mauvais endroit, au pire moment."
    mara neutre "老样子：我永远出现在最不该出现的地方，最倒霉的时候。"

# game/scenario/6_0_1.rpy:166
translate chinese 36bc0a25:

    # elen neutre "Vous avez entendu Kami ? Enfin oui, évidemment, mais vous avez entendu comment elle parlait ? C'était TROOOOP chelou !"
    elen neutre "你们刚才听到Kami了吗？当然听到了，但你们有注意她说话的样子吗？也太——怪——了吧！"

# game/scenario/6_0_1.rpy:168
translate chinese 2569afb5:

    # mara mefiant "Ouais. C'était pas son petit théâtre habituel. C'est vrai."
    mara mefiant "嗯。那不是她平时那套小表演。确实不一样。"

# game/scenario/6_0_1.rpy:170
translate chinese 346bcea9:

    # lysa reflexion "Elle était beaucoup plus ... Expéditive. Comme si ça la saoulait de nous parler."
    lysa reflexion "她明显……利落得过头。像是懒得跟我们说话一样。"

# game/scenario/6_0_1.rpy:172
translate chinese 48d74ebd:

    # elen taquin "Whaou ! Tu crois qu'elle nous fait une dépression ? Genre un Burn-Out ?!"
    elen taquin "哇！你觉得她抑郁了？那种……工作过劳？"

# game/scenario/6_0_1.rpy:174
translate chinese de3dec1e:

    # lysa rire "Je crois pas que ce soit possible !"
    lysa rire "我觉得她不可能这样吧！"

# game/scenario/6_0_1.rpy:176
translate chinese aee2fee4:

    # elias reflechit "Kami joue toujours un rôle. C'est son truc. En soit, elle nous imite."
    elias reflechit "Kami一直都在扮演某种角色。她就是这样。说到底，她是在模仿我们。"

# game/scenario/6_0_1.rpy:178
translate chinese 3c0aaef6:

    # lysa blase "Ouais. Mais là c'était pas comme d'habitude."
    lysa blase "对。但刚才真的不像平时。"

# game/scenario/6_0_1.rpy:180
translate chinese a5c39db4:

    # mara colere "Tu m'étonnes qu'elle était pas comme d'habitude. Elle bégayait ! D'où Kami bégaye d'abord !"
    mara colere "她当然不像平时。她都结巴了！Kami什么时候会结巴啊？！"

# game/scenario/6_0_1.rpy:182
translate chinese ec7f7e65:

    # lysa reflechit "Tu crois qu'il lui est arrivé quelque chose ?"
    lysa reflechit "你觉得她是不是出什么事了？"

# game/scenario/6_0_1.rpy:184
translate chinese 5d5d4d34:

    # mara mefiant "Non. Enfin… j'en sais rien. C'était bizarre. Même pour elle."
    mara mefiant "不知道。说真的……我也不知道。反正很怪。就算对她来说都怪。"

# game/scenario/6_0_1.rpy:186
translate chinese 149d7487:

    # noam reflechit "Ouais. On verra bien si ça continuera plus tard, mais je m'étais aussi fait la réflexion."
    noam reflechit "嗯。看看之后还会不会这样吧，不过我刚才也在想这事。"

# game/scenario/6_0_1.rpy:188
translate chinese c48b338e:

    # "Nous avons chacun continué à manger, plus en silence, nos rations sèches et sans goût."
    "我们继续吃着自己的干巴巴、没味道的配给，气氛比刚才安静多了。"

# game/scenario/6_0_1.rpy:189
translate chinese 79080fee:

    # think "Finalement, personne n'a parlé du vote. Personne n'a osé."
    think "最后，没人提投票。没人敢提。"

# game/scenario/6_0_1.rpy:190
translate chinese 1c2b1a8a:

    # think "Où alors, tout le monde sait que c'est inutile."
    think "又或者，大家都知道提了也没用。"

# game/scenario/6_0_1.rpy:204
translate chinese c8a93bc8:

    # "Et puis enfin, l'heure du Conclave est arrivé."
    "终于，议会时间到了。"

# game/scenario/6_0_1.rpy:206
translate chinese 58e5d7a5:

    # think "Nous nous sommes rassemblés sans parler. Sans même se regarder."
    think "我们默默集合。甚至没有互相看一眼。"

# game/scenario/6_0_1.rpy:211
translate chinese c74e6260:

    # think "Les lumières vibrent une seconde, puis reviennent."
    think "灯光颤了一下，然后恢复。"

# game/scenario/6_0_1.rpy:213
translate chinese 0cc6c5f5:

    # noam "Pourquoi rien ne va dans cette journée ?!"
    noam "今天到底还有什么能正常一点？！"

# game/scenario/6_0_1.rpy:219
translate chinese a92250c8:

    # kami "Oh. Déjà en mouvement ? il restait encore un peu de temps."
    kami "哦。已经动起来了？本来还有一点时间。"

# game/scenario/6_0_1.rpy:224
translate chinese 5c734119:

    # kami "C’est bien. C’est très bien."
    kami "很好。非常好。"

# game/scenario/6_0_1.rpy:226
translate chinese 10b66231:

    # kami "Nous pouvons… anticiper."
    kami "我们可以……提前。"

# game/scenario/6_0_1.rpy:228
translate chinese a367e5a9:

    # kami "Le vote peut commencer plus tôt."
    kami "投票可以提前开始。"

# game/scenario/6_0_1.rpy:229
translate chinese 06310da1:

    # kami "Immédiatement, même. Ça m'arrange beaucoup."
    kami "甚至现在就开始。这对我很方便。"

