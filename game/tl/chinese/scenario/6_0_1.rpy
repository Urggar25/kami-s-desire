translate chinese 5e6ae089:

    # think "Le couloir reprend comme si rien ne s'était passé. Puis je remarque qu'il manque quelqu'un."
    think "走廊像什么都没发生一样继续运作。然后我才发现少了一个人。"

# game/scenario/6_0_1.rpy:248
translate chinese b15e0021:

    # think "Sael. Oui. C'est elle. Où est-elle ? Elle était là il y a une seconde !"
    think "Sael。对，是她。她在哪儿？她刚才明明还在这里！"

# game/scenario/6_0_1.rpy:255
translate chinese 30b60ade:

    # "Sael est derrière le groupe, elle ne bouge plus. Elle fixe un angle vide du couloir."
    "Sael落在队伍后面，一动不动。她盯着走廊一处空荡的角落。"

# game/scenario/6_0_1.rpy:257
translate chinese 8b1d53e7:

    # noam inquiet "Sael ?"
    noam inquiet "Sael？"

# game/scenario/6_0_1.rpy:258
translate chinese 57faba46:

    # think "Elle ne répond pas tout de suite."
    think "她没有马上回答。"

# game/scenario/6_0_1.rpy:260
translate chinese c47aa2f3:

    # sael reflechit "... J'ai vu quelqu'un. Là-bas."
    sael reflechit "……我刚才看见有人。就在那边。"

# game/scenario/6_0_1.rpy:262
translate chinese 0b434338:

    # think "Je regarde. Seulement le couloir vide."
    think "我看过去。只有空空的走廊。"

