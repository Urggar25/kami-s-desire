translate chinese 5d30d370:

    # think "Nous entrons et prenons nos places sans ralentir."
    think "我们走进去，直接坐到各自的位置上。"

# game/scenario/6_0_1.rpy:288
translate chinese c119c0dd:

    # think "Nos corps connaissent déjà le chemin."
    think "身体已经记住了路线。"

# game/scenario/6_0_1.rpy:292
translate chinese ecfa8e6d:

    # think "Ryn s'assoit. Iris croise les bras. Sael regarde droit devant."
    think "Ryn坐下。Iris抱起手臂。Sael直视前方。"

# game/scenario/6_0_1.rpy:298
translate chinese de4df1a2:

    # kami "... Ah oui. Vous voilà. Début du débat."
    kami "……啊，对。你们到了。讨论开始。"

# game/scenario/6_0_1.rpy:302
translate chinese febe0bf6:

    # kami "Proposition : autoriser la libre circulation entre districts."
    kami "提案：允许地区之间自由通行。"

# game/scenario/6_0_1.rpy:306
translate chinese f6e6224b:

    # kami "Vous connaissez déjà comment tout ça fonctionne. Je ne vais pas me répéter inutilement."
    kami "你们已经知道整套流程怎么运作了。我就不浪费时间重复。"

# game/scenario/6_0_1.rpy:310
translate chinese e35f7466:

    # kami "Alors. Parlez. Débattez."
    kami "所以。说吧。讨论吧。"

