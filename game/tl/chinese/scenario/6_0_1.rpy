translate chinese 62a5948c:

    # noam reflechit "Il n'y a personne. Enfin… je ne vois personne."
    noam reflechit "没人啊。至少……我什么都没看见。"

# game/scenario/6_0_1.rpy:266
translate chinese 5e8ac0e7:

    # sael triste "... Oui. Tu as sans doute raison…"
    sael triste "……嗯。你大概是对的……"

# game/scenario/6_0_1.rpy:272
translate chinese 8d2cc137:

    # think "Non. Ce n'est pas ça."
    think "不。不是这个。"

# game/scenario/6_0_1.rpy:273
