translate chinese fc60b353:

    # "Personne ne parle. Pas une seule tentative."
    "没人开口。一次尝试都没有。"

# game/scenario/6_0_1.rpy:315
translate chinese 3d6082f0:

    # think "A quoi bon ...?"
    think "反正又有什么用……？"

# game/scenario/6_0_1.rpy:319
translate chinese 25cbb13c:

    # kami "... Intéressant"
    kami "……有意思。"

# game/scenario/6_0_1.rpy:323
translate chinese e352b0fb:

    # kami "Vous souhaitez déjà sauter à la conclusion sans passer par le processus.."
    kami "你们已经想跳过过程，直接奔向结论了……"

