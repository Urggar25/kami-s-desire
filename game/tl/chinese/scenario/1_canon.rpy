    ryn fatigue "反正我先交我的。"

# game/scenario/1_canon.rpy:1551
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_53245ed8:

    # voix "Premier amendement déposé."
    voix "第一份修正案已提交。"

# game/scenario/1_canon.rpy:1554
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_2c00c821:

