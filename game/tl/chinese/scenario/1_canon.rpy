    kami "好了。写吧。想吧。让我惊艳一下。"

# game/scenario/1_canon.rpy:1444
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_a59962cf:

    # kami "Faites semblant d'être des adultes responsables."
