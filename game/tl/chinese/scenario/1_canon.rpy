    kami "你们一共十二个人。"

# game/scenario/1_canon.rpy:1391
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_ef09fae4:

    # kami "Donc deux amendements ne seront pas votés lors de ce Conclave."
