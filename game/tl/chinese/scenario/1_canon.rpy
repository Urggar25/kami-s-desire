# game/scenario/1_canon.rpy:1525
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_57918745:

    # tomas hesitation "Ça ne marchera pas, Ryn. Enfin... pas forcément."
    tomas hesitation "行不通的，Ryn。至少……不一定行得通。"

# game/scenario/1_canon.rpy:1526
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_dd622290:

