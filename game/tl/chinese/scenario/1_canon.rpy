# game/scenario/1_canon.rpy:1530
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_85313ccb:

    # kael reflechit "Raison de plus pour qu'on se parle !"
    kael reflechit "所以我们更应该互相沟通！"

