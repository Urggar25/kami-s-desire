# game/scenario/1_canon.rpy:1395
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_7ef0f654:

    # kami "Ne le prenez pas mal. C'est MATHEMATIQUE."
    kami "别放在心上。这是数学问题。"

# game/scenario/1_canon.rpy:1396
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_92a4a490:

    # kami "Et ce n'est pas plus mal, si jamais je devais reproduire le Conclave l'an prochain."
    kami "而且也未必是坏事。万一我明年还想再办一次呢。"

# game/scenario/1_canon.rpy:1397
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_cc894d82:

