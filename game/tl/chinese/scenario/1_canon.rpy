# game/scenario/1_canon.rpy:1411
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_be47588f:

    # kami "Sur les bulletins exprimés, il faut une unanimité de POUR pour adopter le vote."
    kami "在有效票中，只有所有人都投赞成，修正案才会通过。"

# game/scenario/1_canon.rpy:1412
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_b3dea4ad:

    # kami "Sont retirés des bulletins exprimés : les abstentions et les absences au vote."
    kami "弃权和缺席都不计入有效票。"

# game/scenario/1_canon.rpy:1413
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_8871d6fe:

    # kami "Je ne suis pas un monstre, tout de même. MOI je respecte le principe du vote blanc."
    kami "我又不是什么怪物。我还是尊重空白票原则的。"

# game/scenario/1_canon.rpy:1417
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_4260dfa2:

    # kami "Mais je vous préviens, le peuple n'apprécie généralement pas les PROCRASTINATEURS."
    kami "不过先提醒一句，大众通常都不太喜欢拖拖拉拉的人。"

# game/scenario/1_canon.rpy:1422
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_45734720:

    # elias neutre "Donc si une seule personne dit non… c'est mort."
    elias neutre "所以只要有一个人说不……就完了。"

# game/scenario/1_canon.rpy:1423
translate chinese FIRST_CONCLAVE_ELEN_INTERACT_0327cd8b:

