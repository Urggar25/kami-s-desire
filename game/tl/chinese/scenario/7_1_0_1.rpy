# game/scenario/7_1_0_1.rpy:26
translate chinese f7fad273:

    # think "Je regarde la jeune femme recroquevillée entre les conteneurs. Chaque respiration semble lui demander un effort immense."
    think "我看着蜷缩在集装箱之间的年轻女子。每一次呼吸，对她来说似乎都无比艰难。"

# game/scenario/7_1_0_1.rpy:27
translate chinese a0743583:

    # think "La cacher nous donnerait peut-être une chance de la sauver. Peut-être. Mais au prix d'un mensonge que Kami finirait forcément par découvrir."
    think "把她藏起来，也许还能救她一命。也许吧。但代价是撒下一个迟早会被 Kami 揭穿的谎。"

# game/scenario/7_1_0_1.rpy:29
translate chinese 2f3b13be:

    # noam determine "On prévient Kami."
    noam determine "通知 Kami。"

# game/scenario/7_1_0_1.rpy:31
translate chinese 28e21649:

    # iris colere "Tu es sérieux ?"
    iris colere "你认真的？"

# game/scenario/7_1_0_1.rpy:33
translate chinese c8d422c4:

    # noam inquiet "Si on la déplace en secret et qu'elle meurt, on ne pourra même pas appeler à l'aide."
    noam inquiet "要是我们偷偷转移她，结果她死了，我们连求救都做不到。"

# game/scenario/7_1_0_1.rpy:35
translate chinese c9259402:

    # nyra raison "Et si Kami décide de l'exécuter ?"
    nyra raison "如果 Kami 决定处决她呢？"

# game/scenario/7_1_0_1.rpy:37
translate chinese 428796b7:

    # noam determine "Alors on l'en empêchera. Mais là, elle a besoin de soins tout de suite."
    noam determine "那我们就阻止她。但现在，这女孩必须立刻接受治疗。"

# game/scenario/7_1_0_1.rpy:39
translate chinese 8de69793:

    # tomas inquiet "Comment est-ce qu'on empêche Kami de faire quoi que ce soit ?"
    tomas inquiet "我们要怎么阻止 Kami 做任何事？"

# game/scenario/7_1_0_1.rpy:41
translate chinese cb07f698:

    # noam raison "Je ne sais pas encore. Mais je sais qu'on n'arrivera pas à la réchauffer avec une veste et quatre personnes qui paniquent autour d'elle."
    noam raison "我还不知道。但光靠一件外套，再加上四个人围着她慌成一团，肯定没法让她暖起来。"

# game/scenario/7_1_0_1.rpy:43
translate chinese b18ee6ce:

    # iris desaccord "Je déteste ce choix."
    iris desaccord "我讨厌这个选择。"

# game/scenario/7_1_0_1.rpy:45
translate chinese d9d228cf:

    # noam triste "Moi aussi."
    noam triste "我也是。"

# game/scenario/7_1_0_1.rpy:49
translate chinese 3834385f:

    # nyra raison "Très bien. Mais nous parlons avant qu'elle impose sa version des règles."
    nyra raison "好。但必须赶在她强行解释规则之前先开口。"

# game/scenario/7_1_0_1.rpy:51
translate chinese fd09c66f:

    # think "Nyra se tourne vers la caméra fixée au-dessus de la porte. Son voyant reste parfaitement blanc."
    think "Nyra 转向门上方的摄像机，指示灯依然发出纯白色的光。"

# game/scenario/7_1_0_1.rpy:53
translate chinese 057625fb:

    # nyra determine "Kami. Nous savons que tu nous regardes. Il y a une personne vivante dans la livraison."
    nyra determine "Kami，我们知道你在看。补给里有一个活人。"

# game/scenario/7_1_0_1.rpy:57
translate chinese 2d37e8f1:

    # think "Aucune réponse. Tomas lève les yeux vers la caméra, puis les baisse aussitôt."
    think "没有回应。Tomas 抬头看了一眼摄像机，又立刻低下头。"

# game/scenario/7_1_0_1.rpy:59
translate chinese e83a36ab:

    # tomas inquiet "Elle nous a entendus ?"
    tomas inquiet "她听见了吗？"

# game/scenario/7_1_0_1.rpy:61
translate chinese 342e42f4:

    # iris colere "Évidemment qu'elle nous a entendus. Elle fait durer."
    iris colere "她当然听见了。只是在故意吊着我们。"

# game/scenario/7_1_0_1.rpy:63
translate chinese 1c8a70fe:

    # noam colere "Kami ! Elle est en hypothermie. Si tu veux discuter, fais-le maintenant."
    noam colere "Kami！她严重失温。你想谈，就现在谈。"

# game/scenario/7_1_0_1.rpy:78
translate chinese 491f4f6f:

    # kami "Bonjour, Noam. Moi aussi, je suis ravie de te voir."
    kami "早上好，Noam。见到你我也很高兴。"

# game/scenario/7_1_0_1.rpy:82
translate chinese 45d7e21d:

    # kami "Je comptais justement vous féliciter pour votre remarquable découverte. Une chaussure humaine au milieu des conserves, ça réveille mieux qu'un café."
    kami "我正准备祝贺你们有了如此惊人的发现。一只人类的鞋混在罐头中间，可比咖啡提神多了。"

# game/scenario/7_1_0_1.rpy:86
translate chinese a554f7bc:

    # kami "Écartez-vous de l'intruse."
    kami "离那个闯入者远一点。"

# game/scenario/7_1_0_1.rpy:97
translate chinese 45d41819:

    # think "Un mécanisme lourd se met en mouvement derrière la paroi. Je reconnais ce grondement."
    think "墙后传来沉重机械开始运转的声音。我认得这阵轰鸣。"

# game/scenario/7_1_0_1.rpy:98
translate chinese 3718cd5c:

    # think "Le canon."
    think "是那门炮。"

# game/scenario/7_1_0_1.rpy:100
translate chinese 14bf0730:

    # iris peur "Non..."
    iris peur "不……"

# game/scenario/7_1_0_1.rpy:102
translate chinese 9c899510:

    # tomas inquiet "Elle va vraiment tirer ici ?"
    tomas inquiet "她真要朝这里开火？"

# game/scenario/7_1_0_1.rpy:104
translate chinese 12878b27:

    # nyra determine "Personne ne bouge."
    nyra determine "谁都别动。"

# game/scenario/7_1_0_1.rpy:106
translate chinese 18446a83:

    # noam colere "Kami, arrête."
    noam colere "Kami，住手。"

# game/scenario/7_1_0_1.rpy:112
translate chinese 4f9c7686:

    # kami "Elle a franchi une frontière clandestinement, s'est introduite dans mon Conclave et s'est dissimulée dans ma livraison."
    kami "她偷偷越过边界、闯进我的议会，还藏在我的补给里。"

# game/scenario/7_1_0_1.rpy:116
translate chinese f002f64c:

    # kami "Je vais simplement corriger cette petite erreur logistique."
    kami "我只是要纠正这个小小的物流错误。"

# game/scenario/7_1_0_1.rpy:127
translate chinese 465dc585:

    # nyra raison "En vertu de quelle règle ?"
    nyra raison "依据哪条规则？"

# game/scenario/7_1_0_1.rpy:131
translate chinese 4c4d3979:

    # nyra determine "Les Commandements sont suspendus dans le Conclave. Tu nous l'as toi-même confirmé."
    nyra determine "戒律在议会内暂时失效，这是你亲口确认过的。"

# game/scenario/7_1_0_1.rpy:133
translate chinese 9c9ce4cf:

    # noam surpris "Nyra..."
    noam surpris "Nyra……"

# game/scenario/7_1_0_1.rpy:135
translate chinese 00dd3e82:

    # nyra raison "Et aucune règle du Conclave n'interdit à une personne non représentante d'y entrer."
    nyra raison "议会的规则里，也没有任何一条禁止非代表人员进入。"

# game/scenario/7_1_0_1.rpy:137
translate chinese 564c2d02:

    # iris determine "Elle n'a agressé personne. Elle n'a rien volé. Elle est juste en train de mourir de froid."
    iris determine "她没有袭击任何人，也没有偷东西。她只是快要冻死了。"

# game/scenario/7_1_0_1.rpy:139
translate chinese 0a0e4de3:

    # tomas inquiet "D'un point de vue strictement juridique, l'entrée dans le sas n'est pas définie comme..."
    tomas inquiet "严格从法律角度来说，进入气闸舱并没有被定义为……"

# game/scenario/7_1_0_1.rpy:141
translate chinese 99ed6e1b:

    # tomas panne "Enfin, Nyra a raison. Ce n'est pas interdit."
    tomas panne "总、总之 Nyra 说得对。这并不违规。"

# game/scenario/7_1_0_1.rpy:147
translate chinese 92eb39ad:

    # kami "Elle n'est pas entrée. Elle a été importée. Sans déclaration, sans autorisation et sans la moindre étiquette."
    kami "她不是自己进来的，她是被进口进来的。没有申报，没有许可，身上甚至连张标签都没有。"

# game/scenario/7_1_0_1.rpy:151
translate chinese 926a35a2:

    # kami "Vous ne transformerez pas une intrusion en vide juridique simplement parce que j'ai oublié d'écrire : ne voyagez pas avec les pommes de terre !"
    kami "别以为我忘了写“禁止和土豆一起旅行”，你们就能把一次入侵说成法律漏洞！"

# game/scenario/7_1_0_1.rpy:162
translate chinese 5ace9abb:

    # nyra raison "Tes règles ne seraient donc pas parfaites ? Alors que c'est ce que tu revendiques ?."
    nyra raison "难道你的规则并不完美吗？明明你一直宣称它们是完美的？"

# game/scenario/7_1_0_1.rpy:164
translate chinese a4131b5d:

    # iris taquin "Elle marque un point."
    iris taquin "她说得有道理。"

# game/scenario/7_1_0_1.rpy:166
translate chinese 7db841ec:

    # noam raison "Même si tu refuses cet argument, tu ne peux pas utiliser ton canon ici."
    noam raison "就算你不接受这个论点，也不能在这里动用那门炮。"

# game/scenario/7_1_0_1.rpy:172
translate chinese e49c3bc7:

    # kami "Je ne peux pas ?"
    kami "我不能？"

# game/scenario/7_1_0_1.rpy:183
translate chinese 8b021d62:

    # noam determine "Regarde où elle se trouve."
    noam determine "看看她在哪。"

# game/scenario/7_1_0_1.rpy:185
translate chinese 3e997f99:

    # noam raison "Si tu tires, le rayon traversera le sas. Il percera la coque ou détruira les systèmes de livraison."
    noam raison "你一开火，射线就会穿过气闸舱，不是击穿船体，就是摧毁补给系统。"

# game/scenario/7_1_0_1.rpy:187
translate chinese ad343c81:

    # noam determine "Dans les deux cas, ton Conclave s'arrête aujourd'hui. Plus de représentants, plus de votes, plus de petit jeu."
    noam determine "无论哪种结果，你的议会今天就到此为止。没有代表，没有投票，也没有你那套小游戏了。"

# game/scenario/7_1_0_1.rpy:189
translate chinese 2c6765a2:

    # nyra raison "Et même si le sas résistait, tu contaminerais ou détruirais une partie des ressources que tu viens de nous envoyer."
    nyra raison "就算气闸舱扛得住，你也会污染或摧毁一部分刚送给我们的物资。"

# game/scenario/7_1_0_1.rpy:191
translate chinese 0f52f68c:

    # iris colere "Alors rengaine ton jouet et laisse-nous la soigner."
    iris colere "所以收起你的玩具，让我们救她。"

# game/scenario/7_1_0_1.rpy:195
translate chinese c010a6f0:

    # think "Le grondement continue encore quelques secondes. Puis le mécanisme s'immobilise."
    think "轰鸣又持续了几秒，随后机械停了下来。"

# game/scenario/7_1_0_1.rpy:197
translate chinese b82ae926:

    # tomas inquiet "Elle a arrêté ?"
    tomas inquiet "她停下了？"

# game/scenario/7_1_0_1.rpy:199
translate chinese e6c29d36:

    # noam neutre "Je crois."
    noam neutre "应该是。"

# game/scenario/7_1_0_1.rpy:205
translate chinese 09438f2b:

    # kami "Je vous déteste quand vous devenez raisonnables en groupe."
    kami "我最讨厌你们集体讲道理的时候。"

# game/scenario/7_1_0_1.rpy:209
translate chinese 545cf8f8:

    # kami "Très bien. Puisque cette personne n'a techniquement enfreint aucune règle applicable à l'intérieur du Conclave, elle ne sera pas exécutée."
    kami "好吧。既然严格来说，这个人没有违反议会内适用的任何规则，她不会被处决。"

# game/scenario/7_1_0_1.rpy:213
translate chinese d0683873:

    # kami "Mais elle ne fait pas partie des douze représentants. Elle ne participera à aucun débat officiel, ne proposera aucun texte et ne prendra part à aucun vote."
    kami "但她不是十二名代表之一。她不能参加任何正式辩论，不能提出议案，也不能参与投票。"

# game/scenario/7_1_0_1.rpy:217
translate chinese 4e7d71a2:

    # kami "Et je refuse catégoriquement qu'elle s'installe ici. Elle repartira au jour quatorze, lors de la prochaine livraison."
    kami "而且我绝不允许她在这里住下去。她必须在第十四天随下一批补给离开。"

# game/scenario/7_1_0_1.rpy:221
translate chinese f09ee674:

    # kami "Si elle tient absolument à voyager dans une caisse, je suis certaine que le trajet retour lui plaira."
    kami "她既然这么喜欢坐箱子旅行，我相信返程一定也会让她满意。"

# game/scenario/7_1_0_1.rpy:232
translate chinese 4d14ced7:

    # iris determine "Elle doit d'abord survivre jusqu'au jour quatorze. Ouvre l'infirmerie."
    iris determine "她得先活到第十四天。打开医务室。"

# game/scenario/7_1_0_1.rpy:238
translate chinese 545d44af:

    # kami "Quelle délicatesse dans la formulation."
    kami "措辞真是体贴。"

# game/scenario/7_1_0_1.rpy:242
translate chinese d938b8d7:

    # kami "L'accès est autorisé. Sael et Elias ont été prévenus. Transportez-la sans la faire tomber, ce serait une conclusion terriblement médiocre."
    kami "准许进入。Sael 和 Elias 已经收到通知。搬她的时候别摔着，不然这个结局也太乏味了。"

# game/scenario/7_1_0_1.rpy:262
translate chinese 0ed36d70:

    # think "Le silence retombe dans le sas. Pour la première fois depuis notre arrivée, nous venons de forcer Kami à reculer."
    think "气闸舱重新安静下来。自从抵达这里，这是我们第一次逼 Kami 退让。"

# game/scenario/7_1_0_1.rpy:263
translate chinese 19b248f9:

    # think "La jeune femme, elle, ne sait même pas que sa vie vient de faire l'objet d'un débat."
    think "至于那名年轻女子，她甚至不知道自己的性命刚刚成了辩论议题。"

# game/scenario/7_1_0_1.rpy:265
translate chinese 928d0820:

    # iris determine "Tomas, prends-la sous les épaules. Noam, les jambes."
    iris determine "Tomas，托住她的肩膀。Noam，抬腿。"

# game/scenario/7_1_0_1.rpy:267
translate chinese 09472796:

    # tomas inquiet "Je vais essayer de ne pas lui faire mal."
    tomas inquiet "我会尽量不弄疼她。"

# game/scenario/7_1_0_1.rpy:269
translate chinese 4e4f783e:

    # iris colere "N'essaie pas. Fais-le."
    iris colere "别尽量，必须做到。"

# game/scenario/7_1_0_1.rpy:271
translate chinese 711faa2c:

    # noam determine "À trois. Un... deux... trois."
    noam determine "数到三。一……二……三。"

# game/scenario/7_1_0_1.rpy:279
translate chinese 92ba9f46:

    # think "Nous la soulevons avec les couvertures de transport. Son corps est léger, beaucoup trop léger."
    think "我们连同搬运毯一起把她抬起。她的身体很轻，轻得过分。"

# game/scenario/7_1_0_1.rpy:281
translate chinese 11218178:

    # nyra raison "Je passe devant."
    nyra raison "我走前面。"

# game/scenario/7_1_0_1.rpy:283
translate chinese 22cd37ca:

    # iris inquiet "Gardez sa tête droite. Sa respiration est déjà assez mauvaise comme ça."
    iris inquiet "让她的头保持平直。她现在已经够难呼吸了。"

# game/scenario/7_1_0_1.rpy:289
translate chinese 28cc6d6d:

    # think "Nous traversons le couloir sans avoir à courir ni à éviter les caméras."
    think "我们穿过走廊，不必奔跑，也不必躲避摄像机。"

# game/scenario/7_1_0_1.rpy:290
translate chinese d92cf5e4:

    # think "Tous leurs voyants suivent notre progression. Pour une fois, être observés nous protège davantage que cela ne nous menace."
    think "所有指示灯都在追踪我们的移动。第一次，被监视反而比不被监视更能保护我们。"

# game/scenario/7_1_0_1.rpy:292
translate chinese f7332b96:

    # iris determine "Ralentissez au virage. Gardez son bassin au même niveau que ses épaules."
    iris determine "转弯时慢一点，让她的髋部和肩膀保持同一高度。"

# game/scenario/7_1_0_1.rpy:300
translate chinese 9a53bdac:

    # nyra determine "L'infirmerie est ouverte. Encore quelques mètres."
    nyra determine "医务室开了，再走几米。"

# game/scenario/7_1_0_1.rpy:302
translate chinese 5c87d895:

    # think "Le seuil est étroit. Tomas pivote le premier pendant que je dois maintenir tout le poids sans cogner le chambranle."
    think "门口很窄。Tomas 先转身，我则必须独自撑住全部重量，还不能让她撞上门框。"

# game/scenario/7_1_0_1.rpy:316
translate chinese 2ead7f5f:

    # think "La couverture se replie sous son dos et son épaule redescend brutalement."
    think "毯子在她背后折了起来，她的肩膀猛地往下坠。"

# game/scenario/7_1_0_1.rpy:318
translate chinese c9a2cfe0:

    # iris colere "Stop. Ne tirez pas sur ses bras. Reprenez sous les omoplates."
    iris colere "停。别拽她的胳膊，重新从肩胛骨下面托住。"

# game/scenario/7_1_0_1.rpy:320
translate chinese 6339a2b4:

    # tomas inquiet "Le tissu glisse, je n'arrive pas à la stabiliser."
    tomas inquiet "布一直在滑，我稳不住她。"

# game/scenario/7_1_0_1.rpy:322
translate chinese f131972d:

    # noam determine "Je remonte ses jambes. Reprends ta prise maintenant."
    noam determine "我把她的腿抬高，你现在重新抓稳。"

# game/scenario/7_1_0_1.rpy:324
translate chinese c502fca5:

    # think "Nous corrigeons le portage avant de repartir, avec plusieurs secondes perdues."
    think "我们调整好姿势才继续前进，又浪费了好几秒。"

# game/scenario/7_1_0_1.rpy:326
translate chinese 30787c1d:

    # think "Dans le virage, mon épaule heurte le mur et tout le poids bascule vers Tomas."
    think "转弯时，我的肩膀撞上墙壁，所有重量瞬间压向 Tomas。"

# game/scenario/7_1_0_1.rpy:328
translate chinese a3fcbabc:

    # tomas peur "Attends ! Je la perds !"
    tomas peur "等等！我要抓不住她了！"

# game/scenario/7_1_0_1.rpy:330
translate chinese 8eef95f1:

    # iris colere "Plaquez-vous contre le mur et remettez-la droite."
    iris colere "贴着墙，把她扶正。"

# game/scenario/7_1_0_1.rpy:332
translate chinese 09c62597:

    # noam inquiet "C'est bon. J'ai retrouvé son bassin. On repart doucement."
    noam inquiet "好了，我重新托住她的髋部了。慢慢走。"

# game/scenario/7_1_0_1.rpy:334
translate chinese 5d792f0e:

    # think "Nous retrouvons notre équilibre, mais notre progression s'est nettement ralentie."
    think "我们重新站稳，但速度明显慢了下来。"

# game/scenario/7_1_0_1.rpy:336
translate chinese 59abc8a2:

    # think "Le montant de la porte accroche la couverture et nous force à nous immobiliser."
    think "毯子被门框勾住，逼得我们停下。"

# game/scenario/7_1_0_1.rpy:338
translate chinese 7534a9c3:

    # nyra colere "Ne tirez pas, vous allez la faire tomber. Je dégage le tissu."
    nyra colere "别拽，会把她摔下来的。我来弄开。"

# game/scenario/7_1_0_1.rpy:340
translate chinese f25aecdd:

    # iris inquiet "Maintenez sa tête. Sa respiration devient irrégulière."
    iris inquiet "稳住她的头，她的呼吸开始紊乱了。"

# game/scenario/7_1_0_1.rpy:342
translate chinese b25590d7:

    # tomas determine "Je tiens. Faites vite."
    tomas determine "我撑得住，快点。"

# game/scenario/7_1_0_1.rpy:344
translate chinese 8997dcbb:

    # think "Nyra libère enfin la couverture et nous franchissons le seuil avec retard."
    think "Nyra 终于把毯子解开，我们耽搁了一阵才跨过门槛。"

# game/scenario/7_1_0_1.rpy:363
translate chinese 9d20395c:

    # think "Sael a déjà dégagé un lit. Elias pousse contre le mur un appareil de chauffage monté sur un pied métallique."
    think "Sael 已经腾出一张床。Elias 正把一台装在金属支架上的加热器推到墙边。"

# game/scenario/7_1_0_1.rpy:365
translate chinese c1fc8242:

    # sael determine "Posez-la ici. Doucement."
    sael determine "把她放这里，轻一点。"

# game/scenario/7_1_0_1.rpy:367
translate chinese 24a46ba8:

    # elias inquiet "Le chauffage est à fond, mais collez pas le truc contre elle. On la réchauffe, on la cuit pas."
    elias inquiet "加热器已经开到最大了，但别把那玩意贴在她身上。我们是要给她取暖，不是把她烤熟。"

# game/scenario/7_1_0_1.rpy:370
translate chinese 6389fdc3:

    # think "Tomas et moi déposons la jeune femme sur le lit. Sael glisse immédiatement une main sous sa nuque."
    think "Tomas 和我把年轻女子放到床上。Sael 立刻伸手托住她的后颈。"

# game/scenario/7_1_0_1.rpy:372
translate chinese ac6b5c13:

    # sael inquiet "Depuis combien de temps est-elle inconsciente ?"
    sael inquiet "她昏迷多久了？"

# game/scenario/7_1_0_1.rpy:374
translate chinese aa28969a:

    # iris desaccord "On n'en sait rien. Elle était déjà comme ça quand on l'a trouvée."
    iris desaccord "不知道。我们发现她时，她已经这样了。"

# game/scenario/7_1_0_1.rpy:376
translate chinese 95b9d686:

    # sael determine "Respiration faible. Pouls lent. Elias, les poches chauffantes."
    sael determine "呼吸微弱，脉搏缓慢。Elias，把热敷袋拿来。"

# game/scenario/7_1_0_1.rpy:378
translate chinese 7877e2a0:

    # elias determine "J'en ai quatre. Deux sont encore froides."
    elias determine "我有四个，还有两个是冷的。"

# game/scenario/7_1_0_1.rpy:380
translate chinese 9eb49abd:

    # iris colere "Alors active-les au lieu de faire l'inventaire."
    iris colere "那就赶紧启动，别在这里报库存。"

# game/scenario/7_1_0_1.rpy:382
translate chinese c5deeab9:

    # elias colere "Je sais, bordel. J'essaie juste de pas faire une connerie."
    elias colere "我知道，该死。我只是不想弄出更大的问题。"

# game/scenario/7_1_0_1.rpy:384
translate chinese 9b72f73e:

    # nyra raison "Vous avez besoin de nous ?"
    nyra raison "需要我们帮忙吗？"

# game/scenario/7_1_0_1.rpy:386
translate chinese 2dd03b77:

    # sael determine "Pas tous. Trop de monde ne fera que nous gêner. Iris peut rester."
    sael determine "不用全留下。人太多只会碍事，Iris 可以留下。"

# game/scenario/7_1_0_1.rpy:388
translate chinese 3e327af4:

    # noam inquiet "Elle va survivre ?"
    noam inquiet "她能活下来吗？"

# game/scenario/7_1_0_1.rpy:390
translate chinese fab7319f:

    # sael triste "Je ne vais pas te répondre au hasard pour te rassurer."
    sael triste "我不会为了安慰你就随口乱说。"

# game/scenario/7_1_0_1.rpy:392
translate chinese 3446ac5a:

    # sael determine "Sa température est dangereusement basse, mais elle respire encore. Pour le moment, c'est tout ce que je peux affirmer."
    sael determine "她的体温低得危险，但还在呼吸。目前我只能确定这一点。"

# game/scenario/7_1_0_1.rpy:396
translate chinese 0ab4f1f3:

    # iris determine "Je reste avec eux."
    iris determine "我留下来帮他们。"

# game/scenario/7_1_0_1.rpy:398
translate chinese dd67de04:

    # tomas inquiet "On devrait peut-être chercher son identité. Dans les registres de la livraison, il y a forcément..."
    tomas inquiet "也许我们该查查她的身份。补给记录里肯定有……"

# game/scenario/7_1_0_1.rpy:400
translate chinese 8e07f4eb:

    # nyra raison "Plus tard. Laissons-les travailler."
    nyra raison "以后再说。让他们先工作。"

# game/scenario/7_1_0_1.rpy:402
translate chinese 0f6727b1:

    # noam neutre "Prévenez-nous dès qu'elle se réveille."
    noam neutre "她一醒就通知我们。"

# game/scenario/7_1_0_1.rpy:404
translate chinese b54ef912:

    # sael determine "Si elle se réveille."
    sael determine "如果她能醒的话。"

# game/scenario/7_1_0_1.rpy:408
translate chinese 6e538881:

    # think "Sael se détourne déjà de nous. Elias ouvre un compartiment de matériel et Iris remonte les couvertures jusqu'au menton de la jeune femme."
    think "Sael 已经转身不再理会我们。Elias 打开器材柜，Iris 则把毯子一直拉到年轻女子的下巴。"

# game/scenario/7_1_0_1.rpy:409
translate chinese 38e1fded:

    # think "Nous quittons l'infirmerie avec le sentiment d'avoir fait le seul choix possible, sans savoir s'il était le bon."
    think "我们离开医务室。我们似乎做出了唯一能做的选择，却不知道它是否正确。"

# game/scenario/7_1_0_1.rpy:436
translate chinese d0c9ad55:

    # think "Une heure plus tard, Kami exige que nous nous réunissions à la cafétéria."
    think "一小时后，Kami 要求我们全部到餐厅集合。"

# game/scenario/7_1_0_1.rpy:437
translate chinese 02ecfe23:

    # think "Sael et Elias ont quitté l'infirmerie le temps de l'annonce. Iris surveille la porte depuis l'autre bout de la pièce."
    think "Sael 和 Elias 暂时离开医务室来听公告，Iris 则在房间另一头一直盯着门口。"

# game/scenario/7_1_0_1.rpy:439
translate chinese ee609919:

    # ryn surpris "Donc quelqu'un a vraiment traversé la frontière dans la livraison ?"
    ryn surpris "所以真有人藏在补给里穿过了边界？"

# game/scenario/7_1_0_1.rpy:441
translate chinese b55ae77c:

    # noam raison "On ne sait pas encore d'où elle vient ni comment elle est montée dans la capsule."
    noam raison "我们还不知道她从哪里来，也不知道她是怎么进入补给舱的。"

# game/scenario/7_1_0_1.rpy:443
translate chinese 9e7c5a50:

    # mara mefiant "Et Kami a accepté de la garder ici ? Comme ça ?"
    mara mefiant "Kami 就这么同意让她留下？"

# game/scenario/7_1_0_1.rpy:445
translate chinese 898d979f:

    # lysa blase "Non. Kami a accepté de ne pas tirer dans sa propre maison. Nuance."
    lysa blase "不。Kami 只是同意不朝自己家里开炮，差别很大。"

# game/scenario/7_1_0_1.rpy:447
translate chinese fb64a916:

    # julian inquiet "Elle est consciente ?"
    julian inquiet "她有意识吗？"

# game/scenario/7_1_0_1.rpy:449
translate chinese e7b2b30e:

    # sael neutre "Pas encore."
    sael neutre "还没有。"

# game/scenario/7_1_0_1.rpy:451
translate chinese a7736478:

    # elen inquiet "Elle va s'en sortir ?"
    elen inquiet "她能撑过去吗？"

# game/scenario/7_1_0_1.rpy:453
translate chinese bc59aab5:

    # elias neutre "On fait ce qu'on peut."
    elias neutre "我们正在尽力。"

# game/scenario/7_1_0_1.rpy:464
translate chinese f7becad3:

    # kami "Maintenant que tout le monde connaît la nouvelle, permettez-moi de vous présenter officiellement votre invitée indésirable !"
    kami "既然所有人都知道了这个消息，就请允许我正式介绍一下你们这位不受欢迎的客人！"

# game/scenario/7_1_0_1.rpy:468
translate chinese 72808963:

    # kami "Une jeune femme sans badge, sans invitation et, pour l'instant, sans la courtoisie élémentaire de nous donner son nom."
    kami "一名没有徽章、没有邀请，而且暂时连报上姓名这种基本礼貌都不肯做到的年轻女子。"

# game/scenario/7_1_0_1.rpy:472
translate chinese 0477b24e:

    # kami "Elle restera à l'infirmerie jusqu'à ce que son état permette de la déplacer. Elle quittera ensuite le Conclave lors de la livraison du jour quatorze."
    kami "她会留在医务室，直到身体状况允许转移。之后，她将在第十四天的补给到来时离开议会。"

# game/scenario/7_1_0_1.rpy:476
translate chinese 0d08181d:

    # kami "Je vous rappelle qu'elle n'est pas une représentante. Elle n'a aucune voix, aucun siège et aucun droit d'interrompre vos débats avec ses opinions de passagère clandestine."
    kami "提醒一下，她不是代表。她没有投票权，没有席位，也无权用偷渡客的意见打断你们的辩论。"

# game/scenario/7_1_0_1.rpy:480
translate chinese af48f6bc:

    # kami "En revanche, elle possède une bouche. Une bouche supplémentaire, précisément."
    kami "不过，她倒是有一张嘴。准确来说，是多出来的一张嘴。"

# game/scenario/7_1_0_1.rpy:484
translate chinese 5ec18cdd:

    # kami "Les portions du Conclave ont été calculées pour douze personnes. Vous êtes désormais treize à consommer l'air, l'eau et surtout la nourriture que j'avais si généreusement prévue."
    kami "议会的配给是按十二个人计算的。现在却有十三个人在消耗我慷慨准备的空气、水，尤其是食物。"

# game/scenario/7_1_0_1.rpy:488
translate chinese e505f46e:

    # kami "Je vous laisse donc décider qui mangera un peu moins. Voilà une charmante occasion de transformer votre compassion en quantité mesurable !"
    kami "所以就由你们来决定谁少吃一点吧。多么温馨的机会，可以把你们的同情心换算成具体分量！"

# game/scenario/7_1_0_1.rpy:507
translate chinese 117ddf42:

    # ryn colere "Tu viens de rétablir le commerce. Fais venir une portion de plus."
    ryn colere "你才刚恢复贸易。多送一份过来。"

# game/scenario/7_1_0_1.rpy:513
translate chinese c15128cd:

    # kami "Quelle excellente suggestion ! Elle arrivera avec la prochaine livraison. Celle qui la ramènera."
    kami "真是个好主意！下一批补给就会送到，也就是把她送回去的那一批。"

# game/scenario/7_1_0_1.rpy:532
translate chinese fd85314a:

    # noam determine "On répartira nos portions. Personne ne la laissera mourir de faim."
    noam determine "我们会分出自己的配给，没人会让她饿死。"

# game/scenario/7_1_0_1.rpy:534
translate chinese 819c1e24:

    # nyra raison "Et puisque tu as officiellement reconnu sa présence, chaque prélèvement à l'infirmerie sera justifié."
    nyra raison "既然你已经正式承认她的存在，医务室取用的每一样物资都有了正当理由。"

# game/scenario/7_1_0_1.rpy:540
translate chinese 617470d0:

    # kami "Oui, Nyra. J'avais compris la conséquence de ma propre décision. Merci."
    kami "是的，Nyra。我明白自己这个决定会带来什么后果，谢谢提醒。"

# game/scenario/7_1_0_1.rpy:544
translate chinese 4a623556:

    # kami "Occupez-vous d'elle. J'aimerais au moins savoir qui a eu l'audace de s'expédier jusqu'ici avant de la renvoyer."
    kami "照顾好她。至少在把她送回去之前，我想知道究竟是谁胆大到把自己邮寄到这里来。"

# game/scenario/7_1_0_1.rpy:569
translate chinese 5d4d8b8b:

    # mara mefiant "Bon. Qui veut mon dessert ?"
    mara mefiant "好吧，谁要我的甜点？"

# game/scenario/7_1_0_1.rpy:571
translate chinese 9f02da05_1:

    # elen triste "Mara..."
    elen triste "Mara……"

# game/scenario/7_1_0_1.rpy:573
translate chinese 7455a285:

    # mara neutre "Quoi ? Elle aura besoin de manger quand elle se réveillera. Moi, je survivrai sans crème au chocolat."
    mara neutre "怎么？她醒来后得吃东西，我少吃一份巧克力奶油也死不了。"

# game/scenario/7_1_0_1.rpy:575
translate chinese 3423e682:

    # lysa taquin "Le sacrifice ultime. On devrait graver une plaque."
    lysa taquin "真是至高无上的牺牲。我们应该刻块纪念牌。"

# game/scenario/7_1_0_1.rpy:577
translate chinese 1c673504:

    # julian sourire "Je cède également le mien. Avec un peu plus de dignité, si possible."
    julian sourire "我的也给她。可以的话，我会表现得更有尊严一点。"

# game/scenario/7_1_0_1.rpy:579
translate chinese 3c964a53:

    # ryn determine "On fera un roulement. Une petite partie de chaque plateau."
    ryn determine "我们轮流来，每个人从餐盘里分出一点。"

# game/scenario/7_1_0_1.rpy:581
translate chinese 67eb60d9:

    # sael neutre "Elle n'avalera rien de solide aujourd'hui. Gardez vos effets d'annonce pour plus tard."
    sael neutre "她今天吃不了固体食物。你们那些慷慨宣言还是留到以后吧。"

# game/scenario/7_1_0_1.rpy:583
translate chinese 11f1e2f2:

    # iris desaccord "Sael a raison. Pour l'instant, elle a surtout besoin qu'on arrête de parler d'elle comme si elle était déjà réveillée."
    iris desaccord "Sael 说得对。现在她最需要的，是我们别再把她当成已经醒了的人议论。"

# game/scenario/7_1_0_1.rpy:585
translate chinese 8e4cac68:

    # noam neutre "Retournez manger. On fera le point cet après-midi."
    noam neutre "回去吃饭吧，下午再看看情况。"

# game/scenario/7_1_0_1.rpy:589
translate chinese e401a01e:

    # think "Les conversations reprennent lentement, mais personne ne parvient à revenir à la routine."
    think "谈话缓慢地恢复，但谁也没法真正回到日常状态。"

# game/scenario/7_1_0_1.rpy:590
translate chinese ef5afe3b:

    # think "Une treizième place n'a même pas été ajoutée à la table. Pourtant, son absence occupe déjà toute la pièce."
    think "桌边甚至还没添上第十三个座位，可她的缺席已经占据了整个房间。"

# game/scenario/7_1_0_1.rpy:604
translate chinese c9405725:

    # think "L'après-midi commence sans nouvelle de l'infirmerie."
    think "下午开始了，医务室仍然没有消息。"

# game/scenario/7_1_0_1.rpy:605
translate chinese e6489400:

    # think "Sael nous a demandé de ne pas venir toutes les cinq minutes. Pour une fois, la meilleure manière d'aider consiste à la laisser travailler."
    think "Sael 让我们别每隔五分钟就去一趟。难得这一次，最好的帮忙方式就是别妨碍她工作。"

# game/scenario/7_1_0_1.rpy:619
translate chinese cda8c0c0:

    # think "Mon temps libre terminé, je retourne vers l'infirmerie."
    think "自由活动结束后，我回到医务室。"

# game/scenario/7_1_0_1.rpy:620
translate chinese db1734e1:

    # think "Cette fois, personne ne m'arrête devant la porte."
    think "这一次，没人拦在门口阻止我进去。"

# game/scenario/7_1_0_1.rpy:639
translate chinese cb804fb4:

    # think "La jeune femme repose toujours au centre du lit. Le givre a disparu de ses cheveux, mais son visage reste livide."
    think "年轻女子依然躺在床中央。头发上的霜已经消失，脸色却还是一片惨白。"

# game/scenario/7_1_0_1.rpy:640
translate chinese aa68848b:

    # think "Sael est assise près d'elle. Elias maintient ouvert le boîtier du chauffage avec un tournevis."
    think "Sael 坐在她身边。Elias 用螺丝刀撑开加热器的外壳。"

# game/scenario/7_1_0_1.rpy:642
translate chinese 66242c80:

    # noam inquiet "Elle ne s'est toujours pas réveillée ?"
    noam inquiet "她还没醒？"

# game/scenario/7_1_0_1.rpy:644
translate chinese 24ef9290:

    # sael fatigue "Non."
    sael fatigue "没有。"

# game/scenario/7_1_0_1.rpy:646
translate chinese e2f307d5:

    # noam inquiet "Mais elle va mieux ?"
    noam inquiet "但情况好些了吗？"

# game/scenario/7_1_0_1.rpy:648
translate chinese 94b4a0e3:

    # sael neutre "Sa température remonte. Son pouls est plus stable et sa respiration moins difficile."
    sael neutre "体温在回升，脉搏更稳定，呼吸也没那么困难了。"

# game/scenario/7_1_0_1.rpy:650
translate chinese ac45b8e5:

    # elias fatigue "En gros, elle meurt moins que ce matin. C'est déjà ça."
    elias fatigue "简单来说，她没早上那么接近死亡了。也算是好消息。"

# game/scenario/7_1_0_1.rpy:652
translate chinese 43e83900:

    # sael desaccord "La formulation est affreuse."
    sael desaccord "这说法太难听了。"

# game/scenario/7_1_0_1.rpy:654
translate chinese c07adf43:

    # elias mefiant "Mais elle est vraie."
    elias mefiant "但很准确。"

# game/scenario/7_1_0_1.rpy:656
translate chinese c47be25f:

    # noam raison "Vous avez trouvé son nom ?"
    noam raison "你们查到她的名字了吗？"

# game/scenario/7_1_0_1.rpy:658
translate chinese 00ba26dc:

    # sael neutre "Aucun document. Aucun badge. Rien dans ses vêtements."
    sael neutre "没有证件，没有徽章，衣服里什么都没有。"

# game/scenario/7_1_0_1.rpy:660
translate chinese 8768b871:

    # elias neutre "Juste un bout de tissu cousu dans sa veste. J'ai regardé, y a rien d'écrit dessus."
    elias neutre "只有一小块缝在外套里的布。我检查过，上面什么都没写。"

# game/scenario/7_1_0_1.rpy:662
translate chinese 95083401:

    # noam reflechit "Elle a peut-être retiré tout ce qui pouvait permettre de la suivre."
    noam reflechit "她也许把所有能追踪到她的东西都拿掉了。"

# game/scenario/7_1_0_1.rpy:664
translate chinese 74261354:

    # sael raison "Ou quelqu'un l'a fait à sa place. Nous n'en savons rien."
    sael raison "也可能是别人替她拿掉的。我们什么都不知道。"

# game/scenario/7_1_0_1.rpy:668
translate chinese f37bd4eb:

    # think "Je m'approche du lit. Sa respiration reste faible, mais elle ne produit plus le bruit rauque de ce matin."
    think "我走近床边。她的呼吸依然微弱，却已经不再发出早上那种沙哑的声音。"

# game/scenario/7_1_0_1.rpy:670
translate chinese 765ba8f7:

    # noam inquiet "Elle peut rester inconsciente combien de temps ?"
    noam inquiet "她可能会昏迷多久？"

# game/scenario/7_1_0_1.rpy:672
translate chinese 36ea4b0d:

    # sael neutre "Quelques heures. Davantage. Cela dépend de ce qu'elle a subi avant d'arriver."
    sael neutre "几小时，也可能更久。要看她抵达前经历过什么。"

# game/scenario/7_1_0_1.rpy:674
translate chinese 97dca7ae:

    # noam triste "Et si elle ne se réveille pas ?"
    noam triste "如果她一直醒不过来呢？"

# game/scenario/7_1_0_1.rpy:676
translate chinese 4fb08af7:

    # sael desaccord "Alors nous gérerons ce problème lorsqu'il se présentera. Pas avant."
    sael desaccord "那就等问题真的出现时再处理，而不是现在。"

# game/scenario/7_1_0_1.rpy:678
translate chinese 603083ec:

    # elias neutre "On va continuer à la chauffer doucement. Le machin tient, mais faut le surveiller."
    elias neutre "我们会继续慢慢给她取暖。这东西还能用，但得有人盯着。"

# game/scenario/7_1_0_1.rpy:680
translate chinese 0f417506:

    # noam surpris "Tu l'as réparé ?"
    noam surpris "你把它修好了？"

# game/scenario/7_1_0_1.rpy:682
translate chinese 5afeb3e0:

    # elias mefiant "Réparé, c'est un grand mot. Disons qu'il a arrêté de faire des étincelles."
    elias mefiant "说修好有点夸张。只能说它终于不再冒火花了。"

# game/scenario/7_1_0_1.rpy:684
translate chinese a06f7947:

    # sael colere "Il en a fait une seule."
    sael colere "它就冒了一次。"

# game/scenario/7_1_0_1.rpy:686
translate chinese 3d66d6a2:

    # elias colere "Une étincelle dans une infirmerie, c'est déjà une de trop."
    elias colere "在医务室里，一次火花都嫌多。"

# game/scenario/7_1_0_1.rpy:690
translate chinese b6628dd3:

    # noam neutre "Je peux prendre le relais pour la surveiller."
    noam neutre "我可以接班照看她。"

# game/scenario/7_1_0_1.rpy:692
translate chinese a8a4c7a2:

    # sael determine "Non. Tu ne sais pas quoi surveiller."
    sael determine "不行，你根本不知道该观察什么。"

# game/scenario/7_1_0_1.rpy:694
translate chinese b980c8c5:

    # noam desaccord "Je peux au moins rester là pendant que vous mangez."
    noam desaccord "至少你们去吃饭时，我可以留在这里。"

# game/scenario/7_1_0_1.rpy:696
translate chinese 1f8e0085:

    # sael raison "Iris viendra dans quelques minutes. Elias et moi partirons ensuite."
    sael raison "Iris 几分钟后会过来，之后 Elias 和我再离开。"

# game/scenario/7_1_0_1.rpy:698
translate chinese f91ace4c:

    # elias neutre "On s'en occupe. Va respirer un coup."
    elias neutre "这里有我们。你去喘口气吧。"

# game/scenario/7_1_0_1.rpy:700
translate chinese 0018b1d6:

    # noam inquiet "Prévenez-moi dès qu'elle ouvre les yeux."
    noam inquiet "她一睁眼就通知我。"

# game/scenario/7_1_0_1.rpy:702
translate chinese fc3cc00e:

    # sael neutre "Nous préviendrons tout le monde. Sa présence n'est plus un secret."
    sael neutre "我们会通知所有人。她的存在已经不是秘密了。"

# game/scenario/7_1_0_1.rpy:704
translate chinese 48f65ecb:

    # think "Je hoche la tête. Cette évidence devrait me rassurer. Pourtant, je continue d'avoir l'impression que chaque caméra braquée sur elle attend une faute."
    think "我点了点头。这个事实本该让我安心，可我还是觉得，每一台对着她的摄像机都在等我们犯错。"

# game/scenario/7_1_0_1.rpy:710
translate chinese 04a9f2c9:

    # elias mefiant "Ça, c'est pour nous ?"
    elias mefiant "这话是在说我们吗？"

# game/scenario/7_1_0_1.rpy:712
translate chinese b6f4be57:

    # sael fatigue "Avec Kami, tout finit toujours par être pour nous."
    sael fatigue "只要有 Kami，最后什么事都会落到我们头上。"

# game/scenario/7_1_0_1.rpy:743
translate chinese bd588c4e:

    # think "Kami nous convoque dans la salle du Conclave avant le dîner."
    think "晚餐前，Kami 把我们召集到议事厅。"

# game/scenario/7_1_0_1.rpy:744
translate chinese ecc87d4f:

    # think "Iris arrive la dernière. Elle confirme d'un signe que la jeune femme respire toujours, puis rejoint sa place."
    think "Iris 最后一个到。她用一个眼神确认年轻女子仍在呼吸，随后回到自己的位置。"

# game/scenario/7_1_0_1.rpy:751
translate chinese f9e49fd0:

    # kami "Mes chers représentants, les distractions de ce matin ont légèrement perturbé notre programme."
    kami "我亲爱的代表们，今早那些小插曲稍微打乱了我们的日程。"

# game/scenario/7_1_0_1.rpy:755
translate chinese bd61b3fd:

    # kami "Entre la passagère congelée, les menaces de perforation de coque et votre soudaine passion pour les subtilités juridiques, je n'ai même pas pu annoncer votre prochain vote."
    kami "又是冻僵的偷渡客，又是威胁我会击穿船体，还有你们突然迷上的法律细节，害得我连下一次投票都没来得及宣布。"

# game/scenario/7_1_0_1.rpy:759
translate chinese 47f7336d:

    # kami "Nous allons donc parler du Commandement IV, celui qui interdit les rassemblements et les organisations non autorisées."
    kami "所以，我们要谈谈第四戒律，也就是禁止未经许可的集会与组织活动的那一条。"

# game/scenario/7_1_0_1.rpy:765
translate chinese 4e4b2594:

    # kami "La proposition soumise au vote sera la suivante : autoriser les regroupements de plus de vingt personnes, sous réserve d'une demande d'autorisation préalable."
    kami "提交表决的提案如下：允许二十人以上的集会，但必须提前申请许可。"

# game/scenario/7_1_0_1.rpy:769
translate chinese eac2c6bd:

    # kami "Le lieu, la date, l'objet du rassemblement et l'identité des organisateurs devront être communiqués à Archive avant toute réunion."
    kami "任何集会开始前，都必须向 Archive 通报地点、日期、目的以及组织者的身份。"

# game/scenario/7_1_0_1.rpy:773
translate chinese c42b3ea5:

    # kami "Une liberté sous formulaire. C'est presque poétique."
    kami "填表才能享受的自由，几乎有点诗意。"

# game/scenario/7_1_0_1.rpy:777
translate chinese 65176637:

    # kami "Le vote aura lieu à la fin du jour neuf. Vous disposez donc de deux jours pour déterminer si vingt et une personnes constituent une communauté ou déjà une menace."
    kami "投票将在第九天结束时举行。所以你们有两天时间，判断二十一个人究竟算一个群体，还是已经构成威胁。"

# game/scenario/7_1_0_1.rpy:781
translate chinese 05a3e288:

    # kami "Et puisque vous avez réclamé l'application exacte des règles ce matin, j'attends de vous une rigueur exemplaire. Aucun argument improvisé, aucune interruption et, idéalement, aucun coup au visage."
    kami "既然你们今早要求严格照章办事，那我也期待你们拿出堪称典范的严谨态度。不要临时编论点，不要打断别人，最好也别再往谁脸上来一拳。"

# game/scenario/7_1_0_1.rpy:804
translate chinese 45f7b33b:

    # ryn determine "Des regroupements autorisés pourraient permettre aux familles séparées de se retrouver et de s'organiser."
    ryn determine "允许集会，就能让失散的家人重聚并组织起来。"

# game/scenario/7_1_0_1.rpy:806
translate chinese de856bc0:

    # sael mefiant "Ou aux réseaux qui utilisent les cargaisons de recruter plus facilement."
    sael mefiant "也能让那些利用货运的网络更容易招募人手。"

# game/scenario/7_1_0_1.rpy:808
translate chinese cb750430:

    # nyra raison "Nous ignorons encore si cette femme appartenait à un réseau."
    nyra raison "我们还不知道这个女人是否属于某个网络。"

# game/scenario/7_1_0_1.rpy:810
translate chinese 6fc662a5:

    # lysa blase "Attendez au moins qu'elle se réveille avant de transformer son coma en argument électoral."
    lysa blase "至少先等她醒来，再把她的昏迷当成拉票论据吧。"

# game/scenario/7_1_0_1.rpy:812
translate chinese 2c8d0a5e:

    # noam determine "Lysa a raison. On en parlera demain."
    noam determine "Lysa 说得对，明天再谈。"

# game/scenario/7_1_0_1.rpy:814
translate chinese 15f262ee:

    # iris colere "Demain. Quand j'aurai dormi et qu'elle aura, avec un peu de chance, fait la même chose."
    iris colere "明天。等我睡过一觉，也等她运气好能睡过这一关。"

# game/scenario/7_1_0_1.rpy:818
translate chinese d228644c:

    # think "Nous quittons la salle sans commencer le débat. Pour une fois, personne ne cherche à retenir les autres."
    think "我们没有开始辩论便离开了议事厅。难得这一次，没人试图留下其他人。"

# game/scenario/7_1_0_1.rpy:832
translate chinese 50abf5b0:

    # think "Je retourne vers ma chambre. La porte de l'infirmerie reste fermée, mais sa lumière est encore allumée."
    think "我朝自己的房间走去。医务室的门依然紧闭，里面却还亮着灯。"

# game/scenario/7_1_0_1.rpy:833
translate chinese 307c335d:

    # think "La jeune femme n'a toujours pas ouvert les yeux. Pourtant, elle a déjà obtenu une semaine de sursis et changé le prochain débat."
    think "年轻女子还是没有睁开眼睛，但她已经争取到一周缓期，也改变了下一场辩论。"

# game/scenario/7_1_0_1.rpy:834
translate chinese 2eac2fa6:

    # think "Au jour quatorze, Kami exigera qu'elle reparte. D'ici là, il faudra découvrir qui elle est et ce qu'elle fuyait."
    think "到了第十四天，Kami 会要求她离开。在那之前，我们必须查清她是谁，又在逃避什么。"

