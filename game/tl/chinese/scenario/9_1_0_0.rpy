    # anya reflexion "Il avait pas vraiment l'air surpris."
    anya reflexion "他看上去并不怎么惊讶。"

# game/scenario/9_1_0_0.rpy:1002
translate chinese 6d692573:

    # noam inquiet "Pas vraiment ou pas du tout ?"
    noam inquiet "是不怎么，还是完全不？"

# game/scenario/9_1_0_0.rpy:1004
translate chinese 58390841:

    # anya "Pas du tout."
    anya "完全不。"

# game/scenario/9_1_0_0.rpy:1006
translate chinese 86b7f9bb:

    # "Nyra et moi échangeons un regard."
    "我和 Nyra 交换了一个眼神。"

# game/scenario/9_1_0_0.rpy:1008
translate chinese aa20e3e0:

    # nyra raison "Il savait donc probablement que quelqu'un était ici."
    nyra raison "那他多半事先就知道这里有人。"

# game/scenario/9_1_0_0.rpy:1010
translate chinese 776b6834:

    # anya "C'est l'impression que j'ai eue."
    anya "我当时就是这种感觉。"

# game/scenario/9_1_0_0.rpy:1012
translate chinese 91fdc97f:

    # noam reflexion "Qu'est-ce qu'il a dit ?"
    noam reflexion "他说了什么？"

# game/scenario/9_1_0_0.rpy:1014
translate chinese fb58990d:

    # anya "Il a fermé la porte derrière lui et il m'a demandé si j'étais arrivée avec la dernière livraison."
    anya "他把门关上，然后问我是不是随最近那批货进来的。"

# game/scenario/9_1_0_0.rpy:1016
translate chinese 79f5c7d2:

    # noam surpris "Directement ?"
    noam surpris "一上来就问？"

# game/scenario/9_1_0_0.rpy:1018
translate chinese 5a6cfcfc_2:

    # anya "Oui."
    anya "一上来就问。"

# game/scenario/9_1_0_0.rpy:1020
translate chinese 190c2867:

    # "Mon malaise augmente immédiatement."
    "我的不安立刻加重了。"

# game/scenario/9_1_0_0.rpy:1022
translate chinese ca868ca0:

    # noam reflexion "Il n'a même pas demandé qui tu étais ?"
    noam reflexion "他连你是谁都没问？"

# game/scenario/9_1_0_0.rpy:1024
translate chinese f68774f5:

    # anya "Pas au début."
    anya "一开始没问。"

# game/scenario/9_1_0_0.rpy:1026
translate chinese 1ce15222:

    # nyra "Est-ce qu'il a donné l'impression de reconnaître ton visage ?"
    nyra "他有没有表现出认得你这张脸？"

# game/scenario/9_1_0_0.rpy:1028
translate chinese dcd539ef:

    # anya "Non. Ça, je pense pas."
    anya "没有。这个我觉得没有。"

# game/scenario/9_1_0_0.rpy:1030
translate chinese 4d8fbf31:

    # nyra reflexion "Donc il ne te connaissait probablement pas personnellement."
    nyra reflexion "那他多半并不认识你本人。"

# game/scenario/9_1_0_0.rpy:1032
translate chinese 46be1cb7:

    # anya "J'imagine."
    anya "我想是吧。"

# game/scenario/9_1_0_0.rpy:1034
translate chinese 70563e82:

    # noam "Et après ?"
    noam "然后呢？"

# game/scenario/9_1_0_0.rpy:1036
translate chinese 6bf50f7e:

    # anya reflexion "Après, je lui ai demandé s'il allait appeler Kami."
    anya reflexion "然后我问他会不会去叫 Kami。"

# game/scenario/9_1_0_0.rpy:1038
translate chinese 4a8c417e:

    # "Elle hausse les épaules."
    "她耸了耸肩。"

# game/scenario/9_1_0_0.rpy:1040
translate chinese da1ba56b:

    # anya "Il m'a dit non."
    anya "他说不会。"

# game/scenario/9_1_0_0.rpy:1042
translate chinese f3da6531_2:

    # noam surpris "C'est tout ?"
    noam surpris "就这样？"

# game/scenario/9_1_0_0.rpy:1044
translate chinese 35d4fe80:

    # anya "À peu près."
    anya "差不多。"

# game/scenario/9_1_0_0.rpy:1046
translate chinese 0be6aa9e:

    # anya "J'ai insisté parce que, vous allez rire, découvrir un inconnu dans la chambre où on me cache depuis moins d'une journée m'a pas spécialement mise en confiance."
    anya "我追问了，因为——说出来你们别笑——在藏了不到一天的房间里突然冒出一个陌生人，实在没法让我安心。"

# game/scenario/9_1_0_0.rpy:1048
translate chinese 56314dc0:

    # noam desaccord "Étrange."
    noam desaccord "奇怪。"

# game/scenario/9_1_0_0.rpy:1050
translate chinese 9869e21e:

    # anya taquin "Je sais."
    anya taquin "我知道。"

# game/scenario/9_1_0_0.rpy:1052
translate chinese 5c5845a5:

    # anya reflexion "Mais il a dit qu'il ne raconterait rien. À personne."
    anya reflexion "但他说他不会说出去。对谁都不说。"

# game/scenario/9_1_0_0.rpy:1054
translate chinese dcc0b36e:

    # nyra "Il t'a demandé quelque chose en échange ?"
    nyra "他有没有要你拿什么来交换？"

# game/scenario/9_1_0_0.rpy:1056
translate chinese 63b9a7de_1:

    # anya "Non."
    anya "没有。"

# game/scenario/9_1_0_0.rpy:1058
translate chinese 51292606:

    # noam reflexion "Il t'a menacée ?"
    noam reflexion "他威胁你了？"

# game/scenario/9_1_0_0.rpy:1060
translate chinese 0a1235c9:

    # anya "Non plus."
    anya "也没有。"

# game/scenario/9_1_0_0.rpy:1062
translate chinese d2372607:

    # anya desaccord "Vous avez l'air de vouloir absolument qu'il se soit comporté comme un psychopathe."
    anya desaccord "你们好像非要他表现得像个变态才甘心。"

# game/scenario/9_1_0_0.rpy:1064
translate chinese cf7fd47c:

    # noam "On veut comprendre."
    noam "我们只是想弄明白。"

# game/scenario/9_1_0_0.rpy:1066
translate chinese 5daff458:

    # anya "Alors pour l'instant, il a été beaucoup moins inquiétant que vous deux."
    anya "那到目前为止，他可比你们俩安全多了。"

# game/scenario/9_1_0_0.rpy:1068
translate chinese 00fd6ea9:

    # noam surpris "Nous ?"
    noam surpris "我们？"

# game/scenario/9_1_0_0.rpy:1070
translate chinese 814bc51c:

    # anya "Je vous rappelle comment j'ai rencontré Iris hier matin ?"
    anya "要我提醒你，我昨天早上是怎么认识 Iris 的吗？"

# game/scenario/9_1_0_0.rpy:1072
translate chinese 0cc82d84:

    # noam gene "D'accord, mauvais exemple."
    noam gene "好吧，例子举得不好。"

# game/scenario/9_1_0_0.rpy:1074
translate chinese 03ac5c6d:

    # "Anya esquisse un petit sourire, mais Nyra reste concentrée sur son récit."
    "Anya 露出一丝笑，但 Nyra 依旧专注在她的叙述上。"

# game/scenario/9_1_0_0.rpy:1076
translate chinese d4d514e5:

    # nyra raison "Tu as dit qu'il t'avait posé des questions."
    nyra raison "你说他问了你一些问题。"

# game/scenario/9_1_0_0.rpy:1078
translate chinese 605dcab7:

    # anya reflexion "Oui."
    anya reflexion "对。"

# game/scenario/9_1_0_0.rpy:1080
translate chinese e983a045:

    # nyra "Lesquelles ?"
    nyra "哪些？"

# game/scenario/9_1_0_0.rpy:1082
translate chinese 8371631d:

    # anya "Au début, des trucs assez normaux. D'où je venais, depuis combien de temps j'étais coincée à Limen, pourquoi j'avais pris ce risque."
    anya "一开始是些挺正常的。我从哪儿来，在 Limen 困了多久，为什么要冒这个险。"

# game/scenario/9_1_0_0.rpy:1084
translate chinese dcccb01f:

    # noam "Et ensuite ?"
    noam "然后呢？"

# game/scenario/9_1_0_0.rpy:1086
translate chinese b3150ac1:

    # "Son expression devient plus sérieuse."
    "她的表情严肃了起来。"

# game/scenario/9_1_0_0.rpy:1088
translate chinese b0d125fd:

    # anya reflexion "Ensuite il a commencé à parler du réseau."
    anya reflexion "然后他开始问起那个网络。"

# game/scenario/9_1_0_0.rpy:1090
translate chinese 7be3838f:

    # nyra "Le réseau qui t'a fait entrer dans le conteneur ?"
    nyra "就是把你弄进集装箱的那个网络？"

# game/scenario/9_1_0_0.rpy:1092
translate chinese 5a6cfcfc_3:

    # anya "Oui."
    anya "对。"

# game/scenario/9_1_0_0.rpy:1094
translate chinese 535e67de:

    # anya "Il voulait savoir comment je l'avais trouvé, qui m'avait mise en contact, si j'avais vu les personnes qui organisaient les passages..."
    anya "他想知道我是怎么找到他们的，是谁牵的线，我有没有见过安排偷渡的人……"

# game/scenario/9_1_0_0.rpy:1096
translate chinese 26eae19f:

    # noam reflexion "Tu connaissais leurs noms ?"
    noam reflexion "你知道他们的名字吗？"

# game/scenario/9_1_0_0.rpy:1098
translate chinese 3f42b5c8:

    # anya "Non. Je vous l'ai déjà dit, moins j'en savais, mieux c'était."
    anya "不知道。我说过了，知道得越少越好。"

# game/scenario/9_1_0_0.rpy:1100
translate chinese ef7fc345:

    # anya "J'avais un contact qui me donnait les instructions et c'est tout. Même le type qui m'a amenée jusqu'au dépôt ne m'a jamais donné son vrai nom."
    anya "我只有一个联络人给我指示，就这样。连把我送到仓库的那个人都没告诉我真名。"

# game/scenario/9_1_0_0.rpy:1102
translate chinese 898ca712:

    # nyra raison "Et Ryn s'est arrêté là ?"
    nyra raison "Ryn 问到这里就停了？"

# game/scenario/9_1_0_0.rpy:1104
translate chinese 63b9a7de_2:

    # anya "Non."
    anya "没有。"

# game/scenario/9_1_0_0.rpy:1106
translate chinese 6a1a5e8b:

    # "Elle replace machinalement ses lunettes."
    "她下意识地推了推眼镜。"

# game/scenario/9_1_0_0.rpy:1108
translate chinese 75e7f7a1:

    # anya reflexion "C'est là que c'est devenu plus précis."
    anya reflexion "从那儿开始，问题就变得更具体了。"

# game/scenario/9_1_0_0.rpy:1110
translate chinese 00760f6c:

    # noam inquiet "Précis comment ?"
    noam inquiet "具体到什么程度？"

# game/scenario/9_1_0_0.rpy:1112
translate chinese 955b36ec:

    # anya "Il voulait savoir comment ils choisissaient les conteneurs."
    anya "他想知道他们是怎么挑集装箱的。"

# game/scenario/9_1_0_0.rpy:1114
translate chinese 4e348d6b:

    # anya "S'ils savaient à l'avance lesquels seraient inspectés, s'il y avait des horaires où les dépôts étaient moins surveillés, comment les scellés étaient vérifiés..."
    anya "他们是不是提前就知道哪些会被查，仓库有没有哪些时段看得比较松，铅封是怎么核验的……"

# game/scenario/9_1_0_0.rpy:1116
translate chinese 8ce01236:

    # "Nyra relève légèrement le menton."
    "Nyra 微微抬起下巴。"

# game/scenario/9_1_0_0.rpy:1118
translate chinese 0962e9c6:

    # nyra reflexion "Les scellés ?"
    nyra reflexion "铅封？"

# game/scenario/9_1_0_0.rpy:1120
translate chinese 5a6cfcfc_4:

    # anya "Oui."
    anya "铅封。"

# game/scenario/9_1_0_0.rpy:1122
translate chinese 7d05d8b5:

    # anya "Il m'a même demandé si les équipes de contrôle vérifiaient seulement le numéro extérieur ou si elles ouvraient systématiquement les conteneurs."
    anya "他甚至问我，查验组是只核对箱体外面的编号，还是每次都会把集装箱打开。"

# game/scenario/9_1_0_0.rpy:1124
translate chinese 6eafd596:

    # noam reflexion "Tu savais répondre à tout ça ?"
    noam reflexion "这些你都答得上来？"

# game/scenario/9_1_0_0.rpy:1126
translate chinese d3c62723:

    # anya desaccord "Évidemment que non."
    anya desaccord "当然答不上来。"

# game/scenario/9_1_0_0.rpy:1128
translate chinese 5f8fbae9:

    # anya "Moi, on m'a dit : sois à telle porte à telle heure, monte dans ce conteneur et ne sors surtout pas avant l'arrivée."
    anya "人家跟我说的是：几点到哪个门，钻进哪个箱子，到站之前千万别出来。"

# game/scenario/9_1_0_0.rpy:1130
translate chinese 9a2b18e2:

    # anya reflexion "J'étais pas en stage chez les passeurs."
    anya reflexion "我又不是去蛇头那儿实习的。"

# game/scenario/9_1_0_0.rpy:1132
translate chinese 20175c25:

    # "Malgré la situation, je retiens difficilement un sourire."
    "尽管情况如此，我还是差点没忍住笑。"

# game/scenario/9_1_0_0.rpy:1134
translate chinese ff9fb4f1:

    # nyra raison "Il a utilisé des mots particuliers ? Des noms de zones, des procédures, quelque chose que toi tu n'avais pas mentionné avant ?"
    nyra raison "他有没有用过什么特别的说法？区域名称、流程，或者你自己之前根本没提过的东西？"

# game/scenario/9_1_0_0.rpy:1136
translate chinese aff4a70d:

    # "Anya réfléchit plus longtemps cette fois."
    "这一次 Anya 想得更久。"

# game/scenario/9_1_0_0.rpy:1138
translate chinese dcc37626:

    # anya reflexion "Oui..."
    anya reflexion "有……"

# game/scenario/9_1_0_0.rpy:1140
translate chinese df784008_2:

    # noam "Quoi ?"
    noam "什么？"

# game/scenario/9_1_0_0.rpy:1142
translate chinese 0d4c22ed:

    # anya "À un moment, il m'a demandé si le conteneur avait été placé dans une file de contrôle normale ou dans une zone de transit secondaire."
    anya "有一刻他问我，那个集装箱是被排进了正常查验通道，还是放在了次级中转区。"

# game/scenario/9_1_0_0.rpy:1144
translate chinese 18b10511:

    # nyra reflexion "Tu lui avais parlé de zones de transit ?"
    nyra reflexion "你跟他提过中转区吗？"

# game/scenario/9_1_0_0.rpy:1146
translate chinese 63b9a7de_3:

    # anya "Non."
    anya "没有。"

# game/scenario/9_1_0_0.rpy:1148
translate chinese ef1285aa:

    # "Le silence retombe."
    "沉默重新落了下来。"

# game/scenario/9_1_0_0.rpy:1150
translate chinese d52f486e_1:

    # anya inquiet "Pourquoi ?"
    anya inquiet "怎么了？"

# game/scenario/9_1_0_0.rpy:1152
translate chinese ddc2a934:

    # nyra "Parce que ce n'est pas le genre de détail qu'on demande au hasard."
    nyra "因为这不是随口就会问到的细节。"

# game/scenario/9_1_0_0.rpy:1154
translate chinese 6a83bb10:

    # anya reflexion "J'avais surtout l'impression qu'il savait déjà comment ça fonctionnait."
    anya reflexion "我当时的感觉是，他早就知道那套东西是怎么运作的。"

# game/scenario/9_1_0_0.rpy:1156
translate chinese ba85a393:

    # noam inquiet "Voilà."
    noam inquiet "就是这个。"

# game/scenario/9_1_0_0.rpy:1158
translate chinese a76c8681:

    # anya desaccord "Ça veut pas dire qu'il fait partie du réseau."
    anya desaccord "这也不代表他是那个网络的人。"

# game/scenario/9_1_0_0.rpy:1160
translate chinese fc52e08d:

    # noam "J'ai pas dit ça."
    noam "我没这么说。"

# game/scenario/9_1_0_0.rpy:1162
translate chinese c8b010b0:

    # anya "Tu le penses très fort."
    anya "你心里想得可响了。"

# game/scenario/9_1_0_0.rpy:1164
translate chinese f0e0ab50:

    # noam reflexion "Je pense surtout qu'il en sait beaucoup plus qu'il ne veut me le dire."
    noam reflexion "我想的是，他知道的东西比他愿意告诉我的多得多。"

# game/scenario/9_1_0_0.rpy:1166
translate chinese a7f60660:

    # anya "Peut-être. Mais il aurait pu me dénoncer dès qu'il m'a vue et il l'a pas fait."
    anya "也许吧。可他一看见我就可以把我交出去，他没有。"

# game/scenario/9_1_0_0.rpy:1168
translate chinese 50044c9d:

    # "Elle se tourne vers Nyra."
    "她转向 Nyra。"

# game/scenario/9_1_0_0.rpy:1170
translate chinese 86ca9808:

    # anya reflexion "Et il avait pas l'air de vouloir me piéger. Il était calme."
    anya reflexion "而且他也不像是想给我下套。他很平静。"

# game/scenario/9_1_0_0.rpy:1172
translate chinese 8f8542ea:

    # anya "Il m'a même demandé si Iris me donnait suffisamment à manger."
    anya "他甚至问我 Iris 有没有给我吃够。"

# game/scenario/9_1_0_0.rpy:1174
translate chinese 82ac864c:

    # noam surpris "Sérieusement ?"
    noam surpris "真的假的？"

# game/scenario/9_1_0_0.rpy:1176
translate chinese 5a6cfcfc_5:

    # anya "Oui."
    anya "真的。"

# game/scenario/9_1_0_0.rpy:1178
translate chinese 058a1401:

    # anya taquin "Apparemment ma survie alimentaire inquiète énormément de monde ici."
    anya taquin "看来我的吃饭问题让这里很多人操心。"

# game/scenario/9_1_0_0.rpy:1180
translate chinese e5814631:

    # "Nyra garde le silence quelques secondes, puis pose enfin la question que je n'avais moi-même pas formulée clairement."
    "Nyra 沉默了几秒，然后终于问出了那个连我自己都没有清楚说出口的问题。"

# game/scenario/9_1_0_0.rpy:1182
translate chinese 2af9463a:

    # nyra raison "Anya."
    nyra raison "Anya。"

# game/scenario/9_1_0_0.rpy:1184
translate chinese 673d9ec8:

    # anya "Hm ?"
    anya "嗯？"

# game/scenario/9_1_0_0.rpy:1186
translate chinese 810bbbe7:

    # nyra "Comment savait-il que tu étais là ?"
    nyra "他是怎么知道你在这里的？"

# game/scenario/9_1_0_0.rpy:1188
translate chinese b194d717:

    # "Anya ouvre la bouche, puis s'arrête."
    "Anya 张开嘴，又停住了。"

# game/scenario/9_1_0_0.rpy:1192
translate chinese 1e9ff117_1:

    # anya reflexion "..."
    anya reflexion "……"

# game/scenario/9_1_0_0.rpy:1194
translate chinese f8199b6f:

    # "Son assurance disparaît progressivement."
    "她的底气一点点消失。"

# game/scenario/9_1_0_0.rpy:1196
translate chinese 56147ab4:

    # anya "Je sais pas."
    anya "我不知道。"

# game/scenario/9_1_0_0.rpy:1198
translate chinese ee465519:

    # nyra "Tu ne l'avais jamais vu avant hier ?"
    nyra "昨晚之前你从没见过他？"

# game/scenario/9_1_0_0.rpy:1200
translate chinese 3c9ca378:

    # anya "Jamais."
    anya "从没有。"

# game/scenario/9_1_0_0.rpy:1202
translate chinese 5fa15f23:

    # nyra "Tu n'as parlé à personne d'autre depuis ton réveil ?"
    nyra "你醒来以后没跟别的人说过话？"

# game/scenario/9_1_0_0.rpy:1204
translate chinese 666dde21:

    # anya "À vous. Iris. Tomas."
    anya "只有你们。Iris。Tomas。"

# game/scenario/9_1_0_0.rpy:1206
translate chinese a8743bed:

    # noam "Et personne d'autre."
    noam "再没别人了。"

# game/scenario/9_1_0_0.rpy:1208
translate chinese 63b9a7de_4:

    # anya "Non."
    anya "没有。"

# game/scenario/9_1_0_0.rpy:1210
translate chinese 66bb2b6e:

    # nyra reflexion "Alors il y a deux possibilités."
    nyra reflexion "那就只有两种可能。"

# game/scenario/9_1_0_0.rpy:1212
translate chinese b0a29a34:

    # noam inquiet "Quelqu'un lui a parlé."
    noam inquiet "有人跟他说了。"

# game/scenario/9_1_0_0.rpy:1214
translate chinese 8a46ddc3:

    # nyra "Ou il savait déjà quelque chose avant d'entrer."
    nyra "或者他进门之前就已经知道了些什么。"

# game/scenario/9_1_0_0.rpy:1216
translate chinese f3972a46:

    # anya inquiet "Mais comment ?"
    anya inquiet "可怎么会呢？"

# game/scenario/9_1_0_0.rpy:1218
translate chinese 3e74e590:

    # nyra "C'est précisément ce qu'on ignore."
    nyra "这正是我们不知道的地方。"

