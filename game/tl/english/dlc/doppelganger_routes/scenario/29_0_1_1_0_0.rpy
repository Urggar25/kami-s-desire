# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:312
translate english f8f69373:

    # "On entend quelque chose traîner sur le sol, puis une succession de pas précipités qui s'éloignent."
    ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:314
translate english 28a05a26:

    # julian peur "LÂCHEZ-MOI ! NON, ATTENDEZ !"
    julian peur ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:316
translate english 1626d596:

    # "Sa voix s'éloigne au milieu d'un vacarme de métal et de frottements. Un dernier choc résonne à l'autre bout du couloir."
