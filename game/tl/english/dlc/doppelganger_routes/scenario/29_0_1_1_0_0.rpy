# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:331
translate english cb9bad4f:

    # iris peur "Avec quoi ? T'as vu ce qu'ils ont construit ! Même si on arrachait la porte, on pourrait pas passer à travers."
