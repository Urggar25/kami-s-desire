# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:49
translate english 600f97a0:

    # "Le silence revient enfin."
    ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:53
translate english 6d7c1622:

