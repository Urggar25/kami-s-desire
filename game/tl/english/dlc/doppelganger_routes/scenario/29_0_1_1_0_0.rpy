    noam colere ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:333
translate english 8b7ab802:

    # iris colere "Je sais, Noam ! Je sais ! Mais j'aurais fait quoi ? Je serais sortie pour me faire attraper avec lui ?!"
    iris colere ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:335
translate english a0eea2d6:

