# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:47
translate english 226f4fb7:

    # "Puis la dernière vibration s'arrête."
    ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:48
translate english 31ebcca2:

    # "Nous distinguons quelques pas dans le couloir, un petit choc contre le métal et le bruit d'un objet que quelqu'un laisse tomber."
