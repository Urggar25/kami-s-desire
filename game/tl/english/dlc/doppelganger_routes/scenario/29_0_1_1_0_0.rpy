# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:317
translate english 26f24bd0_1:

    # "Puis plus rien."
    ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:321
translate english 5a21bbac:

    # "Je reste debout devant la porte, le visage à quelques centimètres du bois."
    ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:322
translate english ec308f1b:

    # "Iris n'a pas lâché mon poignet."
    ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:330
translate english d6b6886f:

    # noam desespoir "Il était là... Il nous a entendus. Pourquoi j'ai pas essayé plus tôt ? On aurait peut-être pu lui faire une ouverture, quelque chose..."
