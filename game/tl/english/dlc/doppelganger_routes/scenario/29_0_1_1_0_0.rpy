# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:229
translate english 693f7c80:

    # "Elle attend, puis pousse un soupir exagéré."
    ""

# game/dlc/doppelganger_routes/scenario/29_0_1_1_0_0.rpy:231
