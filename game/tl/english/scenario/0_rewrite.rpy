    # noam "Je peux récupérer mes affaires ?"
    noam "Can I get my things?"

# game/scenario/0_rewrite.rpy:269
translate english b32ad295:

    # agent "Elles seront transférées. Venez maintenant."
    agent "They'll be transferred. Come with us now."

# game/scenario/0_rewrite.rpy:273
translate english f97a003b:

    # "Deux agents m'encadrent dans une aile grise que je n'avais jamais vue, assez loin pour rester polis et assez près pour décourager toute idée de fuite."
    "Two agents escort me through a gray wing I've never seen before—far enough away to remain polite, close enough to discourage any attempt to run."

# game/scenario/0_rewrite.rpy:276
translate english 9ca7823a_2:

    # voix "Accès autorisé."
    voix "Access granted."

# game/scenario/0_rewrite.rpy:281
translate english c2634d5e:

    # "La pièce n'a pas de fenêtre : quatre chaises, une table, trois caméras et deux caissons neufs."
    "The room has no windows: four chairs, one table, three cameras, and two brand-new pods."

# game/scenario/0_rewrite.rpy:282
translate english d067bba5:

    # agent "Asseyez-vous, ne touchez à rien et attendez le responsable."
    agent "Sit down, don't touch anything, and wait for the administrator."

# game/scenario/0_rewrite.rpy:284
