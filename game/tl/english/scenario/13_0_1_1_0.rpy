# TODO: Translation updated at 2026-08-23 12:01

# game/scenario/13_0_1_1_0.rpy:7
translate english 94c4579a:

    # "Je me réveille en sursaut, le cœur battant à tout rompre."
    "I jolt awake, my heart pounding."

# game/scenario/13_0_1_1_0.rpy:8
translate english 04a4d52c:

    # "Un bruit métallique incessant remplit la chambre. Clac. Clac. Clac."
    "A relentless metallic clatter fills the room. Clack. Clack. Clack."

# game/scenario/13_0_1_1_0.rpy:9
translate english d047cbbb:

    # "Pendant une seconde, je ne comprends même pas où je suis."
    "For a second, I don't even know where I am."

# game/scenario/13_0_1_1_0.rpy:10
translate english 2e367f0b:

    # "Mon corps réagit avant ma tête. Je me redresse d’un coup, encore à moitié dans le brouillard."
    "My body reacts before my brain catches up. I sit bolt upright, still half asleep."

# game/scenario/13_0_1_1_0.rpy:11
translate english df2dc180:

    # "La lumière froide de la chambre m’agresse les yeux."
    "The room's harsh light stings my eyes."

# game/scenario/13_0_1_1_0.rpy:12
translate english 5efd9105:

    # "Au pied de mon lit, un petit robot de maintenance, à peine plus haut qu’une poubelle, est en train de démonter méthodiquement le brouilleur fixé au mur."
    "At the foot of my bed, a little maintenance robot, barely taller than a trash can, is methodically dismantling the jammer mounted on the wall."

# game/scenario/13_0_1_1_0.rpy:13
translate english 6e32b7c9:

    # "Ses bras fins et multiples s’agitent avec une précision chirurgicale, arrachant vis, câbles et composants sans aucune délicatesse."
    "Its many spindly arms move with surgical precision, ripping out screws, cables, and components without the slightest care."

# game/scenario/13_0_1_1_0.rpy:14
translate english 4cfa907f:

    # "Des morceaux de plastique noir tombent au sol, un par un, comme les restes d’un animal disséqué."
    "Pieces of black plastic fall to the floor, one by one, like the remains of something being dissected."

# game/scenario/13_0_1_1_0.rpy:19
translate english baaae05f:

    # noam panique "Qu’est-ce que… ?!"
    noam panique ""

# game/scenario/13_0_1_1_0.rpy:21
translate english d0d92a2c:

    # "Le petit robot tourne lentement sa tête ronde vers moi. Ses yeux LED rouges clignotent paresseusement."
    "The little robot slowly turns its round head toward me. Its red LED eyes blink lazily."

# game/scenario/13_0_1_1_0.rpy:22
translate english 87c5e43e:

    # "Il garde une pince serrée autour d’un câble, comme si mon réveil n’était qu’un contretemps mineur."
    "It keeps a clamp wrapped around a cable, as if my waking up is only a minor inconvenience."

# game/scenario/13_0_1_1_0.rpy:24
translate english 25622cb5:

    # robot "Ah. Vous êtes réveillé."
    robot "Oh. You're awake."

# game/scenario/13_0_1_1_0.rpy:26
translate english 6b60b51d:

    # "Sa voix est plate, monotone, presque ennuyée. Comme un employé de bureau qui fait son troisième inventaire de la journée."
    "Its voice is flat, monotonous, almost bored. Like an office worker doing their third inventory of the day."

# game/scenario/13_0_1_1_0.rpy:28
translate english cc20ad51:

    # robot "Bonjour. Ou pas. Peu importe."
    robot "Good morning. Or not. Whatever."

# game/scenario/13_0_1_1_0.rpy:30
translate english 3861309e:

    # "Il continue tranquillement à démonter le brouilleur, arrachant un gros câble dans un bruit sec."
    "It calmly keeps dismantling the jammer, yanking out a thick cable with a sharp snap."

# game/scenario/13_0_1_1_0.rpy:32
translate english 289a28ce:

    # noam colere "Mais qu’est-ce que tu fous dans ma chambre ?!"
    noam colere ""

# game/scenario/13_0_1_1_0.rpy:34
translate english c83f5033:

    # robot "Je démonte votre brouilleur. Ordre du Conclave."
    robot "I'm removing your jammer. Conclave orders."

# game/scenario/13_0_1_1_0.rpy:36
translate english f2679007:

    # "Il sort un tournevis électrique et attaque une autre vis sans même me regarder."
    "It pulls out an electric screwdriver and starts on another screw without so much as looking at me."

# game/scenario/13_0_1_1_0.rpy:38
translate english aa99c3e4:

    # robot "Le vote d’hier a interdit les dispositifs de brouillage. Donc je retire tous les brouilleurs des chambres des représentants."
    robot "Yesterday's vote banned jamming devices. So I'm removing them from every representative's room."

# game/scenario/13_0_1_1_0.rpy:39
translate english e943e615:

    # robot "C’est chiant. Il y en a douze à faire. Vous êtes le septième."
    robot "What a pain. Twelve rooms to do. You're number seven."

# game/scenario/13_0_1_1_0.rpy:41
translate english e14f998e:

    # "Je reste assis sur mon lit, complètement abasourdi."
    "I sit on the bed, completely dumbfounded."

# game/scenario/13_0_1_1_0.rpy:42
translate english d0339e0d:

    # "La phrase met quelques secondes à trouver sa place dans mon crâne."
    "It takes a few seconds for those words to sink in."

# game/scenario/13_0_1_1_0.rpy:44
translate english e434cdc8:

    # noam "Attends… ils ont voté pour interdire ?!"
    noam "Wait... they voted to ban them?!"

# game/scenario/13_0_1_1_0.rpy:46
translate english 59e28e5a:

    # robot "Oui. Une personne a voté contre au dernier moment. Quel suspense ! Je n'aurai jamais imaginé devoir me lever tôt ce matin."
    robot "Yes. Someone voted against at the last second. Riveting stuff. Never thought I'd have to get up this early."

# game/scenario/13_0_1_1_0.rpy:48
translate english dc2b11bc:

    # noam panique "Une personne seulement ?"
    noam panique ""

# game/scenario/13_0_1_1_0.rpy:50
translate english f7dffcec:

    # robot "Correct."
    robot "Correct."

# game/scenario/13_0_1_1_0.rpy:52
translate english 31459814:

    # noam "Qui ?"
    noam "Who?"

# game/scenario/13_0_1_1_0.rpy:54
translate english a755d71a:

    # "Le robot s’arrête enfin."
    "The robot finally stops."

# game/scenario/13_0_1_1_0.rpy:55
translate english 2b75e952:

    # "Il tourne sa tête vers moi avec une lenteur presque insultante."
    "It turns its head toward me at an almost insulting pace."

# game/scenario/13_0_1_1_0.rpy:57
translate english 07f96c6b:

    # robot "Vous pensez vraiment que je vais vous donner le détail nominatif d’un vote du Conclave pendant que je démonte un appareil mural ?"
    robot "Do you seriously think I'm going to hand over an itemized list of secret votes while I'm taking apart a wall fixture?"

# game/scenario/13_0_1_1_0.rpy:59
translate english c681eb57:

    # noam colere "Tu viens littéralement d’entrer dans ma chambre pendant que je dormais."
    noam colere ""

# game/scenario/13_0_1_1_0.rpy:61
translate english 82d64ce3:

    # robot "Oui. Mais ça, c’est autorisé."
    robot "Yes. But that's allowed."

# game/scenario/13_0_1_1_0.rpy:63
translate english 1f6ecbea:

    # "Il recommence à dévisser, parfaitement indifférent."
    "It starts unscrewing things again, utterly indifferent."

# game/scenario/13_0_1_1_0.rpy:65
translate english f9c331ca:

    # robot "La confidentialité des votes reste protégée. Votre intimité physique, en revanche, vient de perdre son statut prioritaire."
    robot "Your vote is still confidential. Your physical privacy, however, has just been downgraded."

# game/scenario/13_0_1_1_0.rpy:67
translate english cc02a4e7:

    # noam "C’est censé me rassurer ?"
    noam "Is that supposed to make me feel better?"

# game/scenario/13_0_1_1_0.rpy:69
translate english cbaa5999:

    # robot "Non. C’est censé vous informer."
    robot "No. It's supposed to inform you."

# game/scenario/13_0_1_1_0.rpy:71
translate english a1497474:

    # "Un nouveau morceau du brouilleur tombe au sol."
    "Another piece of the jammer drops to the floor."

# game/scenario/13_0_1_1_0.rpy:72
translate english 84b97496:

    # "Je reconnais la petite plaque extérieure que j’avais l’habitude de fixer du regard avant de dormir."
    "I recognize the small outer panel I'd stare at every night before going to sleep."

# game/scenario/13_0_1_1_0.rpy:73
translate english a45c08bc:

    # "Elle était devenue une sorte de verrou mental. Une preuve que Kami ne pouvait pas tout voir."
    "It had become a kind of mental lock. Proof Kami couldn't see everything."

# game/scenario/13_0_1_1_0.rpy:75
translate english 77b419d5:

    # think "C’était ridicule."
    think "That was stupid."

# game/scenario/13_0_1_1_0.rpy:76
translate english 215e6bc1:

    # think "Mais au moins, c’était quelque chose."
    think "But at least it was something."

# game/scenario/13_0_1_1_0.rpy:78
translate english ba24fc12:

    # noam "Et Kami ? Elle voit déjà ?"
    noam "And Kami? Can she see me already?"

# game/scenario/13_0_1_1_0.rpy:80
translate english 2e05425d:

    # robot "Pas encore totalement. Je procède au retrait physique. La reconnexion optique de la chambre se fera dans quelques minutes."
    robot "Not entirely. I'm carrying out the physical removal. Visual surveillance will reconnect in a few minutes."

# game/scenario/13_0_1_1_0.rpy:82
translate english aef97ce2:

    # noam panique "La reconnexion optique ?"
    noam panique ""

# game/scenario/13_0_1_1_0.rpy:84
translate english dd266dbd:

    # robot "La chambre redeviendra compatible avec la surveillance centrale."
    robot "Your room will be back on the central surveillance network."

# game/scenario/13_0_1_1_0.rpy:86
translate english bd1ebc50:

    # "Il marque une courte pause."
    "It pauses briefly."

# game/scenario/13_0_1_1_0.rpy:87
translate english 3e2e311f:

    # "Ses yeux rouges clignotent deux fois."
    "Its red eyes blink twice."

# game/scenario/13_0_1_1_0.rpy:89
translate english 7809caf5:

    # robot "En langage humain : oui, elle pourra vous voir."
    robot "In human terms: yes, she'll be able to see you."

# game/scenario/13_0_1_1_0.rpy:91
translate english 7b108b4d:

    # noam "Tout le temps ?"
    noam "All the time?"

# game/scenario/13_0_1_1_0.rpy:93
translate english 7ffc0bbe:

    # robot "Sauf panne, surcharge, angle mort temporaire, obstruction accidentelle ou décision contraire de l’autorité centrale."
    robot "Unless there's a malfunction, overload, temporary blind spot, accidental obstruction, or a directive from central authority."

# game/scenario/13_0_1_1_0.rpy:95
translate english 779d5166:

    # noam "Donc tout le temps."
    noam "So, all the time."

# game/scenario/13_0_1_1_0.rpy:97
translate english 990f1d9c:

    # robot "C’est ce que je viens de dire avec plus de précision."
    robot "That's what I just said, only more accurately."

# game/scenario/13_0_1_1_0.rpy:99
translate english c95e5e7e:

    # "J’ai envie de descendre du lit et de l’arracher du mur moi-même."
    "I want to jump out of bed and rip the thing off the wall myself."

# game/scenario/13_0_1_1_0.rpy:100
translate english 8a18877f:

    # "Mais mes jambes sont encore lourdes, et une partie de moi sait déjà que ça ne servirait à rien."
    "But my legs still feel heavy, and part of me already knows it would be pointless."

# game/scenario/13_0_1_1_0.rpy:102
translate english 33873306:

    # noam colere "Tu peux arrêter deux secondes ?"
    noam colere ""

# game/scenario/13_0_1_1_0.rpy:104
translate english da589e7e:

    # robot "Non."
    robot "No."

# game/scenario/13_0_1_1_0.rpy:106
translate english 06e71761:

    # noam "Pourquoi ?"
    noam "Why?"

# game/scenario/13_0_1_1_0.rpy:108
translate english 95a6cffa:

    # robot "Parce que si je m’arrête deux secondes dans chaque chambre, je perds vingt-quatre secondes."
    robot "Because stopping for two seconds in each room would cost me twenty-four seconds."

# game/scenario/13_0_1_1_0.rpy:110
translate english 50fe97d8:

    # noam "C’est dramatique."
    noam "Tragic."

# game/scenario/13_0_1_1_0.rpy:112
translate english 877a420d:

    # robot "Pour vous, non. Pour mon planning, oui."
    robot "Not for you. For my schedule."

# game/scenario/13_0_1_1_0.rpy:114
translate english 99bc4702:

    # "Il tire sur un faisceau de câbles plus épais."
    "It tugs on a thicker bundle of cables."

# game/scenario/13_0_1_1_0.rpy:115
translate english 04ad75c8:

    # "Le brouilleur résiste une seconde, puis cède avec un craquement sec."
    "The jammer holds for a second, then gives way with a sharp crack."

# game/scenario/13_0_1_1_0.rpy:117
translate english 1217521d:

    # noam "Ce truc était censé nous protéger."
    noam "That thing was supposed to protect us."

# game/scenario/13_0_1_1_0.rpy:119
translate english c2e251a7:

    # robot "Il était surtout censé brouiller le signal de surveillance."
    robot "It was primarily designed to interfere with the surveillance signal."

# game/scenario/13_0_1_1_0.rpy:121
translate english f4871074:

    # noam "C’est la même chose."
    noam "Same difference."

# game/scenario/13_0_1_1_0.rpy:123
translate english 48fc33b6:

    # robot "Pas dans le rapport d’intervention."
    robot "Not according to the maintenance report."

# game/scenario/13_0_1_1_0.rpy:125
translate english 01fbff9b:

    # "Le robot arrache un dernier module dans un bruit de plastique brisé."
    "The robot tears out the last module with a crunch of breaking plastic."

# game/scenario/13_0_1_1_0.rpy:127
translate english c88bf027:

    # robot "Voilà. C’est fait. Vous êtes désormais totalement et constamment visible par Kami. Félicitations."
    robot "There. Done. You are now fully and continuously visible to Kami. Congratulations."

# game/scenario/13_0_1_1_0.rpy:129
translate english 16fdbb79:

    # "Il range ses outils dans un petit compartiment sur son torse avec un soupir mécanique."
    "It stows its tools in a small compartment in its chest with a mechanical sigh."

# game/scenario/13_0_1_1_0.rpy:130
translate english e1eff9ee:

    # "Le trou dans le mur laisse apparaître quelques fils encore tremblants, comme une plaie mal refermée."
    "The hole in the wall exposes a few trembling wires, like a wound that hasn't quite closed."

# game/scenario/13_0_1_1_0.rpy:132
translate english 4449c097:

    # robot "Franchement, je m’en fiche. Mais bon, c’est mon boulot."
    robot "Frankly, I don't care. But hey, it's my job."

# game/scenario/13_0_1_1_0.rpy:134
translate english e198d13a:

    # noam colere "Et tu pouvais pas attendre que je sois réveillé ?!"
    noam colere ""

# game/scenario/13_0_1_1_0.rpy:136
translate english 01c4c66a:

    # robot "J’ai essayé de faire doucement. Vous dormiez comme un mort. J’ai même fait tomber une vis sur votre front. Vous n’avez pas bougé."
    robot "I tried not to wake you. You were sleeping like the dead. I even dropped a screw on your forehead. You didn't move."

# game/scenario/13_0_1_1_0.rpy:138
translate english 797bd4ac:

    # "Instinctivement, je porte une main à mon front."
    "I instinctively touch my forehead."

# game/scenario/13_0_1_1_0.rpy:139
translate english 7d5bd9ed:

    # "Je sens une petite marque douloureuse au-dessus de mon sourcil."
    "There's a small tender spot above my eyebrow."

# game/scenario/13_0_1_1_0.rpy:141
translate english 800a2f1b:

    # noam "Tu m’as fait tomber une vis sur le front ?"
    noam "You dropped a screw on my head?"

# game/scenario/13_0_1_1_0.rpy:143
translate english d30c3c68:

    # robot "Une petite."
    robot "A small one."

# game/scenario/13_0_1_1_0.rpy:145
translate english f18c5755:

    # noam colere "C’est pas mieux."
    noam colere ""

# game/scenario/13_0_1_1_0.rpy:147
translate english 5e6659b7:

    # robot "Je n’ai jamais prétendu que c’était mieux. J’ai précisé la taille."
    robot "I never said that made it better. I was specifying its size."

# game/scenario/13_0_1_1_0.rpy:149
translate english 807cfcb4:

    # "Il me regarde avec ses yeux rouges impassibles."
    "It stares at me with its impassive red eyes."

# game/scenario/13_0_1_1_0.rpy:151
translate english 8f485dd6:

    # robot "Vous voulez que je vous remette le brouilleur ? Non, parce que je peux pas. Ordre supérieur."
    robot "Want me to put the jammer back? Because I can't. Orders from above."

# game/scenario/13_0_1_1_0.rpy:153
translate english 536adad5_1:

    # noam "Et si je refuse ?"
    noam "What if I refuse?"

# game/scenario/13_0_1_1_0.rpy:155
translate english e9f0214b:

    # robot "Vous refusez quoi ?"
    robot "Refuse what?"

# game/scenario/13_0_1_1_0.rpy:157
translate english aa827aaa:

    # noam "Qu’on me surveille."
    noam "Being watched."

# game/scenario/13_0_1_1_0.rpy:159
translate english debe3bf6:

    # robot "Alors vous êtes en retard d’un vote."
    robot "Then you're one vote too late."

# game/scenario/13_0_1_1_0.rpy:161
translate english 3f2df6c7:

    # "La réponse tombe sans colère, sans plaisir, sans intention de blesser."
    "The answer comes without anger, pleasure, or any intention to hurt me."

# game/scenario/13_0_1_1_0.rpy:162
translate english cffcffa8:

    # "C’est peut-être ça le pire."
    "Maybe that's the worst part."

# game/scenario/13_0_1_1_0.rpy:164
translate english cbfc54c4:

    # robot "Le refus individuel n’a plus de valeur opérationnelle sur ce sujet."
    robot "Individual refusal no longer has any operational significance in this matter."

# game/scenario/13_0_1_1_0.rpy:166
translate english 63c6a4ba:

    # noam "Formidable."
    noam "Fantastic."

# game/scenario/13_0_1_1_0.rpy:168
translate english a8a5b8fd:

    # robot "Je note une réaction sarcastique. Aucune incidence sur la procédure."
    robot "Sarcasm noted. No impact on the procedure."

# game/scenario/13_0_1_1_0.rpy:170
translate english 296eefb9:

    # "Il pivote vers la porte, puis s’arrête brusquement."
    "It turns toward the door, then suddenly stops."

# game/scenario/13_0_1_1_0.rpy:171
translate english 25b3e132:

    # "Un petit tiroir s’ouvre sur son flanc, et il en sort un minuscule sac transparent rempli de vis et de fragments."
    "A tiny drawer slides out of its side. Inside is a clear bag full of screws and fragments."

# game/scenario/13_0_1_1_0.rpy:173
translate english 0473fce3:

    # robot "Vous voulez conserver les déchets ?"
    robot "Would you like to keep the waste materials?"

# game/scenario/13_0_1_1_0.rpy:175
translate english df784008:

    # noam "Quoi ?"
    noam "What?"

# game/scenario/13_0_1_1_0.rpy:177
translate english bbae2dcd:

    # robot "Certains représentants veulent garder des morceaux. Souvenir, colère, preuve symbolique, je ne sais pas. Les humains font souvent ça avec les objets inutiles."
    robot "Some representatives like keeping scraps. Souvenirs, anger, symbolic proof—I don't know. Humans do that a lot with useless objects."

# game/scenario/13_0_1_1_0.rpy:179
translate english 4de6cd5b:

    # "Je fixe le sachet sans répondre."
    "I stare at the bag without answering."

# game/scenario/13_0_1_1_0.rpy:180
translate english b5579727:

    # "À l’intérieur, il y a les restes de la seule chose qui nous séparait encore un peu de Kami."
    "Inside are the remains of the only thing that still kept Kami at arm's length."

# game/scenario/13_0_1_1_0.rpy:182
translate english 22b361d3:

    # noam fatigue "Garde-les."
    noam fatigue ""

# game/scenario/13_0_1_1_0.rpy:184
translate english 759c865d:

    # robot "Très bien. Déchets classés en catégorie composants non réutilisables."
    robot "Very well. Waste classified as non-reusable components."

# game/scenario/13_0_1_1_0.rpy:186
translate english f250e25e:

    # "Il referme son tiroir."
    "It shuts the drawer."

# game/scenario/13_0_1_1_0.rpy:188
translate english f78bf6a2:

    # noam "… Sors de ma chambre."
    noam "...Get out of my room."

# game/scenario/13_0_1_1_0.rpy:190
translate english 69f94ec2:

    # robot "Avec plaisir. J’ai encore cinq chambres à faire et je suis déjà en retard sur mon planning."
    robot "Gladly. I've got five rooms left, and I'm already behind schedule."

# game/scenario/13_0_1_1_0.rpy:192
translate english 9e9463e5:

    # "Le petit robot roule vers la porte, ses roulettes grinçant légèrement sur le sol."
    "The little robot rolls toward the door, its wheels squeaking slightly against the floor."

# game/scenario/13_0_1_1_0.rpy:193
translate english 280a2646:

    # "Il passe devant le bureau, évite une chaussure, puis marque un arrêt devant la sortie."
    "It passes the desk, steers around a shoe, then stops at the doorway."

# game/scenario/13_0_1_1_0.rpy:195
translate english 67f02349:

    # robot "Au fait… bonne chance pour le reste de la journée. Avec ce que vous avez fait hier, je sens que l'ambiance va être ... délicate."
    robot "By the way... good luck with the rest of your day. After what you did yesterday, I suspect the atmosphere will be... delicate."

# game/scenario/13_0_1_1_0.rpy:197
translate english d8bc2349:

    # noam "Merci pour l’analyse."
    noam "Thanks for the analysis."

# game/scenario/13_0_1_1_0.rpy:199
translate english c7554018:

    # robot "De rien. Elle était gratuite et probablement évidente."
    robot "You're welcome. It was free, and probably obvious."

# game/scenario/13_0_1_1_0.rpy:201
translate english 22c1cb00:

    # "Il ouvre la porte tout seul et sort sans se retourner."
    "It opens the door itself and leaves without looking back."

# game/scenario/13_0_1_1_0.rpy:202
translate english 820f2040:

    # "Le bruit de ses roulettes s’éloigne dans le couloir."
    "The squeak of its wheels fades down the corridor."

# game/scenario/13_0_1_1_0.rpy:203
translate english 0cd8ab8d:

    # "Puis il y a un autre clac métallique, plus lointain."
    "Then comes another metallic clack, farther away."

# game/scenario/13_0_1_1_0.rpy:204
translate english 71bbd981:

    # "Une autre chambre."
    "Another room."

# game/scenario/13_0_1_1_0.rpy:208
translate english 14e263b0:

    # "Je reste assis sur mon lit, les yeux fixés sur le trou béant dans le mur où se trouvait mon brouilleur il y a encore deux minutes."
    "I stay seated on the bed, staring at the gaping hole where my jammer was mounted just two minutes ago."

# game/scenario/13_0_1_1_0.rpy:209
translate english 80ee2c8a:

    # "La chambre n’a pas changé."
    "The room hasn't changed."

# game/scenario/13_0_1_1_0.rpy:210
translate english 1361de48:

    # "Le lit est toujours là. Le bureau aussi. Mes vêtements traînent toujours sur la chaise."
    "The bed is still here. So is the desk. My clothes are still draped over the chair."

# game/scenario/13_0_1_1_0.rpy:211
translate english d301b6ee:

    # "Pourtant, tout me semble déplacé."
    "And yet everything feels different."

# game/scenario/13_0_1_1_0.rpy:212
translate english 0ce28477:

    # "Comme si quelqu’un avait retiré un mur invisible."
    "As though someone had removed an invisible wall."

# game/scenario/13_0_1_1_0.rpy:214
translate english 19f3cfe1:

    # think "Ils ont voté pour interdire…"
    think "They voted to ban them..."

# game/scenario/13_0_1_1_0.rpy:215
translate english 7927a93e:

    # think "Kael a probablement changé d’avis à cause de sa sœur…"
    think "Kael probably changed his mind because of his sister..."

# game/scenario/13_0_1_1_0.rpy:216
translate english 46b73ec5:

    # think "Et maintenant… plus rien ne nous protège."
    think "And now... there's nothing left to protect us."

# game/scenario/13_0_1_1_0.rpy:218
translate english 3a4d6630:

    # "Je passe une main sur mon visage, encore sonné."
    "I rub my face, still in shock."

# game/scenario/13_0_1_1_0.rpy:219
translate english d8023a31:

    # "La petite marque sur mon front me lance légèrement."
    "The little mark on my forehead throbs faintly."

# game/scenario/13_0_1_1_0.rpy:221
translate english c00a430b:

    # think "Plus d’intimité. Plus d’ombre. Plus nulle part où se cacher."
    think "No privacy. No blind spots. Nowhere left to hide."

# game/scenario/13_0_1_1_0.rpy:223
translate english 1f6b81a5:

    # "Je lève les yeux vers le plafond."
    "I look up at the ceiling."

# game/scenario/13_0_1_1_0.rpy:224
translate english 7f30acdd:

    # "Il n’y a aucune caméra visible."
    "There's no visible camera."

# game/scenario/13_0_1_1_0.rpy:225
translate english 35e3d368:

    # "Aucun voyant."
    "No indicator light."

# game/scenario/13_0_1_1_0.rpy:226
translate english 7ce4e6e4:

    # "Aucun œil mécanique fixé sur moi."
    "No mechanical eye trained on me."

# game/scenario/13_0_1_1_0.rpy:227
translate english 641914cc:

    # "C’est presque pire."
    "Somehow, that's almost worse."

# game/scenario/13_0_1_1_0.rpy:229
translate english a776b62e:

    # think "Elle n’a même pas besoin de se montrer."
    think "She doesn't even need to show herself."

# game/scenario/13_0_1_1_0.rpy:230
translate english 34128e8f:

    # think "Il suffit de savoir qu’elle peut regarder."
    think "Just knowing she can watch is enough."

# game/scenario/13_0_1_1_0.rpy:232
translate english d0e001aa:

    # "Je descends lentement du lit."
    "I slowly get out of bed."

# game/scenario/13_0_1_1_0.rpy:233
translate english 92f949fe:

    # "Mes pieds touchent le sol froid."
    "My feet meet the cold floor."

# game/scenario/13_0_1_1_0.rpy:234
translate english 60a27eb7:

    # "Pendant quelques secondes, je reste immobile, incapable de décider quoi faire."
    "For a few seconds I stand still, unable to decide what to do."

# game/scenario/13_0_1_1_0.rpy:235
translate english e5966b99:

    # "M’habiller. Sortir. Faire semblant."
    "Get dressed. Go out. Pretend."

# game/scenario/13_0_1_1_0.rpy:236
translate english 72b37a85:

    # "Comme tous les autres."
    "Like everyone else."

# game/scenario/13_0_1_1_0.rpy:238
translate english b7379a44:

    # think "Ils doivent tous être en train de vivre la même chose."
    think "They must all be going through the same thing."

# game/scenario/13_0_1_1_0.rpy:239
translate english 468c44a0:

    # think "Les mêmes murs ouverts."
    think "The same exposed walls."

# game/scenario/13_0_1_1_0.rpy:240
translate english 63c78f65:

    # think "Les mêmes chambres rendues à Kami."
    think "The same rooms handed back to Kami."

# game/scenario/13_0_1_1_0.rpy:242
translate english e7f9759a:

    # "Je regarde la porte."
    "I look toward the door."

# game/scenario/13_0_1_1_0.rpy:243
translate english b00c1a78:

    # "De l’autre côté, il y a les autres représentants."
    "The other representatives are on the other side."

# game/scenario/13_0_1_1_0.rpy:244
translate english d5be99da:

    # "Ceux qui ont voté."
    "The ones who voted."

# game/scenario/13_0_1_1_0.rpy:245
translate english 8756dadc:

    # "Ceux qui m’ont attendu."
    "The ones who waited for me."

# game/scenario/13_0_1_1_0.rpy:246
translate english 8beb2762:

    # "Ceux qui vont forcément me demander pourquoi je suis parti."
    "The ones who are bound to ask why I left."

# game/scenario/13_0_1_1_0.rpy:248
translate english 62e97d5c:

    # think "Je les ai laissés seuls hier."
    think "I abandoned them yesterday."

# game/scenario/13_0_1_1_0.rpy:249
translate english c54e1d3f:

    # think "Et maintenant, ils ont perdu leur brouilleur."
    think "And now they've lost their jammers."

# game/scenario/13_0_1_1_0.rpy:250
translate english 48e1f913:

    # think "Ils vont me le faire payer."
    think "They're going to make me pay for it."

# game/scenario/13_0_1_1_0.rpy:252
translate english a29c3cae:

    # "Le poids de cette nouvelle réalité me tombe dessus d’un coup."
    "The weight of this new reality crashes down on me."

# game/scenario/13_0_1_1_0.rpy:253
translate english 93f587f8:

    # "J’ai presque envie de rire, mais rien ne sort."
    "I almost want to laugh, but nothing comes out."

# game/scenario/13_0_1_1_0.rpy:255
translate english 5130bc56:

    # think "Au moins, plus personne ne peut se cacher... Non ?"
    think "At least no one can hide anymore... right?"

# game/scenario/13_0_1_1_0.rpy:257
translate english 34c7979d:

    # "Cette pensée reste suspendue un instant."
    "The thought hangs there for a moment."

# game/scenario/13_0_1_1_0.rpy:258
translate english e45cd163:

    # "Puis elle se retourne contre moi."
    "Then it turns against me."

# game/scenario/13_0_1_1_0.rpy:260
translate english f2db00f1:

    # think "Sauf si quelqu’un n’a jamais eu besoin de se cacher."
    think "Unless someone never needed to hide."

# game/scenario/13_0_1_1_0.rpy:261
translate english 02a14330:

    # think "Sauf si quelqu’un a déjà accès à tout."
    think "Unless someone already has access to everything."

# game/scenario/13_0_1_1_0.rpy:263
translate english 3f6f89fe:

    # "Je fixe encore le trou dans le mur."
    "I stare at the hole in the wall again."

# game/scenario/13_0_1_1_0.rpy:264
translate english f7dc25bc:

    # "Les fils pendent dans le vide, parfaitement immobiles maintenant."
    "The wires hang in empty space, perfectly still now."

# game/scenario/13_0_1_1_0.rpy:266
translate english c5fadb42:

    # think "Kami voit."
    think "Kami sees."

# game/scenario/13_0_1_1_0.rpy:267
translate english 4cb2fbbb:

    # think "Kami écoute."
    think "Kami hears."

# game/scenario/13_0_1_1_0.rpy:268
translate english 6d2d3c74:

    # think "Et quelqu’un, quelque part, continue d’agir malgré ça."
    think "And someone, somewhere, is still doing things anyway."

# game/scenario/13_0_1_1_0.rpy:270
translate english 9599efd0:

    # "Je me rallonge lentement, le regard perdu au plafond."
    "I slowly lie back down, staring at the ceiling."

# game/scenario/13_0_1_1_0.rpy:271
translate english 84c4d26e:

    # "Le sommeil est impossible."
    "Sleep is impossible."

# game/scenario/13_0_1_1_0.rpy:272
translate english ed4fcf28:

    # "Mais me lever l’est presque autant."
    "But getting up feels almost as hard."

# game/scenario/13_0_1_1_0.rpy:274
translate english 41d3d3e5:

    # think "Tout devient de plus en plus dangereux…"
    think "Things keep getting more dangerous..."

# game/scenario/13_0_1_1_0.rpy:275
translate english cb4c98ac:

    # think "Et je ne sais même plus si le danger vient d’elle."
    think "And I don't even know whether the danger comes from her anymore."

# game/scenario/13_0_1_1_0.rpy:276
translate english e88ed22a:

    # think "Ou de nous."
    think "Or from us."

# game/scenario/13_0_1_1_0.rpy:287
translate english 8915474e:

    # "La cafétéria est déjà bien remplie quand j’arrive. L’ambiance est étrange : bruyante, mais dès que j’apparais à l’entrée, plusieurs conversations s’arrêtent net."
    "The cafeteria is already crowded when I arrive. It's noisy, until I appear in the doorway and several conversations abruptly stop."

# game/scenario/13_0_1_1_0.rpy:288
translate english 01ba5ff6:

    # "Ce n’est pas un silence total."
    "It isn't complete silence."

# game/scenario/13_0_1_1_0.rpy:289
translate english 1748fee5:

    # "C’est pire que ça."
    "It's worse."

# game/scenario/13_0_1_1_0.rpy:290
translate english adf4cc2e:

    # "C’est le genre de silence où les gens font semblant de continuer à parler, juste assez bas pour que je comprenne que je suis devenu le sujet principal."
    "It's the kind where people pretend to keep talking, just quietly enough for me to know I'm the subject."

# game/scenario/13_0_1_1_0.rpy:292
translate english ccf4b46c:

    # "Je sens les regards sur moi. Certains curieux. D’autres clairement hostiles."
    "I can feel their eyes on me. Some curious. Others openly hostile."

# game/scenario/13_0_1_1_0.rpy:293
translate english 4b87bb13:

    # "Quelques représentants détournent les yeux dès que je croise leur regard."
    "A few representatives look away as soon as our eyes meet."

# game/scenario/13_0_1_1_0.rpy:294
translate english 17fc42f5:

    # "D’autres ne prennent même pas cette peine."
    "Others don't even bother."

# game/scenario/13_0_1_1_0.rpy:296
translate english af3fd7c3:

    # think "Super… Ils sont déjà tous au courant."
    think "Great... They all know already."

# game/scenario/13_0_1_1_0.rpy:297
translate english f0b5aafb:

    # think "Évidemment qu’ils sont au courant."
    think "Of course they know."

# game/scenario/13_0_1_1_0.rpy:298
translate english 6ed81ac9:

    # think "Dans cet endroit, une humiliation met moins de temps à circuler qu’un ordre de Kami."
    think "A humiliation spreads faster around here than an order from Kami."

# game/scenario/13_0_1_1_0.rpy:309
translate english df8efb58:

    # "Je me dirige vers le comptoir en essayant de garder la tête haute."
    "I walk toward the counter, trying to hold my head high."

# game/scenario/13_0_1_1_0.rpy:310
translate english 514dc216:

    # "Chaque pas me paraît trop bruyant."
    "Every step sounds too loud."

# game/scenario/13_0_1_1_0.rpy:311
translate english ffa86bf3:

    # "Chaque mouvement trop visible."
    "Every movement feels too visible."

# game/scenario/13_0_1_1_0.rpy:312
translate english 4d08b80e:

    # "Je sens encore l’absence du brouilleur comme une pression sur ma nuque."
    "I can still feel the missing jammer like pressure against the back of my neck."

# game/scenario/13_0_1_1_0.rpy:314
translate english 9b53f1aa:

    # goumi "Bonjour Noam. Comme d’habitude ?"
    goumi "Morning, Noam. The usual?"

# game/scenario/13_0_1_1_0.rpy:316
translate english 3ad3235e:

    # "Même Goumi parle plus doucement que d’habitude."
    "Even Goumi speaks more quietly than normal."

# game/scenario/13_0_1_1_0.rpy:317
translate english a0c31f0d:

    # "Il évite de regarder derrière moi, mais je vois très bien qu’il a compris l’ambiance."
    "It avoids looking behind me, but I can tell it knows exactly what's going on."

# game/scenario/13_0_1_1_0.rpy:319
translate english 6b29d655:

    # noam fatigue "Ouais… juste un café et ce que tu as."
    noam fatigue ""

# game/scenario/13_0_1_1_0.rpy:321
translate english 431d1825:

    # goumi "Je te mets quelque chose de chaud avec."
    goumi "I'll add something warm."

# game/scenario/13_0_1_1_0.rpy:323
translate english b4973ea8:

    # noam "Comme tu veux."
    noam "Whatever you think."

# game/scenario/13_0_1_1_0.rpy:325
translate english 3e30251f:

    # "Pendant que Goumi prépare mon plateau, je sens une présence derrière moi."
    "As Goumi prepares my tray, I sense someone behind me."

# game/scenario/13_0_1_1_0.rpy:326
translate english 33d7a28c:

    # "Je n’ai même pas besoin de me retourner pour deviner qui c’est."
    "I don't even have to turn around to know who it is."

# game/scenario/13_0_1_1_0.rpy:328
translate english e6e9b0da:

    # mara stress "Tiens, voilà le héros du jour."
    mara stress ""

# game/scenario/13_0_1_1_0.rpy:330
translate english 8cee80a9:

    # "Mara est appuyée contre le comptoir, les bras croisés. Son regard est glacial."
    "Mara leans against the counter, arms crossed. Her stare is ice-cold."

# game/scenario/13_0_1_1_0.rpy:331
translate english ef1cfb08:

    # "Elle ne crie pas."
    "She doesn't shout."

# game/scenario/13_0_1_1_0.rpy:332
translate english 45450494:

    # "Elle n’en a pas besoin."
    "She doesn't have to."

# game/scenario/13_0_1_1_0.rpy:333
translate english 0c4a3ce5:

    # "Sa voix porte assez pour que les tables proches cessent définitivement de faire semblant."
    "Her voice carries far enough for the nearby tables to stop pretending."

# game/scenario/13_0_1_1_0.rpy:335
translate english d0d160e9:

    # mara colere "Grâce à toi, on est tous à poil maintenant. Content ?"
    mara colere ""

# game/scenario/13_0_1_1_0.rpy:336
translate english 835b1a97:

    # mara "On avait une chance d’avoir un minimum d’intimité, et Monsieur a décidé de tout faire foirer."
    mara "We had one shot at a little privacy, and His Highness had to go and screw it all up."

# game/scenario/13_0_1_1_0.rpy:338
translate english bbc2f18c:

    # "Je serre les dents sans répondre."
    "I grit my teeth and say nothing."

# game/scenario/13_0_1_1_0.rpy:339
translate english 895982c0:

    # "Répondre ne servirait à rien."
    "Answering wouldn't help."

# game/scenario/13_0_1_1_0.rpy:340
translate english 3b3df020:

    # "Pas ici. Pas devant tout le monde."
    "Not here. Not in front of everyone."

# game/scenario/13_0_1_1_0.rpy:342
translate english 1583e538:

    # mara "Tu pourrais au moins avoir l’air désolé."
    mara "You could at least pretend you're sorry."

# game/scenario/13_0_1_1_0.rpy:344
translate english 513f9775:

    # noam fatigue "Je le suis."
    noam fatigue ""

# game/scenario/13_0_1_1_0.rpy:346
translate english 596eb325:

    # mara colere "Ah. Super. Ça me rassure énormément."
    mara colere ""

# game/scenario/13_0_1_1_0.rpy:348
translate english a757c6dc:

    # elen triste "Mara… arrête."
    elen triste ""

# game/scenario/13_0_1_1_0.rpy:350
translate english fe9e4e8c:

    # "Elen est juste à côté, mais elle n’ose presque pas me regarder. Elle a l’air blessée."
    "Elen is standing nearby, but she can barely bring herself to look at me. She looks hurt."

# game/scenario/13_0_1_1_0.rpy:351
translate english 1b627b76:

    # "Pas seulement en colère."
    "Not just angry."

# game/scenario/13_0_1_1_0.rpy:352
translate english b26e9d19:

    # "Blessée."
    "Hurt."

# game/scenario/13_0_1_1_0.rpy:353
translate english ca5ba4f6:

    # "Et d’une certaine manière, ça me fait plus mal que Mara."
    "And somehow that stings more than anything Mara says."

# game/scenario/13_0_1_1_0.rpy:355
translate english e00958c6:

    # elen "Noam… pourquoi t’as fait ça ? On t’a attendu hier. On pensait que tu allais voter avec nous."
    elen "Noam... why did you do it? We waited for you yesterday. We thought you'd vote with us."

# game/scenario/13_0_1_1_0.rpy:357
translate english f72dcf21:

    # "Je baisse les yeux vers le plateau que Goumi vient de poser devant moi."
    "I look down at the tray Goumi just set in front of me."

# game/scenario/13_0_1_1_0.rpy:358
translate english db9d28be:

    # "Le café fume lentement."
    "Steam rises slowly from the coffee."

# game/scenario/13_0_1_1_0.rpy:359
translate english 49c652da:

    # "Je devrais répondre quelque chose."
    "I should say something."

# game/scenario/13_0_1_1_0.rpy:360
translate english 807030a0:

    # "N’importe quoi."
    "Anything."

# game/scenario/13_0_1_1_0.rpy:362
translate english 2e535864:

    # noam fatigue "Je sais."
    noam fatigue ""

# game/scenario/13_0_1_1_0.rpy:364
translate english 0fb317d9:

    # elen "C’est tout ?"
    elen "That's it?"

# game/scenario/13_0_1_1_0.rpy:366
translate english 290dd969:

    # noam "Non."
    noam "No."

# game/scenario/13_0_1_1_0.rpy:367
translate english 0b3311e7:

    # noam "Mais je ne sais pas quoi dire d’autre."
    noam "I just don't know what else to say."

# game/scenario/13_0_1_1_0.rpy:369
translate english 78a4f1a5:

    # "Iris arrive à son tour. Elle semble partagée : en colère, mais avec une pointe d’inquiétude dans les yeux."
    "Iris joins us. She looks torn between anger and a glimmer of worry."

# game/scenario/13_0_1_1_0.rpy:370
translate english c2ebc9b2:

    # "Elle me regarde comme si elle cherchait encore à comprendre où s’arrête ma faute et où commence mon malaise."
    "She studies me as though she's still trying to work out where my mistake ends and my breakdown begins."

# game/scenario/13_0_1_1_0.rpy:372
translate english 054ac83b:

    # iris inquiet "Tu aurais pu au moins rester jusqu’au vote… Au lieu de nous planter comme ça."
    iris inquiet ""

# game/scenario/13_0_1_1_0.rpy:374
translate english 4acaf6ad:

    # noam fatigue "Je… je n’étais plus en état."
    noam fatigue ""

# game/scenario/13_0_1_1_0.rpy:376
translate english 2d5d814f:

    # mara colere "Ah ouais ? Et nous, on était en état peut-être ?!"
    mara colere ""

# game/scenario/13_0_1_1_0.rpy:377
translate english b8af0190:

    # mara "On est tous crevés, Noam ! On est tous sur les nerfs ! Mais on est restés jusqu’au bout !"
    mara "We're ALL exhausted, Noam! We're ALL on edge! But we stuck it out to the end!"

# game/scenario/13_0_1_1_0.rpy:378
translate english 260d0b10:

    # mara "Toi tu fais ton petit caprice, tu nous traites tous de traîtres, et après tu te casses ?!"
    mara "You throw your little tantrum, call us all traitors, and then just walk out?!"

# game/scenario/13_0_1_1_0.rpy:380
translate english 34d5a8be:

    # "Le mot traîtres reste suspendu entre nous."
    "The word 'traitors' hangs between us."

# game/scenario/13_0_1_1_0.rpy:381
translate english 5c811cd7:

    # "Plusieurs regards se durcissent autour de la table la plus proche."
    "Several faces harden at the nearest table."

# game/scenario/13_0_1_1_0.rpy:383
translate english f6ca4c94:

    # think "Je l’ai vraiment dit."
    think "I actually said it."

# game/scenario/13_0_1_1_0.rpy:384
translate english 515f3380:

    # think "Devant eux."
    think "To their faces."

# game/scenario/13_0_1_1_0.rpy:385
translate english b29a48ee:

    # think "Devant tout le monde."
    think "In front of everyone."

# game/scenario/13_0_1_1_0.rpy:387
translate english 7d80045d:

    # noam "Je n’aurais pas dû le dire comme ça."
    noam "I shouldn't have said it like that."

# game/scenario/13_0_1_1_0.rpy:389
translate english e012e9da:

    # mara "Mais tu le pensais."
    mara "But you meant it."

# game/scenario/13_0_1_1_0.rpy:391
translate english e91aee1f:

    # "Je ne réponds pas."
    "I don't answer."

# game/scenario/13_0_1_1_0.rpy:392
translate english c1d4e200:

    # "Et ce silence suffit."
    "And that says enough."

# game/scenario/13_0_1_1_0.rpy:394
translate english e9f60c17:

    # elen triste "Noam..."
    elen triste ""

# game/scenario/13_0_1_1_0.rpy:396
translate english 4c39b3ad:

    # "Julian tente une approche, avec un sourire forcé qui tombe complètement à plat."
    "Julian tries to step in with a forced smile that falls completely flat."

# game/scenario/13_0_1_1_0.rpy:398
translate english 480b1d6c:

    # julian hesitation "Allez les gars… on se calme. Noam a juste pété un câble, c’est pas la fin du monde."
    julian hesitation ""

# game/scenario/13_0_1_1_0.rpy:400
translate english 8fa89e0b:

    # "Personne ne rit."
    "No one laughs."

# game/scenario/13_0_1_1_0.rpy:401
translate english 421ea59e:

    # "Julian garde son sourire une seconde de trop, puis finit par regarder son assiette."
    "Julian holds the smile a second too long before looking down at his plate."

