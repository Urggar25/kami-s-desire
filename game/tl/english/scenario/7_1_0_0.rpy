# game/scenario/7_1_0_0.rpy:99
translate english 20fe672a:

    # think "Quelqu'un frappe à ma porte."
    think "Someone's knocking on my door."

# game/scenario/7_1_0_0.rpy:105
translate english 4c9ca12e:

    # think "Une première série de coups rapides. Puis une deuxième, plus forte."
    think "A quick burst of knocks. Then another, louder one."

# game/scenario/7_1_0_0.rpy:111
translate english 1567dfc8:

    # think "J'ouvre les yeux sans comprendre où je suis. Ma joue me lance dès que je bouge la mâchoire."
    think "I open my eyes, disoriented. My cheek throbs as soon as I move my jaw."

# game/scenario/7_1_0_0.rpy:112
translate english feb48003:

    # think "Le coup de Ryn a laissé une marque plus douloureuse que prévu."
    think "Ryn's punch left a more painful mark than I expected."

# game/scenario/7_1_0_0.rpy:116
translate english 7eec9626:

    # nyra "Noam ? Ouvre. Vite."
    nyra "Noam? Open up. Now."

# game/scenario/7_1_0_0.rpy:118
translate english 9ed1436c:

    # think "Nyra. Sa voix est basse, mais elle ne cherche même pas à cacher son impatience."
    think "Nyra. Her voice is low, but she isn't even trying to hide her impatience."

# game/scenario/7_1_0_0.rpy:120
translate english b4b7f0e0:

    # noam inquiet "J'arrive."
    noam inquiet "Coming."

# game/scenario/7_1_0_0.rpy:122
translate english fd8e97f2:

    # think "J'enfile le premier vêtement à portée de main et traverse la chambre."
    think "I throw on the first thing I can reach and cross the room."

# game/scenario/7_1_0_0.rpy:143
translate english 21c66d6e:

    # think "Lorsque j'ouvre, Nyra entre presque sans attendre mon autorisation. Tomas et Iris se tiennent derrière elle."
    think "When I open the door, Nyra steps inside without even waiting for permission. Tomas and Iris are standing behind her."

# game/scenario/7_1_0_0.rpy:144
translate english 2225091a:

    # think "Ils sont habillés à la hâte. Iris tient encore sa veste contre elle au lieu de l'avoir correctement enfilée."
    think "They got dressed in a hurry. Iris is still clutching her jacket instead of wearing it properly."

# game/scenario/7_1_0_0.rpy:146
translate english 2a07744c:

    # noam surpris "Qu'est-ce qui se passe ?"
    noam surpris "What's going on?"

# game/scenario/7_1_0_0.rpy:148
translate english e504890a:

    # nyra inquiet "Laisse-nous entrer."
    nyra inquiet "Let us in."

# game/scenario/7_1_0_0.rpy:150
translate english 5470dcd2:

    # noam inquiet "Vous êtes déjà pratiquement dedans."
    noam inquiet "You're practically inside already."

# game/scenario/7_1_0_0.rpy:152
translate english c4283604:

    # iris colere "Noam, ferme la porte."
    iris colere "Noam, close the door."

# game/scenario/7_1_0_0.rpy:156
translate english 70c59517:

    # think "Je m'exécute. Nyra vérifie l'écran du brouilleur fixé près du lit."
    think "I do as she says. Nyra checks the jammer display by the bed."

# game/scenario/7_1_0_0.rpy:158
translate english ffffc597:

    # nyra raison "Il fonctionne ?"
    nyra raison "Is it working?"

# game/scenario/7_1_0_0.rpy:160
translate english 5bc3a84c:

    # noam neutre "Oui. Pourquoi ?"
    noam neutre "Yes. Why?"

# game/scenario/7_1_0_0.rpy:162
translate english 382dfbd4:

    # tomas inquiet "P-Parle moins fort."
    tomas inquiet "K-Keep your voice down."

# game/scenario/7_1_0_0.rpy:164
translate english 38c56177:

    # noam surpris "Vous venez de me réveiller en frappant comme si la station brûlait et maintenant vous me demandez de chuchoter ?"
    noam surpris "You just woke me up by pounding on my door like the station was on fire, and now you want me to whisper?"

# game/scenario/7_1_0_0.rpy:166
translate english 13833bd6:

    # iris desaccord "Approche."
    iris desaccord "Come closer."

# game/scenario/7_1_0_0.rpy:168
translate english 1dffbefb:

    # think "Iris m'attrape par la manche. Tous les trois se rapprochent au point que la scène devient presque ridicule."
    think "Iris grabs my sleeve. The three of them crowd in so close that the whole thing almost becomes ridiculous."

# game/scenario/7_1_0_0.rpy:170
translate english ba84ff74:

    # noam inquiet "Vous me faites peur."
    noam inquiet "You're scaring me."

# game/scenario/7_1_0_0.rpy:172
translate english 5abe706e:

    # nyra inquiet "C'est préférable. Tu comprendras plus vite."
    nyra inquiet "Good. You'll understand faster."

# game/scenario/7_1_0_0.rpy:174
translate english a8d0a667:

    # think "Nyra se penche jusqu'à mon oreille."
    think "Nyra leans in close to my ear."

# game/scenario/7_1_0_0.rpy:176
translate english e34444f1:

    # nyra raison "Il y a quelqu'un dans la livraison."
    nyra raison "There's someone in the delivery."

# game/scenario/7_1_0_0.rpy:180
translate english 7941b899:

    # noam surpris "Quelqu'un ?"
    noam surpris "Someone?"

# game/scenario/7_1_0_0.rpy:182
translate english 91452df6:

    # iris colere "Moins fort !"
    iris colere "Keep it down!"

# game/scenario/7_1_0_0.rpy:184
translate english ca1d2554:

    # noam inquiet "Quelqu'un comment ?"
    noam inquiet "What do you mean, someone?"

# game/scenario/7_1_0_0.rpy:186
translate english e06f0665:

    # tomas panne "Une... une personne. Dans un conteneur."
    tomas panne "A... a person. Inside a container."

# game/scenario/7_1_0_0.rpy:188
translate english 9ce11921:

    # noam surpris "Vous êtes sûrs ?"
    noam surpris "Are you sure?"

# game/scenario/7_1_0_0.rpy:190
translate english 3772edca:

    # nyra raison "Nous avons vu une main entre deux caisses. Iris l'a touchée."
    nyra raison "We saw a hand between two crates. Iris touched it."

# game/scenario/7_1_0_0.rpy:192
translate english abf93d24:

    # iris inquiet "Elle est glacée. Je ne sais même pas si elle est encore consciente."
    iris inquiet "She's freezing. I don't even know if she's still conscious."

# game/scenario/7_1_0_0.rpy:194
translate english b42d6184:

    # noam determine "Pourquoi vous ne l'avez pas sortie ?"
    noam determine "Why didn't you get her out?"

# game/scenario/7_1_0_0.rpy:196
translate english 1e97f5d9:

    # nyra colere "Parce qu'il y a trois caméras dans le sas et que nous ignorons si Kami l'a déjà repérée."
    nyra colere "Because there are three cameras in the airlock, and we don't know if Kami has already spotted her."

# game/scenario/7_1_0_0.rpy:198
translate english cefb8d46:

    # tomas inquiet "On a replacé la bâche exactement comme elle était. Enfin... je crois."
    tomas inquiet "We put the tarp back exactly the way it was. Well... I think we did."

# game/scenario/7_1_0_0.rpy:200
translate english e3627000:

    # iris colere "Tu crois ?"
    iris colere "You think?"

# game/scenario/7_1_0_0.rpy:202
translate english 9af46a3a:

    # tomas panne "J'ai fait au mieux !"
    tomas panne "I did my best!"

# game/scenario/7_1_0_0.rpy:204
translate english 66f386f5:

    # noam inquiet "Qui d'autre est au courant ?"
    noam inquiet "Who else knows?"

# game/scenario/7_1_0_0.rpy:206
translate english 586181bd:

    # nyra neutre "Personne. La livraison est arrivée plus tôt que prévu. Nous étions les premiers dans le sas."
    nyra neutre "No one. The delivery arrived ahead of schedule. We were the first ones in the airlock."

# game/scenario/7_1_0_0.rpy:208
translate english 69beba6f:

    # iris determine "Mais elle ne tiendra pas longtemps dans cet état. Il faut y retourner maintenant."
    iris determine "But she won't last long like this. We need to go back now."

# game/scenario/7_1_0_0.rpy:210
translate english fb13261a:

    # noam determine "Alors on y va."
    noam determine "Then let's go."

# game/scenario/7_1_0_0.rpy:214
translate english 74e1d29d:

    # think "Nyra rouvre la porte avec précaution. Nous quittons la chambre séparément, à quelques secondes d'intervalle."
    think "Nyra carefully opens the door again. We leave the room separately, a few seconds apart."

# game/scenario/7_1_0_0.rpy:215
translate english 24515d9f:

    # think "Dès que nous atteignons l'angle mort du couloir, nous cessons de marcher et nous courons."
    think "The moment we reach the corridor's blind spot, we stop walking and start running."

# game/scenario/7_1_0_0.rpy:235
translate english 94d0d09e:

    # think "L'air du sas est nettement plus froid que celui des autres pièces. Les conteneurs occupent presque tout l'espace."
    think "The airlock is noticeably colder than the other rooms. Containers take up almost all the space."

# game/scenario/7_1_0_0.rpy:236
translate english c2fd8042:

    # think "Des caisses de nourriture, de médicaments et de matériel s'empilent jusqu'aux parois."
    think "Crates of food, medicine, and equipment are stacked all the way to the walls."

# game/scenario/7_1_0_0.rpy:238
translate english bbab69ae:

    # nyra raison "Regarde ici. Sous la bâche grise."
    nyra raison "Look here. Under the gray tarp."

# game/scenario/7_1_0_0.rpy:239
translate english b0071151:

    # nyra colere "Mais ne l'enlève pas, il ne faut pas que Kami voit ça aux caméras."
    nyra colere "But don't remove it. Kami can't see this through the cameras."

# game/scenario/7_1_0_0.rpy:244
translate english 2fe17432:

    # think "Nous avançons entre les palettes. Une main dépasse d'un drap recouvrant une palette."
    think "We move between the pallets. A hand sticks out from beneath a sheet covering one of them."

# game/scenario/7_1_0_0.rpy:246
translate english 39f546c2:

    # noam peur "Merde..."
    noam peur "Shit..."

# game/scenario/7_1_0_0.rpy:248
translate english 27e98258:

    # iris determine "Aide-moi à la dégager. Doucement."
    iris determine "Help me get her out. Gently."

# game/scenario/7_1_0_0.rpy:250
translate english 40066477:

    # think "Je soulève la bâche pendant que Tomas écarte une caisse légère."
    think "I lift the tarp while Tomas moves a light crate aside."

# game/scenario/7_1_0_0.rpy:251
translate english e970d0e1:

    # think "Une jeune femme est recroquevillée dans l'espace laissé entre deux conteneurs. Ses vêtements sont couverts de givre."
    think "A young woman is curled up in the gap between two containers. Her clothes are covered in frost."

# game/scenario/7_1_0_0.rpy:252
translate english f7a08f3b:

    # think "Ses lèvres ont perdu leur couleur. Ses cheveux sont collés contre son visage par l'humidité."
    think "Her lips have lost all their color. Her hair is plastered to her face with moisture."

# game/scenario/7_1_0_0.rpy:254
translate english 0f50e13f:

    # tomas inquiet "Elle est morte ?!"
    tomas inquiet "Is she dead?!"

# game/scenario/7_1_0_0.rpy:256
translate english b57b394b:

    # iris colere "Ne dis pas ça."
    iris colere "Don't say that."

# game/scenario/7_1_0_0.rpy:258
translate english 3e6c98bc:

    # think "Iris pose deux doigts contre son cou. Elle attend. Une seconde. Deux secondes."
    think "Iris presses two fingers to her neck. She waits. One second. Two."

# game/scenario/7_1_0_0.rpy:260
translate english b2458548:

    # iris inquiet "J'ai un pouls. Mais il est très lent. Elle en a plus pour longtemps."
    iris inquiet "I have a pulse. But it's very slow. She doesn't have much time."

# game/scenario/7_1_0_0.rpy:262
translate english 422b5887:

    # noam inquiet "Elle respire ?"
    noam inquiet "Is she breathing?"

# game/scenario/7_1_0_0.rpy:264
translate english 46da63d0:

    # iris determine "Difficilement. Aide-moi à la tourner un peu."
    iris determine "Barely. Help me turn her a little."

# game/scenario/7_1_0_0.rpy:266
translate english 999cf1c0:

    # think "Nous dégageons son visage. Un souffle faible passe entre ses lèvres, suivi d'un bruit rauque."
    think "We uncover her face. A faint breath slips through her lips, followed by a raspy sound."

# game/scenario/7_1_0_0.rpy:268
translate english c205d119:

    # nyra inquiet "Combien de temps peut-elle tenir ?"
    nyra inquiet "How long can she hold on?"

# game/scenario/7_1_0_0.rpy:270
translate english 95f2696f:

    # iris colere "Je ne sais pas. Pas longtemps si on la laisse ici."
    iris colere "I don't know. Not long if we leave her here."

# game/scenario/7_1_0_0.rpy:281
translate english 5fed92ba:

    # tomas inquiet "On pourrait l'emmener à l'infirmerie."
    tomas inquiet "We could take her to the infirmary."

# game/scenario/7_1_0_0.rpy:283
translate english 4395a578:

    # nyra raison "L'infirmerie est surveillée. Les entrées, le matériel utilisé, les stocks médicaux. Tout."
    nyra raison "The infirmary is monitored. Who goes in, what equipment gets used, the medical inventory. Everything."

# game/scenario/7_1_0_0.rpy:285
translate english f8282b52:

    # noam reflechit "Et si Kami la voit ?"
    noam reflechit "What if Kami sees her?"

# game/scenario/7_1_0_0.rpy:287
translate english a99f6b3a:

    # nyra raison "Elle a franchi une frontière sans autorisation. Tu connais la sanction."
    nyra raison "She crossed a border without authorization. You know the punishment."

# game/scenario/7_1_0_0.rpy:289
translate english bdf04dd7:

    # tomas inquiet "L'exécution immédiate."
    tomas inquiet "Immediate execution."

# game/scenario/7_1_0_0.rpy:291
translate english 1e9bf4dd:

    # iris desaccord "Pas ici. Les Commandements ne s'appliquent pas dans le Conclave."
    iris desaccord "Not here. The Commandments don't apply inside the Conclave."

# game/scenario/7_1_0_0.rpy:293
translate english f465bad1:

    # nyra raison "Nous l'espérons. Elle n'est pas représentante et Kami adore les interprétations qui l'arrangent."
    nyra raison "We hope. She isn't a representative, and Kami loves whatever interpretation suits her."

# game/scenario/7_1_0_0.rpy:297
translate english 604e67d1:

    # think "La jeune femme laisse échapper un souffle irrégulier. Iris retire sa veste et la pose sur elle."
    think "The young woman lets out an uneven breath. Iris takes off her jacket and lays it over her."

# game/scenario/7_1_0_0.rpy:299
translate english 8e1aea68:

    # noam reflechit "Et si... Si on la cachait ?"
    noam reflechit "What if... What if we hid her?"

# game/scenario/7_1_0_0.rpy:301
translate english ac305d54:

    # iris colere "La cacher ?! Mais tu veux là cacher où ?"
    iris colere "Hide her?! Where exactly do you plan on hiding her?"

# game/scenario/7_1_0_0.rpy:303
translate english b66abbf2:

    # nyra colere "Chut, parle moins fort ! Si les caméras nous entendent on est foutu !"
    nyra colere "Shh, keep your voice down! If the cameras pick us up, we're screwed!"

# game/scenario/7_1_0_0.rpy:305
translate english 1b6d941e:

    # noam reflechit "Il y a des caméras partout..."
    noam reflechit "There are cameras everywhere..."

# game/scenario/7_1_0_0.rpy:306
translate english cdc55285:

    # noam reflechit "Dans une chambre ! On a les brouilleurs, ça devrait le faire, non ?"
    noam reflechit "In someone's room! We have jammers. That should work, right?"

# game/scenario/7_1_0_0.rpy:308
translate english 2a97fcf6:

    # iris reflechit "Dans la chambre de qui tu veux mettre un corps à moitié congelé ?"
    iris reflechit "Whose room do you want to put a half-frozen body in?"

# game/scenario/7_1_0_0.rpy:310
translate english e6bc7c9c:

    # "Je ne dis rien. Je la regarde simplement dans le fond des yeux."
    "I say nothing. I just look her straight in the eye."

# game/scenario/7_1_0_0.rpy:312
translate english 03465ffe:

    # iris colere "Raaah ! Ok, je peux m'en occuper si tu veux la garder."
    iris colere "Argh! Fine, I can take care of her if you want to keep her hidden."

# game/scenario/7_1_0_0.rpy:313
translate english 257c9bff:

    # iris determine "Mais il faut décider maintenant. Soit nous prévenons Kami, soit nous la cachons."
    iris determine "But we have to decide now. Either we tell Kami or we hide her."

# game/scenario/7_1_0_0.rpy:315
translate english 25aba66f:

    # tomas inquiet "Tu crois vraiment qu'on peut la cacher ? Parce que ça signifie mentir à Kami. Et manipuler les caméras. Et les registres de livraison."
    tomas inquiet "Do you really think we can hide her? Because that means lying to Kami. Tampering with the cameras. And the delivery logs."

# game/scenario/7_1_0_0.rpy:317
translate english 5e4562af:

    # nyra raison "Et si on la prévient on sait très bien comment elle va finir..."
    nyra raison "And if we tell her, we know exactly how this will end..."

# game/scenario/7_1_0_0.rpy:319
translate english 7fc94e58:

    # iris colere "Pendant que nous discutons, cette fille gèle. On a pas le temps de débattre."
    iris colere "While we're talking, this girl is freezing to death. We don't have time for a debate."

# game/scenario/7_1_0_0.rpy:341
translate english c00d4971:

    # noam determine "On la cache."
    noam determine "We hide her."

# game/scenario/7_1_0_0.rpy:343
translate english f8556e0e:

    # tomas inquiet "D'accord. Enfin non, pas d'accord, mais... qu'est-ce qu'on fait ?"
    tomas inquiet "Okay. Well, no, not okay, but... what do we do?"

# game/scenario/7_1_0_0.rpy:345
translate english 9df4e5d8:

    # iris determine "Il faut d'abord la réchauffer. Ma chambre est la plus proche et j'ai un brouilleur."
    iris determine "We need to warm her up first. My room is the closest, and I have a jammer."

# game/scenario/7_1_0_0.rpy:347
translate english 26cf36e1:

    # nyra raison "Le problème n'est pas la destination. C'est le trajet."
    nyra raison "The destination isn't the problem. Getting there is."

# game/scenario/7_1_0_0.rpy:349
translate english 56a8c699:

    # noam reflechit "Les caméras couvrent le sas, le couloir et l'entrée du dortoir."
    noam reflechit "The cameras cover the airlock, the corridor, and the dormitory entrance."

# game/scenario/7_1_0_0.rpy:351
translate english c1b72252:

    # tomas panne "Donc c'est impossible."
    tomas panne "So it's impossible."

# game/scenario/7_1_0_0.rpy:353
translate english cc191659:

    # nyra colere "Si tu répètes ça assez souvent, elle finira effectivement par mourir."
    nyra colere "If you keep saying that, she'll eventually make it true by dying."

# game/scenario/7_1_0_0.rpy:355
translate english f025e046:

    # tomas inquiet "Je cherche seulement à être réaliste."
    tomas inquiet "I'm just trying to be realistic."

# game/scenario/7_1_0_0.rpy:357
translate english 863fd93d:

    # iris colere "Alors sois réaliste plus vite."
    iris colere "Then be realistic faster."

# game/scenario/7_1_0_0.rpy:361
translate english 14a840a7:

    # think "Je regarde les caméras. Puis le terminal logistique fixé contre la paroi."
    think "I look at the cameras, then at the logistics terminal mounted on the wall."

# game/scenario/7_1_0_0.rpy:362
translate english 597886fa:

    # think "Les images sont enregistrées quelque part. Si le système s'arrête, nous aurons peut-être quelques secondes."
    think "The footage is stored somewhere. If the system goes down, we might get a few seconds."

# game/scenario/7_1_0_0.rpy:364
translate english 9e2f6dbc:

    # noam reflexion "Kael."
    noam reflexion "Kael."

# game/scenario/7_1_0_0.rpy:366
translate english 6c7ce4eb:

    # nyra surpris "Quoi, Kael ?"
    nyra surpris "What about Kael?"

# game/scenario/7_1_0_0.rpy:368
translate english 9155c86b:

    # noam determine "Il comprend les réseaux et les systèmes du Conclave mieux que nous. Il peut peut-être couper les caméras."
    noam determine "He understands the Conclave's networks and systems better than we do. Maybe he can shut down the cameras."

# game/scenario/7_1_0_0.rpy:370
translate english 7b133a75:

    # tomas inquiet "Et s'il refuse ?"
    tomas inquiet "What if he refuses?"

# game/scenario/7_1_0_0.rpy:372
translate english 105ac6c5:

    # noam neutre "Je lui expliquerai."
    noam neutre "I'll explain it to him."

# game/scenario/7_1_0_0.rpy:374
translate english 0c976456:

    # nyra raison "Pas dans le couloir. Tu entres dans sa chambre avant de lui dire quoi que ce soit."
    nyra raison "Not in the corridor. Get inside his room before you say anything."

# game/scenario/7_1_0_0.rpy:376
translate english 2f672367:

    # iris determine "Je reste ici avec elle."
    iris determine "I'm staying here with her."

# game/scenario/7_1_0_0.rpy:378
translate english 95e531a0:

    # tomas inquiet "Moi aussi."
    tomas inquiet "Me too."

# game/scenario/7_1_0_0.rpy:380
translate english 35accd8a:

    # nyra raison "Je vais vérifier le trajet jusqu'à la chambre d'Iris. Si quelqu'un approche, je trouve une raison de l'éloigner."
    nyra raison "I'll check the route to Iris's room. If anyone comes near, I'll find a reason to send them away."

# game/scenario/7_1_0_0.rpy:382
translate english 42019de6:

    # noam determine "Je reviens avec Kael."
    noam determine "I'll be back with Kael."

# game/scenario/7_1_0_0.rpy:384
translate english c20ae5f4:

    # iris inquiet "Fais vite. Sa respiration ralentit encore."
    iris inquiet "Hurry. Her breathing is getting even slower."

# game/scenario/7_1_0_0.rpy:390
translate english bba30203:

    # think "Je quitte le sas sans courir. La caméra au-dessus de la porte suit mon passage."
    think "I leave the airlock without running. The camera above the door tracks me as I pass."

# game/scenario/7_1_0_0.rpy:391
translate english e7ab90f7:

    # think "Chaque pas normal me paraît absurdement lent."
    think "Every normal step feels absurdly slow."

# game/scenario/7_1_0_0.rpy:401
translate english 28f3473e:

    # think "Je frappe deux fois à la porte de Kael."
    think "I knock twice on Kael's door."

# game/scenario/7_1_0_0.rpy:405
translate english 462150e9:

    # kael "Une seconde."
    kael "One second."

# game/scenario/7_1_0_0.rpy:416
translate english 90f7bfad:

    # kael fatigue "Noam ? Tu as vu l'heure ?"
    kael fatigue "Noam? Do you know what time it is?"

# game/scenario/7_1_0_0.rpy:418
translate english 9ff5665f:

    # noam determine "Laisse-moi entrer."
    noam determine "Let me in."

# game/scenario/7_1_0_0.rpy:420
translate english e7002c4a:

    # kael surpris "Tu saignes encore ?"
    kael surpris "Are you still bleeding?"

# game/scenario/7_1_0_0.rpy:422
translate english 93295d6d:

    # noam colere "Kael. Maintenant."
    noam colere "Kael. Now."

# game/scenario/7_1_0_0.rpy:424
translate english 4c6e3b8c:

    # think "Il s'écarte. J'entre et referme immédiatement la porte."
    think "He steps aside. I enter and immediately close the door behind me."

# game/scenario/7_1_0_0.rpy:433
translate english 5ca3a5fb:

    # kael inquietude "Qu'est-ce qu'il se passe ?"
    kael inquietude "What's going on?"

# game/scenario/7_1_0_0.rpy:435
translate english 9e68127a:

    # think "Je vérifie le voyant du brouilleur avant de me rapprocher."
    think "I check the jammer light before moving closer."

# game/scenario/7_1_0_0.rpy:437
translate english d79265f2:

    # noam reflexion "Il y a une fille dans la livraison. Elle s'est cachée dans un conteneur."
    noam reflexion "There's a girl in the delivery. She hid inside a container."

# game/scenario/7_1_0_0.rpy:439
translate english ed558dd1:

    # kael surpris "Une fille ? Dans le sas ?"
    kael surpris "A girl? In the airlock?"

# game/scenario/7_1_0_0.rpy:441
translate english 3fd1299c:

    # noam determine "Elle est vivante, mais elle est presque congelée. Il faut l'emmener dans la chambre d'Iris sans que les caméras nous voient."
    noam determine "She's alive, but nearly frozen. We need to get her to Iris's room without the cameras seeing us."

# game/scenario/7_1_0_0.rpy:443
translate english dcdbbfab:

    # kael reflechit "Et tu veux que je les désactive."
    kael reflechit "And you want me to disable them."

# game/scenario/7_1_0_0.rpy:445
translate english a56405d6:

    # noam neutre "Oui."
    noam neutre "Yes."

# game/scenario/7_1_0_0.rpy:447
translate english 7a77ef40:

    # kael inquietude "Désactiver une caméra alerterait immédiatement le serveur central. Il enverrait une copie de l'incident à Kami avant même que l'image disparaisse."
    kael inquietude "Disabling a camera would immediately alert the central server. It would send Kami a copy of the incident before the feed even went dark."

# game/scenario/7_1_0_0.rpy:449
translate english eb9aa891:

    # noam inquiet "Tu peux faire autre chose ?"
    noam inquiet "Can you do something else?"

# game/scenario/7_1_0_0.rpy:451
translate english 5ed70e80:

    # kael reflechit "Redémarrer le serveur de surveillance depuis le routeur logistique."
    kael reflechit "Reboot the surveillance server through the logistics router."

# game/scenario/7_1_0_0.rpy:453
translate english 2b56516c:

    # noam surpris "Ça couperait les caméras ?"
    noam surpris "Would that shut down the cameras?"

# game/scenario/7_1_0_0.rpy:455
translate english a23e9690:

    # kael calme "Pendant le redémarrage, oui. Mais tout le Conclave basculerait sur les générateurs de secours."
    kael calme "During the reboot, yes. But the entire Conclave would switch to backup generators."

# game/scenario/7_1_0_0.rpy:457
translate english 221ed517:

    # noam inquiet "Pendant combien de temps ?"
    noam inquiet "For how long?"

# game/scenario/7_1_0_0.rpy:459
translate english 821e0518:

    # kael reflechit "Une minute, peut-être un peu moins. Les systèmes prioritaires reviendront avant les caméras."
    kael reflechit "A minute, maybe a little less. Priority systems will come back before the cameras."

# game/scenario/7_1_0_0.rpy:461
translate english 3d527ef4:

    # noam determine "C'est suffisant."
    noam determine "That's enough."

# game/scenario/7_1_0_0.rpy:463
translate english d5df1dcc:

    # kael inquietude "Non. C'est juste la durée pendant laquelle on peut se faire prendre sans preuve vidéo."
    kael inquietude "No. That's just how long we can get caught without video evidence."

# game/scenario/7_1_0_0.rpy:465
translate english d873c0b6:

    # noam desaccord "Elle mourra si on ne fait rien."
    noam desaccord "She'll die if we do nothing."

# game/scenario/7_1_0_0.rpy:469
translate english cbcaad30_1:

    # kael triste "Je sais."
    kael triste "I know."

# game/scenario/7_1_0_0.rpy:471
translate english 4ca19a13:

    # noam inquiet "Tu vas nous aider ?"
    noam inquiet "Will you help us?"

# game/scenario/7_1_0_0.rpy:473
translate english 6e609959:

    # kael reflechit "Si j'entre dans le routeur, j'aurai peut-être accès aux relais extérieurs."
    kael reflechit "If I get into the router, I might be able to access the external relays."

# game/scenario/7_1_0_0.rpy:475
translate english 172f48d8:

    # noam surpris "Tu veux chercher ta sœur."
    noam surpris "You want to look for your sister."

# game/scenario/7_1_0_0.rpy:477
translate english 9c322532:

    # kael triste "J'ai toujours aucune nouvelle d'elle depuis l'incident."
    kael triste "I still haven't heard anything from her since the incident."

# game/scenario/7_1_0_0.rpy:478
translate english 9812917f:

    # kael culpabilite "Je ne sais rien. Alors même si je me fais chopper j'utiliserai ça comme excuse."
    kael culpabilite "I know nothing. So even if I get caught, I'll use that as my excuse."

# game/scenario/7_1_0_0.rpy:480
translate english d7946df1:

    # noam inquiet "Kael, on n'a pas le temps de parcourir les registres maintenant."
    noam inquiet "Kael, we don't have time to search through the records right now."

# game/scenario/7_1_0_0.rpy:482
translate english 6a3c95f6:

    # kael calme "Je redémarre le serveur. Ensuite, pendant que vous la déplacez, je cherche une trace de Léa."
    kael calme "I'll reboot the server. Then, while you move her, I'll look for any trace of Léa."

# game/scenario/7_1_0_0.rpy:484
translate english 1947e82b:

    # noam desaccord "C'est plus risqué."
    noam desaccord "That's even riskier."

# game/scenario/7_1_0_0.rpy:486
translate english 7b21f988:

    # kael calme "Je sais. Mais si je dois prendre ce risque, je veux me donner à fond."
    kael calme "I know. But if I'm taking this risk, I'm going all in."

# game/scenario/7_1_0_0.rpy:490
translate english 89fa9030:

    # noam determine "D'accord. Mais dès que les générateurs redémarrent, tu quittes le système."
    noam determine "Fine. But the moment the generators restart, you get out of the system."

# game/scenario/7_1_0_0.rpy:492
translate english a0a46af9:

    # kael reflechit "Je ferai au mieux."
    kael reflechit "I'll do my best."

# game/scenario/7_1_0_0.rpy:496
translate english 932c6dd7:

    # think "Il récupère sa tablette et un petit câble dissimulé dans un tiroir."
    think "He grabs his tablet and a small cable hidden in a drawer."

# game/scenario/7_1_0_0.rpy:498
translate english d9d0424e:

    # kael neutre "Allons-y."
    kael neutre "Let's go."

# game/scenario/7_1_0_0.rpy:520
translate english 2b15df8c:

    # think "À notre retour, Iris a dégagé les draps du corps."
    think "When we return, Iris has pulled the sheets away from the body."

# game/scenario/7_1_0_0.rpy:522
translate english cd96aeb3:

    # iris inquiet "Son pouls est toujours bas. On ne peut plus attendre."
    iris inquiet "Her pulse is still weak. We can't wait any longer."

# game/scenario/7_1_0_0.rpy:524
translate english 80a1468c:

    # kael reflechit "Le routeur est derrière ce panneau."
    kael reflechit "The router is behind this panel."

# game/scenario/7_1_0_0.rpy:526
translate english 945fd006:

    # nyra raison "Le couloir est vide. J'ai bloqué la porte de la salle de repos avec un chariot. Si quelqu'un sort, il perdra quelques secondes."
    nyra raison "The corridor is clear. I blocked the lounge door with a cart. If anyone comes out, it'll slow them down for a few seconds."

# game/scenario/7_1_0_0.rpy:528
translate english 544be553:

    # tomas inquiet "C'est vraiment notre plan ? On a quelques secondes pour la transporter à l'autre bout du Conclave ?"
    tomas inquiet "Is this really our plan? We have a few seconds to carry her to the other end of the Conclave?"

# game/scenario/7_1_0_0.rpy:530
translate english 08da7a2c:

    # nyra raison "Tu préfères demander l'autorisation ?cTu as un meilleur plan ?"
    nyra raison "Would you rather ask for permission? Do you have a better plan?"

# game/scenario/7_1_0_0.rpy:532
translate english 804d5996:

    # tomas panne "N-Non."
    tomas panne "N-No."

# game/scenario/7_1_0_0.rpy:534
translate english b3ed7150:

    # kael calme "Une fois que je lance le redémarrage, vous aurez environ une minute. Peut-être moins."
    kael calme "Once I start the reboot, you'll have about a minute. Maybe less."

# game/scenario/7_1_0_0.rpy:536
translate english fff5f77e:

    # noam determine "Tomas et moi la portons. Iris ouvre les portes et nous guide. Nyra surveille le couloir."
    noam determine "Tomas and I will carry her. Iris opens the doors and leads the way. Nyra watches the corridor."

# game/scenario/7_1_0_0.rpy:538
translate english 1194a6b2:

    # iris determine "Dans ma chambre, posez-la directement sur le lit. Ne retirez pas les couvertures."
    iris determine "Once you're in my room, put her straight on the bed. Don't remove the blankets."

# game/scenario/7_1_0_0.rpy:540
translate english d8ed7990:

    # tomas inquiet "Et Kael ?"
    tomas inquiet "What about Kael?"

# game/scenario/7_1_0_0.rpy:542
translate english cc0f1b35:

    # kael calme "Je reste ici pour relancer les serveurs."
    kael calme "I'm staying here to bring the servers back online."

# game/scenario/7_1_0_0.rpy:544
translate english e8a41900:

    # noam raison "Et tu quittes le système dès que c'est fait."
    noam raison "And you'll get out of the system as soon as it's done."

# game/scenario/7_1_0_0.rpy:546
translate english dd3d3bf8:

    # kael neutre "Oui."
    kael neutre "Yes."

# game/scenario/7_1_0_0.rpy:550
translate english 0f23bd3c:

    # think "Kael retire la plaque du routeur et branche son câble. Des lignes de texte apparaissent sur sa tablette."
    think "Kael removes the router panel and plugs in his cable. Lines of text appear on his tablet."

# game/scenario/7_1_0_0.rpy:552
translate english cd7d2f21:

    # kael reflechit "J'accède au serveur logistique... puis à la surveillance..."
    kael reflechit "Accessing the logistics server... then surveillance..."

# game/scenario/7_1_0_0.rpy:554
translate english c14a1d7f:

    # nyra inquiet "Combien de temps ?"
    nyra inquiet "How long?"

# game/scenario/7_1_0_0.rpy:556
translate english c1d30c4c:

    # kael calme "Maintenant."
    kael calme "Now."

# game/scenario/7_1_0_0.rpy:558
translate english 29c40487:

    # think "Il valide une commande."
    think "He confirms a command."

# game/scenario/7_1_0_0.rpy:576
translate english bce1388b:

    # kael determine "J'y suis. Les deux sentinelles sont isolées. Je force le redémarrage."
    kael determine "I'm in. Both sentinels are isolated. Forcing the reboot now."

# game/scenario/7_1_0_0.rpy:577
translate english ce876782:

    # noam determine "Tout le monde est prêt ?"
    noam determine "Is everyone ready?"

# game/scenario/7_1_0_0.rpy:578
translate english 475d5b60:

    # iris determine "Fais-le."
    iris determine "Do it."

# game/scenario/7_1_0_0.rpy:599
translate english 7b55e4ce:

    # centered "{size=36}COUPURE ÉLECTRIQUE GÉNÉRALE{/size}"
    centered "{size=36}TOTAL POWER FAILURE{/size}"

# game/scenario/7_1_0_0.rpy:600
translate english 434e02a6:

    # centered "{size=36}BASCULEMENT SUR LES GÉNÉRATEURS DE SECOURS{/size}"
    centered "{size=36}SWITCHING TO BACKUP GENERATORS{/size}"

# game/scenario/7_1_0_0.rpy:601
translate english 09213155:

    # centered "{size=36}TEMPS ESTIMÉ AVANT RÉTABLISSEMENT : SOIXANTE SECONDES{/size}"
    centered "{size=36}ESTIMATED RESTORATION TIME: SIXTY SECONDS{/size}"

# game/scenario/7_1_0_0.rpy:603
translate english c32c820b:

    # think "Les lumières s'éteignent. Une seconde plus tard, les bandes d'urgence couvrent le sas d'une lumière rouge."
    think "The lights go out. A second later, the emergency strips flood the airlock with red light."

# game/scenario/7_1_0_0.rpy:607
translate english b61c2724:

    # noam determine "On y va !"
    noam determine "Go!"

# game/scenario/7_1_0_0.rpy:609
translate english 6a495108:

    # think "Tomas passe un bras sous les épaules de la jeune femme. Je soulève ses jambes."
    think "Tomas slips an arm under the young woman's shoulders. I lift her legs."

# game/scenario/7_1_0_0.rpy:610
translate english 5aac5b46:

    # think "Son corps est assez lourds, le draps glisse entre nos mains et on commence à avancer rapidement."
    think "Her body is heavier than I expected. The sheet slips through our hands as we start moving as fast as we can."

# game/scenario/7_1_0_0.rpy:612
translate english d860a383:

    # tomas inquiet "Je la tiens ! Avance !"
    tomas inquiet "I've got her! Move!"

# game/scenario/7_1_0_0.rpy:614
translate english f685348d:

    # iris determine "La porte est ouverte. Dépêchez-vous !"
    iris determine "The door's open. Hurry!"

# game/scenario/7_1_0_0.rpy:627
translate english 7c491880:

    # think "Nous sortons du sas. Le dortoir entier baigne dans le rouge."
    think "We leave the airlock. The entire dormitory is bathed in red."

# game/scenario/7_1_0_0.rpy:628
translate english 9d602b06:

    # think "Nyra court devant nous et vérifie chaque embranchement."
    think "Nyra runs ahead of us, checking every intersection."

# game/scenario/7_1_0_0.rpy:630
translate english b08ac57b:

    # nyra determine "Personne à gauche. Continuez."
    nyra determine "No one to the left. Keep going."

# game/scenario/7_1_0_0.rpy:632
translate english 60f4c496:

    # tomas inquiet "Elle respire encore ?"
    tomas inquiet "Is she still breathing?"

# game/scenario/7_1_0_0.rpy:634
translate english 70eaea94:

    # iris colere "Ne t'arrête pas pour vérifier !"
    iris colere "Don't stop to check!"

# game/scenario/7_1_0_0.rpy:636
translate english 6b1a3418:

    # think "Mes bras commencent déjà à trembler. Je resserre ma prise sous ses genoux."
    think "My arms are already starting to shake. I tighten my grip beneath her knees."

# game/scenario/7_1_0_0.rpy:638
translate english 1bf932ad:

    # noam inquiet "Tomas, plus haut. Sa tête part en arrière."
    noam inquiet "Tomas, lift her higher. Her head is falling back."

# game/scenario/7_1_0_0.rpy:640
translate english 6174fb63:

    # tomas determine "Je fais ce que je peux !"
    tomas determine "I'm doing the best I can!"

# game/scenario/7_1_0_0.rpy:648
translate english c884fe3c:

    # think "Une porte s'ouvre au bout du couloir. Nyra pousse brutalement le chariot devant l'entrée."
    think "A door opens at the end of the corridor. Nyra roughly shoves the cart in front of the entrance."

# game/scenario/7_1_0_0.rpy:650
translate english fa7e53dc:

    # nyra colere "Maintenance électrique ! Restez dans votre chambre !"
    nyra colere "Electrical maintenance! Stay in your room!"

# game/scenario/7_1_0_0.rpy:652
translate english 841fdf0e:

    # elias "C'était quoi, ce bruit ?"
    elias "What was that noise?"

# game/scenario/7_1_0_0.rpy:654
translate english 14b5b912:

    # nyra determine "Le générateur. Referme !"
    nyra determine "The generator. Close the door!"

# game/scenario/7_1_0_0.rpy:656
translate english d3754e78:

    # think "La porte se referme. Nous poursuivons notre course."
    think "The door closes. We keep running."

# game/scenario/7_1_0_0.rpy:667
translate english 00eee5d7:

    # think "Iris ouvre sa chambre et arrache les couvertures de son propre lit."
    think "Iris opens her room and yanks the blankets off her bed."

# game/scenario/7_1_0_0.rpy:669
translate english b25cda21:

    # iris determine "Posez-la ici. Sur le côté."
    iris determine "Put her here. On her side."

# game/scenario/7_1_0_0.rpy:671
translate english 4df980e8:

    # think "Tomas et moi déposons la jeune femme sur le matelas. Iris la recouvre aussitôt de plusieurs couettes."
    think "Tomas and I lower the young woman onto the mattress. Iris immediately covers her with several comforters."

# game/scenario/7_1_0_0.rpy:673
translate english b6ff0a22:

    # tomas inquiet "Elle ne bouge pas."
    tomas inquiet "She's not moving."

# game/scenario/7_1_0_0.rpy:677
translate english 0fea4360:

    # iris colere "Parce qu'elle est inconsciente. Donne-moi l'oreiller."
    iris colere "Because she's unconscious. Give me the pillow."

# game/scenario/7_1_0_0.rpy:679
translate english ee247e57:

    # noam inquiet "Nyra, la porte."
    noam inquiet "Nyra, the door."

# game/scenario/7_1_0_0.rpy:681
translate english 07cafb8e:

    # nyra determine "Je l'ai. Sortez. Il ne faut pas qu'on nous voie tous ici quand les caméras reviennent."
    nyra determine "I've got it. Get out. We can't all be in here when the cameras come back online."

# game/scenario/7_1_0_0.rpy:683
translate english 9bc4d41a:

    # iris determine "Je reste avec elle."
    iris determine "I'm staying with her."

# game/scenario/7_1_0_0.rpy:685
translate english 71ef2186:

    # noam inquiet "Tu es sûre ?"
    noam inquiet "Are you sure?"

# game/scenario/7_1_0_0.rpy:687
translate english 5b0abe97:

    # iris colere "Non. Mais je suis la seule ici à savoir vérifier si elle meurt."
    iris colere "No. But I'm the only one here who knows how to tell if she's dying."

# game/scenario/7_1_0_0.rpy:689
translate english af63aee9:

    # think "Tomas et moi quittons la chambre. Nyra referme derrière nous."
    think "Tomas and I leave the room. Nyra closes the door behind us."

# game/scenario/7_1_0_0.rpy:697
translate english ec61d1aa:

    # think "Nous nous éloignons les uns des autres et reprenons une allure normale."
    think "We put some distance between ourselves and return to a normal pace."

# game/scenario/7_1_0_0.rpy:703
translate english 1b9a2507:

    # think "Les plafonniers se rallument brutalement. Les ventilations repartent dans un grondement sourd."
    think "The ceiling lights snap back on. The ventilation rumbles back to life."

# game/scenario/7_1_0_0.rpy:707
translate english 09ec1a2f:

    # centered "{size=34}ALIMENTATION PRINCIPALE RÉTABLIE — REDÉMARRAGE PROGRESSIF DES SYSTÈMES{/size}"
    centered "{size=34}MAIN POWER RESTORED — SYSTEMS RESTARTING GRADUALLY{/size}"

# game/scenario/7_1_0_0.rpy:717
translate english d3b75051:

    # tomas inquiet "On l'a fait ?"
    tomas inquiet "Did we do it?"

# game/scenario/7_1_0_0.rpy:719
translate english f96f8484:

    # nyra raison "Ne regarde pas la porte d'Iris."
    nyra raison "Don't look at Iris's door."

# game/scenario/7_1_0_0.rpy:721
translate english 2dcc5c74:

    # tomas inquiet "Je ne la regardais pas."
    tomas inquiet "I wasn't looking at it."

# game/scenario/7_1_0_0.rpy:723
translate english 907a0735:

    # nyra raison "Tu la fixes depuis que les lumières sont revenues."
    nyra raison "You've been staring at it since the lights came back on."

# game/scenario/7_1_0_0.rpy:725
translate english d0702df2:

    # noam determine "On se sépare. On agit normalement."
    noam determine "We split up. Act normal."

# game/scenario/7_1_0_0.rpy:727
translate english 898b326b:

    # tomas panne "Normalement. Oui. Je suis parfaitement normal."
    tomas panne "Normal. Right. I'm perfectly normal."

# game/scenario/7_1_0_0.rpy:729
translate english c31a86c1:

    # nyra taquin "Tu ressembles à quelqu'un qui vient de cacher un cadavre."
    nyra taquin "You look like someone who just hid a body."

# game/scenario/7_1_0_0.rpy:731
translate english a288d229:

    # tomas inquiet "Ce n'est pas un cadavre !"
    tomas inquiet "She's not a body!"

# game/scenario/7_1_0_0.rpy:733
translate english 4230f120:

    # nyra colere "Moins fort."
    nyra colere "Keep it down."

# game/scenario/7_1_0_0.rpy:737
translate english 7e0f3601:

    # noam inquiet "Kael est encore dans le sas."
    noam inquiet "Kael is still in the airlock."

# game/scenario/7_1_0_0.rpy:739
translate english 360d0f38:

    # nyra raison "Il nous rejoindra. Si tu retournes le chercher maintenant, tu attireras l'attention."
    nyra raison "He'll catch up with us. Going back for him now would draw attention."

# game/scenario/7_1_0_0.rpy:741
translate english b08f4888:

    # think "Elle a raison. Pourtant, quelque chose me dérange dans le silence du sas."
    think "She's right. Still, something about the silence from the airlock bothers me."

# game/scenario/7_1_0_0.rpy:753
translate english 0d93d9f1:

    # think "La couverture glisse et son épaule heurte le bord du conteneur."
    think "The blanket slips, and her shoulder strikes the edge of the container."

# game/scenario/7_1_0_0.rpy:755
translate english c38554bb:

    # iris colere "Arrêtez. Reprenez-la sous les omoplates."
    iris colere "Stop. Get your hands back under her shoulder blades."

# game/scenario/7_1_0_0.rpy:757
translate english af6b2925:

    # tomas panne "Je n'ai plus de prise, le tissu est gelé !"
    tomas panne "I can't get a grip. The fabric is frozen!"

# game/scenario/7_1_0_0.rpy:759
translate english 5adb8d6e:

    # noam determine "Passe ton bras dessous. Je maintiens ses jambes."
    noam determine "Put your arm underneath her. I'll hold her legs."

# game/scenario/7_1_0_0.rpy:761
translate english 39cba4ee:

    # think "Nous la soulevons de nouveau. Plusieurs secondes viennent de disparaître."
    think "We lift her again. We've just lost several seconds."

# game/scenario/7_1_0_0.rpy:763
translate english 88ee8c77:

    # think "Mon pied accroche le rail d'une porte et je bascule contre le mur."
    think "My foot catches on a door rail, and I stumble into the wall."

# game/scenario/7_1_0_0.rpy:765
translate english 921c583e:

    # tomas peur "Noam ! Sa tête !"
    tomas peur "Noam! Her head!"

# game/scenario/7_1_0_0.rpy:767
translate english 05f8dcc1:

    # iris colere "Ne la posez pas. Stabilisez-la contre vous."
    iris colere "Don't put her down. Brace her against your body."

# game/scenario/7_1_0_0.rpy:769
translate english 957d0291:

    # noam inquiet "Ça va. Je l'ai encore. Avance."
    noam inquiet "I'm fine. I still have her. Keep moving."

# game/scenario/7_1_0_0.rpy:771
translate english d216bc79:

    # think "Nous retrouvons notre équilibre, beaucoup moins vite que le compteur ne descend."
    think "We regain our balance, far more slowly than the timer is counting down."

# game/scenario/7_1_0_0.rpy:773
translate english 9d286aea:

    # think "Le chariot bloque mal le passage et revient dans nos jambes."
    think "The cart is blocking the passage badly and rolls back into our legs."

# game/scenario/7_1_0_0.rpy:775
translate english 9955b43b:

    # nyra colere "Attendez. Je le dégage."
    nyra colere "Wait. I'll move it."

# game/scenario/7_1_0_0.rpy:777
translate english a8f5af3d:

    # iris inquiet "Sa respiration vient de changer. Dépêchez-vous."
    iris inquiet "Her breathing just changed. Hurry."

# game/scenario/7_1_0_0.rpy:779
translate english d06ca095:

    # tomas determine "Je tiens. Je tiens encore."
    tomas determine "I've got her. I still have her."

# game/scenario/7_1_0_0.rpy:781
translate english 80863dc7:

    # think "Nyra libère enfin le passage. La porte d'Iris paraît toujours trop loin."
    think "Nyra finally clears the way. Iris's door still looks impossibly far away."

# game/scenario/7_1_0_0.rpy:798
translate english 8e87fcc4:

    # kami "Vous aviez une minute. Une minute entière."
    kami "You had one minute. One whole minute."

# game/scenario/7_1_0_0.rpy:800
translate english 208c0e58:

    # kami "Les caméras sont revenues avant vous. Elles ont donc eu le temps d'admirer votre livraison très personnelle."
    kami "The cameras came back before you made it. So they had plenty of time to admire your very personal delivery."

# game/scenario/7_1_0_0.rpy:802
translate english 368c59dd:

    # kami "Une clandestine, quatre complices et un itinéraire improvisé. Vous rendez les infractions si laborieuses."
    kami "One stowaway, four accomplices, and an improvised route. You make breaking the rules look so exhausting."

# game/scenario/7_1_0_0.rpy:803
translate english 2b9a0a7e:

    # kami "Le Commandement VI ne laisse malheureusement aucune place à votre retard."
    kami "Unfortunately, Commandment VI leaves no room for your tardiness."

# game/scenario/7_1_0_0.rpy:805
translate english 13edc0f5:

    # kami "La prochaine fois, courez plus vite. Enfin... il n'y aura pas de prochaine fois."
    kami "Next time, run faster. Then again... there won't be a next time."

# game/scenario/7_1_0_0.rpy:811
translate english ce26afe4:

    # centered "{size=78}{color=#FF334F}GAME OVER{/color}{/size}"
    centered "{size=78}{color=#FF334F}GAME OVER{/color}{/size}"

# game/scenario/7_1_0_0.rpy:843
translate english 1f411c41:

    # think "À midi, nous nous retrouvons presque tous à la cafétéria."
    think "At noon, almost all of us meet in the cafeteria."

# game/scenario/7_1_0_0.rpy:844
translate english 91e2cd19:

    # think "Iris prétend être fatiguée. Kael n'est pas là non plus."
    think "Iris claims she's tired. Kael isn't here either."

# game/scenario/7_1_0_0.rpy:845
translate english 70cc8e13:

    # think "Personne ne doit regarder trop souvent leurs places vides. Personne ne doit se montrer inquiet."
    think "No one can look at their empty seats too often. No one can appear worried."

# game/scenario/7_1_0_0.rpy:847
translate english 520a1edb:

    # elen content "Je savais que le commerce changerait tout, mais pas au point de couper l'électricité !"
    elen content "I knew trade would change everything, but I didn't think it would cut the power!"

# game/scenario/7_1_0_0.rpy:849
translate english 0e6e6ea0:

    # julian taquin "Le cacao a peut-être demandé trop de puissance."
    julian taquin "Maybe the cocoa needed too much electricity."

# game/scenario/7_1_0_0.rpy:851
translate english d053eb35:

    # elias ecoute "C'était le serveur central. Les machines de la maintenance ont redémarré avant le réseau."
    elias ecoute "It was the central server. The maintenance machines rebooted before the network."

# game/scenario/7_1_0_0.rpy:853
translate english b62defc3:

    # mara mefiant "Et notre spécialiste d'Orbite a disparu juste après. Quelle coïncidence."
    mara mefiant "And our Orbit systems expert vanished right afterward. What a coincidence."

# game/scenario/7_1_0_0.rpy:855
translate english 09b6e3bc:

    # nyra neutre "Kael aime les systèmes. Une panne lui donne probablement l'impression d'avoir été personnellement invité."
    nyra neutre "Kael likes systems. A power failure probably feels like a personal invitation to him."

# game/scenario/7_1_0_0.rpy:857
translate english 373312b8:

    # tomas panne "Oui. Voilà. C'est exactement ça."
    tomas panne "Yes. Exactly. That's exactly it."

# game/scenario/7_1_0_0.rpy:859
translate english 15e01f30:

    # lysa taquin "Tomas, personne ne t'accusait de quoi que ce soit."
    lysa taquin "Tomas, no one was accusing you of anything."

# game/scenario/7_1_0_0.rpy:861
translate english 869d52aa:

    # tomas inquiet "Je sais."
    tomas inquiet "I know."

# game/scenario/7_1_0_0.rpy:863
translate english 16d8cea0:

    # lysa blase "Tu rends la situation extrêmement rassurante."
    lysa blase "You're making this whole situation extremely reassuring."

# game/scenario/7_1_0_0.rpy:865
translate english 2f6ac219:

    # noam sourire "On devrait profiter de l'après-midi. Kami n'a encore rien annoncé."
    noam sourire "We should enjoy the afternoon. Kami still hasn't announced anything."

# game/scenario/7_1_0_0.rpy:867
translate english 6d14219d:

    # ryn fatigue "Pour une fois qu'elle nous fout la paix."
    ryn fatigue "For once, she's leaving us the fuck alone."

# game/scenario/7_1_0_0.rpy:869
translate english d0b8aabc:

    # sael mefiant "Elle ne nous laisse jamais tranquilles. Elle attend."
    sael mefiant "She never leaves us alone. She's waiting."

# game/scenario/7_1_0_0.rpy:873
translate english 73fff772:

    # think "Je force mes épaules à se détendre. Agir normalement est beaucoup plus difficile quand on essaie de le faire consciemment."
    think "I force my shoulders to relax. Acting normal is much harder when you're consciously trying to do it."

# game/scenario/7_1_0_0.rpy:877
translate english 30b5f2ec:

    # think "J'ai encore du temps avant le soir. Le mieux est de suivre la routine prévue et de ne pas retourner immédiatement voir Iris."
    think "I still have time before evening. The best thing to do is stick to the usual routine and not go straight back to check on Iris."

# game/scenario/7_1_0_0.rpy:891
translate english 80e55311:

    # think "Mon premier temps libre terminé, je repasse par le dortoir."
    think "After my first free-time period, I pass through the dormitory again."

# game/scenario/7_1_0_0.rpy:892
translate english 56bcc6c0:

    # think "Je ralentis devant la chambre d'Iris, puis continue sans frapper. Une caméra se trouve à l'autre extrémité du couloir."
    think "I slow down outside Iris's room, then keep walking without knocking. There's a camera at the other end of the corridor."

# game/scenario/7_1_0_0.rpy:893
translate english c4889008:

    # think "Nous avons décidé d'agir normalement. Alors je dois encore attendre."
    think "We agreed to act normal. So I have to keep waiting."

# game/scenario/7_1_0_0.rpy:907
translate english 0d62fc8e:

    # think "Après mon deuxième temps libre, le couloir est enfin vide."
    think "After my second free-time period, the corridor is finally empty."

# game/scenario/7_1_0_0.rpy:908
translate english 85f59036:

    # think "Je frappe doucement à la porte d'Iris : deux coups, une pause, puis un troisième. Le signal convenu."
    think "I knock softly on Iris's door: two knocks, a pause, then a third. The signal we agreed on."

# game/scenario/7_1_0_0.rpy:916
translate english b8555e4c:

    # iris "Entre."
    iris "Come in."

# game/scenario/7_1_0_0.rpy:932
translate english 298333b5:

    # think "La chambre est plus chaude que le reste du dortoir. Iris a poussé le chauffage au maximum."
    think "The room is warmer than the rest of the dormitory. Iris has turned the heat all the way up."

# game/scenario/7_1_0_0.rpy:933
translate english 8032972b:

    # think "La jeune femme est presque entièrement dissimulée sous les couettes. Seule une partie de son visage reste visible."
    think "The young woman is almost completely hidden beneath the comforters. Only part of her face is visible."

# game/scenario/7_1_0_0.rpy:935
translate english f743f116:

    # noam inquiet "Elle s'est réveillée ?"
    noam inquiet "Has she woken up?"

# game/scenario/7_1_0_0.rpy:937
translate english 0b295ac3_1:

    # iris fatigue "Non."
    iris fatigue "No."

# game/scenario/7_1_0_0.rpy:939
translate english 9046b6b8:

    # noam inquiet "Son état s'améliore ?"
    noam inquiet "Is she getting better?"

# game/scenario/7_1_0_0.rpy:941
translate english 2ded2520:

    # iris reflexion "Sa température remonte lentement. Sa respiration est moins irrégulière, mais elle reste beaucoup trop faible."
    iris reflexion "Her temperature is slowly rising. Her breathing is less erratic, but she's still far too weak."

# game/scenario/7_1_0_0.rpy:943
translate english cfbedfbd:

    # noam neutre "Tu as besoin de quelque chose ?"
    noam neutre "Do you need anything?"

# game/scenario/7_1_0_0.rpy:945
translate english b6de2e8a:

    # iris inquiet "De matériel médical. D'une perfusion. D'un vrai thermomètre. De savoir combien de temps elle est restée dans le froid."
    iris inquiet "Medical supplies. An IV. A proper thermometer. To know how long she was out in the cold."

# game/scenario/7_1_0_0.rpy:946
translate english 688b7cbc:

    # iris colere "Bref, de tout ce que je ne peux pas prendre à l'infirmerie sans laisser une trace."
    iris colere "In short, everything I can't take from the infirmary without leaving a trail."

# game/scenario/7_1_0_0.rpy:948
translate english 08b5dff5:

    # noam raison "On peut répartir les prélèvements. Une personne prend des compresses, une autre une poche chauffante..."
    noam raison "We could split up what we take. One person grabs gauze, someone else takes a heat pack..."

# game/scenario/7_1_0_0.rpy:950
translate english cd95b613:

    # iris desaccord "Et demain Kami demandera pourquoi onze représentants ont soudain développé la même maladie."
    iris desaccord "And tomorrow, Kami will ask why eleven representatives suddenly came down with the same illness."

# game/scenario/7_1_0_0.rpy:954
translate english 994ce0d8:

    # think "La jeune femme bouge légèrement sous les couvertures. Un son faible sort de sa gorge, mais ses yeux restent fermés."
    think "The young woman shifts slightly beneath the blankets. A faint sound escapes her throat, but her eyes stay closed."

# game/scenario/7_1_0_0.rpy:956
translate english a17f17de:

    # noam surpris "Elle a réagi."
    noam surpris "She reacted."

# game/scenario/7_1_0_0.rpy:958
translate english aff9038f:

    # iris determine "C'est bon signe. Pas suffisant, mais bon signe."
    iris determine "That's a good sign. Not enough, but it's a good sign."

# game/scenario/7_1_0_0.rpy:960
translate english d4cd0620:

    # noam inquiet "Tu as trouvé quelque chose sur elle ? Un nom ?"
    noam inquiet "Did you find anything on her? A name?"

# game/scenario/7_1_0_0.rpy:962
translate english 8862235a:

    # iris neutre "Rien que je puisse vérifier. Ses poches étaient vides. Pas de tablette, pas de badge actif."
    iris neutre "Nothing I can verify. Her pockets were empty. No tablet, no active badge."

# game/scenario/7_1_0_0.rpy:964
translate english 84f1f4b4:

    # noam reflechit "Elle a dû tout abandonner avant de monter dans le conteneur."
    noam reflechit "She must have left everything behind before climbing into the container."

# game/scenario/7_1_0_0.rpy:966
translate english e93a2d88:

    # iris triste "Ou quelqu'un l'a dépouillée avant de l'y mettre."
    iris triste "Or someone stripped her of everything before putting her in there."

# game/scenario/7_1_0_0.rpy:968
translate english f87f1eff:

    # noam inquiet "Tu crois qu'elle a été forcée ?"
    noam inquiet "Do you think she was forced?"

# game/scenario/7_1_0_0.rpy:970
translate english f0656beb:

    # iris reflexion "Je ne crois rien tant qu'elle ne peut pas répondre."
    iris reflexion "I'm not assuming anything until she can answer us."

# game/scenario/7_1_0_0.rpy:974
translate english ae26babf:

    # iris inquiet "Kael est revenu ?"
    iris inquiet "Has Kael come back?"

# game/scenario/7_1_0_0.rpy:976
translate english 24cf56d0:

    # noam neutre "Non. Je pensais qu'il était avec toi."
    noam neutre "No. I thought he was with you."

# game/scenario/7_1_0_0.rpy:978
translate english c9c4fa77:

    # iris colere "Il devait quitter le système après le redémarrage."
    iris colere "He was supposed to get out of the system after the reboot."

# game/scenario/7_1_0_0.rpy:980
translate english a1a9c451:

    # noam inquiet "Il voulait chercher des informations sur sa sœur."
    noam inquiet "He wanted to look for information about his sister."

# game/scenario/7_1_0_0.rpy:982
translate english 0c32cfa1:

    # iris desaccord "Et tu l'as laissé faire ?"
    iris desaccord "And you let him?"

# game/scenario/7_1_0_0.rpy:984
translate english 3820bb93:

    # noam colere "Je lui ai dit d'arrêter dès que les générateurs reviendraient."
    noam colere "I told him to stop as soon as the generators came back on."

# game/scenario/7_1_0_0.rpy:986
translate english d879a51c:

    # iris colere "Donc tu l'as laissé faire."
    iris colere "So you let him."

# game/scenario/7_1_0_0.rpy:990
translate english 0197be9b:

    # think "Avant que je puisse répondre, tous les écrans de la chambre s'allument simultanément."
    think "Before I can answer, every screen in the room turns on at once."

# game/scenario/7_1_0_0.rpy:994
translate english 0dd6af7c:

    # iris peur "Éloigne-toi du lit."
    iris peur "Move away from the bed."

# game/scenario/7_1_0_0.rpy:996
translate english 66eeb75b:

    # think "Iris remonte la couverture sur le visage de la jeune femme. Je me place devant, autant que possible."
    think "Iris pulls the blanket over the young woman's face. I stand in front of her as best I can."

# game/scenario/7_1_0_0.rpy:1011
translate english d3630628:

    # kami "Mes chers représentants ! J'aimerais attirer votre attention sur un concept révolutionnaire : l'éducation !"
    kami "My dear representatives! I'd like to draw your attention to a revolutionary concept: manners!"

# game/scenario/7_1_0_0.rpy:1015
translate english 5b5cc18b:

    # kami "Lorsque vous êtes invités quelque part, vous ne fouillez pas dans les tiroirs. Vous ne démontez pas les serrures."
    kami "When you're invited somewhere, you don't rummage through drawers. You don't take the locks apart."

# game/scenario/7_1_0_0.rpy:1016
translate english d65ed979:

    # kami "Et surtout, vous n'essayez pas d'explorer les serveurs de votre hôte pendant qu'ils redémarrent !"
    kami "And most importantly, you don't try to explore your host's servers while they're rebooting!"

# game/scenario/7_1_0_0.rpy:1020
translate english 58d9c2a2:

    # kami "Kael ! Tu veux expliquer aux autres pourquoi je viens de te trouver dans un relais administratif qui ne te concernait absolument pas ?"
    kami "Kael! Would you like to tell the others why I just found you inside an administrative relay that was absolutely none of your business?"

# game/scenario/7_1_0_0.rpy:1022
translate english d1fff5b4:

    # kael "Je cherchais des informations sur ma sœur."
    kael "I was looking for information about my sister."

# game/scenario/7_1_0_0.rpy:1026
translate english 26de5ba7:

    # kami "Oh ! Une réponse directe ! Presque touchante !"
    kami "Oh! A straight answer! Almost touching!"

# game/scenario/7_1_0_0.rpy:1028
translate english 5d10d07d:

    # kael "Elle s'appelle Léa. Je voulais seulement savoir si elle allait bien."
    kael "Her name is Léa. I only wanted to know if she was all right."

# game/scenario/7_1_0_0.rpy:1032
translate english a5021eeb:

    # kami "Seulement ? Tu as ouvert six registres, tenté trois requêtes extérieures et parcouru une partie de mon architecture réseau."
    kami "Only? You opened six records, attempted three external queries, and explored part of my network architecture."

# game/scenario/7_1_0_0.rpy:1034
translate english 69b8a478:

    # kael "Aucune règle du Conclave ne l'interdit."
    kael "No Conclave rule forbids it."

# game/scenario/7_1_0_0.rpy:1040
translate english 30b1a8b0:

    # kami "Je le sais ! C'est précisément ce qui rend cette conversation insupportable !"
    kami "I know! That's exactly what makes this conversation so infuriating!"

# game/scenario/7_1_0_0.rpy:1044
translate english ba6f90e1:

    # kami "Techniquement, Kael n'a enfreint aucune règle. Il n'a détruit aucune donnée et n'a franchi aucun accès explicitement interdit."
    kami "Technically, Kael didn't break any rules. He didn't destroy any data or access anything that was explicitly off-limits."

# game/scenario/7_1_0_0.rpy:1045
translate english 616322f7:

    # kami "Il ne sera donc pas puni."
    kami "Therefore, he will not be punished."

# game/scenario/7_1_0_0.rpy:1049
translate english 0fdba595:

    # kami "Mais est-ce trop demander que vous vous comportiez comme des invités correctement élevés ?!"
    kami "But is it too much to ask that you behave like well-mannered guests?!"

# game/scenario/7_1_0_0.rpy:1050
translate english 86571e9b:

    # kami "On ne touche pas aux serveurs. On ne branche pas ses câbles partout. On ne profite pas d'une panne pour fouiller chez les autres !"
    kami "You don't touch the servers. You don't plug your cables into everything. You don't use a power failure as an excuse to snoop through other people's things!"

# game/scenario/7_1_0_0.rpy:1054
translate english b80f52df:

    # kami "Vos familles seraient-elles fières de votre manque absolu de savoir-vivre ?"
    kami "Would your families be proud of your complete lack of manners?"

# game/scenario/7_1_0_0.rpy:1056
translate english 2e7dd999:

    # kael "Tu as des informations sur Léa ?"
    kael "Do you have any information about Léa?"

# game/scenario/7_1_0_0.rpy:1060
translate english 326fcb9f:

    # kami "Ce n'est pas le sujet !"
    kami "That is not the point!"

# game/scenario/7_1_0_0.rpy:1066
translate english 000845cc:

    # kami "Pour les autres : considérez ceci comme un rappel collectif. Le fait qu'une action ne soit pas interdite ne la rend pas polie."
    kami "As for the rest of you, consider this a collective reminder: just because something isn't forbidden doesn't make it polite."

# game/scenario/7_1_0_0.rpy:1070
translate english ac737f95:

    # kami "Et maintenant, retournez à vos activités. Je dois réparer ce que votre curiosité adolescente a dérangé."
    kami "Now get back to whatever you were doing. I have to repair everything your adolescent curiosity disrupted."

# game/scenario/7_1_0_0.rpy:1087
translate english 016f5cd5:

    # noam inquiet "Il nous a couverts."
    noam inquiet "He covered for us."

# game/scenario/7_1_0_0.rpy:1089
translate english 6eff2073:

    # iris reflexion "Ou il a réellement oublié de partir parce qu'il cherchait sa sœur."
    iris reflexion "Or he genuinely forgot to leave because he was looking for his sister."

# game/scenario/7_1_0_0.rpy:1091
translate english eb5edb49:

    # noam triste "Les deux peuvent être vrais."
    noam triste "Both can be true."

# game/scenario/7_1_0_0.rpy:1093
translate english 5ec8c35c:

    # iris inquiet "Kami va surveiller les accès plus attentivement maintenant."
    iris inquiet "Kami will be watching access points more closely now."

# game/scenario/7_1_0_0.rpy:1095
translate english 211fc715:

    # noam inquiet "Mais elle n'a rien dit sur le redémarrage volontaire."
    noam inquiet "But she didn't say anything about the reboot being deliberate."

# game/scenario/7_1_0_0.rpy:1097
translate english 9c4a3772:

    # iris reflexion "Kael lui a donné une explication suffisamment crédible. Pour le moment."
    iris reflexion "Kael gave her a convincing enough explanation. For now."

# game/scenario/7_1_0_0.rpy:1099
translate english 4fc40a25:

    # think "Nous regardons le lit. La jeune femme respire toujours, invisible sous les couettes."
    think "We look at the bed. The young woman is still breathing, invisible beneath the comforters."

# game/scenario/7_1_0_0.rpy:1101
translate english 0dd97aec:

    # iris determine "Retourne dans le couloir. Si quelqu'un vérifie où nous sommes, il ne faut pas nous trouver ensemble."
    iris determine "Go back into the corridor. If anyone checks where we are, they can't find us together."

# game/scenario/7_1_0_0.rpy:1103
translate english b5337992:

    # noam neutre "Tu m'appelles si elle se réveille."
    noam neutre "Call me if she wakes up."

# game/scenario/7_1_0_0.rpy:1105
translate english 8c251664:

    # iris determine "Je trouverai un moyen."
    iris determine "I'll find a way."

# game/scenario/7_1_0_0.rpy:1109
translate english c6a2bcbb:

    # think "Je quitte la chambre en vérifiant que personne ne se trouve derrière la porte."
    think "I leave the room after checking that no one is waiting outside the door."

# game/scenario/7_1_0_0.rpy:1123
translate english 53b24d69:

    # think "La soirée arrive sans que la jeune femme se réveille."
    think "Evening comes, and the young woman still hasn't woken up."

# game/scenario/7_1_0_0.rpy:1124
translate english 502e7129:

    # think "Je croise Kael une seule fois. Il me fait un signe bref, sans s'arrêter. Kami doit encore observer chacun de ses gestes."
    think "I only see Kael once. He gives me a quick nod without stopping. Kami must still be watching his every move."

# game/scenario/7_1_0_0.rpy:1125
translate english 6e1e1e19:

    # think "J'espère que son histoire sur Léa suffira à masquer ce qu'il a réellement fait dans le sas."
    think "I hope his story about Léa is enough to hide what he really did in the airlock."

# game/scenario/7_1_0_0.rpy:1131
translate english e4eb9984:

    # think "Tous les écrans du couloir s'allument en même temps."
    think "Every screen in the corridor turns on at once."

# game/scenario/7_1_0_0.rpy:1137
translate english ccecd2d8:

    # kami "Bonsoir, mes chers représentants !"
    kami "Good evening, my dear representatives!"

# game/scenario/7_1_0_0.rpy:1141
translate english 3b140dcd:

    # kami "Entre la livraison, cette adorable panne générale et les explorations éducatives de Kael, ma matinée a été légèrement chargée."
    kami "Between the delivery, that delightful power failure, and Kael's educational little expedition, I've had a rather busy morning."

# game/scenario/7_1_0_0.rpy:1142
translate english 5b5fae23:

    # kami "J'en ai presque oublié de vous annoncer le thème de votre prochain vote. Presque !"
    kami "I almost forgot to announce the subject of your next vote. Almost!"

# game/scenario/7_1_0_0.rpy:1146
translate english be24f09a:

    # kami "Votre prochaine décision concernera le Commandement IV relatif aux rassemblements et à l'organisation."
    kami "Your next decision will concern Commandment IV, regarding gatherings and organization."

# game/scenario/7_1_0_0.rpy:1152
translate english aa0092c5:

    # kami "La proposition est la suivante : autoriser les regroupements de plus de vingt personnes, sous réserve d'une demande d'autorisation préalable."
    kami "The proposal is as follows: allow gatherings of more than twenty people, provided prior authorization is requested."

# game/scenario/7_1_0_0.rpy:1156
translate english f110a99c:

    # kami "Autrement dit : plus de vingt personnes pourront se réunir, à condition d'annoncer à l'avance qui, où, quand et pourquoi."
    kami "In other words, more than twenty people may gather, as long as they declare in advance who, where, when, and why."

# game/scenario/7_1_0_0.rpy:1157
translate english 6db2a9b9:

    # kami "Une liberté parfaitement encadrée ! Le compromis préféré de ceux qui veulent ouvrir une porte tout en gardant la clé."
    kami "Perfectly regulated freedom! The favorite compromise of people who want to open a door while keeping the key."

# game/scenario/7_1_0_0.rpy:1161
translate english 9fb8b80c:

    # kami "Le vote aura lieu à la fin du jour 9."
    kami "The vote will take place at the end of Day 9."

# game/scenario/7_1_0_0.rpy:1162
translate english ca2509f7:

    # kami "Vous avez donc deux jours pour décider si les habitants peuvent se retrouver en groupe sans devenir de dangereux conspirateurs."
    kami "So you have two days to decide whether residents can gather in groups without becoming dangerous conspirators."

# game/scenario/7_1_0_0.rpy:1166
translate english 40af24de:

    # kami "Et cette fois, essayez d'offrir un débat un peu plus long que le précédent. Je refuse de préparer autant de caméras pour rien !"
    kami "And this time, try to give me a debate that lasts a little longer than the last one. I refuse to set up this many cameras for nothing!"

# game/scenario/7_1_0_0.rpy:1174
translate english 92bcbc55:

    # think "Les écrans s'éteignent."
    think "The screens turn off."

# game/scenario/7_1_0_0.rpy:1175
translate english 786d7bbd:

    # think "Plus de vingt personnes réunies avec une autorisation. Sur le papier, la proposition paraît presque raisonnable."
    think "More than twenty people gathering with authorization. On paper, the proposal almost sounds reasonable."

# game/scenario/7_1_0_0.rpy:1176
translate english 1cafc546:

    # think "Mais dans la chambre d'Iris, une seule personne suffit déjà à nous faire risquer la mort."
    think "But in Iris's room, just one person is already enough to put all our lives at risk."

# game/scenario/7_1_0_0.rpy:1180
translate english b0d8ea9a:

    # think "Je retourne vers ma chambre sans m'arrêter devant celle d'Iris."
    think "I head back to my room without stopping outside Iris's."

# game/scenario/7_1_0_0.rpy:1181
translate english dff34358:

    # think "Demain, il faudra continuer à agir normalement. Et espérer que la jeune femme finisse par ouvrir les yeux."
    think "Tomorrow, we'll have to keep acting normal. And hope the young woman finally opens her eyes."

translate english strings:

    # game/scenario/7_1_0_0.rpy:321
    old "Que faire de la jeune femme ?"
    new "What should we do with the young woman?"

    # game/scenario/7_1_0_0.rpy:321
    old "La cacher."
    new "Hide her."

    # game/scenario/7_1_0_0.rpy:321
    old "Prévenir Kami."
    new "Tell Kami."