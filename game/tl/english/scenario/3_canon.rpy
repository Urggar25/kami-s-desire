    # noam "Mais si tu te mets trop en avant, les hésitants vont voir autre chose que le texte."
    noam "But if you put yourself front and center, the undecided will start seeing something other than the proposal."

# game/scenario/3_canon.rpy:882
translate english day3_collect_vote_argument_c37d333b:

    # noam reflexion "On lit clair dans ton jeu, Julian. Tu veux briller."
    noam reflexion "Your game is obvious, Julian. You want the spotlight."

# game/scenario/3_canon.rpy:883
translate english day3_collect_vote_argument_d52db0ba:

    # noam raison "Résultat : le vote ne portera plus sur la proposition. Il portera sur toi."
    noam raison "And then the vote won't be about the proposal anymore. It'll be about you."

# game/scenario/3_canon.rpy:884
translate english day3_collect_vote_argument_9bbf2f6d:

    # noam colere "Et une chose est sûre : toi, tu ne fais pas l'unanimité."
    noam colere "And one thing is certain: you are not someone everyone agrees on."

# game/scenario/3_canon.rpy:886
translate english day3_collect_vote_argument_2291c030:

    # julian sourire "Tu te réveilles, aujourd'hui ? On ne t'entendait pas depuis le premier jour."
    julian sourire "Finally found your voice today? We haven't heard from you since day one."

# game/scenario/3_canon.rpy:887
translate english day3_collect_vote_argument_124c5e70:

    # julian taquin "Et là, tu viens faire le malin ?"
    julian taquin "And now you're here trying to act smart?"

# game/scenario/3_canon.rpy:888
translate english day3_collect_vote_argument_93ecb4ad:

    # julian "JE veux que ce texte passe. Alors laisse-moi convaincre les autres."
    julian "I want this proposal to pass. So let me convince the others."

# game/scenario/3_canon.rpy:890
translate english day3_collect_vote_argument_c27daa4a:

    # noam "Parle du texte. Rien d'autre. Ta personne, ta gloire, tout le monde s'en contrefiche."
    noam "Talk about the proposal. Nothing else. You, your glory—no one gives a damn."

# game/scenario/3_canon.rpy:892
translate english day3_collect_vote_argument_1a307d8d:

    # tomas "I-Il a raison. Enfin… je veux dire…"
    tomas "H-He's right. I mean... what I'm trying to say is..."

# game/scenario/3_canon.rpy:893
translate english day3_collect_vote_argument_509f52cd:

    # tomas "Si ça ressemble à une démonstration d'ego, f-franchement… ce sera sans moi."
    tomas "If this turns into an ego show, h-honestly... count me out."

# game/scenario/3_canon.rpy:895
translate english day3_collect_vote_argument_293896b4:

    # julian triste "Bon. Très bien. On verra au Conclave qui porte réellement ce vote."
    julian triste "Fine. Very well. We'll see in the Conclave who truly carries this vote."

# game/scenario/3_canon.rpy:896
translate english day3_collect_vote_argument_51616b09:

    # julian "Évite juste de me transformer en méchant de l'histoire. Je me bouge pour le collectif, moi. C'est déjà plus que la plupart."
    julian "Just don't turn me into the villain of the story. I'm actually doing something for the group. That's already more than most."

# game/scenario/3_canon.rpy:903
translate english day3_collect_vote_argument_a7661e4f:

    # tomas mefiant "…D-Désolé. À cause de moi, vous avez dû venir."
    tomas mefiant "...S-Sorry. You had to come here because of me."

# game/scenario/3_canon.rpy:905
translate english day3_collect_vote_argument_826af3a9:

    # nyra "Non. Il fallait remettre les points sur les i de toute façon."
    nyra "No. Someone had to set him straight anyway."

# game/scenario/3_canon.rpy:907
translate english day3_collect_vote_argument_71c22858:

    # tomas "P-Pour être honnête… je ne veux pas que ce soit lui qui donne le ton."
    tomas "T-To be honest... I don't want him setting the tone."

# game/scenario/3_canon.rpy:908
translate english day3_collect_vote_argument_25626cb9:

    # tomas "Il faut que quelqu'un puisse lui tenir tête. T-Tu vas parler, tout à l'heure ?"
    tomas "Someone needs to be able to stand up to him. A-Are you going to speak later?"

# game/scenario/3_canon.rpy:910
translate english day3_collect_vote_argument_7dae10f3:

    # noam "Oui. Mais pas pour briller. Pour que ça avance dans le bon sens."
    noam "Yes. But not for the spotlight. To keep things moving in the right direction."

# game/scenario/3_canon.rpy:912
translate english day3_collect_vote_argument_8f45f9a7:

    # tomas hoche_la_tete "Alors ça a une chance de passer."
    tomas hoche_la_tete "Then it has a chance of passing."

# game/scenario/3_canon.rpy:914
translate english day3_collect_vote_argument_fa339453:

    # nyra sourire "Allez, viens, Tomas. Tu as bien mérité une pause."
    nyra sourire "Come on, Tomas. You've earned a break."

# game/scenario/3_canon.rpy:915
translate english day3_collect_vote_argument_49811321:

    # nyra "Merci, Noam."
    nyra "Thanks, Noam."

# game/scenario/3_canon.rpy:917
translate english day3_collect_vote_argument_1cb1ea28:

    # think "Ils repartent ensemble. Tomas marche un peu plus droit qu'à l'aller."
    think "They leave together. Tomas walks a little straighter than before."

# game/scenario/3_canon.rpy:921
translate english day3_collect_vote_argument_78bdf50e:

    # think "Ce vote, ce n'est pas juste un texte. C'est une question de confiance."
    think "This vote isn't just about a proposal. It's about trust."

# game/scenario/3_canon.rpy:922
translate english day3_collect_vote_argument_c50cdef0:

    # think "Julian n'est pas un ennemi. Mais son besoin d'exister peut causer le pire comme le meilleur."
    think "Julian isn't an enemy. But his need to matter could bring out either the best or the worst in him."

# game/scenario/3_canon.rpy:923
translate english day3_collect_vote_argument_8e7e4998:

    # think "Je serre les poings. Ils tremblent moins qu'avant."
    think "I clench my fists. They're shaking less than before."

# game/scenario/3_canon.rpy:924
translate english day3_collect_vote_argument_8c930d4a:

    # think "Les grands discours, c'est pas pour moi. Mais je ne peux pas laisser ça déraper."
    think "Big speeches aren't my thing. But I can't let this spin out of control."

# game/scenario/3_canon.rpy:934
translate english day3_collect_vote_argument_a3a68403:

    # think "Bientôt l'heure. Le couloir paraît plus étroit, moins amical, comme s'il se resserrait sur nous."
    think "It's almost time. The hallway feels narrower, less welcoming, as if it's closing in around us."

# game/scenario/3_canon.rpy:940
translate english day3_collect_vote_argument_a27e8b10:

    # think "Respire, Noam. C'est juste un vote."
    think "Breathe, Noam. It's just a vote."

# game/scenario/3_canon.rpy:941
translate english day3_collect_vote_argument_8753eb61:

    # think "Alors pourquoi mon cœur cogne comme ça ?"
    think "Then why is my heart pounding like this?"

# game/scenario/3_canon.rpy:942
translate english day3_collect_vote_argument_caac5221:

    # think "Une sueur froide glisse dans ma nuque. J'ai l'impression d'être observé plus que d'habitude."
    think "Cold sweat runs down the back of my neck. I feel more watched than usual."

# game/scenario/3_canon.rpy:943
translate english day3_collect_vote_argument_87d35277:

    # think "Les caméras, évidemment. Pourquoi auraient-elles disparu aujourd'hui, justement ?"
    think "The cameras, obviously. Why would they disappear today of all days?"

# game/scenario/3_canon.rpy:945
translate english day3_collect_vote_argument_c10dcb75:

    # think "Le groupe converge peu à peu vers le Conclave, tout le monde partageant le même silence épais."
    think "The group gradually converges on the Conclave, all of us sharing the same heavy silence."

# game/scenario/3_canon.rpy:952
translate english day3_collect_vote_argument_f0c76ce6:

    # "Lysa marche en retrait. Juste assez pour que ça se remarque."
    "Lysa walks at the back. Just far enough behind for everyone to notice."

# game/scenario/3_canon.rpy:953
translate english day3_collect_vote_argument_5604a0fa:

    # "Le groupe accélère quand le couloir se resserre. Elle, non. Elle traîne les pieds, exprès."
    "The others speed up when the corridor narrows. She doesn't. She drags her feet on purpose."

# game/scenario/3_canon.rpy:955
translate english day3_collect_vote_argument_4c47c452:

    # lysa triste "On va voter. On va échouer."
    lysa triste "We're going to vote. We're going to fail."

# game/scenario/3_canon.rpy:956
translate english day3_collect_vote_argument_c552d96e:

    # lysa triste "Puis demain on se réveillera ici, mêmes murs, même pression. Et dans trois jours, on recommencera."
    lysa triste "Then tomorrow we'll wake up here again. Same walls, same pressure. And three days from now, we'll do it all over again."

# game/scenario/3_canon.rpy:957
translate english day3_collect_vote_argument_d76be465:

    # lysa blase "Et on échouera encore. On ne change pas un monde à douze marionnettes."
    lysa blase "And we'll fail again. Twelve puppets don't change the world."

# game/scenario/3_canon.rpy:959
translate english day3_collect_vote_argument_ffdeded6:

    # think "Elle ne me parle pas vraiment. Elle récite une conclusion qu'elle a déjà tranchée toute seule."
    think "She isn't really talking to me. She's reciting a conclusion she already reached on her own."

# game/scenario/3_canon.rpy:961
translate english day3_collect_vote_argument_2f522e0d:

    # noam reflechit "Il n'y a que ceux qui ne tentent rien qui n'ont jamais rien."
    noam reflechit "Only people who never try anything never get anywhere."

# game/scenario/3_canon.rpy:962
translate english day3_collect_vote_argument_21a59e43:

    # noam sourire "On avance, et ce qui arrivera arrivera. C'est déjà ça de moins à regretter."
    noam sourire "We move forward, and whatever happens, happens. At least that's one less thing to regret."

# game/scenario/3_canon.rpy:964
translate english day3_collect_vote_argument_150177f0:

    # "Lysa fait une moue déconfite alors qu'on approche de la porte du Conclave."
    "Lysa pulls a defeated face as we approach the Conclave door."

# game/scenario/3_canon.rpy:969
translate english day3_collect_vote_argument_024a72f2:

    # think "Sael s'est laissée glisser à l'arrière du groupe, elle aussi. Volontairement. Elle observe Lysa depuis un moment."
    think "Sael has drifted to the back of the group too. Deliberately. She's been watching Lysa for a while."

# game/scenario/3_canon.rpy:970
translate english day3_collect_vote_argument_4a4d1452:

    # "Sans prévenir, sans théâtre, elle attrape Lysa et la serre contre elle."
    "Without warning, without making a show of it, she grabs Lysa and pulls her into a hug."

# game/scenario/3_canon.rpy:972
translate english day3_collect_vote_argument_917fb876:

    # sael "Je te regarde depuis hier. Tu portes tout ce que les autres refusent de voir. C'est lourd."
    sael "I've been watching you since yesterday. You carry everything the others refuse to see. That's heavy."

# game/scenario/3_canon.rpy:973
translate english day3_collect_vote_argument_e7040906:

    # sael "Ma grand-mère disait que même les morts se reposent avant de revenir dans nos rêves."
    sael "My grandmother used to say even the dead need rest before they return to our dreams."

# game/scenario/3_canon.rpy:974
translate english day3_collect_vote_argument_d520ab9f:

    # sael "On a besoin de ta lucidité. Pas d'une autre Lysa. De celle qui est là, maintenant."
    sael "We need your clear eyes. Not some other Lysa. The one who's here, right now."

# game/scenario/3_canon.rpy:976
translate english day3_collect_vote_argument_2675072c:

    # "Elle pointe la poitrine de Lysa du doigt. Les épaules de Lysa se relâchent, à peine."
    "She points a finger at Lysa's chest. Lysa's shoulders loosen, barely."

# game/scenario/3_canon.rpy:978
translate english day3_collect_vote_argument_1f5dd587:

    # lysa "Tu dramatises. Je suis toujours là."
    lysa "You're being dramatic. I'm still here."

# game/scenario/3_canon.rpy:980
translate english day3_collect_vote_argument_ddf2787a:

    # sael "Alors montre-le. Montre-nous la battante qui se cache là-dedans."
    sael "Then show it. Show us the fighter hiding in there."

# game/scenario/3_canon.rpy:981
translate english day3_collect_vote_argument_e21322e6:

    # sael "Tu vois des failles qu'on ne voit pas. C'est pénible. Mais aujourd'hui, ça peut nous sauver."
    sael "You see cracks the rest of us miss. It's annoying. But today, it might save us."

# game/scenario/3_canon.rpy:983
translate english day3_collect_vote_argument_50c2a97d:

    # lysa "…Si je sauve le débat, tu me dois un café. Les oracles se faisaient mieux payer, pourtant."
    lysa "...If I save the debate, you owe me a coffee. Oracles used to charge better than that."

# game/scenario/3_canon.rpy:985
translate english day3_collect_vote_argument_5626e73a:

    # sael sourire "Je t'en offre deux. Ici, personne ne paie rien. Peut-être un signe que ton monde d'avant n'était pas si parfait."
    sael sourire "I'll buy you two. No one pays for anything here. Maybe that's a sign your old world wasn't so perfect."

# game/scenario/3_canon.rpy:987
translate english day3_collect_vote_argument_1ed48428:

    # lysa blase "Touché. Bref. On y va avant que je devienne sentimentale."
    lysa blase "Fair point. Let's go before I get sentimental."

# game/scenario/3_canon.rpy:991
translate english day3_collect_vote_argument_70d7ce0a:

    # think "On entre. On s'installe. Voilà. C'est parti."
    think "We go in. We sit down. Here we go."

# game/scenario/3_canon.rpy:1000
translate english day3_collect_vote_argument_c0dd96c6:

    # kami "Vous voilà tous ! Douze fauteuils, douze silhouettes. Personne ne manque à l'appel."
    kami "You're all here! Twelve chairs, twelve silhouettes. No one missing."

# game/scenario/3_canon.rpy:1001
translate english day3_collect_vote_argument_040161a0:

    # kami "Ce serait dommage. Les chaises vides, ça déprime l'audience."
    kami "That would be such a shame. Empty chairs bring the audience down."

# game/scenario/3_canon.rpy:1004
translate english day3_collect_vote_argument_03106f94:

    # kami "Et je vois des visages émus ! Il y a eu de la tendresse dans les couloirs, on dirait."
    kami "And I see some emotional faces! Looks like there was a little tenderness in the halls."

# game/scenario/3_canon.rpy:1005
translate english day3_collect_vote_argument_8d3b59dd:

    # kami "Cameraman, un gros plan sur ces petites âmes fragiles."
    kami "Cameraman, give me a close-up of those fragile little souls."

# game/scenario/3_canon.rpy:1008
translate english day3_collect_vote_argument_beda0b89:

    # kami "Installez-vous. On commence dans un instant."
    kami "Take your seats. We'll begin in a moment."

# game/scenario/3_canon.rpy:1015
translate english day3_collect_vote_argument_bf4d301e:

    # "Les portes se referment. Un déclic net résonne derrière nous."
    "The doors close. A sharp click echoes behind us."

# game/scenario/3_canon.rpy:1019
translate english day3_collect_vote_argument_98d1e56e:

    # think "…C'était un verrou ? Ils nous ont enfermés."
    think "...Was that a lock? They've locked us in."

# game/scenario/3_canon.rpy:1020
translate english day3_collect_vote_argument_de05fdd2:

    # think "Pas de sortie tant qu'il n'y a pas de décision. Kami veut un vote, ou un cadavre. Pas d'entre-deux."
    think "No way out until there's a decision. Kami wants a vote, or a body. Nothing in between."

# game/scenario/3_canon.rpy:1037
translate english day3_collect_vote_argument_56aface1:

    # kami "Avant de débattre, encore faut-il savoir de quoi on parle."
    kami "Before you can debate, you need to know what you're debating."

# game/scenario/3_canon.rpy:1038
translate english day3_collect_vote_argument_e7584a50:

    # kami "Alors soyons rigoureux. Voici le texte officiel de l'amendement."
    kami "So let's be precise. Here is the official wording of the amendment."

# game/scenario/3_canon.rpy:1041
translate english day3_collect_vote_argument_16d755ec:

    # kami "Enfin… « officiel ». [codex_dialogue_link('archive', 'ARCHIVE')] l'a harmonisé avec les Commandements existants."
    kami "Well... 'official.' [codex_dialogue_link('archive', 'ARCHIVE')] harmonized it with the existing Commandments."

# game/scenario/3_canon.rpy:1042
translate english day3_collect_vote_argument_a03aa61f:

    # kami "Vos petites phrases d'amateurs, seules, ne valent rien en droit. Il a fallu les traduire."
    kami "Your amateur little sentences mean nothing in law on their own. They had to be translated."

# game/scenario/3_canon.rpy:1045
translate english day3_collect_vote_argument_e8142606:

    # nyra "Traduire. Ou réécrire ?"
    nyra "Translated. Or rewritten?"

# game/scenario/3_canon.rpy:1049
translate english day3_collect_vote_argument_b4699d4b:

    # kami "Réécrire est un vilain mot. Disons que j'ai rendu vos intentions… exécutables."
    kami "Rewritten is such an ugly word. Let's say I made your intentions... executable."

# game/scenario/3_canon.rpy:1050
translate english day3_collect_vote_argument_7e8907fd:

    # kami "Le texte est là. Compilé, dense, juridique. Exactement comme les lois que vous adoriez ignorer avant moi."
    kami "The text is right there. Compiled, dense, legalistic. Just like the laws you all loved ignoring before me."

# game/scenario/3_canon.rpy:1053
translate english day3_collect_vote_argument_20be108a:

    # kami "À vous de le remettre en ordre et de le lire. Vraiment le lire."
    kami "Now put it back in order and read it. Really read it."

# game/scenario/3_canon.rpy:1054
translate english day3_collect_vote_argument_ec9f60a3:

    # kami "Le diable se cache dans les détails. Moi, je me contente de l'y ranger."
    kami "The devil is in the details. I merely make sure he stays there."

# game/scenario/3_canon.rpy:1074
translate english day3_collect_vote_argument_355fb5ca:

    # ryn colere "Un texte juridique compilé ?! On voulait juste autoriser le commerce !"
    ryn colere "A compiled legal text?! We just wanted to legalize trade!"

# game/scenario/3_canon.rpy:1076
translate english day3_collect_vote_argument_f6570784:

    # tomas hesitation "C'est… c'est exactement là qu'il faut se méfier. Un texte de loi, c'est jamais neutre."
    tomas hesitation "That's... that's exactly why we have to be careful. Legal text is never neutral."

# game/scenario/3_canon.rpy:1077
translate english day3_collect_vote_argument_9b63ea82:

    # tomas raison "Chaque mot ajouté peut changer tout le sens. Faut le reconstruire proprement avant d'en juger."
    tomas raison "Every added word can change the entire meaning. We need to reconstruct it properly before we judge it."

# game/scenario/3_canon.rpy:1079
translate english day3_collect_vote_argument_acbd809e:

    # nyra "On fait ça vite et bien. Cherchez la ponctuation et les majuscules, ça situe les fragments."
    nyra "We do this fast and clean. Look for punctuation and capital letters; they'll help place the fragments."

# game/scenario/3_canon.rpy:1080
translate english day3_collect_vote_argument_72f20f3c:

    # nyra "Chacun prend un morceau. Personne ne conclut avant qu'on ait la phrase entière."
    nyra "Everyone takes one piece. No one draws conclusions until we have the full sentence."

# game/scenario/3_canon.rpy:1082
translate english day3_collect_vote_argument_41aa9bca:

    # noam "D'accord. On assemble, on lit, ensuite on discute."
    noam "All right. We assemble it, we read it, then we discuss it."

# game/scenario/3_canon.rpy:1083
translate english day3_collect_vote_argument_f66d0dc0:

    # noam "Et on garde les yeux ouverts sur ce qu'elle a pu glisser dedans."
    noam "And we keep our eyes open for anything she might have slipped in."

# game/scenario/3_canon.rpy:1112
translate english day3_collect_vote_argument_c141e4af:

    # lysa "« Autoriser le transport, la vente et l'échange de marchandises. »"
    lysa "'Authorize the transport, sale, and exchange of goods.'"

# game/scenario/3_canon.rpy:1113
translate english day3_collect_vote_argument_c1366bad:

    # lysa colere "« En conséquence, le système de distribution de denrées est aboli. »"
    lysa colere "'Consequently, the food distribution system is abolished.'"

# game/scenario/3_canon.rpy:1115
translate english day3_collect_vote_argument_cab1b812:

    # elen surpris "Attendez… « aboli » ? C'était pas dans l'idée de départ, ça !"
    elen surpris "Wait... 'abolished'? That wasn't part of the original idea!"

# game/scenario/3_canon.rpy:1117
translate english day3_collect_vote_argument_b8b491e5:

    # tomas "M-Maintenant, le vrai débat peut commencer. Et il est plus grave qu'on croyait."
    tomas "N-Now the real debate can begin. And it's more serious than we thought."

# game/scenario/3_canon.rpy:1144
translate english day3_collect_vote_argument_f38265a7:

    # mara surpris "Donc voilà le piège. Autoriser le commerce, ça supprime les rations. En un seul texte."
    mara surpris "So that's the trap. Legalizing trade abolishes rationing. All in one text."

# game/scenario/3_canon.rpy:1146
translate english day3_collect_vote_argument_d85695fb:

    # noam "Du calme. On sait tous que ce n'est pas ce qui avait été proposé au départ."
    noam "Easy. We all know that isn't what was originally proposed."

# game/scenario/3_canon.rpy:1147
translate english day3_collect_vote_argument_ec453925:

    # noam "C'est l'habillage qu'en a fait Kami. La question, c'est : est-ce qu'on peut vivre avec ?"
    noam "This is Kami's legal packaging. The question is: can we live with it?"

# game/scenario/3_canon.rpy:1149
translate english day3_collect_vote_argument_636855d6:

    # nyra reflechit "Si on vote ce texte, demain il n'y a plus une seule distribution gratuite. Nulle part."
    nyra reflechit "If we approve this text, tomorrow there will be no free distribution anywhere. None."

# game/scenario/3_canon.rpy:1151
translate english day3_collect_vote_argument_66a009d4:

    # kael inquiet "Supprimer les rations… ça change tout."
    kael inquiet "Abolishing rations... that changes everything."

# game/scenario/3_canon.rpy:1153
translate english day3_collect_vote_argument_1ffc6070:

    # ryn colere "Ça supprime la seule sécurité qu'on avait ! À Limen, c'est ce qui tient les gens en vie."
    ryn colere "It wipes out the only safety net we had! In Limen, that's what keeps people alive."

# game/scenario/3_canon.rpy:1155
translate english day3_collect_vote_argument_851e2bc3:

    # lysa reflechit "Et pourtant, c'est logique."
    lysa reflechit "And yet, it makes sense."

# game/scenario/3_canon.rpy:1157
translate english day3_collect_vote_argument_50e41c99:

    # noam "…Comment ça ?"
    noam "...How?"

# game/scenario/3_canon.rpy:1159
translate english day3_collect_vote_argument_d9fa808c:

    # lysa blase "On disait hier : rétablir le commerce, c'est rétablir la monnaie."
    lysa blase "Yesterday we said restoring trade means restoring currency."

# game/scenario/3_canon.rpy:1160
translate english day3_collect_vote_argument_16c03972:

    # lysa reflechit "Pour gagner de la monnaie, il faut travailler. Et pour pousser les gens à travailler…"
    lysa reflechit "To earn currency, people need to work. And to make people work..."

# game/scenario/3_canon.rpy:1161
translate english day3_collect_vote_argument_a3c5d7b2:

    # lysa blase "…on arrête de leur donner de quoi vivre gratuitement. Kami n'a rien inventé. Elle a juste écrit tout haut ce qu'on pensait tout bas."
    lysa blase "...you stop giving them what they need to live for free. Kami didn't invent anything. She just wrote down what we were all thinking."

# game/scenario/3_canon.rpy:1163
translate english day3_collect_vote_argument_9e89db84:

    # nyra reflechit "Sauf que supprimer une structure mondiale, ça ne se décide pas sur un coup de tête."
    nyra reflechit "Except dismantling a worldwide system isn't something you decide on a whim."

# game/scenario/3_canon.rpy:1165
translate english day3_collect_vote_argument_8bccfb42:

    # sael triste "Les morts de Limen n'ont pas besoin d'un nouveau responsable."
    sael triste "The dead of Limen don't need someone new to blame."

# game/scenario/3_canon.rpy:1166
translate english day3_collect_vote_argument_0e4e3168:

    # sael reflechit "Kami. Dis-nous seulement une chose : ce texte vient-il vraiment de l'un de nous ?"
    sael reflechit "Kami. Tell us one thing: did this text really come from one of us?"

# game/scenario/3_canon.rpy:1168
translate english day3_collect_vote_argument_5bda5e56:

    # think "Les regards se croisent. L'écran central reste figé. Kami ne répond pas."
    think "Eyes meet across the table. The central screen stays frozen. Kami doesn't answer."

# game/scenario/3_canon.rpy:1169
translate english day3_collect_vote_argument_61bd4090:

    # think "Le silence dure trop longtemps pour être innocent."
    think "The silence lasts too long to be innocent."

# game/scenario/3_canon.rpy:1171
translate english day3_collect_vote_argument_976ecf4c:

    # lysa blase "Elle ne répondra pas. Dix votes pour douze textes, le tour de passe-passe est parfait."
    lysa blase "She won't answer. Ten votes for twelve texts—the trick is perfect."

# game/scenario/3_canon.rpy:1172
translate english day3_collect_vote_argument_d6919757:

    # lysa colere "Elle peut ajouter, couper, tordre ce qu'elle veut. On ne le saura jamais."
    lysa colere "She can add, remove, twist whatever she wants. We'll never know."

# game/scenario/3_canon.rpy:1174
translate english day3_collect_vote_argument_938e9eb7:

    # ryn reflechit "Attends… tu dis quoi, là ?"
    ryn reflechit "Wait... what are you saying?"

# game/scenario/3_canon.rpy:1176
translate english day3_collect_vote_argument_9901e792:

    # lysa salut "Que peut-être aucun de ces textes n'est de nous. Que la manipulation est invérifiable. Bienvenue."
    lysa salut "That maybe none of these texts are ours. That the manipulation can't be verified. Welcome to the game."

# game/scenario/3_canon.rpy:1178
translate english day3_collect_vote_argument_6d1743dc:

    # noam "Manipulation ou pas, il faudra voter. Alors autant décider en connaissance de cause."
    noam "Manipulation or not, we'll still have to vote. So we may as well decide with all the facts we can get."

# game/scenario/3_canon.rpy:1179
translate english day3_collect_vote_argument_11812dee:

    # noam reflexion "Concentrons-nous sur ce qu'on peut vérifier : ce que ce texte fait, concrètement, à chacun de nos districts."
    noam reflexion "Let's focus on what we can verify: what this text will actually do to each of our districts."

# game/scenario/3_canon.rpy:1186
translate english day3_collect_vote_argument_69b27004:

    # kami "On m'informe que l'audience décroche. Trop de blabla, pas assez de sang."
    kami "I'm being told the audience is dropping off. Too much talking, not enough blood."

# game/scenario/3_canon.rpy:1187
translate english day3_collect_vote_argument_dd8dcba6:

    # kami "Je reprends la main. À partir de maintenant, un seul parle à la fois."
    kami "I'm taking back control. From now on, only one person speaks at a time."

# game/scenario/3_canon.rpy:1189
translate english day3_collect_vote_argument_5c06c94f:

    # "Les pupitres se transforment. Un micro et un buzzer émergent devant chacun de nous."
    "The desks transform. A microphone and buzzer rise in front of each of us."

# game/scenario/3_canon.rpy:1192
translate english day3_collect_vote_argument_c62ef0a6:

    # kami "Vous ne parlez que quand votre buzzer passe au vert. Vous voulez contredire ? Vous appuyez."
    kami "You may only speak when your buzzer turns green. Want to object? Press it."

# game/scenario/3_canon.rpy:1193
translate english day3_collect_vote_argument_d69b35eb:

    # kami "On appellera ça un débat. Moi, j'appelle ça du divertissement."
    kami "We'll call it a debate. I call it entertainment."

# game/scenario/3_canon.rpy:1196
translate english day3_collect_vote_argument_2240534a:

    # kami "Montrez-moi qui sait viser. C'est parti."
    kami "Show me who knows how to aim. Let's begin."

# game/scenario/3_canon.rpy:1211
translate english day3_before_objection_protocol_minigame_c2b3caae:

    # ryn colere "On tourne en rond depuis une heure ! Pendant qu'on parle, eux, ils attendent."
    ryn colere "We've been going in circles for an hour! While we talk, they're waiting."

# game/scenario/3_canon.rpy:1213
translate english day3_before_objection_protocol_minigame_2191ab6c:

    # think "Il a raison. Et Kami adore avoir raison à notre place."
    think "He's right. And Kami loves being right on our behalf."

# game/scenario/3_canon.rpy:1218
translate english day3_before_objection_protocol_minigame_5101debe:

    # kami "« Ils attendent. » Oh, Ryn. Quelle jolie transition."
    kami "'They're waiting.' Oh, Ryn. What a lovely transition."

# game/scenario/3_canon.rpy:1219
translate english day3_before_objection_protocol_minigame_27a655fc:

    # kami "Justement. J'ai pensé que vous débattiez un peu trop dans le vide."
    kami "Exactly. I thought you were all debating a little too far removed from reality."

# game/scenario/3_canon.rpy:1220
translate english day3_before_objection_protocol_minigame_064f17fd:

    # kami "Alors regardez. En direct. Ce n'est pas une rediffusion."
    kami "So look. Live. This is not a replay."

# game/scenario/3_canon.rpy:1223
translate english day3_before_objection_protocol_minigame_95297f00:

    # "Les écrans du Conclave basculent sur un plan de Limen. Une file devant un centre de distribution. Des gens qui poussent. Des cartons vides."
    "The Conclave screens switch to a view of Limen. A line outside a distribution center. People shoving. Empty boxes."

# game/scenario/3_canon.rpy:1226
translate english day3_before_objection_protocol_minigame_e804d823:

    # kami "Vos districts vous écoutent depuis ce matin. Ils savent qu'aujourd'hui, vous touchez aux rations."
    kami "Your districts have been listening since this morning. They know you're dealing with rationing today."

# game/scenario/3_canon.rpy:1227
translate english day3_before_objection_protocol_minigame_d1f495e5:

    # kami "Alors certains ont commencé à faire des réserves. À se battre pour un carton. Par anticipation."
    kami "So some of them started stockpiling. Fighting over a box. Just in case."

# game/scenario/3_canon.rpy:1230
translate english day3_before_objection_protocol_minigame_11d26095:

    # ryn "Ce sont… ce sont des gens de chez moi."
    ryn "Those are... those are my people."

# game/scenario/3_canon.rpy:1234
translate english day3_before_objection_protocol_minigame_59038473:

    # kami "Douze mille trois cent quarante et un."
    kami "Twelve thousand three hundred and forty-one."

# game/scenario/3_canon.rpy:1235
translate english day3_before_objection_protocol_minigame_3e5c5534:

    # kami "C'est le nombre de foyers de Limen sans ration complète à cette heure précise. Le chiffre monte pendant que vous hésitez."
    kami "That's how many households in Limen are without a full ration at this exact moment. The number keeps rising while you hesitate."

# game/scenario/3_canon.rpy:1238
translate english day3_before_objection_protocol_minigame_dcf7dd29:

    # kami "Alors dépêchez-vous de décider. Ils comptent sur vous."
    kami "So hurry up and decide. They're counting on you."

# game/scenario/3_canon.rpy:1239
translate english day3_before_objection_protocol_minigame_98b9f563:

    # kami "Enfin… sur l'un de vous. Il en suffit d'un pour tout faire capoter, souvenez-vous."
    kami "Well... on one of you. It only takes one to ruin everything, remember?"

# game/scenario/3_canon.rpy:1258
translate english day3_before_objection_protocol_minigame_5f9fa0ce:

    # ryn triste "Elle nous met le couteau sous la gorge avec des vrais visages."
    ryn triste "She's holding a knife to our throats with real people's faces."

# game/scenario/3_canon.rpy:1260
translate english day3_before_objection_protocol_minigame_6c2d26fa:

    # elen inquiet "Mais… du coup, c'est pire de ne rien faire, non ? Ils souffrent déjà."
    elen inquiet "But... doesn't that mean doing nothing is worse? They're already suffering."

# game/scenario/3_canon.rpy:1262
translate english day3_before_objection_protocol_minigame_76890bc4:

    # mara colere "Ou alors c'est exactement ce qu'elle veut qu'on pense. Paniquer, voter vite, se planter."
    mara colere "Or that's exactly what she wants us to think. Panic, rush the vote, make the wrong call."

# game/scenario/3_canon.rpy:1264
translate english day3_before_objection_protocol_minigame_ae7c4b2c:

    # noam reflexion "Elle nous montre le prix de l'attente. Pas celui de l'erreur. Ne la laissons pas choisir pour nous."
    noam reflexion "She's showing us the cost of waiting. Not the cost of making a mistake. Don't let her decide for us."

# game/scenario/3_canon.rpy:1265
translate english day3_before_objection_protocol_minigame_5704ede8:

    # noam "On garde la tête froide. On finit ce qu'on a commencé, mais on le finit lucides."
    noam "We keep our heads. We finish what we started, but we finish it with clear minds."

# game/scenario/3_canon.rpy:1360
translate english day3_choose_debate_argument_64fa398c:

    # noam "[selected_argument_noam_line]"
    noam "[selected_argument_noam_line]"

# game/scenario/3_canon.rpy:1515
translate english day3_choose_debate_argument_7fb83f71:

    # noam "Bon. On a le vrai texte, on a le chiffre de Kami. Il nous reste à décider avec la tête, pas avec la peur."
    noam "All right. We have the real text, and we have Kami's number. Now we have to decide with our heads, not our fear."

# game/scenario/3_canon.rpy:1517
translate english day3_choose_debate_argument_ca2f0c1d:

    # julian "La tête ? On est en train de crever à petit feu, Noam."
    julian "Our heads? We're dying by inches, Noam."

# game/scenario/3_canon.rpy:1518
translate english day3_choose_debate_argument_5ff84e73:

    # julian "Le statu quo, c'est une tombe collective avec des bons de pain rassi. Tu appelles ça la sécurité ?"
    julian "The status quo is a mass grave with coupons for stale bread. You call that security?"

# game/scenario/3_canon.rpy:1520
translate english day3_choose_debate_argument_363fb5c3:

    # ryn colere "Et ton grand soir, c'est quoi ? On sacrifie Limen pour que Nexus se paie du luxe ?"
    ryn colere "And your glorious revolution is what? We sacrifice Limen so Nexus can buy luxury goods?"

# game/scenario/3_canon.rpy:1522
translate english day3_choose_debate_argument_df20c570:

    # julian surpris "Nexus ? Je te rappelle que j'en viens, de Nexus. Et je ne roule pas sur l'or, figure-toi."
    julian surpris "Nexus? I come from Nexus, remember? And I'm not exactly swimming in money."

# game/scenario/3_canon.rpy:1524
translate english day3_choose_debate_argument_52c27a02:

    # ryn "…Ouais. Bref. Ça change rien au fond !"
    ryn "...Yeah. Whatever. Doesn't change the point!"

# game/scenario/3_canon.rpy:1526
translate english day3_choose_debate_argument_d8b31950:

    # mara colere "Ryn. Respire. On avance mieux sans hurler."
    mara colere "Ryn. Breathe. We make more progress when you aren't shouting."

# game/scenario/3_canon.rpy:1528
translate english day3_choose_debate_argument_6aee5fff:

    # elen joie "Mais c'est ça qui est beau ! Choisir ce qu'on mange sans demander la permission !"
    elen joie "But that's the beautiful part! Choosing what we eat without asking permission!"

# game/scenario/3_canon.rpy:1531
translate english day3_choose_debate_argument_2da2048a:

    # lysa raison "Pour choisir, il faut de l'argent, Elen. Midas transformait tout en or, et il est quand même mort de faim."
    lysa raison "To choose, you need money, Elen. Midas turned everything to gold and still starved to death."

# game/scenario/3_canon.rpy:1533
translate english day3_choose_debate_argument_04edcae1:

    # tomas "Euh… il faut dire que la production mondiale s'est effondrée depuis Kami."
    tomas "Um... global production has collapsed since Kami took over."

# game/scenario/3_canon.rpy:1534
translate english day3_choose_debate_argument_5568282e:

    # tomas "On fabrique presque quatre fois moins qu'avant. C'est… c'est pas rien."
    tomas "We produce almost four times less than before. That's... that's significant."

# game/scenario/3_canon.rpy:1536
translate english day3_choose_debate_argument_861d8301:

    # nyra "Rien d'étonnant. Sans récompense, personne ne se donne la peine de produire."
    nyra "No surprise. Without a reward, no one bothers producing anything."

# game/scenario/3_canon.rpy:1541
translate english day3_choose_debate_argument_6f174663:

    # kami "Voilà. Enfin une vraie question sous le vernis."
    kami "There. Finally, a real question beneath the polish."

# game/scenario/3_canon.rpy:1542
translate english day3_choose_debate_argument_260616fb:

    # kami "Je vous rappelle que ce texte est né de VOTRE imagination. Ne me regardez pas comme la coupable."
    kami "Let me remind you that this text came from YOUR imagination. Don't look at me like I'm the culprit."

# game/scenario/3_canon.rpy:1543
translate english day3_choose_debate_argument_72d1dd0f:

    # kami "Continuez. Vous êtes bien plus intéressants quand vous avez peur."
    kami "Keep going. You're much more interesting when you're scared."

# game/scenario/3_canon.rpy:1555
translate english day3_choose_debate_argument_b39ab71f:

    # elias "Le vrai problème, c'est qu'on évite la vraie question. Le système actuel, il marche pas. Point."
    elias "The real problem is we're dodging the real question. The current system doesn't work. Period."

# game/scenario/3_canon.rpy:1557
translate english day3_choose_debate_argument_49117aef:

    # sael "…Vous dépendez trop de ce système."
    sael "...You depend too much on that system."

# game/scenario/3_canon.rpy:1558
translate english day3_choose_debate_argument_563cc88f:

    # sael colere "Les gens ne veulent plus travailler, plus faire d'effort, mais ils veulent être libres."
    sael colere "People don't want to work anymore, don't want to make an effort, but they still want to be free."

# game/scenario/3_canon.rpy:1559
translate english day3_choose_debate_argument_afa9cad5:

    # sael colere "Il va falloir choisir. Entre la liberté et la sécurité. On ne peut pas garder les deux entières."
    sael colere "They'll have to choose. Freedom or security. We can't keep all of both."

# game/scenario/3_canon.rpy:1561
translate english day3_choose_debate_argument_995bdcab:

    # lysa blase "Même en votant pour, il reste un trou béant dans le texte."
    lysa blase "Even if we vote yes, there's still a gaping hole in the text."

# game/scenario/3_canon.rpy:1562
translate english day3_choose_debate_argument_9008efb7:

    # lysa reflechit "Avec quoi les gens gagnent leur premier argent ? Si personne n'a rien, personne ne peut rien acheter à personne."
    lysa reflechit "How do people earn their first money? If no one has anything, no one can buy anything from anyone."

# game/scenario/3_canon.rpy:1564
translate english day3_choose_debate_argument_a6c44033:

    # noam "Elle a raison. C'est le point noir de toute la proposition."
    noam "She's right. That's the biggest flaw in the whole proposal."

# game/scenario/3_canon.rpy:1565
translate english day3_choose_debate_argument_3dc1747d:

    # noam "Kami. Tu peux nous éclairer, ou tu comptes rester muette encore une heure ?"
    noam "Kami. Care to enlighten us, or are you planning to stay silent for another hour?"

# game/scenario/3_canon.rpy:1569
translate english day3_choose_debate_argument_68afe41a:

    # kami "Oh. Une question pratique ? On progresse."
    kami "Oh. A practical question? Progress."

# game/scenario/3_canon.rpy:1572
translate english day3_choose_debate_argument_0f7a2fa2:

    # kami "Si ce texte passe, j'ouvrirai des contrats de travail rémunérés. Des tâches assignées, des objectifs, un salaire à la clé."
    kami "If this text passes, I'll introduce paid work contracts. Assigned tasks, objectives, and a salary at the end."

# game/scenario/3_canon.rpy:1573
translate english day3_choose_debate_argument_6d682ad1:

    # kami "Vous fabriquez, vous récoltez, vous livrez. Vous êtes payés. Simple."
    kami "You make things, harvest things, deliver things. You get paid. Simple."

# game/scenario/3_canon.rpy:1576
translate english day3_choose_debate_argument_df587286:

    # kami "Libre à vous de travailler. Ou pas. Mais ne comptez plus sur la générosité des rations."
    kami "You're free to work. Or not. But don't expect the generosity of rations anymore."

# game/scenario/3_canon.rpy:1577
translate english day3_choose_debate_argument_93f2393a:

    # kami "La faim est une motivation remarquablement efficace. Je l'ai observé sur vous mille fois."
    kami "Hunger is a remarkably effective motivator. I've observed it in all of you a thousand times."

# game/scenario/3_canon.rpy:1596
translate english day3_choose_debate_argument_4568b126:

    # lysa reflechit "Un système de contrats. C'est… viable. Au moins pour amorcer l'économie."
    lysa reflechit "A contract system. That's... workable. At least to get the economy started."

# game/scenario/3_canon.rpy:1598
translate english day3_choose_debate_argument_5f42e796:

    # nyra reflechit "Et avec le commerce, des structures plus grosses finiront par émerger. Des entreprises. Un vrai tissu."
    nyra reflechit "And once trade begins, larger structures will eventually emerge. Companies. A real economic network."

# game/scenario/3_canon.rpy:1600
translate english day3_choose_debate_argument_214f9b4a:

    # ryn reflechit "Ouais, sur le papier. Mais qui décide des contrats ? Elle. Toujours elle."
    ryn reflechit "Yeah, on paper. But who controls the contracts? Her. Always her."

# game/scenario/3_canon.rpy:1614
translate english day3_choose_debate_argument_1675cbdb:

    # noam "Bon. Je crois qu'on a fait le tour."
    noam "All right. I think we've covered everything."

# game/scenario/3_canon.rpy:1615
translate english day3_choose_debate_argument_19033264:

    # noam "Le monde d'avant, le texte brut, les trocs qui existent déjà, les contrats de Kami…"
    noam "The old world, the raw text, the barter already happening, Kami's contracts..."

# game/scenario/3_canon.rpy:1616
translate english day3_choose_debate_argument_1123ecdf:

    # noam "On sait tout ce qu'on peut savoir. Le reste, c'est un pari."
    noam "We know everything we can know. The rest is a gamble."

# game/scenario/3_canon.rpy:1619
translate english day3_choose_debate_argument_64b589f7:

    # think "Je regarde autour de la table. Les visages se sont figés. Chacun a choisi. Ou presque."
    think "I look around the table. Every face has gone still. Everyone has chosen. Almost."

# game/scenario/3_canon.rpy:1620
translate english day3_choose_debate_argument_a3a2b2bf:

    # think "Presque."
    think "Almost."

# game/scenario/3_canon.rpy:1628
translate english day3_choose_debate_argument_62ea799d:

    # noam "Il ne manque plus que… vous deux. Ceux de qui tout dépend."
    noam "That leaves... you two. The ones everything depends on."

# game/scenario/3_canon.rpy:1630
translate english day3_choose_debate_argument_30434ab6:

    # ryn triste "…Moi, je sais. Que je le veuille ou non. Limen, c'est écrit là. Alors je porterai mon choix."
    ryn triste "...I know my answer. Whether I like it or not. Limen is right there in the text. So I'll own my choice."

# game/scenario/3_canon.rpy:1632
translate english day3_choose_debate_argument_54d278f7:

    # think "Reste Kael. Celui qui déciderait « au moment de voter ». Le moment, c'est maintenant."
    think "That leaves Kael. The one who would decide 'when it was time to vote.' The time is now."

# game/scenario/3_canon.rpy:1634
translate english day3_choose_debate_argument_fa6327d2:

    # kael inquiet "Je…"
    kael inquiet "I..."

# game/scenario/3_canon.rpy:1636
translate english day3_choose_debate_argument_0120770f:

    # kael triste "Sur Orbite, une erreur ne pardonne pas. Et là, je n'arrive pas à voir si on ouvre une porte…"
    kael triste "On Orbit, mistakes are unforgiving. And right now, I can't tell whether we're opening a door..."

# game/scenario/3_canon.rpy:1637
translate english day3_choose_debate_argument_871185d6:

    # kael peur "…ou si on retire le dernier filet sous nos pieds."
    kael peur "...or pulling away the last safety net beneath our feet."

# game/scenario/3_canon.rpy:1639
translate english day3_choose_debate_argument_ca6b3230:

    # noam "Kael. Regarde-moi. Pour ou contre ?"
    noam "Kael. Look at me. Yes or no?"

# game/scenario/3_canon.rpy:1641
translate english day3_choose_debate_argument_8e97ba8d:

    # think "Il ouvre la bouche."
    think "He opens his mouth."

# game/scenario/3_canon.rpy:1646
translate english day3_choose_debate_argument_7658ed14:

    # kami "STOP !"
    kami "STOP!"

# game/scenario/3_canon.rpy:1647
translate english day3_choose_debate_argument_4763d4d4:

    # kami "Non, non, non. Ne me gâchez pas le suspense en le disant tout haut."
    kami "No, no, no. Don't ruin the suspense by saying it out loud."

# game/scenario/3_canon.rpy:1648
translate english day3_choose_debate_argument_a01a8ac2:

    # kami "L'audimat est à son sommet. Un cœur qui hésite en direct, ça n'a pas de prix."
    kami "Ratings are at their peak. A heart wavering live on air is priceless."

# game/scenario/3_canon.rpy:1651
translate english day3_choose_debate_argument_8ad8206b:

    # kami "Vous garderez vos réponses pour le bulletin. C'est plus honnête. Et tellement plus cruel."
    kami "You'll save your answers for the ballot. It's more honest. And so much crueler."

# game/scenario/3_canon.rpy:1652
translate english day3_choose_debate_argument_e3d384e7:

    # kami "Rappel des règles : il suffit d'un « contre ». Un seul. Et tout s'effondre."
    kami "One last reminder: a single 'no' is enough. Just one. And it all collapses."

# game/scenario/3_canon.rpy:1655
translate english day3_choose_debate_argument_b6707dd6:

    # kami "Alors… on vote. Maintenant. POUR, ou CONTRE."
    kami "So... we vote. Now. YES, or NO."

# game/scenario/3_canon.rpy:1656
translate english day3_choose_debate_argument_801fd906:

    # kami "Je meurs d'envie de compter."
    kami "I'm dying to count."

# game/scenario/3_canon.rpy:1682
translate english day3_choose_debate_argument_3e809022:

    # noam "Même avec les bons, les rayons sont vides. On distribue des droits sur des étagères qui n'existent pas."
    noam "Even with ration coupons, the shelves are empty. We're handing out rights to products that don't exist."

# game/scenario/3_canon.rpy:1684
translate english day3_choose_debate_argument_2a497220:

    # elias determine "Ça, c'est la vérité vraie. Un bon pour du riz, et pas de riz au bout. On appelle ça la sécurité ?"
    elias determine "That's the honest truth. A coupon for rice, and no rice at the end of it. You call that security?"

# game/scenario/3_canon.rpy:1686
translate english day3_choose_debate_argument_cd55aae6:

    # julian sourire "Le commerce remplit les rayons. Un producteur qui peut vendre produit davantage. C'est mécanique."
    julian sourire "Trade fills shelves. A producer who can sell will produce more. It's basic economics."

# game/scenario/3_canon.rpy:1688
translate english day3_choose_debate_argument_c64c045b:

    # mara doute "Ou alors les rayons se remplissent là où il y a de l'argent. Et Limen regarde par la fenêtre."
    mara doute "Or the shelves fill up where the money is. And Limen watches through the window."

# game/scenario/3_canon.rpy:1690
translate english day3_choose_debate_argument_e49c5703:

    # ryn colere "Voilà ! Nexus déborde, nous on ramasse les miettes. Comme aujourd'hui, mais en pire."
    ryn colere "Exactly! Nexus overflows while we pick up the crumbs. Same as now, only worse."

# game/scenario/3_canon.rpy:1692
translate english day3_choose_debate_argument_156cab59:

    # kael reflechit "…Sauf que Limen est le plus peuplé. La demande y sera énorme. Un marché suit la demande, non ?"
    kael reflechit "...Except Limen has the largest population. Demand would be huge. Markets follow demand, don't they?"

# game/scenario/3_canon.rpy:1694
translate english day3_choose_debate_argument_2faecf5b:

    # ryn reflechit "…Mouais. Peut-être. Si on a de quoi payer, déjà."
    ryn reflechit "...Maybe. If we have money to spend in the first place."

# game/scenario/3_canon.rpy:1696
translate english day3_choose_debate_argument_fc0aa1ab:

    # sael neutre "Chez nous, on fabrique ce qu'il nous faut. Le manque, on le connaît. On lui survit."
    sael neutre "Where we live, we make what we need. We know scarcity. We survive it."

# game/scenario/3_canon.rpy:1698
translate english day3_choose_debate_argument_02ad06b3:

    # elen joie "Et avec les échanges, on n'aura plus à seulement survivre. On pourra vivre !"
    elen joie "And with trade, we won't have to just survive anymore. We can live!"

# game/scenario/3_canon.rpy:1714
translate english day3_choose_debate_argument_4221b42d:

    # noam "On répète que les bons donnent droit à tout. En vrai, ils donnent droit à quoi ?"
    noam "We keep saying the coupons entitle people to everything. In reality, what do they actually get?"

# game/scenario/3_canon.rpy:1716
translate english day3_choose_debate_argument_b6b988be:

    # tomas raison "Euh… 62 %% des références listées sont en rupture permanente en périphérie. C'est… c'est pas rien."
    tomas raison "Um... 62 %% of listed products are permanently unavailable in outlying areas. That's... that's not insignificant."

# game/scenario/3_canon.rpy:1718
translate english day3_choose_debate_argument_b1e9b988:

    # iris colere "Un bon, c'est un ticket pour faire la queue. Point. Le produit correct part en deux jours."
    iris colere "A coupon is a ticket to stand in line. That's it. Anything decent is gone within two days."

# game/scenario/3_canon.rpy:1720
translate english day3_choose_debate_argument_a1f82ac1:

    # ryn colere "À Limen, on a des bons pour du lait qui arrive caillé. Des médocs périmés avant même la livraison."
    ryn colere "In Limen, we get coupons for milk that arrives spoiled. Medicine that's expired before it even gets delivered."

# game/scenario/3_canon.rpy:1721
translate english day3_choose_debate_argument_116f53c8:

    # ryn triste "Ça, c'est votre « sécurité » ? Un papier qui promet ce qui n'arrive jamais ?"
    ryn triste "That's your 'security'? A piece of paper promising something that never arrives?"

# game/scenario/3_canon.rpy:1723
translate english day3_choose_debate_argument_57c9a789:

    # mara reflexion "…D'accord. Là, tu marques un point. Défendre ce système-là, c'est défendre du vide."
    mara reflexion "...All right. You have a point there. Defending that system means defending nothing."

# game/scenario/3_canon.rpy:1725
translate english day3_choose_debate_argument_67c83c04:

    # elias determine "Le même ticket pour rien, qu'on se crève au boulot ou qu'on dorme toute la journée. Faut que ça change."
    elias determine "The same worthless ticket whether you work yourself to the bone or sleep all day. That has to change."

# game/scenario/3_canon.rpy:1727
translate english day3_choose_debate_argument_2b36ccd9:

    # elen joie "Plus de fournisseurs, plus de concurrence, plus de choix. On mérite mieux qu'un ticket vide !"
    elen joie "More suppliers, more competition, more choice. We deserve better than an empty ticket!"

# game/scenario/3_canon.rpy:1744
translate english day3_choose_debate_argument_41222181:

    # nyra raison "Vous parlez de Limen. Mais que savez-vous du prix d'une erreur sur Orbite ?"
    nyra raison "You're talking about Limen. But what do you know about the cost of a mistake on Orbit?"

# game/scenario/3_canon.rpy:1746
translate english day3_choose_debate_argument_49fc62ec:

    # kael mefiant "Un écart de flux. Un module dépressurisé. Là-haut, une erreur logistique, ça tue en silence."
    kael mefiant "One deviation in supply flow. One depressurized module. Up there, a logistics mistake kills in silence."

# game/scenario/3_canon.rpy:1747
translate english day3_choose_debate_argument_9d3128e0:

    # kael triste "On ne peut pas se permettre l'imprévu. Jamais."
    kael triste "We can't afford the unexpected. Ever."

# game/scenario/3_canon.rpy:1749
translate english day3_choose_debate_argument_a8b2e40a:

    # noam "Et le commerce, c'est de l'imprévu par définition."
    noam "And trade is unpredictability by definition."

# game/scenario/3_canon.rpy:1751
translate english day3_choose_debate_argument_4da38469:

    # iris inquiet "…Ok. Là, même moi je tique. On met des vies en balance contre des étals mieux garnis ?"
    iris inquiet "...Okay. Even I'm hesitating now. Are we weighing lives against better-stocked shelves?"

# game/scenario/3_canon.rpy:1753
translate english day3_choose_debate_argument_f015915d:

    # tomas raison "P-Paradoxalement, c'est sur Orbite qu'il y a le moins de morts par an. Le carcan actuel les protège."
    tomas raison "P-Paradoxically, Orbit has the lowest annual death toll. The current restrictions protect them."

# game/scenario/3_canon.rpy:1755
translate english day3_choose_debate_argument_2b6854f8:

    # julian hesitation "On n'interdit rien de plus, pourtant… Enfin. Je vois l'idée. Mais je vois aussi le vide sous nos pieds."
    julian hesitation "We aren't banning anything else, though... I mean. I see the point. But I also see the drop beneath us."

# game/scenario/3_canon.rpy:1757
translate english day3_choose_debate_argument_59a9327b:

    # lysa blase "Un grain de sable dans un système sous pression, et tout saute. Kael et Nyra le savent mieux que nous."
    lysa blase "One grain of sand in a pressurized system, and the whole thing blows. Kael and Nyra know that better than any of us."

# game/scenario/3_canon.rpy:1759
translate english day3_choose_debate_argument_a69d23eb:

    # nyra stress "Sur Orbite, la perte de contrôle se paie dans la seconde. Pas au prochain vote."
    nyra stress "On Orbit, losing control costs lives in seconds. Not at the next vote."

# game/scenario/3_canon.rpy:1761
translate english day3_choose_debate_argument_8ff9f46f:

    # mara stress "…Super. Donc en votant pour, on joue avec la vie de gens qu'on ne verra jamais."
    mara stress "...Great. So by voting yes, we're gambling with the lives of people we'll never meet."

# game/scenario/3_canon.rpy:1763
translate english day3_choose_debate_argument_11782fbf:

    # think "Nyra et Kael échangent un regard bref, tendu. Personne n'insiste."
    think "Nyra and Kael exchange a brief, tense look. No one presses them."

# game/scenario/3_canon.rpy:1786
translate english day3_choose_debate_argument_0e0b9278:

    # iris reflechit "Le monde d'avant… vous en parlez comme d'un paradis perdu. Moi, je me souviens des files et des prix qui doublaient sans raison."
    iris reflechit "The old world... you talk about it like some lost paradise. I remember the lines, and prices doubling for no reason."

# game/scenario/3_canon.rpy:1787
translate english day3_choose_debate_argument_e307b7c7:

    # iris reflechit "…Mais au moins, ça bougeait. On pouvait râler ET agir. Aujourd'hui, on ne fait plus que râler."
    iris reflechit "...But at least things moved. We could complain AND do something about it. Now all we do is complain."

# game/scenario/3_canon.rpy:1789
translate english day3_choose_debate_argument_97831756:

    # elen joie "Voilà ! Tu bossais, tu achetais. Personne pour juger si tes chaussures étaient assez trouées."
    elen joie "Exactly! You worked, you bought things. No one deciding whether your shoes were worn out enough."

# game/scenario/3_canon.rpy:1791
translate english day3_choose_debate_argument_6b8b216c:

    # julian sourire "Ce monde n'était pas parfait. Il était vivant. Je préfère le mouvement à une égalité dans l'attente."
    julian sourire "That world wasn't perfect. It was alive. I'd rather have movement than equality in waiting."

# game/scenario/3_canon.rpy:1793
translate english day3_choose_debate_argument_109b34e2:

    # mara reflexion "« Choisir »… c'est un joli mot, Elen."
    mara reflexion "'Choice'... that's a pretty word, Elen."

# game/scenario/3_canon.rpy:1794
translate english day3_choose_debate_argument_447c350f:

    # mara reflexion "Moi, je me souviens surtout des sourires obligatoires. Des portes qui se ferment si tu n'es pas… parfaite."
    mara reflexion "What I remember most are the mandatory smiles. Doors closing if you weren't... perfect."

# game/scenario/3_canon.rpy:1795
translate english day3_choose_debate_argument_cb2e0377:

    # mara triste "La liberté d'avant, certains l'ont payée très cher. J'en fais partie."
    mara triste "Some people paid dearly for the old world's freedom. I was one of them."

# game/scenario/3_canon.rpy:1797
translate english day3_choose_debate_argument_042c178b:

    # tomas raison "Faut dire… ce qui pourrissait tout, avant, c'était la guerre. Elle est interdite maintenant. Techniquement, ça pourrait mieux tourner."
    tomas raison "To be fair... what poisoned everything back then was the war. War is banned now. Technically, things could work better."

# game/scenario/3_canon.rpy:1799
translate english day3_choose_debate_argument_ca58ec19:

    # ryn colere "« Techniquement ». Dis ça aux gamins de Limen qui bouffaient les restes des riches."
    ryn colere "'Technically.' Tell that to the kids in Limen who used to eat rich people's leftovers."

# game/scenario/3_canon.rpy:1801
translate english day3_choose_debate_argument_67047c5d:

    # noam "Le monde d'avant offrait la liberté à ceux qui avaient déjà les moyens. Aux autres, la loi de la jungle."
    noam "The old world offered freedom to people who already had the means. Everyone else got the law of the jungle."

# game/scenario/3_canon.rpy:1803
translate english day3_choose_debate_argument_1562d113:

    # elen joie "Alors gardons le meilleur ! L'essentiel pour tous, la liberté pour le reste. Comme avant, mais sans la guerre !"
    elen joie "Then let's keep the best parts! The essentials for everyone, freedom for the rest. Like before, but without the war!"

# game/scenario/3_canon.rpy:1805
translate english day3_choose_debate_argument_57d3573f:

    # think "Mara détourne le regard, comme si elle regrettait déjà d'avoir livré quelque chose de vrai."
    think "Mara looks away, as if she already regrets revealing something real."

# game/scenario/3_canon.rpy:1821
translate english day3_choose_debate_argument_2c724556:

    # ryn colere "Lisez le texte, bon sang ! « Suppression des bons. Fin de la distribution. » Point."
    ryn colere "Read the damn text! 'Abolition of coupons. End of distribution.' Period."

# game/scenario/3_canon.rpy:1822
translate english day3_choose_debate_argument_f5337392:

    # ryn colere "Pas de « minimum vital ». Pas de « transition ». Rien."
    ryn colere "No 'minimum guarantee.' No 'transition.' Nothing."

# game/scenario/3_canon.rpy:1824
translate english day3_choose_debate_argument_6298c1ec:

    # elias determine "C'est ça qui libère ! Plus de bons, plus de laisse. On produit, on échange, on vit."
    elias determine "That's what sets us free! No more coupons, no more leash. We produce, we trade, we live."

# game/scenario/3_canon.rpy:1826
translate english day3_choose_debate_argument_995e3d2c:

    # noam "Le texte est binaire. Pour : suppression totale, tout de suite. Contre : rien ne change. Aucun entre-deux."
    noam "The text is binary. Yes: total abolition, immediately. No: nothing changes. No middle ground."

# game/scenario/3_canon.rpy:1828
translate english day3_choose_debate_argument_e47e6759:

    # kael triste "Aucune transition. On saute sans corde. Sur Orbite, ça, c'est un arrêt de mort."
    kael triste "No transition. We're jumping without a rope. On Orbit, that's a death sentence."

# game/scenario/3_canon.rpy:1830
translate english day3_choose_debate_argument_fc6e52cb:

    # lysa blase "« Suppression » veut dire suppression. Pas « réduction ». Icare aussi croyait pouvoir négocier avec la gravité."
    lysa blase "'Abolition' means abolition. Not 'reduction.' Icarus thought he could negotiate with gravity too."

# game/scenario/3_canon.rpy:1832
translate english day3_choose_debate_argument_f346a7f0:

    # ryn colere "Sans bons, à Limen, on meurt en silence pendant que vous « produisez » vos rêves."
    ryn colere "Without coupons, people in Limen die quietly while you 'produce' your dreams."

# game/scenario/3_canon.rpy:1833
translate english day3_choose_debate_argument_c4fb6991:

    # ryn colere "Le texte condamne les faibles. C'est écrit noir sur blanc !"
    ryn colere "The text condemns the weak. It's right there in black and white!"

# game/scenario/3_canon.rpy:1835
translate english day3_choose_debate_argument_147861e7:

    # mara stress "…Et il l'écrit noir sur blanc. On ne pourra pas dire qu'on ne savait pas."
    mara stress "...And it says so in black and white. We won't be able to claim we didn't know."

# game/scenario/3_canon.rpy:1837
translate english day3_choose_debate_argument_a6559878:

    # sael determine "Les Limenois échangent déjà pour survivre. Ce texte ne les condamne pas. Il les libère du mensonge."
    sael determine "People in Limen already trade to survive. This text doesn't condemn them. It frees them from the lie."

# game/scenario/3_canon.rpy:1839
translate english day3_choose_debate_argument_1e4f88d1:

    # think "Ryn frappe du poing. Sael ne cille pas."
    think "Ryn slams his fist down. Sael doesn't flinch."

# game/scenario/3_canon.rpy:1855
translate english day3_choose_debate_argument_10ca5a83:

    # ryn surpris "Attends… tu dis que ça se fait déjà ? Des trocs en douce, à Limen ?"
    ryn surpris "Wait... you're saying it already happens? People barter in secret in Limen?"

# game/scenario/3_canon.rpy:1857
translate english day3_choose_debate_argument_773040d8:

    # sael reflechit "Depuis toujours. Un sac contre une réparation. Un service contre du tissu. Ça tient les gens debout entre deux rations."
    sael reflechit "Always has. A sack of goods for a repair. A service for fabric. It keeps people standing between ration deliveries."

# game/scenario/3_canon.rpy:1859
translate english day3_choose_debate_argument_5e76631f:

    # noam "Ça marche en petit. Mais à grande échelle, officiel : est-ce que ça reste sous contrôle ?"
    noam "It works on a small scale. But officially, on a large scale—can it stay under control?"

# game/scenario/3_canon.rpy:1861
translate english day3_choose_debate_argument_88d79c68:

    # kael doute "…Si ça existe déjà sans provoquer le chaos, alors peut-être que sur Orbite aussi, ça pourrait tenir."
    kael doute "...If it already exists without causing chaos, then maybe it could work on Orbit too."

# game/scenario/3_canon.rpy:1863
translate english day3_choose_debate_argument_33cdd537:

    # julian sourire "Exactement ! Les gens s'organisent déjà. Supprimer les bons, c'est cesser de nier ce qu'ils font en cachette."
    julian sourire "Exactly! People are already organizing. Abolishing coupons means no longer denying what they do in secret."

# game/scenario/3_canon.rpy:1865
translate english day3_choose_debate_argument_7ffa2e92:

    # lysa blase "S'organiser… ou couronner des petits rois. Les marchés noirs finissent toujours par sacrer quelqu'un."
    lysa blase "Organizing... or crowning little kings. Black markets always end up putting someone on a throne."

# game/scenario/3_canon.rpy:1867
translate english day3_choose_debate_argument_3ede299a:

    # ryn reflechit "…Mais si c'est déjà là, et que ça sauve des familles… alors on pourrait faire pareil. En mieux. Sans crever en attendant Kami."
    ryn reflechit "...But if it's already there, and it's saving families... then we could do the same thing. Better. Without dying while we wait for Kami."

# game/scenario/3_canon.rpy:1869
translate english day3_choose_debate_argument_e5c94913:

    # mara reflexion "Tiens. Pour une fois, un plan qui ne sort pas de nulle part. Ça existe, ça marche. C'est déjà ça."
    mara reflexion "Well. For once, a plan that didn't come out of nowhere. It exists, it works. That's something."

# game/scenario/3_canon.rpy:1871
translate english day3_choose_debate_argument_7aa38408:

    # sael determine "On survit déjà. On peut faire plus que survivre."
    sael determine "We already survive. We can do more than survive."

# game/scenario/3_canon.rpy:1873
translate english day3_choose_debate_argument_efb3afc4:

    # think "Ryn baisse les yeux. Kael recalcule. Le troc existe déjà — l'idée trouve enfin une prise."
    think "Ryn lowers his eyes. Kael recalculates. Barter already exists—the idea finally has something solid to hold on to."

# game/scenario/3_canon.rpy:1898
translate english day3_choose_debate_argument_bf687d50:

    # kami "VERT."
    kami "GREEN."

# game/scenario/3_canon.rpy:1899
translate english day3_choose_debate_argument_96029010:

    # kami "Le vote est POUR. À l'unanimité. Pas un seul « contre ». Je suis presque émue."
    kami "The vote is YES. Unanimous. Not a single 'no.' I'm almost moved."

# game/scenario/3_canon.rpy:1900
translate english day3_choose_debate_argument_17e86c96:

    # kami "Suppression totale des bons de rationnement. Fin de la distribution gratuite."
    kami "Total abolition of ration coupons. Free distribution is over."

# game/scenario/3_canon.rpy:1901
translate english day3_choose_debate_argument_20522c48:

    # kami "Le commerce, le transport et le stockage de marchandises sont désormais autorisés."
    kami "The trade, transport, and storage of goods are now authorized."

# game/scenario/3_canon.rpy:1904
translate english day3_choose_debate_argument_9d0493f7:

    # kami "Félicitations, mes petits rebelles. Vous avez coupé la laisse."
    kami "Congratulations, my little rebels. You've cut the leash."

# game/scenario/3_canon.rpy:1905
translate english day3_choose_debate_argument_0aef29d3:

    # kami "Mais la laisse, c'était aussi ce qui vous retenait de tomber."
    kami "But that leash was also what kept you from falling."

# game/scenario/3_canon.rpy:1906
translate english day3_choose_debate_argument_f1b7b99d:

    # kami "On va voir ce que ça donne sans filet. J'ai hâte du spectacle."
    kami "Let's see what happens without a safety net. I can't wait for the show."

# game/scenario/3_canon.rpy:1911
translate english day3_choose_debate_argument_b15ef1f7:

    # think "L'écran s'éteint. Aucun cri de joie. On n'a pas gagné. On a changé les règles, c'est tout."
    think "The screen goes dark. No one cheers. We haven't won. We changed the rules, that's all."

# game/scenario/3_canon.rpy:1920
translate english day3_choose_debate_argument_28b48e2a:

    # julian sourire "C'est fait. Le collectif vient de créer une chance réelle."
    julian sourire "It's done. The group just created a real opportunity."

# game/scenario/3_canon.rpy:1922
translate english day3_choose_debate_argument_2a0fb256:

    # ryn jaloux "Ouais."
    ryn jaloux "Yeah."

# game/scenario/3_canon.rpy:1923
translate english day3_choose_debate_argument_e7f16a88:

    # ryn inquiet "Mais sans les bons, Limen va morfler au début. Faut pas se mentir."
    ryn inquiet "But Limen's gonna get hit hard at first without the coupons. No point pretending otherwise."

# game/scenario/3_canon.rpy:1925
translate english day3_choose_debate_argument_4184f6bb:

    # noam "Je me demande si on savait vraiment ce qu'on faisait."
    noam "I wonder whether we really knew what we were doing."

# game/scenario/3_canon.rpy:1926
translate english day3_choose_debate_argument_06a6a614:

    # noam "On ne pouvait plus rester comme avant. Mais… est-ce que c'était vraiment un choix ?"
    noam "We couldn't stay the way we were. But... was it ever really a choice?"

# game/scenario/3_canon.rpy:1928
translate english day3_choose_debate_argument_7b25bc29:

    # mara rire_profond "Génial. On va enfin pouvoir acheter des trucs."
    mara rire_profond "Fantastic. Now we'll finally be able to buy things."

# game/scenario/3_canon.rpy:1929
translate english day3_choose_debate_argument_200cd113:

    # mara taquin "Et crever avec le choix de la sauce. Le luxe."
    mara taquin "And die with our choice of sauce. Luxury."

# game/scenario/3_canon.rpy:1936
translate english day3_choose_debate_argument_7edb7c64:

    # kael mefiant "Orbite tiendra. Si les protocoles de sécurité restent intacts."
    kael mefiant "Orbit will hold. If the safety protocols remain intact."

# game/scenario/3_canon.rpy:1937
translate english day3_choose_debate_argument_bb7b4896:

    # kael triste "Si."
    kael triste "If."

# game/scenario/3_canon.rpy:1939
translate english day3_choose_debate_argument_7584533f:

    # think "Julian souriait trop fort. Elen rayonne et tremble. Ryn fixe le sol. Kael compte ses respirations."
    think "Julian is smiling too hard. Elen is glowing and trembling. Ryn stares at the floor. Kael counts his breaths."

# game/scenario/3_canon.rpy:1940
translate english day3_choose_debate_argument_6d580c74:

    # think "Personne n'exulte. Le plus dur commence maintenant."
    think "No one celebrates. The hardest part starts now."

# game/scenario/3_canon.rpy:1944
translate english day3_choose_debate_argument_4dfd8ca4:

    # think "Dix-sept heures dix. On se lève en silence."
    think "Ten past five. We rise in silence."

