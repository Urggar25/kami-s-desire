    "A few seconds pass before the door opens a crack."

# game/scenario/9_1_0_0.rpy:894
translate english e98e4c28:

    # anya "{i}Qui c'est ?{/i}"
    anya "{i}Who is it?{/i}"

# game/scenario/9_1_0_0.rpy:896
translate english d2c2f08d:

    # noam "{i}Nous.{/i}"
    noam "{i}Us.{/i}"

# game/scenario/9_1_0_0.rpy:898
translate english e5c7951a:

    # anya desaccord "{i}C'est extrêmement rassurant comme réponse.{/i}"
    anya desaccord "{i}That is an extremely reassuring answer.{/i}"

# game/scenario/9_1_0_0.rpy:900
translate english c5d78579:

    # nyra "{i}Nyra et Noam.{/i}"
    nyra "{i}Nyra and Noam.{/i}"

# game/scenario/9_1_0_0.rpy:902
translate english d2ab1ff9:

    # "La porte s'ouvre un peu plus."
    "The door opens a little wider."

# game/scenario/9_1_0_0.rpy:904
translate english a577de52:

    # anya reflexion "{i}Iris est pas là.{/i}"
    anya reflexion "{i}Iris isn't here.{/i}"

# game/scenario/9_1_0_0.rpy:906
translate english 18f463e7:

    # noam "{i}On vient pas voir Iris.{/i}"
    noam "{i}We're not here for Iris.{/i}"

# game/scenario/9_1_0_0.rpy:908
translate english e8f03d8c:

    # "Anya nous regarde tour à tour avant de comprendre que quelque chose ne va pas."
    "Anya looks from one of us to the other before realizing something's wrong."

# game/scenario/9_1_0_0.rpy:910
translate english 80fae207:

    # anya inquiet "{i}Quoi ?{/i}"
    anya inquiet "{i}What?{/i}"

# game/scenario/9_1_0_0.rpy:912
translate english 73f6f9aa:

    # nyra "{i}On peut entrer ?{/i}"
    nyra "{i}Can we come in?{/i}"

# game/scenario/9_1_0_0.rpy:914
translate english 0743a427:

    # anya reflexion "{i}J'imagine que oui. C'est pas vraiment chez moi.{/i}"
    anya reflexion "{i}I guess so. It's not really my place.{/i}"

# game/scenario/9_1_0_0.rpy:919
translate english c6588689:

    # "Nous refermons immédiatement derrière nous. Anya reste dans la partie de la chambre masquée à la caméra, exactement comme Iris a dû le lui répéter toute la journée."
    "We close the door behind us immediately. Anya stays in the part of the room hidden from the camera, exactly as Iris must have repeated to her all day."

# game/scenario/9_1_0_0.rpy:921
translate english 4b1325b1:

    # anya reflexion "{i}Vous avez tous cette tête quand vous venez ici ou c'est juste aujourd'hui ?{/i}"
    anya reflexion "{i}Do you all have that face when you come here or is it just today?{/i}"

# game/scenario/9_1_0_0.rpy:923
translate english 8cf112ba:

    # noam "{i}Il faut qu'on parle.{/i}"
    noam "{i}We need to talk.{/i}"

# game/scenario/9_1_0_0.rpy:925
translate english 36b8ef7e:

    # anya fatigue "{i}Oui, j'avais compris cette partie.{/i}"
    anya fatigue "{i}Yeah, I got that part.{/i}"

# game/scenario/9_1_0_0.rpy:927
translate english 3cb16ea5:

    # "Nyra indique simplement la salle de bain."
    "Nyra simply points at the bathroom."

# game/scenario/9_1_0_0.rpy:929
translate english 9ef755bf:

    # anya desaccord "{i}Encore ?{/i}"
    anya desaccord "{i}Again?{/i}"

# game/scenario/9_1_0_0.rpy:931
translate english c0796f89:

    # nyra raison "{i}Encore.{/i}"
    nyra raison "{i}Again.{/i}"

# game/scenario/9_1_0_0.rpy:933
translate english 7daf802c:

    # anya fatigue "{i}Je vais finir par connaître cette pièce mieux que le reste de la station.{/i}"
    anya fatigue "{i}I'm going to end up knowing that room better than the rest of the station.{/i}"

# game/scenario/9_1_0_0.rpy:944
translate english 1e0eadce:

    # "Une fois la porte fermée, Nyra attend quelques secondes avant d'aller droit au sujet."
    "Once the door is closed, Nyra waits a few seconds before going straight to the point."

# game/scenario/9_1_0_0.rpy:946
translate english 42f9e6b2:

    # nyra raison "Ryn est venu ici hier soir."
    nyra raison "Ryn came here last night."

# game/scenario/9_1_0_0.rpy:948
translate english f64e05c5:

    # "Anya cligne des yeux, puis acquiesce avec une simplicité qui suffit déjà à me faire comprendre que mes soupçons étaient fondés."
    "Anya blinks, then nods with a simplicity that's already enough to tell me my suspicions were justified."

# game/scenario/9_1_0_0.rpy:950
translate english 5a6cfcfc:

    # anya "Oui."
    anya "Yes."

# game/scenario/9_1_0_0.rpy:952
translate english a896ed89:

    # noam surpris "Tu l'as vu ?"
    noam surpris "You saw him?"

# game/scenario/9_1_0_0.rpy:954
translate english 5a6cfcfc_1:

    # anya "Oui."
    anya "Yes."

# game/scenario/9_1_0_0.rpy:956
translate english 271766a4:

    # noam "Et tu comptais nous le dire quand ?"
    noam "And when were you planning to tell us?"

# game/scenario/9_1_0_0.rpy:958
translate english 33a648a5:

    # anya desaccord "Je savais pas que j'étais censée faire un rapport détaillé de chaque personne qui passe la porte."
    anya desaccord "I didn't know I was supposed to file a detailed report on everyone who walks through that door."

# game/scenario/9_1_0_0.rpy:960
translate english 86167bde:

    # noam inquiet "Anya, il ne savait pas que tu existais."
    noam inquiet "Anya, he didn't know you existed."

# game/scenario/9_1_0_0.rpy:962
translate english 2f9a1eaa:

    # "Elle fronce légèrement les sourcils."
    "She frowns slightly."

# game/scenario/9_1_0_0.rpy:964
translate english 659ba1f9:

    # anya reflexion "Ah."
    anya reflexion "Ah."

# game/scenario/9_1_0_0.rpy:968
translate english 4da5d3f6:

    # anya "Ça, par contre, je savais pas."
    anya "That part, I didn't know."

# game/scenario/9_1_0_0.rpy:970
translate english fec34631:

    # "Nyra intervient avant que je poursuive."
    "Nyra steps in before I can go on."

# game/scenario/9_1_0_0.rpy:972
translate english d22427a5:

    # nyra raison "Raconte-nous simplement ce qui s'est passé. Depuis le moment où il est entré."
    nyra raison "Just tell us what happened. From the moment he came in."

# game/scenario/9_1_0_0.rpy:974
translate english 4d92cac2:

    # "Anya s'adosse contre le mur et réfléchit quelques secondes."
    "Anya leans back against the wall and thinks for a few seconds."

# game/scenario/9_1_0_0.rpy:976
translate english a1240c8d:

    # anya reflexion "Iris était sortie. Je crois qu'elle était partie prendre quelque chose à manger ou récupérer des affaires."
    anya reflexion "Iris was out. I think she'd gone to get something to eat or pick up some stuff."

# game/scenario/9_1_0_0.rpy:978
translate english 2970d234:

    # anya "J'étais sur le lit et j'ai entendu la porte."
    anya "I was on the bed and I heard the door."

# game/scenario/9_1_0_0.rpy:980
translate english e06b4448:

    # noam inquiet "Tu t'es pas cachée ?"
    noam inquiet "You didn't hide?"

# game/scenario/9_1_0_0.rpy:982
translate english b83e495b:

    # anya desaccord "J'ai essayé ! Mais votre merveilleux système de camouflage repose sur un drap, un morceau de tissu devant une caméra et l'espoir que personne n'entre sans prévenir."
    anya desaccord "I tried! But your wonderful camouflage system relies on a sheet, a scrap of cloth over a camera and the hope that nobody walks in unannounced."

# game/scenario/9_1_0_0.rpy:984
translate english 559ffb91:

    # noam gene "C'est pas faux."
    noam gene "Fair enough."

# game/scenario/9_1_0_0.rpy:986
translate english 3cd321d0:

    # anya reflexion "Quand j'ai compris que c'était pas Iris, il était déjà dans la chambre."
    anya reflexion "By the time I realized it wasn't Iris, he was already in the room."

# game/scenario/9_1_0_0.rpy:988
translate english 3c7edd08:

    # nyra "Et sa réaction ?"
    nyra "And how did he react?"

# game/scenario/9_1_0_0.rpy:990
translate english 981f68c0:

    # anya "C'est ça qui était bizarre."
    anya "That's the part that was weird."

# game/scenario/9_1_0_0.rpy:992
translate english 2d4bfbcb:

    # "Elle croise les bras."
    "She crosses her arms."

# game/scenario/9_1_0_0.rpy:994
translate english 6f5a5634:

    # anya reflexion "Il m'a regardée. Moi je me suis figée parce que je pensais que j'étais morte, ou au minimum que j'allais devoir expliquer pourquoi une inconnue dormait dans le lit d'une représentante."
    anya reflexion "He looked at me. I froze because I thought I was dead, or at the very least that I'd have to explain why a stranger was sleeping in a representative's bed."

# game/scenario/9_1_0_0.rpy:996
translate english 3ad2fb6b:

    # anya "Mais lui..."
    anya "But him..."

# game/scenario/9_1_0_0.rpy:998
translate english 1a6a2c39:

    # "Elle cherche ses mots."
    "She searches for the words."

# game/scenario/9_1_0_0.rpy:1000
translate english 25efaedc:

    # anya reflexion "Il avait pas vraiment l'air surpris."
    anya reflexion "He didn't really look surprised."

# game/scenario/9_1_0_0.rpy:1002
translate english 6d692573:

    # noam inquiet "Pas vraiment ou pas du tout ?"
    noam inquiet "Not really, or not at all?"

# game/scenario/9_1_0_0.rpy:1004
translate english 58390841:

    # anya "Pas du tout."
    anya "Not at all."

# game/scenario/9_1_0_0.rpy:1006
translate english 86b7f9bb:

    # "Nyra et moi échangeons un regard."
    "Nyra and I exchange a look."

# game/scenario/9_1_0_0.rpy:1008
translate english aa20e3e0:

    # nyra raison "Il savait donc probablement que quelqu'un était ici."
    nyra raison "So he probably knew someone was here."

# game/scenario/9_1_0_0.rpy:1010
translate english 776b6834:

    # anya "C'est l'impression que j'ai eue."
    anya "That's the impression I got."

# game/scenario/9_1_0_0.rpy:1012
translate english 91fdc97f:

    # noam reflexion "Qu'est-ce qu'il a dit ?"
    noam reflexion "What did he say?"

# game/scenario/9_1_0_0.rpy:1014
translate english fb58990d:

    # anya "Il a fermé la porte derrière lui et il m'a demandé si j'étais arrivée avec la dernière livraison."
    anya "He closed the door behind him and asked me if I'd come in with the last delivery."

# game/scenario/9_1_0_0.rpy:1016
translate english 79f5c7d2:

    # noam surpris "Directement ?"
    noam surpris "Just like that?"

# game/scenario/9_1_0_0.rpy:1018
translate english 5a6cfcfc_2:

    # anya "Oui."
    anya "Yes."

# game/scenario/9_1_0_0.rpy:1020
translate english 190c2867:

    # "Mon malaise augmente immédiatement."
    "My unease jumps up immediately."

# game/scenario/9_1_0_0.rpy:1022
translate english ca868ca0:

    # noam reflexion "Il n'a même pas demandé qui tu étais ?"
    noam reflexion "He didn't even ask who you were?"

# game/scenario/9_1_0_0.rpy:1024
translate english f68774f5:

    # anya "Pas au début."
    anya "Not at first."

# game/scenario/9_1_0_0.rpy:1026
translate english 1ce15222:

    # nyra "Est-ce qu'il a donné l'impression de reconnaître ton visage ?"
    nyra "Did he give the impression he recognized your face?"

# game/scenario/9_1_0_0.rpy:1028
translate english dcd539ef:

    # anya "Non. Ça, je pense pas."
    anya "No. That, I don't think so."

# game/scenario/9_1_0_0.rpy:1030
translate english 4d8fbf31:

    # nyra reflexion "Donc il ne te connaissait probablement pas personnellement."
    nyra reflexion "So he probably didn't know you personally."

# game/scenario/9_1_0_0.rpy:1032
translate english 46be1cb7:

    # anya "J'imagine."
    anya "I guess not."

# game/scenario/9_1_0_0.rpy:1034
translate english 70563e82:

    # noam "Et après ?"
    noam "And then?"

# game/scenario/9_1_0_0.rpy:1036
translate english 6bf50f7e:

    # anya reflexion "Après, je lui ai demandé s'il allait appeler Kami."
    anya reflexion "Then I asked him if he was going to call Kami."

# game/scenario/9_1_0_0.rpy:1038
translate english 4a8c417e:

    # "Elle hausse les épaules."
    "She shrugs."

# game/scenario/9_1_0_0.rpy:1040
translate english da1ba56b:

    # anya "Il m'a dit non."
    anya "He said no."

# game/scenario/9_1_0_0.rpy:1042
translate english f3da6531_2:

    # noam surpris "C'est tout ?"
    noam surpris "That's it?"

# game/scenario/9_1_0_0.rpy:1044
translate english 35d4fe80:

    # anya "À peu près."
    anya "Pretty much."

# game/scenario/9_1_0_0.rpy:1046
translate english 0be6aa9e:

    # anya "J'ai insisté parce que, vous allez rire, découvrir un inconnu dans la chambre où on me cache depuis moins d'une journée m'a pas spécialement mise en confiance."
    anya "I pushed, because, you'll laugh, finding a stranger in the room where I've been hidden for less than a day didn't exactly fill me with trust."

# game/scenario/9_1_0_0.rpy:1048
translate english 56314dc0:

    # noam desaccord "Étrange."
    noam desaccord "Strange."

# game/scenario/9_1_0_0.rpy:1050
translate english 9869e21e:

    # anya taquin "Je sais."
    anya taquin "I know."

# game/scenario/9_1_0_0.rpy:1052
translate english 5c5845a5:

    # anya reflexion "Mais il a dit qu'il ne raconterait rien. À personne."
    anya reflexion "But he said he wouldn't tell anyone. Nobody at all."

# game/scenario/9_1_0_0.rpy:1054
translate english dcc0b36e:

    # nyra "Il t'a demandé quelque chose en échange ?"
    nyra "Did he ask you for anything in return?"

# game/scenario/9_1_0_0.rpy:1056
translate english 63b9a7de_1:

    # anya "Non."
    anya "No."

# game/scenario/9_1_0_0.rpy:1058
translate english 51292606:

    # noam reflexion "Il t'a menacée ?"
    noam reflexion "Did he threaten you?"

# game/scenario/9_1_0_0.rpy:1060
translate english 0a1235c9:

    # anya "Non plus."
    anya "Not that either."

# game/scenario/9_1_0_0.rpy:1062
translate english d2372607:

    # anya desaccord "Vous avez l'air de vouloir absolument qu'il se soit comporté comme un psychopathe."
    anya desaccord "You two really seem to want him to have behaved like a psychopath."

# game/scenario/9_1_0_0.rpy:1064
translate english cf7fd47c:

    # noam "On veut comprendre."
    noam "We want to understand."

# game/scenario/9_1_0_0.rpy:1066
translate english 5daff458:

    # anya "Alors pour l'instant, il a été beaucoup moins inquiétant que vous deux."
    anya "Well, so far he's been a lot less unsettling than the two of you."

# game/scenario/9_1_0_0.rpy:1068
translate english 00fd6ea9:

    # noam surpris "Nous ?"
    noam surpris "Us?"

# game/scenario/9_1_0_0.rpy:1070
translate english 814bc51c:

    # anya "Je vous rappelle comment j'ai rencontré Iris hier matin ?"
    anya "Want me to remind you how I met Iris yesterday morning?"

# game/scenario/9_1_0_0.rpy:1072
translate english 0cc82d84:

    # noam gene "D'accord, mauvais exemple."
    noam gene "Okay, bad example."

# game/scenario/9_1_0_0.rpy:1074
translate english 03ac5c6d:

    # "Anya esquisse un petit sourire, mais Nyra reste concentrée sur son récit."
    "Anya cracks a small smile, but Nyra stays focused on her account."

# game/scenario/9_1_0_0.rpy:1076
translate english d4d514e5:

    # nyra raison "Tu as dit qu'il t'avait posé des questions."
    nyra raison "You said he asked you questions."

# game/scenario/9_1_0_0.rpy:1078
translate english 605dcab7:

    # anya reflexion "Oui."
    anya reflexion "Yeah."

# game/scenario/9_1_0_0.rpy:1080
translate english e983a045:

    # nyra "Lesquelles ?"
    nyra "Which ones?"

# game/scenario/9_1_0_0.rpy:1082
translate english 8371631d:

    # anya "Au début, des trucs assez normaux. D'où je venais, depuis combien de temps j'étais coincée à Limen, pourquoi j'avais pris ce risque."
    anya "At first, fairly normal stuff. Where I came from, how long I'd been stuck in Limen, why I took that risk."

# game/scenario/9_1_0_0.rpy:1084
translate english dcccb01f:

    # noam "Et ensuite ?"
    noam "And then?"

# game/scenario/9_1_0_0.rpy:1086
translate english b3150ac1:

    # "Son expression devient plus sérieuse."
    "Her expression turns more serious."

# game/scenario/9_1_0_0.rpy:1088
translate english b0d125fd:

    # anya reflexion "Ensuite il a commencé à parler du réseau."
    anya reflexion "Then he started talking about the network."

# game/scenario/9_1_0_0.rpy:1090
translate english 7be3838f:

    # nyra "Le réseau qui t'a fait entrer dans le conteneur ?"
    nyra "The network that got you into the container?"

# game/scenario/9_1_0_0.rpy:1092
translate english 5a6cfcfc_3:

    # anya "Oui."
    anya "Yes."

# game/scenario/9_1_0_0.rpy:1094
translate english 535e67de:

    # anya "Il voulait savoir comment je l'avais trouvé, qui m'avait mise en contact, si j'avais vu les personnes qui organisaient les passages..."
    anya "He wanted to know how I'd found them, who put me in contact, whether I'd seen the people organizing the crossings..."

# game/scenario/9_1_0_0.rpy:1096
translate english 26eae19f:

    # noam reflexion "Tu connaissais leurs noms ?"
    noam reflexion "Did you know their names?"

# game/scenario/9_1_0_0.rpy:1098
translate english 3f42b5c8:

    # anya "Non. Je vous l'ai déjà dit, moins j'en savais, mieux c'était."
    anya "No. I already told you, the less I knew the better."

# game/scenario/9_1_0_0.rpy:1100
translate english ef7fc345:

    # anya "J'avais un contact qui me donnait les instructions et c'est tout. Même le type qui m'a amenée jusqu'au dépôt ne m'a jamais donné son vrai nom."
    anya "I had one contact who gave me instructions and that was it. Even the guy who drove me to the depot never gave me his real name."

# game/scenario/9_1_0_0.rpy:1102
translate english 898ca712:

    # nyra raison "Et Ryn s'est arrêté là ?"
    nyra raison "And Ryn stopped there?"

# game/scenario/9_1_0_0.rpy:1104
translate english 63b9a7de_2:

    # anya "Non."
    anya "No."

# game/scenario/9_1_0_0.rpy:1106
translate english 6a1a5e8b:

    # "Elle replace machinalement ses lunettes."
    "She absently pushes her glasses back up."

# game/scenario/9_1_0_0.rpy:1108
translate english 75e7f7a1:

    # anya reflexion "C'est là que c'est devenu plus précis."
    anya reflexion "That's when it got more specific."

# game/scenario/9_1_0_0.rpy:1110
translate english 00760f6c:

    # noam inquiet "Précis comment ?"
    noam inquiet "Specific how?"

# game/scenario/9_1_0_0.rpy:1112
translate english 955b36ec:

    # anya "Il voulait savoir comment ils choisissaient les conteneurs."
    anya "He wanted to know how they picked the containers."

# game/scenario/9_1_0_0.rpy:1114
translate english 4e348d6b:

    # anya "S'ils savaient à l'avance lesquels seraient inspectés, s'il y avait des horaires où les dépôts étaient moins surveillés, comment les scellés étaient vérifiés..."
    anya "Whether they knew in advance which ones would be inspected, whether there were hours when the depots were less watched, how the seals were checked..."

# game/scenario/9_1_0_0.rpy:1116
translate english 8ce01236:

    # "Nyra relève légèrement le menton."
    "Nyra lifts her chin slightly."

# game/scenario/9_1_0_0.rpy:1118
translate english 0962e9c6:

    # nyra reflexion "Les scellés ?"
    nyra reflexion "The seals?"

# game/scenario/9_1_0_0.rpy:1120
translate english 5a6cfcfc_4:

    # anya "Oui."
    anya "Yes."

# game/scenario/9_1_0_0.rpy:1122
translate english 7d05d8b5:

    # anya "Il m'a même demandé si les équipes de contrôle vérifiaient seulement le numéro extérieur ou si elles ouvraient systématiquement les conteneurs."
    anya "He even asked me whether the inspection teams only checked the number on the outside or whether they systematically opened the containers."

# game/scenario/9_1_0_0.rpy:1124
translate english 6eafd596:

    # noam reflexion "Tu savais répondre à tout ça ?"
    noam reflexion "Did you have answers to all that?"

# game/scenario/9_1_0_0.rpy:1126
translate english d3c62723:

    # anya desaccord "Évidemment que non."
    anya desaccord "Obviously not."

# game/scenario/9_1_0_0.rpy:1128
translate english 5f8fbae9:

    # anya "Moi, on m'a dit : sois à telle porte à telle heure, monte dans ce conteneur et ne sors surtout pas avant l'arrivée."
    anya "What I got told was: be at this door at this time, get in this container and whatever you do, don't come out before it arrives."

# game/scenario/9_1_0_0.rpy:1130
translate english 9a2b18e2:

    # anya reflexion "J'étais pas en stage chez les passeurs."
    anya reflexion "I wasn't doing an internship with the smugglers."

# game/scenario/9_1_0_0.rpy:1132
translate english 20175c25:

    # "Malgré la situation, je retiens difficilement un sourire."
    "Despite the situation, I barely hold back a smile."

# game/scenario/9_1_0_0.rpy:1134
translate english ff9fb4f1:

    # nyra raison "Il a utilisé des mots particuliers ? Des noms de zones, des procédures, quelque chose que toi tu n'avais pas mentionné avant ?"
    nyra raison "Did he use any particular words? Zone names, procedures, anything you hadn't mentioned first?"

# game/scenario/9_1_0_0.rpy:1136
translate english aff4a70d:

    # "Anya réfléchit plus longtemps cette fois."
    "Anya thinks longer this time."

# game/scenario/9_1_0_0.rpy:1138
translate english dcc37626:

    # anya reflexion "Oui..."
    anya reflexion "Yeah..."

# game/scenario/9_1_0_0.rpy:1140
translate english df784008_2:

    # noam "Quoi ?"
    noam "What?"

# game/scenario/9_1_0_0.rpy:1142
translate english 0d4c22ed:

    # anya "À un moment, il m'a demandé si le conteneur avait été placé dans une file de contrôle normale ou dans une zone de transit secondaire."
    anya "At one point he asked me whether the container had been put in a normal inspection line or in a secondary transit area."

# game/scenario/9_1_0_0.rpy:1144
translate english 18b10511:

    # nyra reflexion "Tu lui avais parlé de zones de transit ?"
    nyra reflexion "Had you mentioned transit areas to him?"

# game/scenario/9_1_0_0.rpy:1146
translate english 63b9a7de_3:

    # anya "Non."
    anya "No."

# game/scenario/9_1_0_0.rpy:1148
translate english ef1285aa:

    # "Le silence retombe."
    "The silence settles back in."

# game/scenario/9_1_0_0.rpy:1150
translate english d52f486e_1:

    # anya inquiet "Pourquoi ?"
    anya inquiet "Why?"

# game/scenario/9_1_0_0.rpy:1152
translate english ddc2a934:

    # nyra "Parce que ce n'est pas le genre de détail qu'on demande au hasard."
    nyra "Because that's not the kind of detail you ask about at random."

# game/scenario/9_1_0_0.rpy:1154
translate english 6a83bb10:

    # anya reflexion "J'avais surtout l'impression qu'il savait déjà comment ça fonctionnait."
    anya reflexion "Mostly I got the feeling he already knew how it all worked."

# game/scenario/9_1_0_0.rpy:1156
translate english ba85a393:

    # noam inquiet "Voilà."
    noam inquiet "There it is."

# game/scenario/9_1_0_0.rpy:1158
translate english a76c8681:

    # anya desaccord "Ça veut pas dire qu'il fait partie du réseau."
    anya desaccord "That doesn't mean he's part of the network."

# game/scenario/9_1_0_0.rpy:1160
translate english fc52e08d:

    # noam "J'ai pas dit ça."
    noam "I didn't say that."

# game/scenario/9_1_0_0.rpy:1162
translate english c8b010b0:

    # anya "Tu le penses très fort."
    anya "You're thinking it very loudly."

# game/scenario/9_1_0_0.rpy:1164
translate english f0e0ab50:

    # noam reflexion "Je pense surtout qu'il en sait beaucoup plus qu'il ne veut me le dire."
    noam reflexion "What I think is that he knows a lot more than he wants to tell me."

# game/scenario/9_1_0_0.rpy:1166
translate english a7f60660:

    # anya "Peut-être. Mais il aurait pu me dénoncer dès qu'il m'a vue et il l'a pas fait."
    anya "Maybe. But he could have turned me in the second he saw me, and he didn't."

# game/scenario/9_1_0_0.rpy:1168
translate english 50044c9d:

    # "Elle se tourne vers Nyra."
    "She turns to Nyra."

# game/scenario/9_1_0_0.rpy:1170
translate english 86ca9808:

    # anya reflexion "Et il avait pas l'air de vouloir me piéger. Il était calme."
    anya reflexion "And he didn't seem like he wanted to trap me. He was calm."

# game/scenario/9_1_0_0.rpy:1172
translate english 8f8542ea:

    # anya "Il m'a même demandé si Iris me donnait suffisamment à manger."
    anya "He even asked me whether Iris was giving me enough to eat."

# game/scenario/9_1_0_0.rpy:1174
translate english 82ac864c:

    # noam surpris "Sérieusement ?"
    noam surpris "Seriously?"

# game/scenario/9_1_0_0.rpy:1176
translate english 5a6cfcfc_5:

    # anya "Oui."
    anya "Yes."

# game/scenario/9_1_0_0.rpy:1178
translate english 058a1401:

    # anya taquin "Apparemment ma survie alimentaire inquiète énormément de monde ici."
    anya taquin "Apparently my nutritional survival is a huge concern for a lot of people around here."

# game/scenario/9_1_0_0.rpy:1180
translate english e5814631:

    # "Nyra garde le silence quelques secondes, puis pose enfin la question que je n'avais moi-même pas formulée clairement."
    "Nyra stays quiet for a few seconds, then finally asks the question I hadn't clearly formulated myself."

# game/scenario/9_1_0_0.rpy:1182
translate english 2af9463a:

    # nyra raison "Anya."
    nyra raison "Anya."

# game/scenario/9_1_0_0.rpy:1184
translate english 673d9ec8:

    # anya "Hm ?"
    anya "Hm?"

# game/scenario/9_1_0_0.rpy:1186
translate english 810bbbe7:

    # nyra "Comment savait-il que tu étais là ?"
    nyra "How did he know you were here?"

# game/scenario/9_1_0_0.rpy:1188
translate english b194d717:

    # "Anya ouvre la bouche, puis s'arrête."
    "Anya opens her mouth, then stops."

# game/scenario/9_1_0_0.rpy:1192
translate english 1e9ff117_1:

    # anya reflexion "..."
    anya reflexion "..."

# game/scenario/9_1_0_0.rpy:1194
translate english f8199b6f:

    # "Son assurance disparaît progressivement."
    "Her confidence gradually drains away."

# game/scenario/9_1_0_0.rpy:1196
translate english 56147ab4:

    # anya "Je sais pas."
    anya "I don't know."

# game/scenario/9_1_0_0.rpy:1198
translate english ee465519:

    # nyra "Tu ne l'avais jamais vu avant hier ?"
    nyra "You'd never seen him before last night?"

# game/scenario/9_1_0_0.rpy:1200
translate english 3c9ca378:

    # anya "Jamais."
    anya "Never."

# game/scenario/9_1_0_0.rpy:1202
translate english 5fa15f23:

    # nyra "Tu n'as parlé à personne d'autre depuis ton réveil ?"
    nyra "You haven't spoken to anyone else since you woke up?"

# game/scenario/9_1_0_0.rpy:1204
translate english 666dde21:

    # anya "À vous. Iris. Tomas."
    anya "To you. Iris. Tomas."

# game/scenario/9_1_0_0.rpy:1206
translate english a8743bed:

    # noam "Et personne d'autre."
    noam "And nobody else."

# game/scenario/9_1_0_0.rpy:1208
translate english 63b9a7de_4:

    # anya "Non."
    anya "No."

# game/scenario/9_1_0_0.rpy:1210
translate english 66bb2b6e:

    # nyra reflexion "Alors il y a deux possibilités."
    nyra reflexion "Then there are two possibilities."

# game/scenario/9_1_0_0.rpy:1212
translate english b0a29a34:

    # noam inquiet "Quelqu'un lui a parlé."
    noam inquiet "Someone talked to him."

# game/scenario/9_1_0_0.rpy:1214
translate english 8a46ddc3:

    # nyra "Ou il savait déjà quelque chose avant d'entrer."
    nyra "Or he already knew something before he walked in."

# game/scenario/9_1_0_0.rpy:1216
translate english f3972a46:

    # anya inquiet "Mais comment ?"
    anya inquiet "But how?"

# game/scenario/9_1_0_0.rpy:1218
translate english 3e74e590:

    # nyra "C'est précisément ce qu'on ignore."
    nyra "That's exactly what we don't know."

# game/scenario/9_1_0_0.rpy:1220
translate english 9b47f186:

    # "Je repense à Ryn dans la cafétéria, puis à son regard pendant l'annonce de Kami sur les contrôles."
    "I think back to Ryn in the cafeteria, then to the look on his face during Kami's announcement about the inspections."

# game/scenario/9_1_0_0.rpy:1222
translate english 63e5feaf:

    # think "Et il vient justement poser des questions sur les conteneurs la veille d'une annonce qui va rendre leurs contrôles beaucoup plus stricts."
    think "And he happens to come asking questions about containers the day before an announcement that's going to make inspecting them far stricter."

# game/scenario/9_1_0_0.rpy:1224
translate english 4901e2b6:

    # noam reflexion "Ce matin, quand je lui ai demandé pourquoi il était venu ici, il m'a dit qu'il avait quelque chose de personnel à dire à Iris."
    noam reflexion "This morning, when I asked him why he'd come here, he told me he had something personal to say to Iris."

# game/scenario/9_1_0_0.rpy:1226
translate english 20cb5e33:

    # anya desaccord "Iris était même pas là quand il est venu."
    anya desaccord "Iris wasn't even here when he came."

# game/scenario/9_1_0_0.rpy:1228
translate english b11ae2df_2:

    # noam "Je sais."
    noam "I know."

# game/scenario/9_1_0_0.rpy:1230
translate english 14b1dfdb:

    # nyra raison "Ça confirme au moins une chose : il ne veut pas que Noam sache ce qu'il cherchait réellement."
    nyra raison "That confirms at least one thing: he doesn't want Noam to know what he was really after."

# game/scenario/9_1_0_0.rpy:1232
translate english e7438d10:

    # anya inquiet "Et maintenant ?"
    anya inquiet "And now?"

# game/scenario/9_1_0_0.rpy:1234
translate english 13b2d9fe:

    # noam "Bonne question."
    noam "Good question."

# game/scenario/9_1_0_0.rpy:1236
translate english 49bb8f10:

    # "La porte de la chambre s'ouvre brusquement de l'autre côté de la salle de bain."
    "The bedroom door swings open on the other side of the bathroom."

# game/scenario/9_1_0_0.rpy:1244
translate english c8ee9850:

    # "Nous nous regardons tous les trois."
    "The three of us look at each other."

# game/scenario/9_1_0_0.rpy:1246
translate english a53c02c6_4:

    # noam surpris "..."
    noam surpris "..."

# game/scenario/9_1_0_0.rpy:1248
translate english a3a5de6e:

    # anya fatigue "..."
    anya fatigue "..."

# game/scenario/9_1_0_0.rpy:1250
translate english 5d9648e7:

    # nyra reflexion "..."
    nyra reflexion "..."

# game/scenario/9_1_0_0.rpy:1252
translate english 3e3c927d:

    # iris "Je refuse."
    iris "I refuse."

# game/scenario/9_1_0_0.rpy:1254
translate english 3540cc89:

    # "Quelques pas rapides traversent la chambre avant que la porte de la salle de bain s'ouvre."
    "A few quick steps cross the room before the bathroom door opens."

# game/scenario/9_1_0_0.rpy:1263
translate english a5285013:

    # iris colere "C'est quoi ÇA ?!"
    iris colere "What is THIS?!"

# game/scenario/9_1_0_0.rpy:1265
translate english a80e61bc:

    # noam gene "Bonjour."
    noam gene "Morning."

# game/scenario/9_1_0_0.rpy:1267
translate english 9175bfe6:

    # iris "Non, pas bonjour."
    iris "No, not morning."

# game/scenario/9_1_0_0.rpy:1269
translate english 12b585b5:

    # iris colere "Pourquoi il y a encore une réunion dans MA salle de bain ?!"
    iris colere "Why is there another meeting in MY bathroom?!"

# game/scenario/9_1_0_0.rpy:1271
translate english 7ca7f8c1:

    # nyra raison "On avait besoin de parler sans les micros."
    nyra raison "We needed to talk without the mics."

# game/scenario/9_1_0_0.rpy:1273
translate english ed559d4e:

    # iris "Vous avez tous des brouilleurs dans vos chambres !"
    iris "You all have jammers in your rooms!"

# game/scenario/9_1_0_0.rpy:1275
translate english 6c7f998b:

    # noam "Anya peut pas vraiment traverser le couloir pour aller dans la mienne."
    noam "Anya can't exactly walk down the hallway to get to mine."

# game/scenario/9_1_0_0.rpy:1277
translate english 6b41c5a1:

    # iris desaccord "Je sais très bien pourquoi vous êtes ici, c'est pas le problème !"
    iris desaccord "I know perfectly well why you're here, that's not the problem!"

# game/scenario/9_1_0_0.rpy:1279
translate english a9f00d1f:

    # "Elle pose ses affaires sur le meuble avec beaucoup plus de force que nécessaire."
    "She drops her things on the counter with a lot more force than necessary."

# game/scenario/9_1_0_0.rpy:1281
translate english f8b3a009:

    # iris colere "Depuis hier, ma chambre est devenue une gare."
    iris colere "Since yesterday, my room has turned into a train station."

# game/scenario/9_1_0_0.rpy:1283
translate english c5cfd8bc:

    # iris "Tomas vient avec des plateaux de nourriture."
    iris "Tomas comes by with trays of food."

# game/scenario/9_1_0_0.rpy:1285
translate english 46a0a634:

    # iris "Noam passe le matin."
    iris "Noam stops in every morning."

# game/scenario/9_1_0_0.rpy:1287
translate english 1d8029e2:

    # iris "Nyra organise des réunions."
    iris "Nyra holds meetings."

# game/scenario/9_1_0_0.rpy:1289
translate english 1ada444d:

    # iris "Ryn entre je sais même pas pourquoi."
    iris "Ryn walks in for reasons I don't even know."

# game/scenario/9_1_0_0.rpy:1291
translate english 794430f3:

    # iris "Et maintenant je découvre TROIS personnes enfermées dans ma salle de bain !"
    iris "And now I find THREE people locked in my bathroom!"

# game/scenario/9_1_0_0.rpy:1293
translate english 210f32a8:

    # anya taquin "En comptant toi, on est quatre."
    anya taquin "Counting you, that's four."

# game/scenario/9_1_0_0.rpy:1295
translate english fbbbe6b8:

    # "Iris tourne lentement la tête vers elle."
    "Iris slowly turns her head toward her."

# game/scenario/9_1_0_0.rpy:1297
translate english 7e582da7:

    # iris desaccord "Merci Anya."
    iris desaccord "Thank you, Anya."

# game/scenario/9_1_0_0.rpy:1299
translate english 7a7e9c87:

    # anya sourire "De rien."
    anya sourire "You're welcome."

# game/scenario/9_1_0_0.rpy:1301
translate english 3b9d8637:

    # iris "C'était une information essentielle."
    iris "That was essential information."

# game/scenario/9_1_0_0.rpy:1303
translate english 9e4aa1c2:

    # anya "J'aime être utile."
    anya "I like being useful."

# game/scenario/9_1_0_0.rpy:1305
translate english 59db9f52:

    # noam sourire "Elle s'intègre vite."
    noam sourire "She's settling in fast."

# game/scenario/9_1_0_0.rpy:1307
translate english 00174b19:

    # iris colere "Toi, ne l'encourage pas."
    iris colere "You, don't encourage her."

# game/scenario/9_1_0_0.rpy:1309
translate english f8b8f39d:

    # "Nyra semble lutter pour conserver son sérieux."
    "Nyra seems to be struggling to keep a straight face."

# game/scenario/9_1_0_0.rpy:1311
translate english 794f0a62:

    # nyra taquin "On avait presque terminé."
    nyra taquin "We were almost done."

# game/scenario/9_1_0_0.rpy:1313
translate english ddf7f091:

    # iris desaccord "Magnifique. Est-ce que je peux réserver un créneau pour utiliser ma propre salle de bain ou je dois remplir un formulaire ?"
    iris desaccord "Wonderful. Can I book a slot to use my own bathroom or do I need to fill out a form?"

# game/scenario/9_1_0_0.rpy:1315
translate english 49c23609:

    # noam taquin "On peut mettre un planning à l'entrée."
    noam taquin "We could put a schedule on the door."

# game/scenario/9_1_0_0.rpy:1317
translate english 6c7bb674:

    # iris colere "Noam."
    iris colere "Noam."

# game/scenario/9_1_0_0.rpy:1319
translate english 11aa783a:

    # noam sourire "J'arrête."
    noam sourire "I'll stop."

# game/scenario/9_1_0_0.rpy:1321
translate english 4ea410ff:

    # "Iris croise les bras puis désigne Anya."
    "Iris crosses her arms, then points at Anya."

# game/scenario/9_1_0_0.rpy:1323
translate english f91fdc92:

    # iris desaccord "Et puisqu'on parle d'organisation, ce soir tu choisis un côté du lit."
    iris desaccord "And while we're on the subject of organization, tonight you pick a side of the bed."

# game/scenario/9_1_0_0.rpy:1325
translate english 38e42176:

    # anya surpris "Pardon ?"
    anya surpris "Excuse me?"

# game/scenario/9_1_0_0.rpy:1327
translate english e9f8a040:

    # iris "Un côté. Gauche ou droite. Peu importe. Mais tu le gardes."
    iris "A side. Left or right. I don't care. But you stay on it."

# game/scenario/9_1_0_0.rpy:1329
translate english d34c4c86:

    # anya desaccord "Je dors déjà d'un côté."
    anya desaccord "I already sleep on one side."

# game/scenario/9_1_0_0.rpy:1331
translate english 05637726:

    # iris colere "Tu dors en diagonale !"
    iris colere "You sleep diagonally!"

# game/scenario/9_1_0_0.rpy:1333
translate english 828ccf9e:

    # anya "Pas du tout !"
    anya "I do not!"

# game/scenario/9_1_0_0.rpy:1335
translate english 4544af95:

    # iris "Cette nuit, ton pied était presque sur mon oreiller !"
    iris "Last night your foot was practically on my pillow!"

# game/scenario/9_1_0_0.rpy:1337
translate english adaeb49c:

    # anya colere "Parce que TU m'avais poussée !"
    anya colere "Because YOU pushed me!"

# game/scenario/9_1_0_0.rpy:1339
translate english 8d14819c:

    # iris surpris "Moi ?!"
    iris surpris "Me?!"

# game/scenario/9_1_0_0.rpy:1341
translate english fed08da8:

    # anya "Oui, toi !"
    anya "Yes, you!"

# game/scenario/9_1_0_0.rpy:1343
translate english 96bd8051:

    # iris colere "C'est mon lit !"
    iris colere "It's my bed!"

# game/scenario/9_1_0_0.rpy:1345
translate english 0b628647:

    # anya desaccord "Et ça te donne le droit de prendre toute la couverture ?"
    anya desaccord "And that gives you the right to take the entire blanket?"

# game/scenario/9_1_0_0.rpy:1347
translate english 49153f1c:

    # iris "Je prends pas toute la couverture."
    iris "I don't take the entire blanket."

# game/scenario/9_1_0_0.rpy:1349
translate english 6dd9dad2:

    # anya "Tu t'enroules dedans comme une espèce de burrito agressif !"
    anya "You roll yourself up in it like some kind of aggressive burrito!"

# game/scenario/9_1_0_0.rpy:1353
translate english 0e80e0da_2:

    # noam "..."
    noam "..."

# game/scenario/9_1_0_0.rpy:1355
translate english 01425ca7:

    # nyra "..."
    nyra "..."

# game/scenario/9_1_0_0.rpy:1357
translate english 9d29b197:

    # "Je baisse la tête pour cacher mon sourire."
    "I look down to hide my smile."

# game/scenario/9_1_0_0.rpy:1359
translate english b784dccf:

    # iris colere "Je ne m'enroule PAS comme un burrito !"
    iris colere "I do NOT roll up like a burrito!"

# game/scenario/9_1_0_0.rpy:1361
translate english 5fecde71:

    # anya "Je me suis réveillée trois fois sans rien sur moi."
    anya "I woke up three times with nothing on me."

# game/scenario/9_1_0_0.rpy:1363
translate english fb72f54e:

    # iris "Parce que tu bouges !"
    iris "Because you move!"

# game/scenario/9_1_0_0.rpy:1365
translate english 1667bd0a:

    # anya "Parce que j'ai froid !"
    anya "Because I'm cold!"

# game/scenario/9_1_0_0.rpy:1367
translate english 7a1219be:

    # iris "Parce que tu prends toute la place !"
    iris "Because you take up all the space!"

# game/scenario/9_1_0_0.rpy:1369
translate english d8984891:

    # anya "Ton lit est énorme !"
    anya "Your bed is enormous!"

# game/scenario/9_1_0_0.rpy:1371
translate english 80d0d9c1:

    # iris "C'est pas une raison !"
    iris "That's not a reason!"

# game/scenario/9_1_0_0.rpy:1373
translate english 4b0eb206:

    # noam sourire "Vous vous entendez plutôt bien finalement."
    noam sourire "You two get along pretty well, actually."

# game/scenario/9_1_0_0.rpy:1375
translate english d642f230:

    # iris colere "DEHORS."
    iris colere "OUT."

# game/scenario/9_1_0_0.rpy:1377
translate english 0739e9e2:

    # noam surpris "D'accord."
    noam surpris "All right."

# game/scenario/9_1_0_0.rpy:1379
translate english 85185e8e:

    # "Nyra lève néanmoins une main avant que la discussion ne se termine complètement."
    "Nyra still raises a hand before the discussion ends completely."

# game/scenario/9_1_0_0.rpy:1381
translate english 77dd5355:

    # nyra raison "Une chose avant."
    nyra raison "One thing first."

# game/scenario/9_1_0_0.rpy:1383
translate english 0f72a6fc:

    # "Iris soupire mais se tait."
    "Iris sighs but stays quiet."

# game/scenario/9_1_0_0.rpy:1385
translate english 8bebf9f4:

    # nyra "À partir de maintenant, personne ne vient voir Anya seul."
    nyra "From now on, nobody comes to see Anya alone."

# game/scenario/9_1_0_0.rpy:1387
translate english 2f4472eb:

    # anya reflexion "Même vous ?"
    anya reflexion "Even you?"

# game/scenario/9_1_0_0.rpy:1389
translate english ebe7806e:

    # nyra "Même nous. Si quelqu'un doit entrer ici, au moins une autre personne parmi celles qui connaissent la situation doit être au courant."
    nyra "Even us. If someone has to come in here, at least one other person who knows the situation has to be aware of it."

# game/scenario/9_1_0_0.rpy:1391
translate english 533041af:

    # iris reflexion "Vu ce qui s'est passé hier soir, ça me paraît pas stupide."
    iris reflexion "Given what happened last night, that doesn't sound stupid."

# game/scenario/9_1_0_0.rpy:1393
translate english 34d74ed0:

    # nyra "Et si une nouvelle personne découvre Anya, volontairement ou non, on se le dit immédiatement."
    nyra "And if a new person finds out about Anya, on purpose or not, we tell each other immediately."

# game/scenario/9_1_0_0.rpy:1395
translate english c75c6f3e:

    # noam "Pour Ryn, on fait quoi ?"
    noam "What do we do about Ryn?"

# game/scenario/9_1_0_0.rpy:1397
translate english e5b48424:

    # "Nyra réfléchit une seconde."
    "Nyra thinks for a second."

# game/scenario/9_1_0_0.rpy:1399
translate english a9abe6bc:

    # nyra raison "Rien, pour l'instant."
    nyra raison "Nothing, for now."

# game/scenario/9_1_0_0.rpy:1401
translate english 99c2a3ad:

    # noam surpris "Rien ?"
    noam surpris "Nothing?"

# game/scenario/9_1_0_0.rpy:1403
translate english 19b2cce7:

    # nyra "Il a eu plusieurs heures pour prévenir Kami et il ne l'a pas fait. Lui tomber dessus sans savoir ce qu'il cherche ne ferait que lui montrer que nous paniquons."
    nyra "He had several hours to warn Kami and he didn't. Going after him without knowing what he's after would only show him that we're panicking."

# game/scenario/9_1_0_0.rpy:1405
translate english 61645d98:

    # noam reflexion "Donc on lui fait confiance ?"
    noam reflexion "So we trust him?"

# game/scenario/9_1_0_0.rpy:1407
translate english a522d80b_1:

    # nyra "Non."
    nyra "No."

# game/scenario/9_1_0_0.rpy:1409
translate english 1e9954c4:

    # "Elle jette un bref regard vers Anya."
    "She glances briefly at Anya."

# game/scenario/9_1_0_0.rpy:1411
translate english 851621fa:

    # nyra raison "On considère qu'il sait."
    nyra raison "We assume he knows."

# game/scenario/9_1_0_0.rpy:1415
translate english eb2fc6a5:

    # nyra "Pas qu'il est avec nous."
    nyra "Not that he's with us."

# game/scenario/9_1_0_0.rpy:1417
translate english 85fda7d8:

    # "Cette distinction suffit à faire disparaître les derniers sourires de la pièce."
    "That distinction is enough to wipe the last smiles out of the room."

# game/scenario/9_1_0_0.rpy:1419
translate english 9de1f770:

    # iris reflexion "Ça me va."
    iris reflexion "Works for me."

# game/scenario/9_1_0_0.rpy:1421
translate english 43f8b9f6:

    # anya "Moi aussi."
    anya "Me too."

# game/scenario/9_1_0_0.rpy:1423
translate english dba2cb71:

    # noam reflexion "D'accord."
    noam reflexion "All right."

# game/scenario/9_1_0_0.rpy:1425
translate english e2c2f8da:

    # iris desaccord "Parfait. Maintenant, puisque cette réunion clandestine est officiellement terminée..."
    iris desaccord "Perfect. Now, since this clandestine meeting is officially over..."

# game/scenario/9_1_0_0.rpy:1427
translate english 680a627c:

    # "Elle ouvre grand la porte de la salle de bain."
    "She swings the bathroom door wide open."

# game/scenario/9_1_0_0.rpy:1429
translate english d642f230_1:

    # iris colere "DEHORS."
    iris colere "OUT."

# game/scenario/9_1_0_0.rpy:1431
translate english e7e74094:

    # nyra taquin "Je crois que c'était destiné à nous."
    nyra taquin "I believe that was aimed at us."

# game/scenario/9_1_0_0.rpy:1433
translate english e32ebc64:

    # noam sourire "J'avais compris."
    noam sourire "I got that."

# game/scenario/9_1_0_0.rpy:1435
translate english 7fa6e554:

    # anya taquin "À demain."
    anya taquin "See you tomorrow."

# game/scenario/9_1_0_0.rpy:1437
translate english cd56314a:

    # iris colere "N'encourage pas les visites !"
    iris colere "Don't encourage the visits!"

# game/scenario/9_1_0_0.rpy:1452
translate english 77d1930c:

    # "La soirée se termine sans nouvel incident. Après avoir mangé, je retourne vers ma chambre en croisant quelques représentants qui parlent encore du vote et de tout ce que l'assouplissement du Commandement IV pourrait permettre."
    "The evening ends without another incident. After eating, I head back toward my room, passing a few representatives still talking about the vote and everything the loosening of Commandment IV could allow."

# game/scenario/9_1_0_0.rpy:1454
translate english 39829848:

    # "Pour une fois, ils ont de bonnes raisons d'être optimistes."
    "For once, they've got good reason to be optimistic."

# game/scenario/9_1_0_0.rpy:1456
translate english e574f6e5:

    # think "Un vote adopté sans crise, Elen qui parle déjà de festivals... Ça aurait presque pu être une bonne journée."
    think "A vote passed without a crisis, Elen already talking about festivals... It could almost have been a good day."

# game/scenario/9_1_0_0.rpy:1458
translate english c76472a4:

    # "Je ralentis légèrement en passant devant la chambre d'Iris."
    "I slow down a little as I pass Iris's room."

# game/scenario/9_1_0_0.rpy:1460
translate english fdd0b0ef:

    # "Aucun bruit particulier n'en sort."
    "No particular sound comes out of it."

# game/scenario/9_1_0_0.rpy:1462
translate english 5a9540ef:

    # think "Soit elles dorment déjà, soit Iris a finalement réussi à imposer une frontière au milieu du lit."
    think "Either they're already asleep, or Iris finally managed to impose a border down the middle of the bed."

# game/scenario/9_1_0_0.rpy:1464
translate english 58a2c0d1:

    # "Je continue jusqu'à ma chambre."
    "I keep going to my room."

# game/scenario/9_1_0_0.rpy:1469
translate english 493a0e31:

    # "Je referme la porte derrière moi, retire ma veste et me laisse tomber sur le lit. La fatigue arrive presque immédiatement, mais ma tête refuse encore de suivre."
    "I close the door behind me, take off my jacket and drop onto the bed. The tiredness hits almost immediately, but my head still refuses to follow."

# game/scenario/9_1_0_0.rpy:1471
translate english 47a109b0:

    # think "Ryn savait qu'Anya était là."
    think "Ryn knew Anya was there."

# game/scenario/9_1_0_0.rpy:1473
translate english c6535a57:

    # "Je repense à ce qu'elle nous a raconté : son absence totale de surprise, ses questions sur les dépôts, les contrôles, les scellés et ces détails qu'elle-même ne connaissait presque pas."
    "I think back to what she told us: her complete lack of surprise, his questions about the depots, the inspections, the seals and details she barely knew herself."

# game/scenario/9_1_0_0.rpy:1475
translate english 8655fc28:

    # think "Et dès que Kami a parlé des nouvelles inspections, il s'est mis à écouter."
    think "And the second Kami mentioned the new inspections, he started listening."

# game/scenario/9_1_0_0.rpy:1477
translate english 4d4f67b6:

    # "Je me retourne sur le côté."
    "I turn onto my side."

# game/scenario/9_1_0_0.rpy:1479
translate english 89ec4ef0:

    # think "Il n'a pourtant rien dit à Kami."
    think "And yet he didn't say anything to Kami."

# game/scenario/9_1_0_0.rpy:1481
translate english 2858b6a0:

    # think "S'il voulait simplement nous dénoncer, Nyra a raison : il l'aurait déjà fait."
    think "If he simply wanted to turn us in, Nyra's right: he'd have done it already."

# game/scenario/9_1_0_0.rpy:1483
translate english 8b103580:

    # "C'est probablement ce qui me dérange le plus."
    "That's probably what bothers me the most."

# game/scenario/9_1_0_0.rpy:1485
translate english 886d6783:

    # think "Alors qu'est-ce que tu veux, Ryn ?"
    think "So what do you want, Ryn?"

# game/scenario/9_1_0_0.rpy:1489
translate english 17396a93:

    # "Je ferme les yeux et force mon esprit à abandonner la question pour ce soir."
    "I close my eyes and force my mind to drop the question for tonight."

# game/scenario/9_1_0_0.rpy:1491
translate english 32d00c0d:

    # think "Demain."
    think "Tomorrow."

# game/scenario/9_1_0_0.rpy:1493
translate english 3441b258:

    # think "J'y réfléchirai demain."
    think "I'll think about it tomorrow."

# game/scenario/9_1_0_0.rpy:1495
translate english 8ee4b3f4:

    # "L'épuisement finit par prendre le dessus."
    "Exhaustion finally takes over."

