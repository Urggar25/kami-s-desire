    # noam "Anya."
    noam "Anya."

# game/scenario/9_1_0_0.rpy:865
translate english bd93ce36:

    # nyra "Anya."
    nyra "Anya."

# game/scenario/9_1_0_0.rpy:867
translate english 8eac5943:

    # "Elle prend immédiatement la direction de la chambre d'Iris."
    "She immediately heads for Iris's room."

# game/scenario/9_1_0_0.rpy:869
translate english 9e42590a:

    # noam surpris "Maintenant ?"
    noam surpris "Now?"

# game/scenario/9_1_0_0.rpy:871
translate english e012fd79:

    # nyra taquin "Tu me cherchais depuis ce matin et maintenant que je suis disponible, tu veux attendre ?"
    nyra taquin "You've been looking for me since this morning and now that I'm available, you want to wait?"

# game/scenario/9_1_0_0.rpy:873
translate english a739d0f9:

