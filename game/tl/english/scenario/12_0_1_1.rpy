# game/scenario/12_0_1_1.rpy:79
translate english dac67f6c:

    # "Je m'approche de la bouche d'aération et tends l'oreille."
    "I step up to the air vent and listen."

# game/scenario/12_0_1_1.rpy:80
translate english 9e8bd2b3:

    # "Le souffle est régulier. Aucun frottement, aucun pas dans le conduit."
    "The airflow is steady. No scraping, no footsteps in the duct."

# game/scenario/12_0_1_1.rpy:82
translate english 48705307:

    # think "Le bruit ne venait pas de là... enfin, je crois."
    think "The noise didn't come from there... at least I don't think so."

# game/scenario/12_0_1_1.rpy:113
translate english 943e9ad3:

    # "Je passe la main sur le bord de l'écran."
    "I run my hand along the edge of the screen."

# game/scenario/12_0_1_1.rpy:114
translate english 1861fda2:

    # "Il est éteint et froid. Rien n'indique que Kami l'ait activé pendant la nuit."
    "It's off and cold. Nothing says Kami switched it on during the night."

# game/scenario/12_0_1_1.rpy:116
translate english 94e70058:

    # think "Pour une fois, ce silence ne vient pas d'elle."
    think "For once, this silence isn't coming from her."

# game/scenario/12_0_1_1.rpy:164
translate english 0b70bd9c:

    # "J'entrouvre la porte de la salle de bain et vérifie chaque recoin."
    "I ease the bathroom door open and check every corner."

# game/scenario/12_0_1_1.rpy:165
translate english 7ea80506:

    # "La pièce est vide. Le miroir ne me renvoie que mon propre visage épuisé."
    "The room is empty. The mirror only gives me back my own exhausted face."

# game/scenario/12_0_1_1.rpy:167
translate english 66ce75f0:

    # think "Personne ici non plus."
    think "Nobody here either."

# game/scenario/12_0_1_1.rpy:174
translate english 741145e7:

    # "Je vérifie le brouilleur et son boîtier."
    "I check the jammer and its casing."

# game/scenario/12_0_1_1.rpy:175
translate english 0be23518:

    # "Aucune vis ne dépasse, aucun câble ne semble avoir été déplacé."
    "Not a screw out of place, not a single cable that looks like it's been moved."

# game/scenario/12_0_1_1.rpy:177
translate english bb495728:

    # think "S'il y avait quelqu'un ici, le brouilleur ne l'a pas empêché d'entrer."
    think "If someone was in here, the jammer sure didn't keep them out."

# game/scenario/12_0_1_1.rpy:184
translate english fd8632ab:

    # "Mon regard s'arrête sur le dessin de Juliette."
    "My eyes land on Juliette's drawing."

# game/scenario/12_0_1_1.rpy:185
translate english a9cbf665:

    # "Je vérifie ses bords, puis l'espace derrière. Rien. Il paraît intact."
    "I check the edges, then the space behind it. Nothing. It looks untouched."

# game/scenario/12_0_1_1.rpy:187
translate english 56c56960:

    # think "Au moins, personne n'y a touché."
    think "At least nobody went near that."

# game/scenario/12_0_1_1.rpy:194
translate english 6686cd81:

    # "Je réveille la tablette et parcours rapidement les dernières activités."
    "I wake the tablet and scroll quickly through the latest activity."

# game/scenario/12_0_1_1.rpy:195
translate english 621d8a65:

    # "Aucun accès récent. Aucun message. Rien qui explique le bruit."
    "No recent access. No messages. Nothing that explains the noise."

# game/scenario/12_0_1_1.rpy:197
translate english 33c68825:

    # think "Même les traces numériques sont muettes."
    think "Even the digital trail has nothing to say."

# game/scenario/12_0_1_1.rpy:377
translate english 0b3e09e9:

    # think "Qu'est-ce que c'était que ce bruit ?"
    think "What the hell was that noise?"

# game/scenario/12_0_1_1.rpy:443
translate english b6b16139:

    # "Je m’approche de la petite pharmacie et regarde ce qu'il y a de disponible."
    "I head over to the little medicine cabinet and see what's in there."

# game/scenario/12_0_1_1.rpy:608
translate english d78599fe:

    # "Tout le monde parle. Moi, je n'arrive plus à suivre ce qui se dit."
    "Everyone's talking at once. I can't keep up with what's being said anymore."

# game/scenario/12_0_1_1.rpy:668
translate english d5d520be:

    # kael "Si on autorise les brouilleurs, peut-être que je ne saurai jamais qui m'a volé la photo de ma sœur."
    kael "If we allow jammers, maybe I'll never find out who stole my sister's photo."

# game/scenario/12_0_1_1.rpy:679
translate english 02c265f4:

    # think "Même ceux qui étaient hésitants hier ont l'air plus convaincus."
    think "Even the ones who were on the fence yesterday look more convinced now."

# game/scenario/12_0_1_1.rpy:705
translate english 780802b9:

    # noam determine "Mais les brouilleurs ne protègent pas seulement notre intimité. Ils nous protègent aussi de ceux qui veulent profiter de cette intimité."
    noam determine "But jammers don't just protect our privacy. They also protect us from the people who'd take advantage of it."

# game/scenario/12_0_1_1.rpy:754
translate english 66b28ca2:

    # tomas "Très bien… Il faut qu'on arrête de tourner autour du pot."
    tomas "All right... we need to stop dancing around it."

# game/scenario/12_0_1_1.rpy:766
translate english 44bd0dac:

    # elias reflechit "Même si je comprends aussi l'intérêt des caméras."
    elias reflechit "Even if I do see the point of the cameras."

# game/scenario/12_0_1_1.rpy:790
translate english 77f32e22:

    # mara "Qu'est-ce que je risque hein ?! A part qu'un bel homme ait envie de se glisser dans ma chambre ?"
    mara "What have I got to lose, huh?! Other than some handsome guy wanting to sneak into my room?"

# game/scenario/12_0_1_1.rpy:800
translate english a18eb35d:

    # julian taquin "Allez, Noam ! T’es team liberté hein ?! Me dis pas que tu veux qu'on continue à se faire espionner ?!"
    julian taquin "Come on, Noam! You're team freedom, right?! Don't tell me you want us to keep getting spied on?!"

# game/scenario/12_0_1_1.rpy:811
translate english 7ae87f32:

    # noam desaccord "On vote pour notre obéissance totale à ses règles, même quand elles sont absurdes."
    noam desaccord "We're voting to obey her rules completely, even when they're absurd."

# game/scenario/12_0_1_1.rpy:816
translate english b1a9c1e6:

    # noam "Je veux juste qu’on garde un endroit où on peut juste être soi-même."
    noam "I just want us to keep one place where we can simply be ourselves."

