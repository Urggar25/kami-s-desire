    # "Le silence qui suit est assourdissant."
    "The silence that follows is deafening."

# game/scenario/12_0_1_1.rpy:1008
translate english 359bb9fe:

    # iris inquiet "Noam… regarde-moi."
    iris inquiet "Noam... look at me."

