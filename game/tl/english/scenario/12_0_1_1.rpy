    # "Je reste immobile plusieurs secondes, les yeux grands ouverts dans le noir."
    "I lie still for several seconds, eyes wide open in the darkness."

# game/scenario/12_0_1_1.rpy:19
translate english 78362fd4:

    # "Seul le bourdonnement lointain des ventilations du Conclave me répond."
    "Only the distant hum of the Conclave's ventilation answers me."

# game/scenario/12_0_1_1.rpy:21
translate english 07b57a46:

    # noam faible "... Il y a quelqu’un ?"
    noam faible "...Is someone there?"

# game/scenario/12_0_1_1.rpy:23
translate english 1b2a2a40_2:

    # "Aucune réponse."
    "No answer."

# game/scenario/12_0_1_1.rpy:25
translate english c85a2401:

    # "Je me redresse lentement, la tête lourde et la gorge sèche."
    "I slowly sit up, my head heavy and my throat dry."

# game/scenario/12_0_1_1.rpy:27
translate english c50d247e:

    # think "Ce n’était pas un rêve… J’en suis presque sûr."
    think "That wasn't a dream... I'm almost sure of it."

# game/scenario/12_0_1_1.rpy:29
translate english c78c78d7:

    # think "Je me suis déjà réveillé en sursaut avant."
    think "I've woken with a start before."

# game/scenario/12_0_1_1.rpy:30
translate english 13e76312:

    # think "Mais jamais comme ça."
    think "But never like this."

# game/scenario/12_0_1_1.rpy:31
translate english a9fce683:

    # think "J'ai vraiment entendu quelque chose de bizarre."
    think "I definitely heard something strange."

# game/scenario/12_0_1_1.rpy:32
translate english 4e135bf8:

    # think "Ou quelqu'un."
    think "Or someone."

# game/scenario/12_0_1_1.rpy:33
translate english 4487acd4:

    # "Je tends la main vers l’interrupteur. La lumière froide de la chambre m’aveugle un instant."
    "I reach for the light switch. The room's cold light blinds me for a moment."

# game/scenario/12_0_1_1.rpy:37
translate english 7c069321:

    # "La pièce est vide."
    "The room is empty."

# game/scenario/12_0_1_1.rpy:38
translate english 7b5760de:

    # "La porte est fermée. Rien ne semble déplacé."
    "The door is shut. Nothing looks out of place."

# game/scenario/12_0_1_1.rpy:40
translate english 7d95f500:

    # think "Alors pourquoi j'ai l'impression qu'on m'observe encore ?"
    think "Then why do I still feel like someone's watching me?"

# game/scenario/12_0_1_1.rpy:42
translate english a965a24d:

    # "Je reste immobile."
    "I don't move."

# game/scenario/12_0_1_1.rpy:43
translate english ce06fd62:

    # "À écouter."
    "Just listen."

# game/scenario/12_0_1_1.rpy:44
translate english 7790d616:

    # "À attendre un second bruit."
    "Waiting for another sound."

# game/scenario/12_0_1_1.rpy:45
translate english 54a78c7b:

    # "Quelque chose."
    "Anything."

# game/scenario/12_0_1_1.rpy:46
translate english f63c6fae:

    # "Rien ne vient."
    "Nothing comes."

# game/scenario/12_0_1_1.rpy:47
translate english 66e6ef8d:

    # "Pourtant, je ne peux pas me calmer."
    "And yet I can't calm down."

# game/scenario/12_0_1_1.rpy:49
translate english 237f1768:

    # think "Je deviens parano… Il faut que j’arrête."
    think "I'm getting paranoid... I need to stop."

# game/scenario/12_0_1_1.rpy:50
translate english 57841db9:

    # think "… Mais si ce n’était pas de la parano ?"
    think "...But what if I'm not being paranoid?"

# game/scenario/12_0_1_1.rpy:52
translate english dc5cbd35:

    # "Sans vraiment réfléchir, je me lève et commence à fouiller la chambre."
    "Without really thinking, I get up and start searching the room."

# game/scenario/12_0_1_1.rpy:114
translate english 0f471525:

    # "Je m’agenouille devant le lit."
    "I kneel beside the bed."

# game/scenario/12_0_1_1.rpy:115
translate english 0cc0ba64:

    # "Mon cœur bat plus vite que nécessaire."
    "My heart is racing for no good reason."

# game/scenario/12_0_1_1.rpy:117
translate english f6b5c18c:

    # think "Personne ne peut être là."
    think "There's no way anyone could be here."

# game/scenario/12_0_1_1.rpy:119
translate english c8fdbfd5:

    # "Je soulève lentement la couverture."
    "I slowly lift the blanket."

# game/scenario/12_0_1_1.rpy:120
translate english 66c763db:

    # "Pendant une seconde, je redoute réellement ce que je pourrais trouver."
    "For a second, I'm genuinely afraid of what I might find."

# game/scenario/12_0_1_1.rpy:121
translate english 7c67e960:

    # "Je passe une main dessous."
    "I reach underneath."

# game/scenario/12_0_1_1.rpy:122
translate english 0713de2d:

    # "Puis la tête."
    "Then stick my head under."

# game/scenario/12_0_1_1.rpy:123
translate english c09788b4_4:

    # "Rien."
    "Nothing."

# game/scenario/12_0_1_1.rpy:124
translate english 5c694523:

    # "Seulement de la poussière."
    "Just dust."

# game/scenario/12_0_1_1.rpy:125
translate english 17d1c99c:

    # "Le vide."
    "Empty space."

# game/scenario/12_0_1_1.rpy:129
translate english a1e61a80:

    # "Je reste quand même quelques secondes à regarder."
    "I keep staring anyway."

# game/scenario/12_0_1_1.rpy:131
translate english 9f7ca568:

    # think "J'ai vraiment cru qu'il y aurait quelque chose."
    think "I really thought something would be there."

# game/scenario/12_0_1_1.rpy:152
translate english cb8c57e9:

    # "J’ouvre le placard d’un coup sec, le cœur battant."
    "I yank the wardrobe open, my heart pounding."

# game/scenario/12_0_1_1.rpy:154
translate english 5ac0ac32:

    # "Mes vêtements sont là, bien rangés."
    "My clothes are there, neatly folded."

# game/scenario/12_0_1_1.rpy:155
translate english b18a33ae:

    # "Mais sur l’étagère du haut… quelque chose attire mon regard."
    "But something on the top shelf catches my eye..."

# game/scenario/12_0_1_1.rpy:157
translate english cc70af14:

    # "Un de mes sweats est légèrement de travers."
    "One of my hoodies is slightly out of place."

# game/scenario/12_0_1_1.rpy:158
translate english a84ebf7d:

    # "Et surtout… il y a une légère empreinte de main sur la poussière de l’étagère."
    "And worse... there's a faint handprint in the dust on the shelf."

# game/scenario/12_0_1_1.rpy:159
translate english 17ee101c:

    # "Je tends la main vers elle."
    "I reach toward it."

# game/scenario/12_0_1_1.rpy:160
translate english 032a104f:

    # "Sans la toucher."
    "Without touching it."

# game/scenario/12_0_1_1.rpy:161
translate english b93dd6ea:

    # "Juste assez près pour comparer."
    "Just close enough to compare."

# game/scenario/12_0_1_1.rpy:163
translate english c5afd502:

    # think "... Ce n’est pas moi qui ai touché là-haut."
    think "...I wasn't the one who touched that shelf."

# game/scenario/12_0_1_1.rpy:165
translate english fd6fe629:

    # "Mon ventre se noue."
    "My stomach knots."

# game/scenario/12_0_1_1.rpy:167
translate english d1af98c2_1:

    # think "Non."
    think "No."

# game/scenario/12_0_1_1.rpy:168
translate english 29a0f60f:

    # think "Je ne peux pas être certain."
    think "I can't be sure."

# game/scenario/12_0_1_1.rpy:169
translate english 034a3258:

    # think "Je me change régulièrement j'ai peut-être bougé ça accidentellement."
    think "I change clothes all the time. Maybe I knocked it out of place without noticing."

# game/scenario/12_0_1_1.rpy:170
translate english 96c855bd:

    # think "Je ne sais même plus."
    think "I don't even remember anymore."

# game/scenario/12_0_1_1.rpy:179
translate english 1c76560a:

    # "Je m’approche du bureau et regarde rapidement les affaires."
    "I go over to the desk and quickly check my things."

# game/scenario/12_0_1_1.rpy:181
translate english 95021a8a:

    # "Tout semble à sa place… sauf mon badge."
    "Everything looks normal... except my badge."

# game/scenario/12_0_1_1.rpy:182
translate english a50a807b:

    # "Il est retourné, face cachée."
    "It's been turned face down."

# game/scenario/12_0_1_1.rpy:184
translate english d0d5c135:

    # think "Je ne me souviens pas l’avoir laissé comme ça."
    think "I don't remember leaving it like that."

# game/scenario/12_0_1_1.rpy:185
translate english 8a5a410f:

    # think "Ça ne veut rien dire."
    think "It doesn't mean anything."

# game/scenario/12_0_1_1.rpy:186
translate english dc987896:

    # think "Un badge retourné."
    think "A badge turned over."

# game/scenario/12_0_1_1.rpy:187
translate english e1a96545:

    # think "C'est ridicule."
    think "This is ridiculous."

# game/scenario/12_0_1_1.rpy:188
translate english e868b64b:

    # think "Alors pourquoi j'ai l'impression que quelque chose ne va pas ?"
    think "Then why can't I shake the feeling something's wrong?"

# game/scenario/12_0_1_1.rpy:232
translate english 18b00e66:

    # "Mon regard s'arrête sur l'emplacement vide du cadre."
    "My eyes settle on the empty space where the frame used to be."

# game/scenario/12_0_1_1.rpy:233
translate english bfd6db0b:

    # think "Le dessin de Juliette n'est toujours pas revenu. Rien n'a bougé autour."
    think "Juliette's drawing still hasn't turned up. Nothing else around it has moved."

# game/scenario/12_0_1_1.rpy:240
translate english f1898b1d:

    # think "Pas encore. Je dois vérifier au moins quelques endroits avant de me recoucher."
    think "Not yet. I need to check at least a few places before I go back to bed."

# game/scenario/12_0_1_1.rpy:244
translate english b326b9f8:

    # "Je reste un moment debout au milieu de la chambre, puis je soupire."
    "I stand in the middle of the room for a while, then sigh."

# game/scenario/12_0_1_1.rpy:246
translate english a78fd186:

    # think "Je deviens complètement dingue…"
    think "I'm completely losing it..."

# game/scenario/12_0_1_1.rpy:247
translate english 10edfd52:

    # think "Il faut que je dorme."
    think "I need to sleep."

# game/scenario/12_0_1_1.rpy:249
translate english ab41a578:

    # "Je me recouche, mais le sommeil met longtemps à revenir."
    "I get back into bed, but it takes ages to fall asleep again."

# game/scenario/12_0_1_1.rpy:260
translate english 0524d446:

    # "Impossible de me rendormir."
    "There's no way I'm getting back to sleep."

# game/scenario/12_0_1_1.rpy:261
translate english 3e791925:

    # "Chaque fois que je ferme les yeux, j’entends ce bruit… ou je crois l’entendre."
    "Every time I close my eyes, I hear that noise... or think I do."

# game/scenario/12_0_1_1.rpy:263
translate english 0c2a656e:

    # think "Il est encore tôt… à peine 6h30."
    think "It's still early... barely six thirty."

# game/scenario/12_0_1_1.rpy:264
translate english e4beb27e:

    # think "Si je reste ici, je vais devenir fou."
    think "If I stay here, I'm going to lose my mind."

# game/scenario/12_0_1_1.rpy:266
translate english 84f2f6fd:

    # "Je me lève, enfile un sweat à la hâte et sors de ma chambre sans faire de bruit."
    "I get up, throw on a hoodie, and slip out of my room."

# game/scenario/12_0_1_1.rpy:271
translate english 0b6f5503:

    # "Les couloirs sont encore déserts. Parfait."
    "The corridors are still deserted. Perfect."

# game/scenario/12_0_1_1.rpy:273
translate english 2ee0d7af:

    # think "Je ne veux voir personne. Pas maintenant."
    think "I don't want to see anyone. Not now."

# game/scenario/12_0_1_1.rpy:282
translate english e92265d9:

    # "La cafétéria est vide et silencieuse. Seule la lumière froide des néons automatiques est allumée."
    "The cafeteria is empty and silent, lit only by the cold glow of the automatic overhead lights."

# game/scenario/12_0_1_1.rpy:283
translate english 031162f8:

    # "Derrière le comptoir, Goumi est déjà en activité, ses bras mécaniques s’affairant avec précision."
    "Behind the counter, Goumi is already at work, its mechanical arms moving with practiced precision."

# game/scenario/12_0_1_1.rpy:289
translate english 3ef483f8:

    # goumi "Bonjour, Noam. Tu es bien matinal aujourd’hui."
    goumi "Good morning, Noam. You're up early today."

# game/scenario/12_0_1_1.rpy:291
translate english f252e488:

    # noam fatigue "Ouais… je n’arrivais plus à dormir."
    noam fatigue "Yeah... I couldn't get back to sleep."

# game/scenario/12_0_1_1.rpy:293
translate english f2d9e6e2:

    # goumi "Je comprends. Veux-tu que je te prépare quelque chose pour te rebooster ?"
    goumi "I see. Would you like me to make you something to perk you up?"

# game/scenario/12_0_1_1.rpy:295
translate english 920fb5bb:

    # noam "Ce que tu peux. Rien de trop lourd."
    noam "Whatever you can manage. Nothing too heavy."

# game/scenario/12_0_1_1.rpy:297
translate english bcc9418d:

    # goumi "Bien reçu. Je te propose des œufs brouillés, du pain grillé et un yaourt nature. Par contre…"
    goumi "Understood. How about scrambled eggs, toast, and plain yogurt? Although..."

# game/scenario/12_0_1_1.rpy:299
translate english b4d3a29f:

    # "Le robot marque une petite pause, comme s’il consultait ses stocks."
    "The robot pauses, as if checking its inventory."

# game/scenario/12_0_1_1.rpy:301
translate english f26d7fb5:

    # goumi "Je ne pourrai pas te faire de grosse portion aujourd’hui. Les réserves de nourriture sont plus faibles que prévu. Nous sommes en mode rationnement léger."
    goumi "I can't offer you a large portion today. Food supplies are lower than expected. We're on light rations."

# game/scenario/12_0_1_1.rpy:303
translate english 8efea915:

    # noam hesitation "Comment ça, plus faibles que prévu ?"
    noam hesitation "What do you mean, lower than expected?"

# game/scenario/12_0_1_1.rpy:305
translate english abe5d467:

    # goumi "Les calculs de consommation ont été dépassés ces derniers jours."
    goumi "Consumption has exceeded our estimates over the past few days."

# game/scenario/12_0_1_1.rpy:306
translate english e6be66ad:

    # goumi "Pourtant nos prédictions sont souvent fiables."
    goumi "And our forecasts are usually reliable."

# game/scenario/12_0_1_1.rpy:308
translate english b32060a1:

    # think "Évidemment…"
    think "Of course..."

# game/scenario/12_0_1_1.rpy:310
translate english ea8b540e:

    # noam "Je vois…"
    noam "I see..."

# game/scenario/12_0_1_1.rpy:312
translate english 26f590be:

    # goumi "Je peux quand même te préparer un repas correct. Tu veux quand même les œufs ?"
    goumi "I can still make you a decent meal. Want the eggs?"

# game/scenario/12_0_1_1.rpy:314
translate english faadee89:

    # noam "Oui… vas-y."
    noam "Yeah... go ahead."

# game/scenario/12_0_1_1.rpy:316
translate english c6fba4ff:

    # "Je m’assois à une table près de la fenêtre, le regard perdu dans le vide."
    "I sit at a table by the window, staring into space."

# game/scenario/12_0_1_1.rpy:318
translate english 24ca8c1a:

    # think "Même la bouffe commence à manquer… Super."
    think "Great. Now we're running out of food, too..."

# game/scenario/12_0_1_1.rpy:322
translate english ee83e137:

    # "Quelques minutes plus tard, j’entends des pas légers et rapides."
    "A few minutes later, I hear quick, light footsteps."

# game/scenario/12_0_1_1.rpy:332
translate english 1d6a433a:

    # elen content "Noooam ! T’es déjà là ?! T’es un lève-tôt maintenant ?!"
    elen content "Noaaam! You're here already?! Since when are you an early bird?!"

# game/scenario/12_0_1_1.rpy:333
translate english c5baf570:

    # elen "Depuis quand ??"
    elen "Since WHEN?!"

# game/scenario/12_0_1_1.rpy:335
translate english a206b750:

    # "Elen arrive avec son énergie habituelle, un grand sourire aux lèvres."
    "Elen appears with her usual boundless energy, a huge smile on her face."

# game/scenario/12_0_1_1.rpy:337
translate english c238a4cf:

    # think "Toujours la même."
    think "Same old Elen."

# game/scenario/12_0_1_1.rpy:338
translate english d7da2a01:

    # think "Toujours incapable de rester silencieuse plus de trente secondes."
    think "Still physically incapable of staying quiet for more than thirty seconds."

# game/scenario/12_0_1_1.rpy:340
translate english 1ad642c3:

    # "Étrangement..."
    "Strangely enough..."

# game/scenario/12_0_1_1.rpy:342
translate english 378b235e:

    # think "Ça me rassure un peu."
    think "It's actually a little comforting."

# game/scenario/12_0_1_1.rpy:344
translate english ee37a9e3:

    # noam fatigue "… Salut Elen."
    noam fatigue "...Morning, Elen."

# game/scenario/12_0_1_1.rpy:347
translate english 8e0855e8:

    # elen "T’as pas l’air en super forme dis donc. Encore fatigué de ton malaise de l'autre jour ?"
    elen "You look pretty rough! Still worn out from that fainting spell the other day?"

# game/scenario/12_0_1_1.rpy:348
translate english 331497b2:

    # elen content "En même temps c'est pas étonnant, je te vois jamais venir manger !"
    elen content "Not that I'm surprised! I never see you come down to eat!"

# game/scenario/12_0_1_1.rpy:349
translate english 63bf8105:

    # elen rire "Tu sais c'est important hein ?!"
    elen rire "You know eating's important, right?!"

# game/scenario/12_0_1_1.rpy:351
translate english 04c539e1:

    # noam "Ouais… un peu."
    noam "Yeah... a bit."

# game/scenario/12_0_1_1.rpy:353
translate english 5f7045a6:

    # elen joie "Crois moi, la cafétéria c’est le meilleur remède ! Goumi, tu me fais la même chose que d’habitude ? Avec double portion de pain s’il te plaît !"
    elen joie "Trust me, the cafeteria is the best medicine! Goumi, the usual for me? With extra bread, please!"

# game/scenario/12_0_1_1.rpy:355
translate english 5eb60265:

    # goumi "Elen… je viens justement d’expliquer à Noam que les réserves sont plus basses que prévu. Je ne peux pas faire de double portion aujourd’hui."
    goumi "Elen... I was just explaining to Noam that our supplies are lower than expected. I can't give you a double portion today."

# game/scenario/12_0_1_1.rpy:358
translate english 903be337:

    # elen "Hein ?! Sérieux ?!"
    elen "What?! Seriously?!"

# game/scenario/12_0_1_1.rpy:359
translate english c7d639bb:

    # elen colere "Mais tu m'as déjà dit ça hier soir !"
    elen colere "But you told me that last night!"

# game/scenario/12_0_1_1.rpy:361
translate english 89c12dd7:

    # goumi "Et les stocks n'ont pas changé depuis... Enfin si, ils ont encore diminué."
    goumi "And the stock levels haven't changed since... Actually, they have. They've gone down again."

# game/scenario/12_0_1_1.rpy:362
translate english 8c6a5c2a:

    # goumi "On ne sera pas livré avant le quatorzième jour."
    goumi "We won't get another delivery until Day 14."

# game/scenario/12_0_1_1.rpy:364
translate english 0bbdd9d9:

    # "Elle se tourne vers moi, les yeux écarquillés."
    "She turns to me, eyes wide."

# game/scenario/12_0_1_1.rpy:366
translate english 2b3aa38e:

    # elen decu "Oh non… C’est à cause de moi, c’est ça ?"
    elen decu "Oh no... It's because of me, isn't it?"

# game/scenario/12_0_1_1.rpy:368
translate english b413315c:

    # "Elle croise mon regard vide un moment."
    "She meets my vacant stare for a moment."

# game/scenario/12_0_1_1.rpy:370
translate english 1919b837:

    # elen decu "Sérieux ?! Je mange trop ?!"
    elen decu "Seriously?! Am I eating too much?!"

# game/scenario/12_0_1_1.rpy:372
translate english 765391ea:

    # noam hesitation "…"
    noam hesitation "..."

# game/scenario/12_0_1_1.rpy:374
translate english c312c1bf:

    # elen fatigue "Je suis désoléeééé ! Je sais que je mange beaucoup trop ! Mais la nourriture c’est vraiment mon péché mignon ici !"
    elen fatigue "I'm sooooo sorry! I know I eat way too much! But food is my one guilty pleasure around here!"

# game/scenario/12_0_1_1.rpy:375
translate english 0f71f48a:

    # elen taquin "Avec tout ce stress, j’ai besoin de réconfort, tu comprends ?!"
    elen taquin "With all this stress, I need a little comfort food, you know?!"

# game/scenario/12_0_1_1.rpy:377
translate english 6a5951c0:

    # noam "Ouais… je comprends."
    noam "Yeah... I get it."

# game/scenario/12_0_1_1.rpy:379
translate english c07b8fdb:

    # elen determine "Goumi, tu peux me faire une portion normale alors ? Je vais me retenir, promis ! Croix de bois, croix de fer !"
    elen determine "Goumi, could you make that a regular portion, then? I'll behave, I promise! Cross my heart!"

# game/scenario/12_0_1_1.rpy:381
translate english c2e9d9e9:

    # goumi "Bien reçu. Une portion normale pour Elen."
    goumi "Understood. One regular portion for Elen."

# game/scenario/12_0_1_1.rpy:383
translate english f846fef2:

    # "Elen s’assoit en face de moi sans me demander mon avis, toujours avec son sourire éclatant."
    "Elen sits down opposite me without asking, still wearing that dazzling smile."

# game/scenario/12_0_1_1.rpy:385
translate english a5c646a1:

    # elen surpris "Du coup, t’as pas réussi à te rendormir ? T’as fait un cauchemar ou quoi ?"
    elen surpris "So... you couldn't get back to sleep? Bad dream or something?"

# game/scenario/12_0_1_1.rpy:387
translate english 928b36be:

    # think "Si seulement c’était juste un cauchemar…"
    think "If only this were a nightmare..."

# game/scenario/12_0_1_1.rpy:388
translate english 29ae6fa5:

    # think "Un cauchemar s'arrête quand on ouvre les yeux."
    think "Nightmares end when you open your eyes."

# game/scenario/12_0_1_1.rpy:389
translate english 6a7ba6f7:

    # think "Là j'ai l'impression que c'est pire quand je suis réveillé."
    think "This somehow feels worse when I'm awake."

# game/scenario/12_0_1_1.rpy:391
translate english 98fadee7:

    # noam triste "Quelque chose comme ça."
    noam triste "Something like that."

# game/scenario/12_0_1_1.rpy:393
translate english 1408b527:

    # elen reflexion "Raconte ! Je suis super bonne pour écouter les cauchemars ! Une fois j’ai rêvé que Kami nous transformait tous en cupcakes et qu’elle nous mangeait un par un. C'était horrible !"
    elen reflexion "Tell me! I'm great at listening to nightmares! Once I dreamed Kami turned us all into cupcakes and ate us one by one. It was horrible!"

# game/scenario/12_0_1_1.rpy:394
translate english da9ee8df:

    # elen rire "Je me suis réveillée avec une de ces faim, tu n'imagines même pas !"
    elen rire "I woke up STARVING! You have no idea!"

# game/scenario/12_0_1_1.rpy:396
translate english 92261fc0:

    # noam surpris "Hein ?! Me dis pas que tu voulais nous bouffer ?!"
    noam surpris "What?! Don't tell me you wanted to eat us!"

# game/scenario/12_0_1_1.rpy:397
translate english a844a32d:

    # noam taquin "… Si seulement j'avais fais un rêve comme ça."
    noam taquin "...If only I'd had a dream like that."

# game/scenario/12_0_1_1.rpy:399
translate english 9fdf8f13:

    # elen rire "Tu m'étonnes ! Et ouais, on avait tous l'air trop trop bons !"
    elen rire "Right?! And yeah, we all looked so, so delicious!"

# game/scenario/12_0_1_1.rpy:400
translate english a2a495f3:

    # elen taquin "Allez, dis-moi ! T’as rêvé de quoi ? Du vote d’aujourd’hui ? D’un truc bizarre ?"
    elen taquin "Come on, tell me! What did you dream about? Today's vote? Something weird?"

# game/scenario/12_0_1_1.rpy:402
translate english d123b0e3:

    # noam colere "Elen."
    noam colere "Elen."

# game/scenario/12_0_1_1.rpy:404
translate english 04a28fec:

    # elen reflexion "Quoi ?"
    elen reflexion "What?"

# game/scenario/12_0_1_1.rpy:406
translate english 7f5723bf:

    # noam colere "Je n’ai pas trop envie de parler ce matin."
    noam colere "I really don't feel like talking this morning."

# game/scenario/12_0_1_1.rpy:408
translate english 6eb71c70:

    # elen triste "Oh… d’accord."
    elen triste "Oh... okay."

# game/scenario/12_0_1_1.rpy:410
translate english 107e1125:

    # "Elle reste silencieuse deux secondes… avant de repartir de plus belle."
    "She manages to stay quiet for two seconds... before starting up again."

# game/scenario/12_0_1_1.rpy:412
translate english 661ec727:

    # elen determine "Mais tu sais, si tu changes d’avis, je suis là hein ! Je peux même te raconter mes blagues nulles pour te changer les idées !"
    elen determine "But if you change your mind, I'm right here! I can even tell you some of my terrible jokes to cheer you up!"

# game/scenario/12_0_1_1.rpy:414
translate english c5b53c36:

    # think "Elle ne s’arrête donc jamais…"
    think "Does she ever stop?"

# game/scenario/12_0_1_1.rpy:416
translate english da70f0d7:

    # noam "Elen… s’il te plaît."
    noam "Elen... please."

# game/scenario/12_0_1_1.rpy:418
translate english d3e4a306:

    # elen "Okay okay, je me tais !"
    elen "Okay, okay! I'll shut up!"

# game/scenario/12_0_1_1.rpy:420
translate english a67829e3:

    # "Je termine de manger en silence. L'heure tourne doucement."
    "I finish eating in silence. Time slowly slips by."

# game/scenario/12_0_1_1.rpy:423
translate english 939357fe:

    # think "Le fruit de mon imagination ...?"
    think "My imagination playing tricks on me...?"

# game/scenario/12_0_1_1.rpy:425
translate english d1382389:

    # "Je termine mon assiette en silence. Elen finit par comprendre que je ne suis pas d’humeur et part rejoindre d’autres personnes après m’avoir fait un petit signe de la main."
    "I finish my food in silence. Elen eventually gets the message that I'm not in the mood and goes to join the others, giving me a little wave."

# game/scenario/12_0_1_1.rpy:430
translate english eb5a00ac:

    # think "Enfin seul."
    think "Finally. Alone."

# game/scenario/12_0_1_1.rpy:432
translate english 1a081a8c:

    # "Je reste encore quelques minutes à fixer mon plateau vide, puis je me lève."
    "I stare at my empty tray for a few more minutes before getting up."

# game/scenario/12_0_1_1.rpy:437
translate english b904ff6c:

    # "À peine sorti de la cafétéria, la voix de Kami résonne soudain dans tout le Conclave."
    "The moment I leave the cafeteria, Kami's voice suddenly echoes through the Conclave."

# game/scenario/12_0_1_1.rpy:446
translate english fc38ed2a:

    # kami "Bonjour à tous mes petits disciples chéris~"
    kami "Good morning, my darling little disciples~"

# game/scenario/12_0_1_1.rpy:447
translate english b8a193ba:

    # kami "J’espère que vous avez bien dormi… ou du moins, que certains d’entre vous ont essayé."
    kami "Hope you slept well... or at least that some of you gave it a try."

# game/scenario/12_0_1_1.rpy:450
translate english d5bbdef1:

    # kami "Petite annonce du jour : le vote sur l’autorisation ou l’interdiction des dispositifs de brouillage aura lieu aujourd’hui à 14h précises."
    kami "Today's little announcement: the vote on whether to allow or ban jamming devices will take place at precisely two p.m."

# game/scenario/12_0_1_1.rpy:452
translate english 0b17987d:

    # kami "Je vous conseille vivement d’être présents et en pleine possession de vos moyens."
    kami "I strongly recommend showing up, preferably with all your faculties intact."

# game/scenario/12_0_1_1.rpy:453
translate english b6998850:

    # kami "Après tout… ce vote est assez important, n’est-ce pas ?"
    kami "After all... this one's rather important, isn't it?"

# game/scenario/12_0_1_1.rpy:456
translate english 5ad42102:

    # kami "N’oubliez pas : vos choix auront des conséquences. Comme toujours."
    kami "Remember: your choices have consequences. As always."

# game/scenario/12_0_1_1.rpy:457
translate english 9be4d4fb:

    # kami "Je compte sur vous pour être raisonnables… ou du moins, divertissants."
    kami "I'm counting on you to be sensible... or at least entertaining."

# game/scenario/12_0_1_1.rpy:460
translate english d87a79c5:

    # kami "Sur ce, je vous laisse. Profitez bien de votre matinée."
    kami "That's all for now! Enjoy your morning."

# game/scenario/12_0_1_1.rpy:465
translate english 6c404ca0:

    # "Le silence retombe dans les couloirs."
    "Silence returns to the corridors."

# game/scenario/12_0_1_1.rpy:469
translate english e8494e5a:

    # think "14h…"
    think "Two o'clock..."

# game/scenario/12_0_1_1.rpy:470
translate english cf87e637:

    # think "Il ne reste plus que quelques heures avant de décider si on veut vivre sous surveillance permanente ou risquer le chaos."
    think "Only a few hours left to decide whether we want to live under constant surveillance or risk chaos."

# game/scenario/12_0_1_1.rpy:472
translate english 0885283d:

    # "Je serre les poings dans les poches de mon sweat."
    "I clench my fists inside my hoodie pockets."

# game/scenario/12_0_1_1.rpy:474
translate english bac96ab2:

    # think "Je n’ai envie de parler à personne."
    think "I don't want to talk to anyone."

# game/scenario/12_0_1_1.rpy:475
translate english d3f778a4:

    # think "Ni de répondre à des questions, ni de voir leurs regards inquiets, ni d’entendre Elen essayer de me dérider."
    think "I don't want to answer questions, see their worried faces, or hear Elen trying to cheer me up."

# game/scenario/12_0_1_1.rpy:477
translate english b839e75e:

    # "Au lieu de prendre le chemin direct, je décide de faire le grand tour par les couloirs extérieurs, ceux qui longent les zones techniques."
    "Instead of taking the direct route, I make a long detour through the outer corridors along the technical areas."

# game/scenario/12_0_1_1.rpy:479
translate english 206da74e:

    # "C’est plus long. Plus vide. Exactement ce qu’il me faut."
    "It's longer. Emptier. Exactly what I need."

# game/scenario/12_0_1_1.rpy:481
translate english 1c73ced6:

    # "Alors que je passe devant l'infirmerie, je décide de m'y arrêter une minute."
    "As I pass the infirmary, I decide to stop for a minute."

# game/scenario/12_0_1_1.rpy:486
translate english 705e9c9e:

    # think "Mon mal de tête n’est toujours pas parti… Il empire même."
    think "My headache still hasn't gone away... It's actually getting worse."

# game/scenario/12_0_1_1.rpy:487
translate english 2ea72609:

    # think "Sans doute à cause de mon manque de sommeil..."
    think "Probably because I haven't been sleeping..."

# game/scenario/12_0_1_1.rpy:490
translate english d77183c1:

    # "Après quelques secondes, je prends quelques comprimés de paracétamol et je les emporte avec moi."
    "After a few seconds, I take some acetaminophen tablets and pocket them."

# game/scenario/12_0_1_1.rpy:491
translate english 0e7ea913:

    # "Je prends deux comprimés directement dans ma main et les avale à sec."
    "I put two tablets straight into my mouth and swallow them without water."

# game/scenario/12_0_1_1.rpy:493
translate english 30960899:

    # noam faible "..."
    noam faible "..."

# game/scenario/12_0_1_1.rpy:494
translate english 0f3406e4:

    # noam "C'est pas facile à avaler cette merde !"
    noam "God, those things are a bitch to swallow!"

# game/scenario/12_0_1_1.rpy:496
translate english 87ad1dff:

    # think "Ça ne soignera pas ce qui ne va vraiment pas… mais au moins, ma tête arrêtera peut-être de pulser."
    think "It won't fix what's really wrong... but maybe it'll at least stop my head from pounding."

# game/scenario/12_0_1_1.rpy:498
translate english 72e78e14:

    # "Je reste un moment devant l'armoire à pharmacie, les yeux dans le vide."
    "I stand in front of the medicine cabinet for a moment, staring blankly."

# game/scenario/12_0_1_1.rpy:500
translate english 38ebc5ba:

    # think "Tout le monde va vouloir discuter du vote."
    think "Everyone's going to want to talk about the vote."

# game/scenario/12_0_1_1.rpy:501
translate english d776cc4e:

    # think "Et moi je vais devoir faire semblant d’être normal."
    think "And I'll have to pretend I'm fine."

# game/scenario/12_0_1_1.rpy:502
translate english a3621ab6:

    # think "Faire semblant de ne pas me demander si l’un d’entre eux est celui qui m’a regardé dans les yeux hier soir… avant d’effacer les preuves."
    think "Pretend I'm not wondering whether one of them looked me in the eye last night... then deleted the evidence."

# game/scenario/12_0_1_1.rpy:504
translate english f212402f:

    # "Je secoue la tête et reprends ma route, le pas lourd."
    "I shake my head and keep walking, my steps heavy."

# game/scenario/12_0_1_1.rpy:509
translate english e5b5e9d7:

    # "Je referme la porte de ma chambre derrière moi et m’adosse contre elle un long moment."
    "I close my bedroom door and lean against it for a long moment."

# game/scenario/12_0_1_1.rpy:511
translate english 93644339:

    # think "Je vais juste attendre ici jusqu’à 14h."
    think "I'll just wait here until two."

# game/scenario/12_0_1_1.rpy:512
translate english 7be799e9:

    # think "Loin de tout le monde."
    think "Away from everyone."

# game/scenario/12_0_1_1.rpy:514
translate english e156d2a6:

    # "Je m’allonge sur le lit sans enlever mes chaussures, les yeux rivés au plafond."
    "I lie on the bed without taking off my shoes, staring at the ceiling."

# game/scenario/12_0_1_1.rpy:516
translate english 9d498344:

    # think "Plus que quelques heures avant le vote."
    think "Just a few hours until the vote."

# game/scenario/12_0_1_1.rpy:517
translate english 6f1717d6:

    # think "Et je ne sais même plus ce que je dois choisir…"
    think "And I don't even know what I should choose anymore..."

# game/scenario/12_0_1_1.rpy:518
translate english 18977000:

    # think "Ni en qui je peux avoir confiance."
    think "Or who I can trust."

# game/scenario/12_0_1_1.rpy:544
translate english 87e51b93:

    # "J'arrive dans la salle du Conclave alors que les derniers représentants prennent place."
    "I reach the Conclave chamber as the last representatives take their seats."

# game/scenario/12_0_1_1.rpy:545
translate english e80d4763:

    # think "14h… Le moment est venu."
    think "Two o'clock... Here we go."

# game/scenario/12_0_1_1.rpy:547
translate english 20f53123:

    # "Les haut-parleurs crachent soudain la voix de Kami."
    "Kami's voice suddenly crackles through the speakers."

# game/scenario/12_0_1_1.rpy:554
translate english 4ef58dc5:

    # kami "Mes chers représentants, votre attention s’il vous plaît."
    kami "My dear representatives, may I have your attention, please?"

# game/scenario/12_0_1_1.rpy:555
translate english 6cc20c6f:

    # kami "Le débat sur l’autorisation ou l’interdiction des dispositifs de brouillage va débuter dans quelques minutes."
    kami "The debate on permitting or banning jamming devices will begin in a few minutes."

# game/scenario/12_0_1_1.rpy:556
translate english 93b9e764:

    # kami "Je vous attends tous dans la Salle du Conclave. Ne tardez pas~"
    kami "I'll be waiting for you all in the Conclave chamber. Don't be late~"

# game/scenario/12_0_1_1.rpy:559
translate english 52cbac71:

    # kami "Et essayez de ne pas vous entretuer avant le vote, ce serait dommage."
    kami "And do try not to kill each other before the vote. That would be such a waste."

# game/scenario/12_0_1_1.rpy:565
translate english ee1e9fd0:

    # "Presque tout le monde est déjà là. L’ambiance est lourde, électrique."
    "Almost everyone is already here. The atmosphere is tense, charged."

# game/scenario/12_0_1_1.rpy:582
translate english 78d5d64c:

    # "Je m’installe discrètement à ma place habituelle."
    "I quietly take my usual seat."

# game/scenario/12_0_1_1.rpy:584
translate english 0c86f2cd:

    # tomas "Bon… on y est."
    tomas "Well... here we are."

# game/scenario/12_0_1_1.rpy:585
translate english c1251400:

    # tomas "Je pense qu’on est tous d’accord pour dire que ce vote est crucial."
    tomas "I think we can all agree this vote is crucial."

# game/scenario/12_0_1_1.rpy:587
translate english ebc9204c:

    # mara "Évidemment qu’on autorise les brouilleurs !"
    mara "Of course we should allow jammers!"

# game/scenario/12_0_1_1.rpy:589
translate english 0aaf9c6a:

    # mara stress "J’en peux plus de savoir que Kami peut nous mater 24h/24 !"
    mara stress "I can't stand knowing Kami can watch us twenty-four seven!"

# game/scenario/12_0_1_1.rpy:591
translate english 74d952ae:

    # elen "Moi aussi ! J’ai envie de pouvoir danser dans ma chambre sans me sentir jugée !"
    elen "Me too! I want to dance in my room without feeling judged!"

# game/scenario/12_0_1_1.rpy:593
translate english fba2bc11:

    # julian taquin "Et moi j’ai envie de pouvoir dire des conneries sans que Kami les enregistre pour plus tard."
    julian taquin "And I want to be able to say dumb stuff without Kami recording it to use against me later."

# game/scenario/12_0_1_1.rpy:595
translate english a475545d:

    # iris "C’est clair… La vie privée, c’est important."
    iris "Exactly... Privacy matters."

# game/scenario/12_0_1_1.rpy:597
translate english 24b49b28:

    # "Je les écoute en silence, les bras croisés."
    "I listen in silence, arms folded."

# game/scenario/12_0_1_1.rpy:599
translate english e52d9afe:

    # think "Tout le monde est pour."
    think "Everyone's in favor."

# game/scenario/12_0_1_1.rpy:600
translate english 92c9ab15:

    # think "Même ceux qui étaient hésitants hier semblent avoir basculé."
    think "Even the ones who were undecided yesterday seem to have come around."

# game/scenario/12_0_1_1.rpy:602
translate english 3b3de528:

    # sael "Techniquement, tant qu’on respecte les Commandements, on devrait pouvoir avoir notre intimité."
    sael "Technically, as long as we're following the Commandments, we should be entitled to our privacy."

# game/scenario/12_0_1_1.rpy:604
translate english 1f1ee015:

    # kael calme "… Tant qu’on respecte les Commandements, oui."
    kael calme "...As long as we follow the Commandments, yes."

# game/scenario/12_0_1_1.rpy:606
translate english 11244820:

    # "Je serre les mâchoires."
    "I clench my jaw."

# game/scenario/12_0_1_1.rpy:608
translate english 5a56b250:

    # think "Et si on n’avait pas de brouilleurs…"
    think "But without the jammers..."

# game/scenario/12_0_1_1.rpy:609
translate english 78c3d11e:

    # think "Est-ce qu’on aurait pu savoir qui m’a volé mes affaires ?"
    think "Could we have found out who stole my things?"

# game/scenario/12_0_1_1.rpy:610
translate english ad01f05d:

    # think "Est-ce qu’on aurait pu savoir qui a volé la photo de la sœur de Kael ?"
    think "Could we have found out who took the picture of Kael's sister?"

# game/scenario/12_0_1_1.rpy:612
translate english 27496d02:

    # think "Les brouilleurs… ils protègent peut-être notre intimité…"
    think "The jammers might protect our privacy..."

# game/scenario/12_0_1_1.rpy:613
translate english c0dc422d:

    # think "… mais ils protègent surtout ceux qui veulent agir dans l’ombre."
    think "...but mostly they protect whoever wants to operate in the shadows."

# game/scenario/12_0_1_1.rpy:615
translate english e8ba10f3:

    # "Cette pensée me reste en travers de la gorge."
    "The thought sticks in my throat."

# game/scenario/12_0_1_1.rpy:617
translate english 85884d0c:

    # ryn colere "Moi je dis qu’on autorise tout ça. Point final."
    ryn colere "I say we allow them. End of story."

# game/scenario/12_0_1_1.rpy:618
translate english 96752a13:

    # ryn "J’en ai marre de vivre dans un putain de reality show."
    ryn "I'm sick of living in a goddamn reality show."

# game/scenario/12_0_1_1.rpy:620
translate english 3e6926d8:

    # nyra raison "Il faut juste faire attention aux conséquences. Si tout le monde a des brouilleurs, on ne pourra plus rien prouver."
    nyra raison "We just need to think about the consequences. If everyone has a jammer, we won't be able to prove anything."

# game/scenario/12_0_1_1.rpy:623
translate english ef907f45:

    # "Je reste muet."
    "I say nothing."

# game/scenario/12_0_1_1.rpy:625
translate english 9f4ea317:

    # think "Exactement."
    think "Exactly."

# game/scenario/12_0_1_1.rpy:626
translate english 8982963b:

    # think "Les brouilleurs permettent l’insécurité."
    think "Jammers make it easier for people to get away with things."

# game/scenario/12_0_1_1.rpy:627
translate english 176c2a78:

    # think "Ils permettent à quelqu’un de se faire passer pour moi, d’effacer des preuves, de voler… sans qu’on puisse jamais rien prouver."
    think "They let someone impersonate me, erase evidence, steal... with no way to prove any of it."

# game/scenario/12_0_1_1.rpy:629
translate english 031574e1:

    # "Iris me jette un regard en coin."
    "Iris shoots me a sideways glance."

# game/scenario/12_0_1_1.rpy:631
translate english 172e5f2a:

    # iris inquiet "Noam… tu dis rien ?"
    iris inquiet "Noam... you've been awfully quiet."

# game/scenario/12_0_1_1.rpy:634
translate english efe18a10:

    # noam fatigue "… Je réfléchis."
    noam fatigue "...I'm thinking."

# game/scenario/12_0_1_1.rpy:637
translate english 49e79393:

    # julian taquin "Allez, Noam ! T’es pas d’accord pour qu’on ait enfin un peu d’intimité ?"
    julian taquin "Come on, Noam! Don't you want a little privacy for once?"

# game/scenario/12_0_1_1.rpy:639
translate english b7fc9683:

    # "Je hausse légèrement les épaules."
    "I give a small shrug."

# game/scenario/12_0_1_1.rpy:641
translate english c0a3c58a:

    # noam "Si… bien sûr."
    noam "Yeah... of course."

# game/scenario/12_0_1_1.rpy:643
translate english fbc24b5b:

    # think "Mais à quel prix ?"
    think "But at what cost?"

# game/scenario/12_0_1_1.rpy:645
translate english c7fb9f49:

    # "La discussion continue autour de moi, animée, presque enthousiaste."
    "The discussion goes on around me, lively, almost enthusiastic."

# game/scenario/12_0_1_1.rpy:646
translate english 3a4d3830:

    # "Moi, je reste en retrait, perdu dans mes pensées."
    "I hang back, lost in thought."

# game/scenario/12_0_1_1.rpy:648
translate english 02837d5f:

    # think "Si on vote pour les brouilleurs… on donne encore plus de pouvoir à celui qui se cache parmi nous."
    think "If we vote to allow jammers... we're handing even more power to whoever's hiding among us."

# game/scenario/12_0_1_1.rpy:649
translate english cf26ae60:

    # think "Et je suis le seul à m’en rendre compte ?"
    think "Am I really the only one who sees it?"

# game/scenario/12_0_1_1.rpy:676
translate english f385ead6:

    # "La Salle du Conclave est pleine. Tout le monde est présent. L’air est lourd, chargé d’électricité."
    "The Conclave chamber is full. Everyone's here. The air feels thick with tension."

# game/scenario/12_0_1_1.rpy:693
translate english bfabf3cd:

    # tomas "Bon… on ne va pas tourner autour du pot pendant trois heures."
    tomas "Well... no point beating around the bush for three hours."

# game/scenario/12_0_1_1.rpy:694
translate english 4124eaf0:

    # tomas "Le vote est clair : est-ce qu’on autorise les dispositifs de brouillage, oui ou non ?"
    tomas "The question's simple: do we allow jamming devices, yes or no?"

# game/scenario/12_0_1_1.rpy:696
translate english a1286b03:

    # mara stress "Pour moi c’est évident ! On autorise !"
    mara stress "It's obvious to me! Allow them!"

# game/scenario/12_0_1_1.rpy:697
translate english c1bc816f:

    # mara "J’en peux plus de vivre comme dans une télé-réalité où Kami nous mate 24h sur 24 !"
    mara "I'm sick of living in some reality show where Kami watches us twenty-four seven!"

# game/scenario/12_0_1_1.rpy:698
translate english 9d3c8d04:

    # mara "Je veux pouvoir me changer, parler librement, ou même pleurer sans que quelqu’un, ou quelque chose, analyse mes larmes !"
    mara "I want to be able to get dressed, speak my mind, or even cry without someone—or something—analyzing my tears!"

# game/scenario/12_0_1_1.rpy:700
translate english dbf9b045:

    # elen "Moi aussi ! J’ai envie de danser comme une folle dans ma chambre sans me demander si elle est en train de me noter sur 10 !"
    elen "Me too! I want to dance like an idiot in my room without wondering if she's rating me out of ten!"

# game/scenario/12_0_1_1.rpy:702
translate english 6d2904e1:

    # julian taquin "Et moi j’ai envie de pouvoir dire que Kami est une grosse sadique sans qu’elle me le rappelle gentiment le lendemain."
    julian taquin "And I'd like to call Kami a sadistic bitch without her politely reminding me the next morning."

# game/scenario/12_0_1_1.rpy:704
translate english d6f0f088:

    # "Quelques rires nerveux parcourent la salle."
    "A few nervous laughs ripple through the room."

# game/scenario/12_0_1_1.rpy:708
translate english cf005c24:

    # elias fatigue "Je comprends l’idée, mais le sujet est quand même important."
    elias fatigue "I get the idea, but this is still a big decision."

# game/scenario/12_0_1_1.rpy:709
translate english dc080b32:

    # elias fatigue "Sans ça, Kami pourra plus ni nous surveiller, ni nous protéger..."
    elias fatigue "Without them, Kami couldn't watch us or protect us..."

# game/scenario/12_0_1_1.rpy:711
translate english fc125072:

    # lysa inquiet "Alors pas vraiment."
    lysa inquiet "Not exactly."

# game/scenario/12_0_1_1.rpy:712
translate english df9c08d4:

    # lysa inquiet "Même avec les brouilleurs, Kami peut avoir accès aux vidéos, mais après une semaine de délai."
    lysa inquiet "Even with the jammers, Kami can access the footage—just a week later."

# game/scenario/12_0_1_1.rpy:715
translate english 26589fc3:

    # nyra raison "Je peux comprendre l’envie d’intimité… mais il ne faut pas oublier les risques."
    nyra raison "I understand why people want privacy... but we can't ignore the risks."

# game/scenario/12_0_1_1.rpy:716
translate english c0a7baf8:

    # nyra "Si tout le monde a des brouilleurs, comment on prouve quoi que ce soit ?"
    nyra "If everyone has a jammer, how are we supposed to prove anything?"

# game/scenario/12_0_1_1.rpy:717
translate english c7482dca:

    # nyra "Le vol chez Kael, par exemple… on ne saura jamais qui c’était."
    nyra "Take the theft from Kael, for example... We'll never know who did it."

# game/scenario/12_0_1_1.rpy:719
translate english 322f22ab:

    # kael "… Exactement."
    kael "...Exactly."

# game/scenario/12_0_1_1.rpy:721
translate english a44dd1b2:

    # "Kael parle d’une voix basse, mais tout le monde se tait un instant."
    "Kael speaks quietly, but everyone falls silent for a moment."

# game/scenario/12_0_1_1.rpy:725
translate english a7f4c57d:

    # kael "Je veux savoir qui c'est."
    kael "I want to know who it was."

# game/scenario/12_0_1_1.rpy:727
translate english be008b54:

    # ryn colere "Et alors ? Tu préfères vivre en prison dorée juste pour avoir une chance de choper un voleur ?"
    ryn colere "So what? You'd rather live in a gilded cage just for a chance to catch a thief?"

# game/scenario/12_0_1_1.rpy:728
translate english 0adeb4ba:

    # ryn "Moi je dis : l'important c'est d'être libre. On n’est pas des animaux de foire."
    ryn "All I'm saying is, freedom comes first. We're not animals on display."

# game/scenario/12_0_1_1.rpy:730
translate english 54339bbb:

    # sael mefiant "C’est facile à dire tant que ce n’est pas toi qui t’es fait voler un truc précieux."
    sael mefiant "Easy to say when you aren't the one who's had something precious stolen."

# game/scenario/12_0_1_1.rpy:732
translate english 4c879754:

    # "La discussion s’enflamme petit à petit. Je reste silencieux, les bras croisés, à écouter."
    "The debate gradually heats up. I stay silent, arms crossed, listening."

# game/scenario/12_0_1_1.rpy:734
translate english e358862e:

    # think "Tout le monde penche pour l’autorisation…"
    think "Everyone's leaning toward allowing them..."

# game/scenario/12_0_1_1.rpy:737
translate english a74d79ac:

    # iris "Noam ? Tu dis rien ?"
    iris "Noam? You haven't said a word."

# game/scenario/12_0_1_1.rpy:739
translate english 9517c441_1:

    # "Tous les regards se tournent vers moi."
    "All eyes turn toward me."

# game/scenario/12_0_1_1.rpy:741
translate english efe18a10_1:

    # noam fatigue "… Je réfléchis."
    noam fatigue "...I'm still thinking."

# game/scenario/12_0_1_1.rpy:743
translate english e9b91c9b:

    # julian taquin "Noam, on peut au moins décider de ce qu'on fait dans nos chambres, non ? T'es avec nous ?"
    julian taquin "Noam, surely we can at least decide what happens in our own rooms. Are you with us?"

# game/scenario/12_0_1_1.rpy:745
translate english f626b58d:

    # think "Si on vote pour les brouilleurs…"
    think "If we vote to allow jammers..."

# game/scenario/12_0_1_1.rpy:746
translate english aae5ec9d:

    # think "Tout le monde pourra vivre l'esprit plus serein..."
    think "Everyone will be able to relax a little..."

# game/scenario/12_0_1_1.rpy:747
translate english aea03ff7:

    # think "Il faudra plusieurs jours à Kami pour savoir ce qui se passe sous les brouilleurs..."
    think "It'll take Kami days to find out what happens inside a jammed area..."

# game/scenario/12_0_1_1.rpy:749
translate english fc37d091:

    # think "Mais si on vote contre…"
    think "But if we vote against..."

# game/scenario/12_0_1_1.rpy:750
translate english db748323:

    # think "On reste sous la surveillance totale de Kami."
    think "We'll be under Kami's total surveillance."

# game/scenario/12_0_1_1.rpy:751
translate english fd4e75b2:

    # think "Elle saura tout. Absolument tout. Tout le temps."
    think "She'll know everything. Absolutely everything. All the time."

# game/scenario/12_0_1_1.rpy:753
translate english a1233b02:

    # "Je serre les dents."
    "I grit my teeth."

# game/scenario/12_0_1_1.rpy:755
translate english 3152bc84:

    # noam raison "… La sécurité."
    noam raison "...Security."

# game/scenario/12_0_1_1.rpy:757
translate english 3ba0cb4d:

    # "Le mot sort plus sèchement que prévu."
    "The words come out more sharply than I intended."

# game/scenario/12_0_1_1.rpy:759
translate english 172892da:

    # noam "Je ne dis pas que ça me plaît."
    noam "I'm not saying I like it."

# game/scenario/12_0_1_1.rpy:760
translate english ee2dd911:

    # noam fatigue "Je ne dis pas que vivre sous caméra, c’est normal."
    noam fatigue "I'm not saying being watched all the time is normal."

# game/scenario/12_0_1_1.rpy:763
translate english 8fd6eb0d:

    # elen "Noam…"
    elen "Noam..."

# game/scenario/12_0_1_1.rpy:765
translate english 52434c7d:

    # noam "S’il n’y avait pas eu ces zones mortes, ces coupures, ces moyens de disparaître…"
    noam "If there hadn't been those blind spots, those interruptions, those ways of disappearing..."

# game/scenario/12_0_1_1.rpy:766
translate english 3a38830c:

    # noam colere "On saurait déjà qui a volé les affaires de Kael."
    noam colere "We'd already know who stole Kael's things."

# game/scenario/12_0_1_1.rpy:767
translate english e2f4fa51:

    # noam colere "Et on saurait aussi qui a touché aux miennes."
    noam colere "And who messed with mine."

# game/scenario/12_0_1_1.rpy:769
translate english 49d5b9d0:

    # "Kael relève lentement les yeux vers moi."
    "Kael slowly raises his eyes to mine."

# game/scenario/12_0_1_1.rpy:771
translate english 6fde9bdc:

    # kael reflechit "…"
    kael reflechit "..."

# game/scenario/12_0_1_1.rpy:773
translate english c3cd59e2:

    # noam fatigue "On peut appeler ça liberté si vous voulez."
    noam fatigue "Call it freedom if you like."

# game/scenario/12_0_1_1.rpy:774
translate english 044c68f9:

    # noam "Je ne suis au final pas sûr que ce soit l'idéal."
    noam "I'm just not sure that's really the answer."

# game/scenario/12_0_1_1.rpy:776
translate english 343c1c98:

    # mara stress "Donc ta solution, c’est de laisser Kami nous regarder jusque dans nos chambres ?"
    mara stress "So your solution is to let Kami watch us in our bedrooms?"

# game/scenario/12_0_1_1.rpy:778
translate english 694ee91b:

    # noam desaccord "il n'y a pas de solution parfaite."
    noam desaccord "There's no perfect solution."

# game/scenario/12_0_1_1.rpy:780
translate english 9a6ff6f4:

    # "Je sens tous les regards peser sur moi."
    "I can feel everyone's eyes on me."

# game/scenario/12_0_1_1.rpy:782
translate english 8694a8df:

    # "La discussion reprend de plus belle autour de moi, mais je n’écoute plus vraiment."
    "The argument flares up again, but I'm barely listening anymore."

# game/scenario/12_0_1_1.rpy:793
translate english cf350957:

    # "La Salle du Conclave est pleine à craquer. L’atmosphère est électrique, presque fiévreuse."
    "The Conclave chamber is packed. The atmosphere is electric, almost feverish."

# game/scenario/12_0_1_1.rpy:811
translate english a90fec85:

    # tomas "Le vote d’aujourd’hui est clair : est-ce qu’on autorise les dispositifs de brouillage, oui ou non ?"
    tomas "Today's vote comes down to one question: do we allow jamming devices, or don't we?"

# game/scenario/12_0_1_1.rpy:813
translate english 4b095d3c:

    # mara stress "Autoriser ! Évidemment qu’on autorise !"
    mara stress "Allow them! Of COURSE we allow them!"

# game/scenario/12_0_1_1.rpy:814
translate english 120bf47e:

    # mara "Je refuse de continuer à vivre comme une souris de laboratoire !"
    mara "I'm not living like a lab rat anymore!"

# game/scenario/12_0_1_1.rpy:815
translate english 5699c376:

    # mara "Je veux pouvoir fermer ma porte, parler librement, pleurer, crier, ou même me disputer sans que Kami analyse tout ce que je fais !"
    mara "I want to be able to shut my door, speak freely, cry, scream, or even have an argument without Kami analyzing my every move!"

# game/scenario/12_0_1_1.rpy:817
translate english 4818b5f2:

    # elen "Exactement ! J’en ai marre de me sentir observée même quand je danse seule dans ma chambre !"
    elen "Exactly! I'm sick of feeling watched even when I'm dancing alone in my room!"

# game/scenario/12_0_1_1.rpy:819
translate english 7e3ca4bd:

    # julian taquin "Moi je veux pouvoir insulter Kami tranquillement sans qu’elle me le ressorte six mois plus tard avec un petit smiley sadique."
    julian taquin "I just want to insult Kami in peace without her throwing it back in my face six months later with a little sadistic smiley."

# game/scenario/12_0_1_1.rpy:821
translate english e6f15b59:

    # elias fatigue "Je ne vais pas mentir… moi aussi, l’idée de pouvoir respirer deux minutes sans caméra me tente."
    elias fatigue "Not gonna lie... the idea of catching my breath for two minutes without a camera watching sounds pretty good."

# game/scenario/12_0_1_1.rpy:824
translate english 4eb1909e:

    # lysa inquiet "Ça ne règle pas tout. Mais continuer comme ça, avec Kami partout, tout le temps… C'est quand même particulier..."
    lysa inquiet "It doesn't solve everything. But carrying on like this, with Kami everywhere, all the time... that's pretty messed up."

# game/scenario/12_0_1_1.rpy:826
translate english b18c73d5:

    # ryn colere "Liberté ! Point final !"
    ryn colere "Freedom! End of story!"

# game/scenario/12_0_1_1.rpy:827
translate english 4c5604b0:

    # ryn "On n’est pas des putains de prisonniers ! On mérite de pouvoir avoir un minimum d’intimité dans cet enfer !"
    ryn "We're not fucking prisoners! We deserve at least a little privacy in this hellhole!"

# game/scenario/12_0_1_1.rpy:829
translate english f6188717:

    # "Plusieurs voix s’élèvent en soutien. L’énergie est clairement du côté de la liberté."
    "Several voices rise in agreement. The momentum is clearly on the side of freedom."

# game/scenario/12_0_1_1.rpy:831
translate english 15bf4715:

    # nyra raison "Je comprends l’envie… vraiment."
    nyra raison "I get the appeal. I really do."

# game/scenario/12_0_1_1.rpy:832
translate english c26090e4:

    # nyra "Mais on ne peut pas ignorer les risques. Si tout le monde porte un brouilleur, comment on prouve quoi que ce soit ?"
    nyra "But we can't ignore the risks. If everyone has a jammer, how can we prove anything?"

# game/scenario/12_0_1_1.rpy:834
translate english eb96ae54:

    # kael "… Comme ce qui m’est arrivé."
    kael "...Like what happened to me."

# game/scenario/12_0_1_1.rpy:836
translate english 73b085c0:

    # "Le silence retombe un instant."
    "Silence falls for a moment."

# game/scenario/12_0_1_1.rpy:838
translate english 0cd95c25:

    # kael calme "Kami m'a dit que si on interdit les brouilleurs, je n’aurai probablement jamais accès aux images de ma chambre."
    kael calme "Kami told me that if we ban the jammers, I'll probably never see the footage from my room."

# game/scenario/12_0_1_1.rpy:839
translate english 074f3714:

    # kael triste "Les brouilleurs seront désinstallés dans toutes les chambres, les images capturées avec..."
    kael triste "They'll remove the jammers from every room, along with the recordings they captured..."

# game/scenario/12_0_1_1.rpy:840
translate english 37d4a519:

    # kael "Le voleur restera invisible. Pour toujours."
    kael "The thief will remain invisible. Forever."

# game/scenario/12_0_1_1.rpy:842
translate english 0d19a445:

    # sael mefiant "Et si on les interdit ? On reste sous la surveillance totale de Kami. C’est encore moins la solution."
    sael mefiant "And if we ban them? We're back under Kami's total surveillance. That's even worse."

# game/scenario/12_0_1_1.rpy:844
translate english 87bbe6c4:

    # mara "Exactement ! On échange une prison contre une autre !"
    mara "Exactly! We're trading one prison for another!"

# game/scenario/12_0_1_1.rpy:845
translate english afab74f9:

    # mara "Moi je préfère risquer l’insécurité plutôt que de vivre dans une cage dorée."
    mara "I'd rather risk being unsafe than live in a gilded cage."

# game/scenario/12_0_1_1.rpy:848
translate english cd8e6281:

    # "La discussion devient de plus en plus animée. Je reste silencieux, les bras croisés, à écouter."
    "The argument grows increasingly heated. I sit with my arms crossed, listening in silence."

# game/scenario/12_0_1_1.rpy:850
translate english a4f1078e:

    # iris "Noam ? Tu n’as toujours rien dit ?"
    iris "Noam? You still haven't said anything?"

# game/scenario/12_0_1_1.rpy:852
translate english 35b60eeb:

    # "Les regards convergent vers moi."
    "Everyone turns to look at me."

# game/scenario/12_0_1_1.rpy:854
translate english 991e3743:

    # noam fatigue "… Je réfléchis encore."
    noam fatigue "...I'm still thinking."

# game/scenario/12_0_1_1.rpy:856
translate english b2091ab0:

    # julian taquin "Noam ! On a une chance de récupérer un peu de liberté. Tu vas quand même pas nous laisser passer à côté ?"
    julian taquin "Noam! We've got a chance to win back some freedom. You're not going to let us throw it away, are you?"

# game/scenario/12_0_1_1.rpy:858
translate english 0745e194:

