    # noam fatigue "D'accord."
    noam fatigue "Okay."

# game/scenario/14_0_1_1_0.rpy:465
translate english 1c735c36_1:

    # noam fatigue "Bon..."
    noam fatigue "Well..."

# game/scenario/14_0_1_1_0.rpy:734
