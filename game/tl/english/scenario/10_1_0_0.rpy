    "Another container."

# game/scenario/10_1_0_0.rpy:590
translate english e907d34e_2:

    # "\"CONTRÔLE NON PRIORITAIRE\""
    "\"NON-PRIORITY INSPECTION\""

# game/scenario/10_1_0_0.rpy:592
translate english bb41eb4d:

    # "Encore un."
    "Another one."

# game/scenario/10_1_0_0.rpy:594
translate english e907d34e_3:

    # "\"CONTRÔLE NON PRIORITAIRE\""
    "\"NON-PRIORITY INSPECTION\""

# game/scenario/10_1_0_0.rpy:598
translate english e907d34e_4:

    # "\"CONTRÔLE NON PRIORITAIRE\""
    "\"NON-PRIORITY INSPECTION\""

# game/scenario/10_1_0_0.rpy:600
translate english c0fbd230:

    # think "Il valide presque tout."
    think "He's clearing almost all of them."

# game/scenario/10_1_0_0.rpy:602
translate english cfa59ae5:

    # "Je reste encore un moment à l'observer et, plus je regarde, moins la scène ressemble à un simple contrôle administratif."
    "I watch him a while longer and, the more I look, the less the scene looks like a simple administrative check."

# game/scenario/10_1_0_0.rpy:604
translate english 832a05cb:

    # "Ryn examine chaque conteneur suffisamment longtemps pour savoir exactement ce qu'il fait."
    "Ryn examines each container long enough to know exactly what he's doing."

# game/scenario/10_1_0_0.rpy:606
translate english c5aaac87:

    # "Mais il en écarte énormément des inspections physiques."
    "But he's steering a huge number of them away from physical inspection."

# game/scenario/10_1_0_0.rpy:608
translate english bf2c2fb9:

    # think "Comme s'il essayait de faire passer quelque chose."
    think "Like he's trying to get something through."

# game/scenario/10_1_0_0.rpy:610
translate english e62f9fd7:

    # "Ou quelqu'un."
    "Or someone."

# game/scenario/10_1_0_0.rpy:612
translate english 28396741:

    # "Je quitte enfin l'ombre de l'entrée."
    "I finally step out of the shadow by the door."

# game/scenario/10_1_0_0.rpy:614
translate english 4cae96da:

    # noam "Tu bosses ?"
    noam "Working?"

# game/scenario/10_1_0_0.rpy:616
translate english d2a174bd:

    # "Ryn sursaute brutalement."
    "Ryn jolts hard."

# game/scenario/10_1_0_0.rpy:623
translate english b2bf5e5a:

    # ryn surpris "Putain !"
    ryn surpris "Shit!"

# game/scenario/10_1_0_0.rpy:625
translate english 5ea2546c:

    # "Il se retourne immédiatement."
    "He spins around immediately."

# game/scenario/10_1_0_0.rpy:627
translate english 13d47e7c:

    # ryn colere "Noam ?!"
    ryn colere "Noam?!"

# game/scenario/10_1_0_0.rpy:629
translate english c2c28a0f:

    # noam gene "Désolé."
    noam gene "Sorry."

# game/scenario/10_1_0_0.rpy:631
translate english 6358c12f:

    # ryn desaccord "Tu fais quoi ici ?"
    ryn desaccord "What are you doing here?"

# game/scenario/10_1_0_0.rpy:633
translate english b0be950e:

