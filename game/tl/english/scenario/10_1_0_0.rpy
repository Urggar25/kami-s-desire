    "Then he changes the status manually."

# game/scenario/10_1_0_0.rpy:584
translate english f3a61e25:

    # "\"DESTRUCTION — ANOMALIE STRUCTURELLE\""
    "\"DESTRUCTION — STRUCTURAL ANOMALY\""

# game/scenario/10_1_0_0.rpy:586
translate english d5ff0fb1_1:

    # think "Qu'est-ce que..."
    think "What the..."

