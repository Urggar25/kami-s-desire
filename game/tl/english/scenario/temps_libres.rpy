translate english ryn_link_1_fd8f06e4:

    # ryn neutre "Il tourne le dos à la porte."
    ryn neutre "That one faces away from the door."

# game/scenario/temps_libres.rpy:1300
translate english ryn_link_1_baf16452:

    # noam sourire "Je peux la surveiller pour toi."
    noam sourire "I can watch it for you."

# game/scenario/temps_libres.rpy:1301
translate english ryn_link_1_fe199919:

    # ryn desaccord "J'ai pas besoin que tu montes la garde."
    ryn desaccord "I don't need you standing guard."

# game/scenario/temps_libres.rpy:1302
translate english ryn_link_1_e4900638:

    # noam taquin "Alors assieds-toi sans vérifier."
    noam taquin "Then sit down without checking."

# game/scenario/temps_libres.rpy:1303
translate english ryn_link_1_cc62b86c:

    # ryn colere "Me donne pas d'ordres. Tu te prends pour qui ?!"
    ryn colere "Don't order me around. Who the hell do you think you are?!"

# game/scenario/temps_libres.rpy:1304
translate english ryn_link_1_9cfe124a:

    # noam sourire "Tu peux aussi rester debout."
    noam sourire "You can keep standing if you'd rather."

# game/scenario/temps_libres.rpy:1305
translate english ryn_link_1_621e0dfa:

    # "Ryn finit par s'asseoir dos à l'entrée. Quelques secondes plus tard, il regarde derrière lui."
    "Ryn finally sits with his back to the entrance. A few seconds later, he glances over his shoulder."

# game/scenario/temps_libres.rpy:1306
translate english ryn_link_1_9aa06e12:

    # noam taquin "Ça fait même pas dix secondes."
    noam taquin "It hasn't even been ten seconds."

# game/scenario/temps_libres.rpy:1307
translate english ryn_link_1_637953e4:

    # ryn fatigue "J'ai entendu un bruit."
    ryn fatigue "I heard something."

# game/scenario/temps_libres.rpy:1308
translate english ryn_link_1_d335eb5c:

    # noam neutre "Y'avait rien. T'inquiète je regarde."
    noam neutre "There was nothing. Relax, I'm watching."

# game/scenario/temps_libres.rpy:1309
translate english ryn_link_1_740c3d8d:

    # "Ryn se replace lentement dans le fauteuil."
    "Ryn slowly settles back into the chair."

# game/scenario/temps_libres.rpy:1310
translate english ryn_link_1_90d81c25:

    # ryn neutre "Je te fais pas confiance."
    ryn neutre "I don't trust you."

# game/scenario/temps_libres.rpy:1311
translate english ryn_link_1_4274647b:

    # noam taquin "Pourtant, tu restes assis."
    noam taquin "And yet, you're still sitting down."

# game/scenario/temps_libres.rpy:1321
translate english ryn_link_2_a8b8cccb:

    # "Ryn m'observe frapper maladroitement dans le vide depuis plusieurs secondes."
    "Ryn has been watching me throw clumsy punches at the air for several seconds."

# game/scenario/temps_libres.rpy:1326
translate english ryn_link_2_960c3143:

    # ryn desaccord "Ta garde est merdique."
    ryn desaccord "Your guard is shit."

# game/scenario/temps_libres.rpy:1327
translate english ryn_link_2_150001bc:

    # noam reflexion "Merci pour ce conseil très précis."
    noam reflexion "Thanks for the highly specific advice."

# game/scenario/temps_libres.rpy:1328
translate english ryn_link_2_14e5115b:

    # ryn neutre "Tes mains sont trop basses. Remonte-les."
    ryn neutre "Your hands are too low. Bring them up."

# game/scenario/temps_libres.rpy:1329
translate english ryn_link_2_48ef4dd1:

    # noam determine "Comme ça ?"
    noam determine "Like this?"

# game/scenario/temps_libres.rpy:1330
translate english ryn_link_2_62d72c7e:

    # ryn colere "Non. Là, tu protèges rien."
    ryn colere "No. You're not protecting anything like that."

# game/scenario/temps_libres.rpy:1331
translate english ryn_link_2_f3b1ec23:

    # "Ryn replace brutalement mes bras, puis frappe légèrement contre ma garde."
    "Ryn roughly repositions my arms, then taps my guard with a punch."

# game/scenario/temps_libres.rpy:1332
translate english ryn_link_2_b8445da6:

    # noam inquiet "Tu pourrais prévenir."
    noam inquiet "You could warn me."

# game/scenario/temps_libres.rpy:1333
translate english ryn_link_2_fb1db112:

    # ryn neutre "Un type qui veut te casser la gueule préviendra pas."
    ryn neutre "A guy trying to beat the shit out of you won't warn you."

# game/scenario/temps_libres.rpy:1334
translate english ryn_link_2_a24b5b90:

    # noam reflexion "Tu peux m'apprendre sans essayer de me tuer."
    noam reflexion "You can teach me without trying to kill me."

# game/scenario/temps_libres.rpy:1335
translate english ryn_link_2_60268c04:

    # ryn taquin "Si ça, c'est essayer de te tuer, on part de très loin."
    ryn taquin "If you think that's me trying to kill you, we've got a long way to go."

# game/scenario/temps_libres.rpy:1336
translate english ryn_link_2_edacd720:

    # "Il attrape mon poignet et me montre comment me dégager."
    "He grabs my wrist and shows me how to break free."

# game/scenario/temps_libres.rpy:1337
translate english ryn_link_2_cd65d4fe:

    # ryn neutre "Tourne, baisse-toi et frappe."
    ryn neutre "Twist, duck, and strike."

# game/scenario/temps_libres.rpy:1338
translate english ryn_link_2_6538ef29:

    # noam inquiet "Attends, moins vite."
    noam inquiet "Wait—slow down."

# game/scenario/temps_libres.rpy:1339
translate english ryn_link_2_1c9992e8:

    # ryn colere "T'auras pas le temps d'attendre."
    ryn colere "You won't have time to wait."

# game/scenario/temps_libres.rpy:1340
translate english ryn_link_2_c17b1487:

    # noam desaccord "Lâche-moi."
    noam desaccord "Let go of me."

# game/scenario/temps_libres.rpy:1341
translate english ryn_link_2_90917b72:

    # ryn neutre "Dégage-toi."
    ryn neutre "Break free."

# game/scenario/temps_libres.rpy:1342
translate english ryn_link_2_1b8a5236:

    # noam colere "Ryn, lâche-moi."
    noam colere "Ryn, let go."

# game/scenario/temps_libres.rpy:1343
translate english ryn_link_2_343a4bcf:

    # "Il relâche immédiatement mon bras."
    "He immediately releases my arm."

# game/scenario/temps_libres.rpy:1344
translate english ryn_link_2_e3620f59:

    # ryn fatigue "T'es pas prêt."
    ryn fatigue "You're not ready."

# game/scenario/temps_libres.rpy:1345
translate english ryn_link_2_59b195fb:

    # noam desaccord "Parce que tu fais tout à ma place."
    noam desaccord "Because you're doing everything for me."

# game/scenario/temps_libres.rpy:1346
translate english ryn_link_2_45e75257:

    # ryn colere "J'essaie de t'éviter de te défoncer l'épaule."
    ryn colere "I'm trying to stop you from wrecking your shoulder."

# game/scenario/temps_libres.rpy:1347
translate english ryn_link_2_ab15ca04:

    # noam neutre "Je voulais apprendre à me défendre, pas être défendu contre l'entraineur."
    noam neutre "I wanted to learn how to defend myself, not be defended from my instructor."

# game/scenario/temps_libres.rpy:1348
translate english ryn_link_2_90e5086b:

    # ryn desaccord "Je vais pas te laisser faire n'importe quoi."
    ryn desaccord "I'm not letting you do something stupid."

# game/scenario/temps_libres.rpy:1349
translate english ryn_link_2_f5bf7518:

    # noam reflexion "Alors montre-moi et laisse-moi essayer."
    noam reflexion "Then show me and let me try."

# game/scenario/temps_libres.rpy:1350
translate english ryn_link_2_cd9a253c:

    # ryn fatigue "Si tu te blesses, viens pas te plaindre."
    ryn fatigue "If you hurt yourself, don't come crying to me."

# game/scenario/temps_libres.rpy:1351
translate english ryn_link_2_455f8dbb:

    # noam sourire "D'accord."
    noam sourire "Fine."

# game/scenario/temps_libres.rpy:1352
translate english ryn_link_2_86c0bf79:

    # "Ryn reprend lentement la prise. Cette fois, il me laisse chercher le mouvement."
    "Ryn slowly takes hold of me again. This time, he lets me work out the movement."

# game/scenario/temps_libres.rpy:1353
translate english ryn_link_2_46315278:

    # ryn neutre "Tourne ton poignet... Maintenant."
    ryn neutre "Twist your wrist... Now."

# game/scenario/temps_libres.rpy:1354
translate english ryn_link_2_3da24c3e:

    # "Je pivote, me baisse et parviens à lui échapper."
    "I turn, duck, and manage to slip out of his grip."

# game/scenario/temps_libres.rpy:1355
translate english ryn_link_2_bec75213:

    # noam sourire "Ça marche."
    noam sourire "It works."

# game/scenario/temps_libres.rpy:1356
translate english ryn_link_2_13d3c29f:

    # ryn taquin "Parce que je t'ai laissé faire."
    ryn taquin "Because I let you do it."

# game/scenario/temps_libres.rpy:1357
translate english ryn_link_2_2df72b7d:

    # noam reflexion "On recommence ?"
    noam reflexion "Again?"

# game/scenario/temps_libres.rpy:1358
translate english ryn_link_2_57cb76dc:

    # ryn surpris "Tu veux vraiment continuer ?"
    ryn surpris "You really want to keep going?"

# game/scenario/temps_libres.rpy:1359
translate english ryn_link_2_9fb22f48:

    # noam taquin "T'as peur que je te surprenne encore ?"
    noam taquin "Afraid I'll surprise you again?"

# game/scenario/temps_libres.rpy:1360
translate english ryn_link_2_192d9e8b:

    # ryn determine "Remets-toi en garde."
    ryn determine "Get back into your stance."

# game/scenario/temps_libres.rpy:1361
translate english ryn_link_2_6e881eef:

    # noam sourire "Essaie seulement de pas décider tous mes mouvements."
    noam sourire "Just try not to dictate my every move."

# game/scenario/temps_libres.rpy:1362
translate english ryn_link_2_682378f7:

    # ryn sourire "Alors fais-en un qui soit pas complètement con."
    ryn sourire "Then make one that isn't completely stupid."

# game/scenario/temps_libres.rpy:1372
translate english ryn_link_3_e6e25d7a:

    # "Ryn examine une pelle pliable trouvée parmi le matériel de maintenance."
    "Ryn examines a folding shovel he found among the maintenance equipment."

# game/scenario/temps_libres.rpy:1377
translate english ryn_link_3_7f582e6e:

    # noam reflexion "Tu comptes creuser un tunnel pour partir ?"
    noam reflexion "Planning to dig an escape tunnel?"

# game/scenario/temps_libres.rpy:1378
translate english ryn_link_3_76290742:

    # ryn fatigue "Avec cette merde ? Le manche casserait avant de frapper le sol."
    ryn fatigue "With this piece of shit? The handle would snap before the blade hit the ground."

# game/scenario/temps_libres.rpy:1379
translate english ryn_link_3_e07b1911:

    # noam taquin "Tu as l'air de bien connaître les pelles."
    noam taquin "You seem to know a lot about shovels."

# game/scenario/temps_libres.rpy:1380
translate english ryn_link_3_45f2d454:

    # ryn neutre "J'ai creusé assez de tranchées."
    ryn neutre "I've dug enough trenches."

# game/scenario/temps_libres.rpy:1381
translate english ryn_link_3_c8c4e07c:

    # noam surpris "À Limen ?"
    noam surpris "In Limen?"

# game/scenario/temps_libres.rpy:1382
translate english ryn_link_3_57724f2d:

    # ryn desaccord "J'étais gardien. On surveillait les gens avant qu'ils atteignent la frontière."
    ryn desaccord "I was a guard. We stopped people before they reached the border."

# game/scenario/temps_libres.rpy:1383
translate english ryn_link_3_22e6f3e2:

    # noam inquiet "Pour les empêcher de partir ?"
    noam inquiet "To keep them from leaving?"

# game/scenario/temps_libres.rpy:1384
translate english ryn_link_3_f34e7b30:

    # ryn colere "Pour les empêcher de crever, surtout."
    ryn colere "Mostly to keep them from dying."

# game/scenario/temps_libres.rpy:1385
translate english ryn_link_3_811fe04c:

    # ryn triste "Kami exécutait tous ceux qui franchissaient la frontière."
    ryn triste "Kami executed anyone who crossed the border."

# game/scenario/temps_libres.rpy:1386
translate english ryn_link_3_76b7a1f8:

    # noam reflexion "La frontière était pas clairement indiquée ?"
    noam reflexion "Wasn't the border clearly marked?"

# game/scenario/temps_libres.rpy:1387
translate english ryn_link_3_62d979df:

    # ryn triste "Non. Les premiers gardiens ont dû la chercher."
    ryn triste "No. The first guards had to find it."

# game/scenario/temps_libres.rpy:1388
translate english ryn_link_3_3fa27d0b:

    # noam inquiet "Comment ?"
    noam inquiet "How?"

# game/scenario/temps_libres.rpy:1389
translate english ryn_link_3_c48dfe33:

    # ryn colere "Ils avançaient. Jusqu'à ce que Kami tire."
    ryn colere "They walked forward until Kami opened fire."

# game/scenario/temps_libres.rpy:1390
translate english ryn_link_3_c21456e8:

    # ryn triste "On marquait le dernier endroit sûr. Puis un autre avançait un peu plus loin."
    ryn triste "We marked the last safe spot. Then someone else went a little farther."

# game/scenario/temps_libres.rpy:1391
translate english ryn_link_3_62681d54:

    # noam inquiet "Combien sont morts comme ça ?"
    noam inquiet "How many people died that way?"

# game/scenario/temps_libres.rpy:1392
translate english ryn_link_3_d29ae1fd:

    # ryn fatigue "Beaucoup trop."
    ryn fatigue "Far too many."

# game/scenario/temps_libres.rpy:1393
translate english ryn_link_3_841354ef:

    # ryn neutre "Quand on a trouvé la limite, on a creusé les tranchées quelques mètres avant."
    ryn neutre "Once we found the boundary, we dug trenches a few meters inside it."

# game/scenario/temps_libres.rpy:1394
translate english ryn_link_3_12ecef99:

    # ryn neutre "Pour avoir le temps de rattraper ceux qui couraient. Les empêcher de crever bêtement."
    ryn neutre "That gave us time to catch anyone who tried to run across—to stop them dying for nothing."

# game/scenario/temps_libres.rpy:1395
translate english ryn_link_3_48b64531:

    # noam triste "Ils comprenaient pourquoi vous les arrêtiez ?"
    noam triste "Did they understand why you were stopping them?"

# game/scenario/temps_libres.rpy:1396
translate english ryn_link_3_0ca091be:

    # ryn colere "Certains pensaient qu'on bossait pour Kami."
    ryn colere "Some thought we worked for Kami."

# game/scenario/temps_libres.rpy:1397
translate english ryn_link_3_3a35ad3c:

    # ryn colere2 "Ils nous frappaient, nous crachaient dessus... et retournaient courir vers la frontière."
    ryn colere2 "They'd hit us, spit on us... then turn around and run for the border again."

# game/scenario/temps_libres.rpy:1398
translate english ryn_link_3_7f1c1c97:

    # noam inquiet "Vous deviez les retenir de force."
    noam inquiet "You had to restrain them by force."

# game/scenario/temps_libres.rpy:1399
translate english ryn_link_3_c9ea08ee:

    # ryn determine "Je préférais leur casser un bras que les regarder se faire exécuter."
    ryn determine "I'd rather break someone's arm than watch them be executed."

# game/scenario/temps_libres.rpy:1400
translate english ryn_link_3_920ee1f9:

    # noam reflexion "Tu sais combien de personnes tu as sauvées ?"
    noam reflexion "Do you know how many people you saved?"

# game/scenario/temps_libres.rpy:1401
translate english ryn_link_3_00ea7349:

    # ryn colere "Non. Mais beaucoup sont quand même passées..."
    ryn colere "No. But plenty still got through..."

# game/scenario/temps_libres.rpy:1402
translate english ryn_link_3_e77df8f7:

    # "Ryn replie la pelle et la remet brusquement sur l'étagère."
    "Ryn folds the shovel and shoves it back onto the shelf."

# game/scenario/temps_libres.rpy:1403
translate english ryn_link_3_4e0ce96c:

    # noam neutre "Tu continues à faire pareil avec nous."
    noam neutre "You're still doing the same thing with us."

# game/scenario/temps_libres.rpy:1404
translate english ryn_link_3_03dbf2be:

    # ryn desaccord "Ici aussi, y'a des limites qui tuent."
    ryn desaccord "There are lines that can kill us here too."

# game/scenario/temps_libres.rpy:1405
translate english ryn_link_3_5fa02f58:

    # noam reflexion "Et tu préfères qu'on te déteste plutôt que nous laisser les franchir."
    noam reflexion "And you'd rather have us hate you than let us cross them."

# game/scenario/temps_libres.rpy:1406
translate english ryn_link_3_6871cc1d:

    # ryn neutre "Quelqu'un de vivant peut encore me détester."
    ryn neutre "Someone who's alive can still hate me."

# game/scenario/temps_libres.rpy:1407
translate english ryn_link_3_42a774ca:

    # ryn triste "Un mort peut plus rien faire."
    ryn triste "The dead can't do anything."

# game/scenario/temps_libres.rpy:1420
translate english sael_link_1_8a9a4fe4:

    # "Quand j'entre dans l'infirmerie, Sael remplit méthodiquement une petite trousse posée sur le lit d'examen."
    "When I enter the infirmary, Sael is methodically filling a small kit laid out on the examination table."

# game/scenario/temps_libres.rpy:1426
translate english sael_link_1_9d0ab9be:

    # noam taquin "Des bandages, de l'antiseptique, des médicaments... Tu pars en expédition ou tu vas simplement marcher dans les couloirs ?"
    noam taquin "Bandages, antiseptic, medicine... Are you going on an expedition, or just taking a walk through the corridors?"

# game/scenario/temps_libres.rpy:1427
translate english sael_link_1_89b149db:

    # sael neutre "Je vais marcher dehors. Un accident ne devient pas moins grave sous prétexte que la promenade devait être courte."
    sael neutre "I'm going outside. An accident doesn't become less serious just because you planned a short walk."

# game/scenario/temps_libres.rpy:1428
translate english sael_link_1_a448adbd:

    # noam reflexion "On ne peut même pas quitter le Conclave. Il suffirait de revenir ici en cas de problème."
    noam reflexion "We can't even leave the Conclave. If something happens, you can just come back here."

# game/scenario/temps_libres.rpy:1429
translate english sael_link_1_110d5ca8:

    # sael desaccord "Une trousse posée sur une étagère ne soigne personne. Et certains blessés ne peuvent pas attendre qu'on les ramène."
    sael desaccord "A kit sitting on a shelf won't treat anyone. And some injuries can't wait until the victim is brought back."

# game/scenario/temps_libres.rpy:1430
translate english sael_link_1_0ebe9fe0:

    # noam sourire "Tu as vraiment prévu toutes les catastrophes possibles avant même d'avoir quitté la pièce."
    noam sourire "You've planned for every possible disaster before you've even left the room."

# game/scenario/temps_libres.rpy:1431
translate english sael_link_1_ab8d047b:

    # sael raison "Non. Seulement les plus probables. Prévoir toutes les autres rendrait cette trousse trop lourde pour être utile."
    sael raison "No. Only the most likely ones. Preparing for every other possibility would make the kit too heavy to be useful."

# game/scenario/temps_libres.rpy:1433
translate english sael_link_1_73890b41:

    # "Sael retire un appareil électronique de la trousse et le replace sur une étagère."
    "Sael removes an electronic device from the kit and puts it back on the shelf."

# game/scenario/temps_libres.rpy:1434
translate english sael_link_1_cb1b3188:

    # noam surpris "Tu ne prends pas ce scanner ? Il peut détecter une fracture bien plus vite que toi."
    noam surpris "You're not taking the scanner? It can detect a fracture much faster than you can."

# game/scenario/temps_libres.rpy:1435
translate english sael_link_1_0579514d:

    # sael mefiant "Il est fragile, dépend d'une batterie et demande trop de temps. Mes mains et une attelle ne tomberont pas en panne."
    sael mefiant "It's fragile, battery-dependent, and too slow. My hands and a splint won't fail."

# game/scenario/temps_libres.rpy:1436
translate english sael_link_1_e10a6182:

    # noam taquin "Pour quelqu'un qui se méfie du progrès, tu emportes quand même beaucoup de médicaments fabriqués par des machines."
    noam taquin "For someone so suspicious of progress, you're still carrying a lot of machine-made medicine."

# game/scenario/temps_libres.rpy:1437
translate english sael_link_1_fd4dce91:

    # sael neutre "Je rejette le confort qui affaiblit. Pas les outils capables de garder quelqu'un en vie."
    sael neutre "I reject comforts that make people weak, not tools that can keep someone alive."

# game/scenario/temps_libres.rpy:1439
translate english sael_link_1_e4835d65:

    # "En refermant une poche, elle laisse apparaître une petite fiole sombre."
    "As she closes one pocket, a small dark vial comes into view."

# game/scenario/temps_libres.rpy:1440
translate english sael_link_1_c8402086:

    # noam inquiet "Attends... Ce symbole sur la fiole, c'est bien celui qu'on utilise pour identifier un poison ?"
    noam inquiet "Wait... Isn't that symbol on the vial used to mark poison?"

# game/scenario/temps_libres.rpy:1441
translate english sael_link_1_601378bb:

    # sael neutre "Oui. La dose est suffisante pour arrêter un cœur rapidement et sans provoquer davantage de douleur."
    sael neutre "Yes. The dose is enough to stop a heart quickly without causing any further pain."

# game/scenario/temps_libres.rpy:1442
translate english sael_link_1_1615e534:

    # noam desaccord "Je croyais que le but d'une trousse de secours était précisément d'empêcher les gens de mourir."
    noam desaccord "I thought the whole point of a first-aid kit was to stop people from dying."

# game/scenario/temps_libres.rpy:1443
translate english sael_link_1_de6824a1:

    # sael culpabilite "Certains remèdes échouent. Certaines souffrances ne peuvent plus être arrêtées autrement."
    sael culpabilite "Some treatments fail. Some suffering can no longer be stopped any other way."

# game/scenario/temps_libres.rpy:1444
translate english sael_link_1_4e05ef19:

    # noam inquiet "Et tu serais réellement capable de décider que quelqu'un a atteint ce point-là ?"
    noam inquiet "And you could really decide that someone had reached that point?"

# game/scenario/temps_libres.rpy:1445
translate english sael_link_1_0155cb12:

    # sael reflechit "Je l'ai déjà décidé autrefois. J'espère ne jamais avoir à le refaire."
    sael reflechit "I've made that decision before. I hope I never have to make it again."

# game/scenario/temps_libres.rpy:1446
translate english sael_link_1_a3abafdb:

    # noam triste "Tu aurais pu laisser cette fiole ici, si tu espères vraiment ne pas avoir à t'en servir."
    noam triste "If you truly hope you won't need it, you could've left the vial here."

# game/scenario/temps_libres.rpy:1447
translate english sael_link_1_d83af9d0:

    # sael determine "Espérer ne protège personne. Être prête peut encore le faire."
    sael determine "Hope protects no one. Being prepared still can."

# game/scenario/temps_libres.rpy:1459
translate english sael_link_2_f4269b91:

    # "Dans la salle d'observation, Sael fixe la console tandis que les lumières changent de couleur au-dessus d'elle."
    "In the observation room, Sael stares at the console while the lights above her cycle through different colors."

# game/scenario/temps_libres.rpy:1465
translate english sael_link_2_fc78b928:

    # noam taquin "Je ne savais pas que tu appréciais les éclairages violets. Ça donne un côté étonnamment chaleureux à la pièce."
    noam taquin "I didn't know you liked purple lighting. It makes the room feel surprisingly cozy."

# game/scenario/temps_libres.rpy:1466
translate english sael_link_2_2d712874:

    # sael desaccord "Je cherche à tout éteindre. Cette machine semble avoir décidé de me proposer toutes les autres possibilités avant."
    sael desaccord "I'm trying to turn everything off. This machine seems determined to show me every other option first."

# game/scenario/temps_libres.rpy:1467
translate english sael_link_2_b6596fd5:

    # noam sourire "Le bouton est pourtant juste devant toi. Celui avec le symbole qui ressemble vaguement à une ampoule."
    noam sourire "The button is right in front of you. The one with the symbol that looks vaguely like a light bulb."

# game/scenario/temps_libres.rpy:1468
translate english sael_link_2_b1399184:

    # sael mefiant "Je l'ai essayé. Il a fermé les protections extérieures et augmenté le chauffage de trois degrés."
    sael mefiant "I tried it. It closed the external shutters and raised the temperature by three degrees."

# game/scenario/temps_libres.rpy:1469
translate english sael_link_2_bbaba007:

    # noam taquin "Donc, pour résumer, tu as réussi à supprimer les étoiles et à rendre la pièce plus confortable."
    noam taquin "So, to recap, you managed to hide the stars and make the room more comfortable."

# game/scenario/temps_libres.rpy:1470
translate english sael_link_2_97b0a10b:

    # sael neutre "C'est pour cette raison que je t'ai demandé de venir. Éteins tout avant que je casse quelque chose."
    sael neutre "That's why I asked you to come. Turn it all off before I break something."

# game/scenario/temps_libres.rpy:1472
translate english sael_link_2_42521547:

    # "J'annule ses dernières commandes, puis je coupe l'éclairage. La pièce plonge aussitôt dans l'obscurité."
    "I undo her last commands, then switch off the lights. The room immediately falls dark."

# game/scenario/temps_libres.rpy:1473
translate english sael_link_2_ce5ca69f:

    # noam surpris "Je ne pensais pas qu'on pouvait voir autant d'étoiles depuis la station. Certaines étaient complètement invisibles avant."
    noam surpris "I didn't realize you could see so many stars from the station. Some of them were completely invisible before."

# game/scenario/temps_libres.rpy:1474
translate english sael_link_2_7dcc5670:

    # sael joie "Les lumières artificielles effacent le ciel, puis les hommes finissent par oublier ce qu'elles leur ont pris."
    sael joie "Artificial light erases the sky, and eventually people forget what it took from them."

# game/scenario/temps_libres.rpy:1475
translate english sael_link_2_ef7d7b57:

    # noam reflexion "Elles nous évitent aussi de trébucher, de geler et de chercher nos affaires pendant une heure."
    noam reflexion "It also keeps us from tripping, freezing, and spending an hour looking for our things."

# game/scenario/temps_libres.rpy:1476
translate english sael_link_2_5ea7ec94:

    # sael raison "Je ne dis pas qu'il faut les supprimer. Je dis qu'il faut encore être capable de vivre lorsqu'elles s'éteignent."
    sael raison "I'm not saying we should get rid of it. I'm saying we should still be able to live when the lights go out."

# game/scenario/temps_libres.rpy:1477
translate english sael_link_2_1cd26c60:

    # noam neutre "Tu penses vraiment qu'un peu de lumière peut rendre quelqu'un dépendant à ce point ?"
    noam neutre "You really think a little light can make someone that dependent?"

# game/scenario/temps_libres.rpy:1478
translate english sael_link_2_f7eaecbf:

    # sael reflechit "La lumière, le chauffage, le bruit permanent... À force de remplir chaque vide, les gens finissent par en avoir peur."
    sael reflechit "Light, heat, constant noise... When people fill every empty space, eventually they become afraid of emptiness itself."

# game/scenario/temps_libres.rpy:1479
translate english sael_link_2_eddf508c:

    # noam sourire "Tu as quand même eu besoin d'une machine moderne et de mon aide pour retrouver cette fameuse nuit."
    noam sourire "You still needed a modern machine—and my help—to bring back that precious darkness."

# game/scenario/temps_libres.rpy:1480
translate english sael_link_2_e6c45c2a:

    # sael taquin "J'ai eu besoin de toi pour réparer les erreurs de la machine. Ne t'accorde pas davantage de mérite."
    sael taquin "I needed you to correct the machine's mistakes. Don't give yourself too much credit."

# game/scenario/temps_libres.rpy:1481
translate english sael_link_2_13141c89:

    # noam rire "Je vais quand même retenir que Sael m'a demandé de l'aide. L'événement mérite probablement d'être archivé."
    noam rire "I'm still going to remember the day Sael asked me for help. The event probably deserves to be archived."

# game/scenario/temps_libres.rpy:1482
translate english sael_link_2_47267441:

    # sael sourire "Profite plutôt du silence avant que je décide de te laisser retrouver la sortie dans le noir."
    sael sourire "Enjoy the silence before I decide to make you find the exit in the dark."

# game/scenario/temps_libres.rpy:1484
translate english sael_link_2_633ac524:

    # "Nous restons quelque temps face aux étoiles. Avant de partir, Sael réactive finalement une lumière très faible."
    "We spend a while facing the stars. Before we leave, Sael finally turns on one very dim light."

# game/scenario/temps_libres.rpy:1485
translate english sael_link_2_be5f97fd:

    # noam taquin "Tu abandonnes déjà ton grand principe sur la nécessité de savoir marcher dans l'obscurité ?"
    noam taquin "Giving up on your grand principle about learning to walk in the dark already?"

# game/scenario/temps_libres.rpy:1486
translate english sael_link_2_3ca87e98:

    # sael neutre "Iris vient souvent ici. Je préfère éviter qu'elle se casse le nez contre une chaise."
    sael neutre "Iris comes here often. I'd rather she didn't break her nose on a chair."

# game/scenario/temps_libres.rpy:1498
translate english sael_link_3_53833d9b:

    # "Avant de commencer son repas, Sael rompt un morceau de pain et le dépose seul sur une assiette vide."
    "Before beginning her meal, Sael breaks off a piece of bread and places it by itself on an empty plate."

# game/scenario/temps_libres.rpy:1504
translate english sael_link_3_3b85b103:

    # noam reflexion "Si tu n'en veux pas, je peux le prendre. J'ai terminé le mien beaucoup plus vite que prévu."
    noam reflexion "If you don't want it, I'll take it. I finished mine much faster than expected."

# game/scenario/temps_libres.rpy:1505
translate english sael_link_3_e7a02181:

    # sael mefiant "N'y touche pas. Ce morceau n'est pas destiné à quelqu'un qui peut encore se servir lui-même."
    sael mefiant "Don't touch it. That piece isn't meant for anyone still able to serve themselves."

# game/scenario/temps_libres.rpy:1506
translate english sael_link_3_45a104b0:

    # noam surpris "D'accord... Je pensais seulement que tu avais décidé de ne pas finir ton repas."
    noam surpris "All right... I just thought you'd decided not to finish your meal."

# game/scenario/temps_libres.rpy:1507
translate english sael_link_3_0f8679fb:

    # sael neutre "C'est une offrande. Chez moi, le premier morceau revenait à la terre et aux morts de la famille."
    sael neutre "It's an offering. Where I come from, the first piece belonged to the earth and the family's dead."

# game/scenario/temps_libres.rpy:1508
translate english sael_link_3_78b86291:

    # noam taquin "La terre se trouve plusieurs étages sous nos pieds. Ton pain risque d'avoir du mal à l'atteindre."
    noam taquin "The ground is several floors below us. Your bread may have trouble reaching it."

# game/scenario/temps_libres.rpy:1509
translate english sael_link_3_d3e90b3c:

    # sael sourire "La terre sait attendre. Elle le fait depuis bien plus longtemps que nous."
    sael sourire "The earth knows how to wait. It's been doing so for far longer than we have."

# game/scenario/temps_libres.rpy:1510
translate english sael_link_3_6ae62c05:

    # noam reflexion "Et tu crois vraiment que les morts peuvent recevoir ce que tu poses dans cette assiette ?"
    noam reflexion "And you really believe the dead can receive whatever you put on that plate?"

# game/scenario/temps_libres.rpy:1511
translate english sael_link_3_5d27f0ce:

    # sael raison "Ce qu'ils reçoivent n'a aucune importance. Ce geste sert surtout à rappeler quelque chose aux vivants."
    sael raison "What they receive doesn't matter. The gesture is mostly there to remind the living of something."

# game/scenario/temps_libres.rpy:1512
translate english sael_link_3_6b91cfc7:

    # noam neutre "Que nous devons éviter de voler le pain laissé sur une table dès que quelqu'un détourne les yeux ?"
    noam neutre "That we shouldn't steal bread from the table the moment someone looks away?"

# game/scenario/temps_libres.rpy:1513
translate english sael_link_3_af47cc0e:

    # sael desaccord "Que nous mangeons encore parce que d'autres ne le peuvent plus. Ce n'est pas un privilège à oublier."
    sael desaccord "That we're still able to eat when others no longer can. That's not a privilege we should forget."

# game/scenario/temps_libres.rpy:1515
translate english sael_link_3_0fd1b6d3:

    # "Sael observe le morceau de pain quelques secondes avant de reprendre."
    "Sael watches the piece of bread for a few seconds before continuing."

# game/scenario/temps_libres.rpy:1516
translate english sael_link_3_269cbe58:

    # sael triste "Depuis l'arrivée de Kami, j'en laisse aussi pour les exécutés et les disparus qui n'ont jamais reçu de tombe."
    sael triste "Since Kami arrived, I've also left some for those who were executed or disappeared without ever receiving a grave."

# game/scenario/temps_libres.rpy:1517
translate english sael_link_3_ecb0c979:

    # noam inquiet "Tu connais beaucoup de personnes qui ont disparu de cette manière à Limen ?"
    noam inquiet "Did you know many people who disappeared that way in Limen?"

# game/scenario/temps_libres.rpy:1518
translate english sael_link_3_bc09d393:

    # sael culpabilite "Assez pour que l'assiette ne puisse pas toutes les représenter. Un seul morceau doit donc suffire."
    sael culpabilite "Too many for one plate to represent them all. So one piece has to be enough."

# game/scenario/temps_libres.rpy:1520
translate english sael_link_3_5a26c39b:

    # goumi vide "Votre repas semble terminé. Je vais débarrasser cette assiette afin de libérer la place."
    goumi vide "Your meal appears to be over. I will clear this plate to free up the space."

# game/scenario/temps_libres.rpy:1521
translate english sael_link_3_760a5185:

    # sael determine "Non. Cette assiette reste ici jusqu'à la fin du repas, même si personne ne touche à son contenu."
    sael determine "No. That plate stays here until the meal is over, even if no one touches what's on it."

# game/scenario/temps_libres.rpy:1522
translate english sael_link_3_c5aa777f:

    # goumi vide "Cette instruction entraîne la conservation volontaire d'un reste alimentaire. Dois-je l'enregistrer comme une exception ?"
    goumi vide "This instruction requires the deliberate retention of leftover food. Should I record it as an exception?"

# game/scenario/temps_libres.rpy:1523
translate english sael_link_3_42391b91:

    # noam sourire "Oui, Goumi. Et ajoute aussi celui-ci à l'exception."
    noam sourire "Yes, Goumi. And add this to the exception too."

# game/scenario/temps_libres.rpy:1525
translate english sael_link_3_c0346d6f:

    # "Je détache un morceau de mon pain et le pose à côté de celui de Sael."
    "I break off a piece of my bread and set it beside Sael's."

# game/scenario/temps_libres.rpy:1526
translate english sael_link_3_ce1883e8:

    # sael surpris "Tu n'es pas obligé de suivre un rite qui n'appartient ni à ta famille ni à ton district."
    sael surpris "You don't have to observe a rite that belongs to neither your family nor your district."

# game/scenario/temps_libres.rpy:1527
translate english sael_link_3_4b06778a:

    # noam triste "Je sais. Mais les gens dont tu parles n'appartenaient pas seulement à Limen."
    noam triste "I know. But the people you're talking about didn't belong to Limen alone."

# game/scenario/temps_libres.rpy:1528
translate english sael_link_3_83200fda:

    # sael reflechit "Non... Kami s'est chargée de donner les mêmes morts à tous les districts."
    sael reflechit "No... Kami made every district mourn the same dead."

# game/scenario/temps_libres.rpy:1529
translate english sael_link_3_2919db8a:

    # noam neutre "Alors, pour aujourd'hui, ils auront aussi deux morceaux au lieu d'un."
    noam neutre "Then today, they'll have two pieces instead of one."

# game/scenario/temps_libres.rpy:1530
translate english sael_link_3_88e8f635:

    # sael sourire "Mange le reste avant qu'il refroidisse. Les morts n'ont pas besoin que tu les rejoignes affamé."
    sael sourire "Eat the rest before it gets cold. The dead don't need you joining them on an empty stomach."

