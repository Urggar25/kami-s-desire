    kael sourire "Probably."

# game/scenario/temps_libres.rpy:971
translate english kael_link_3_d4f1b8e1:

    # "Nous reportons notre attention sur l'écran jusqu'à la fin du bulletin."
    "We turn our attention back to the screen until the report ends."

