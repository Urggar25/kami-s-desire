    # kael reflexion "Je chercherais sans doute un abri."
    kael reflexion "I'd probably look for shelter."

# game/scenario/temps_libres.rpy:962
translate english kael_link_3_e63089bd:

    # noam taquin "Réponse passionnante."
    noam taquin "Thrilling answer."

