translate english 8c6fb7e5:

    # "Je marche jusqu’à la chambre d’Iris."
    "I walk to Iris’s room."

# game/scenario/salles/4_1.rpy:550
translate english 086827d7:

    # "La porte est entrouverte. Je frappe doucement."
    "The door is ajar. I knock softly."

# game/scenario/salles/4_1.rpy:552
translate english 77416b1d:

    # iris "C’est qui ?"
    iris "Who is it?"

# game/scenario/salles/4_1.rpy:554
translate english 1720b825:

    # "Je pousse la porte. Iris est assise sur son lit, les genoux ramenés contre elle."
    "I push the door open. Iris is sitting on her bed, knees pulled to her chest."

# game/scenario/salles/4_1.rpy:557
translate english 5c9e6969:

    # "Elle a l’air épuisée."
    "She looks exhausted."

# game/scenario/salles/4_1.rpy:560
translate english 032e0ab5:

    # iris "Ah… c’est toi."
    iris "Ah… it’s you."

# game/scenario/salles/4_1.rpy:561
translate english dc9cd8d7:

    # iris "T’es venu me faire la morale ?"
    iris "Did you come to lecture me?"

# game/scenario/salles/4_1.rpy:563
translate english 6f3dfd6c:

    # "Je m’assois à côté d’elle. Pas trop près."
    "I sit down beside her. Not too close."

# game/scenario/salles/4_1.rpy:569
translate english 7e591294:

    # "Je lui explique qu’Elen organise une petite fête pour décompresser."
    "I tell her Elen’s putting together a small party so we can unwind."

# game/scenario/salles/4_1.rpy:570
translate english 472fb14b:

    # "Iris rit sans joie."
    "Iris laughs without any joy."

# game/scenario/salles/4_1.rpy:572
translate english 4391a2b0:

    # iris "Une fête… après ça ?"
    iris "A party… after this?"

# game/scenario/salles/4_1.rpy:573
translate english 2f84c144:

    # iris "Sael est partie en claquant la porte. Mara l’a suivie. Et nous, on fait quoi ? On boit pour oublier ?"
    iris "Sael stormed out. Mara followed her. And what do we do—drink to forget?"

# game/scenario/salles/4_1.rpy:575
translate english a349a704:

    # noam "C'est peut être mieux que de rester seule."
    noam "It might be better than staying alone."

# game/scenario/salles/4_1.rpy:576
translate english 8d053a21:

    # noam "Ca nous fera peut être du bien."
    noam "It might do us some good."

# game/scenario/salles/4_1.rpy:578
translate english f8f6ce60:

    # iris "T’as raison… comme d’habitude."
    iris "You’re right… like always."

# game/scenario/salles/4_1.rpy:579
translate english 6400aa7e:

    # iris "Bon, allons-y. Mais si Julian commence à faire ses beaux discours, je te jure que je le frappe."
    iris "Fine, let’s go. But if Julian starts one of his grand speeches, I swear I’ll hit him."

# game/scenario/salles/4_1.rpy:581
translate english a15a4e12:

    # noam "Je ne laisserai pas ça arriver."
    noam "I won’t let that happen."

# game/scenario/salles/4_1.rpy:582
translate english fec1caf8:

    # noam "Quoi que... Pour le spectacle."
    noam "Then again… for the show."

# game/scenario/salles/4_1.rpy:584
translate english 55bc5b2c:

    # "Iris sourit puis se relève légèrement."
    "Iris smiles, then pushes herself up."

# game/scenario/salles/4_1.rpy:587
translate english f2f82d0a:

    # "On marche ensemble vers la salle de repos."
    "We walk together toward the lounge."

# game/scenario/salles/4_1.rpy:590
translate english 71e286c0:

    # "Les couloirs sont silencieux, mais on entend déjà de la musique au loin."
    "The corridors are quiet, but we can already hear music in the distance."

# game/scenario/salles/4_1.rpy:595
translate english b27fb522:

    # "La fête a déjà commencé. Elen a sorti des rations alcoolisées. Julian sert des verres."
    "The party has already started. Elen brought out the alcoholic rations. Julian is pouring drinks."

# game/scenario/salles/4_1.rpy:596
translate english 1ebf2aca:

    # "Ryn est déjà là, un verre à la main, les épaules un peu moins tendues."
    "Ryn is already there, drink in hand, shoulders a little less tense."

# game/scenario/salles/4_1.rpy:597
translate english 312b498d:

    # "Nyra revient rapidement avec Mara et Sael. Sael a l’air calmée, mais elle reste en retrait."
    "Nyra comes back quickly with Mara and Sael. Sael seems calmer, but she stays in the back."

# game/scenario/salles/4_1.rpy:600
translate english 05fe042e:

    # elen "Ah ! Vous êtes là !"
    elen "Ah! You’re here!"

# game/scenario/salles/4_1.rpy:601
translate english 11bcfd3c:

    # elen joie "Allez, buvez un coup. On a gagné hier. On mérite au moins ça."
    elen joie "Come on, have a drink. We won yesterday. We deserve at least that."

# game/scenario/salles/4_1.rpy:603
translate english 7b5296af:

    # "Je regarde autour de moi."
    "I look around."

# game/scenario/salles/4_1.rpy:604
translate english 77cf0a0a:

    # "On rit. On parle. On boit."
    "We laugh. We talk. We drink."

# game/scenario/salles/4_1.rpy:605
translate english afe762a6:

    # "Mais sous les sourires, je sens toujours la même peur."
    "But beneath the smiles, I can still feel the same fear."

# game/scenario/salles/4_1.rpy:607
translate english 9c905479:

    # "On a gagné une bataille."
    "We won a battle."

# game/scenario/salles/4_1.rpy:608
translate english 2a6727c4:

    # "Mais la guerre ne fait que commencer."
    "But the war is only just beginning."

# game/scenario/salles/4_1.rpy:622
translate english 558a59fb:

    # "La salle de repos est transformée en quelques minutes."
    "The lounge is transformed in a matter of minutes."

# game/scenario/salles/4_1.rpy:623
translate english bcf6afec:

    # "Elen a sorti des boissons alcoolisées, des verres en plastique sont disposés partout, et une petite enceinte qui diffuse une musique électronique douce."
    "Elen brought out alcoholic drinks, plastic cups are scattered everywhere, and a small speaker is playing soft electronic music."

# game/scenario/salles/4_1.rpy:624
translate english b19e4c56:

    # "Les lumières bleues sont tamisées par des tissus improvisés. L’ambiance est presque chaleureuse… mais personne n’ose vraiment se détendre."
    "The blue lights are dimmed with makeshift fabrics. The mood is almost warm… but no one really dares to relax."

# game/scenario/salles/4_1.rpy:625
translate english 5b971b18:

    # "Elen distribue des verres avec un sourire un peu forcé. Tout le monde est là."
    "Elen hands out drinks with a slightly forced smile. Everyone’s here."

# game/scenario/salles/4_1.rpy:626
translate english 6593fb1d:

    # "Sael reste en retrait près de la porte, bras croisés, mais elle accepte un verre sans un mot."
    "Sael stays near the door, arms crossed, but she takes a drink without a word."

# game/scenario/salles/4_1.rpy:629
translate english 3d7c144b:

    # julian "A nous, qui avons osé faire changer les choses."
    julian "To us—the ones who dared to change things."

# game/scenario/salles/4_1.rpy:631
translate english facaad0e:

    # "Il lève son verre. Quelques rires fusent, mais ils sonnent faux. Personne n’est vraiment à l’aise."
    "He raises his glass. A few laughs burst out, but they sound fake. No one is really comfortable."

# game/scenario/salles/4_1.rpy:634
translate english 4f495b83:

    # elias "À l’espoir… ouais."
    elias "To hope… yeah."

# game/scenario/salles/4_1.rpy:635
translate english c409bdcc:

    # elias "Mais est-ce qu’on est prêts pour ce qui arrive ?"
    elias "But are we ready for what’s coming?"

# game/scenario/salles/4_1.rpy:638
translate english 4bd5d389:

    # lysa "Prêts ou pas, c’est fait."
    lysa "Ready or not, it’s done."

# game/scenario/salles/4_1.rpy:639
translate english 67225ffb:

    # lysa "On boit pour oublier, ou on boit pour célébrer ?"
    lysa "Are we drinking to forget, or drinking to celebrate?"

# game/scenario/salles/4_1.rpy:640
translate english c8e2a24e:

    # lysa sourire "Au final, peu importe. Santé."
    lysa sourire "In the end, it doesn’t matter. Cheers."

# game/scenario/salles/4_1.rpy:642
translate english 76c20f4b:

    # "La musique tourne. Quelques-uns bougent timidement. Mais l’ambiance reste lourde, comme si tout le monde attendait que quelqu’un dise que c’était une mauvaise idée."
    "The music plays on. A few people move timidly. But the mood stays heavy, like everyone’s waiting for someone to say it was a bad idea."

# game/scenario/salles/4_1.rpy:644
translate english 346e3ee1:

    # "Soudain, l’écran mural s’allume d’un coup. Un rire familier retentit."
    "Suddenly, the wall screen flashes on. A familiar laugh rings out."

# game/scenario/salles/4_1.rpy:652
translate english 4e2a3505:

    # kami "Vous n’alliez quand même PAS faire une fête sans moi ?!"
    kami "You weren’t seriously going to throw a party WITHOUT me?!"

# game/scenario/salles/4_1.rpy:653
translate english 763c46c3:

    # kami "Mes petits rebelles éméchés… je suis vexée !"
    kami "My tipsy little rebels… I’m offended!"

# game/scenario/salles/4_1.rpy:654
translate english 7a9b6532:

    # kami "Trinquons ensemble, allez !"
    kami "Come on—let’s toast together!"

# game/scenario/salles/4_1.rpy:655
translate english 2a93e7b8:

    # kami "À votre courage… ou à votre inconscience. Santé !"
    kami "To your courage… or your recklessness. Cheers!"

# game/scenario/salles/4_1.rpy:657
translate english be1f80e8:

    # "Kami lève un verre virtuel. L’écran clignote vert et rouge en rythme avec la musique."
    "Kami raises a virtual glass. The screen flashes green and red in time with the music."

# game/scenario/salles/4_1.rpy:658
translate english d901ef6a:

    # "Puis elle disparaît aussi vite qu’elle est venue."
    "Then she vanishes as quickly as she appeared."

# game/scenario/salles/4_1.rpy:664
translate english 85c56c8b:

    # "Un rire général, un peu forcé, éclate."
    "A general laugh—slightly forced—breaks out."

# game/scenario/salles/4_1.rpy:665
translate english 58392e6c:

    # "Julian tape sur l’épaule de Tomas. Elen monte le son."
    "Julian pats Tomas on the shoulder. Elen turns the volume up."

# game/scenario/salles/4_1.rpy:666
translate english 0779ef9f:

    # "Les verres se remplissent à nouveau."
    "Glasses are filled again."

# game/scenario/salles/4_1.rpy:668
translate english d3fc178b:

    # "La soirée avance. Et peu à peu, l’alcool fait son effet."
    "The night goes on. Little by little, the alcohol starts to kick in."

# game/scenario/salles/4_1.rpy:669
translate english 9f39407d:

    # "Les voix montent. Les rires aussi."
    "Voices get louder. So do the laughs."

# game/scenario/salles/4_1.rpy:670
translate english be03aff3:

    # "Ryn danse maladroitement avec Elen. Julian raconte une anecdote exagérée. Kael sourit enfin. Même Sael accepte un deuxième puis un troisième verre."
    "Ryn dances awkwardly with Elen. Julian tells an exaggerated story. Kael finally smiles. Even Sael accepts a second drink, then a third."

# game/scenario/salles/4_1.rpy:673
translate english 68a0aa0b:

    # mara "Bon… ça suffit les mines d’enterrement."
    mara "Alright… enough with the funeral faces."

# game/scenario/salles/4_1.rpy:674
translate english 07ab1aaa:

    # mara "On va pimenter un peu la soirée."
    mara "Let’s spice this night up a bit."

# game/scenario/salles/4_1.rpy:675
translate english d6071910:

    # mara "Jeu de la bouteille, qui est partant ?"
    mara "Spin the bottle—who’s in?"

# game/scenario/salles/4_1.rpy:677
translate english cf006f20:

    # "Elle fait tourner une bouteille vide sur la table basse. Les regards se croisent, entre amusement et gêne."
    "She spins an empty bottle on the coffee table. Eyes meet—half amused, half embarrassed."

# game/scenario/salles/4_1.rpy:681
translate english 06607069:

    # tomas "Euh… c’est quoi le jeu de la bouteille ?"
    tomas "Uh… what’s spin the bottle?"

# game/scenario/salles/4_1.rpy:682
translate english 8662463f:

    # tomas "J’ai jamais joué à ça…"
    tomas "I’ve never played that…"

# game/scenario/salles/4_1.rpy:685
translate english 2a2ebbc0:

    # mara "Oh mon dieu, Tomas !"
    mara "Oh my God, Tomas!"

# game/scenario/salles/4_1.rpy:686
translate english 9a01ec55:

    # mara "C’est simple : on tourne la bouteille, et les deux qui sont désignés doivent s'embrasser."
    mara "It’s simple: you spin the bottle, and the two people it lands on have to kiss."

# game/scenario/salles/4_1.rpy:687
translate english 0e5cc564:

    # mara "C’est pour les gamins… ou les adultes qui veulent s’amuser un peu."
    mara "It’s for kids… or for adults who want to have a little fun."

# game/scenario/salles/4_1.rpy:690
translate english 1fa8f36c:

    # iris "Pff. C’est ridicule."
    iris "Pff. That’s ridiculous."

# game/scenario/salles/4_1.rpy:691
translate english d6f3cec7:

    # iris "Je… je vais me coucher."
    iris "I… I’m going to bed."

# game/scenario/salles/4_1.rpy:693
translate english e600af0f:

    # "Iris tente de s’éloigner discrètement, mais Mara l’attrape par le bras."
    "Iris tries to slip away quietly, but Mara grabs her by the arm."

# game/scenario/salles/4_1.rpy:696
translate english 00d83b5b:

    # mara "Non non non, Iris !"
    mara "No, no, no, Iris!"

# game/scenario/salles/4_1.rpy:697
translate english 936962c6:

    # mara "Tu restes. On a besoin de ton corps de rêve pour pimenter ce jeu."
    mara "You’re staying. We need your killer body to spice this game up."

# game/scenario/salles/4_1.rpy:698
translate english 843b3538:

    # mara "Allez, assieds-toi. Un verre et tu changeras d’avis."
    mara "Come on, sit. One drink and you’ll change your mind."

# game/scenario/salles/4_1.rpy:700
translate english 5ab33ae3:

    # iris fatigue "Lâche-moi !"
    iris fatigue "Let go of me!"

# game/scenario/salles/4_1.rpy:701
translate english af1fcbe2:

    # iris fatigue "Pfff... Bon… d’accord. Mais si la bouteille tombe sur moi, je vous maudis tous."
    iris fatigue "Pfff… Fine. But if the bottle lands on me, I’m cursing all of you."

# game/scenario/salles/4_1.rpy:702
translate english b22e9027:

    # iris gene "Mais je ne joue que si Noam joue."
    iris gene "But I’m only playing if Noam plays."

# game/scenario/salles/4_1.rpy:705
translate english dcc33b2f:

    # lysa "Hein ?? Pourquoi ça ?"
    lysa "Huh?? Why?"

# game/scenario/salles/4_1.rpy:707
translate english aed69181:

    # iris gene "P-Pour rien enfin !"
    iris gene "F-For no reason!"

# game/scenario/salles/4_1.rpy:708
translate english a39ad00e:

    # iris gene "C'est plus amusant si tout le monde participe, c'est tout !"
    iris gene "It’s more fun if everyone joins in, that’s all!"

# game/scenario/salles/4_1.rpy:710
translate english b244d4d2:

    # "Mara rit. Iris s’assoit, boudeuse."
    "Mara laughs. Iris sits down, sulking."

# game/scenario/salles/4_1.rpy:715
translate english 1e16fec4:

    # "Je hoche la tête. Pourquoi pas. Ça pourrait détendre l’atmosphère."
    "I nod. Why not. It might lighten the mood."

# game/scenario/salles/4_1.rpy:720
translate english c33db704:

    # "Je décline d’un geste. Pas ce soir."
    "I wave it off. Not tonight."

# game/scenario/salles/4_1.rpy:721
translate english c7379a4a:

    # mara "Tant pis pour toi, Noam. On va bien s’amuser sans toi."
    mara "Your loss, Noam. We’ll have plenty of fun without you."

# game/scenario/salles/4_1.rpy:737
translate english a23231d1:

    # mara "Allez, premier round !"
    mara "Alright, first round!"

# game/scenario/salles/4_1.rpy:738
translate english 3900a092:

    # mara "Tourne, tourne, petite bouteille… fais-nous rêver !"
    mara "Spin, spin, little bottle… make us dream!"

# game/scenario/salles/4_1.rpy:740
translate english 7b938cc6:

    # "La bouteille ralentit… s’arrête sur Noam."
    "The bottle slows… and stops on Noam."

# game/scenario/salles/4_1.rpy:743
translate english 5e788971:

    # noam "Moi ? Sérieusement..."
    noam "Me? Seriously…"

# game/scenario/salles/4_1.rpy:745
translate english 542daf19:

    # "La bouteille pointe ensuite Lysa."
    "Then the bottle points to Lysa."

# game/scenario/salles/4_1.rpy:748
translate english 9706ca4b:

    # lysa "Évidemment que c’est moi... Raah ! Allez, viens Noam."
    lysa "Of course it’s me… Ugh! Come on, Noam."

# game/scenario/salles/4_1.rpy:750
translate english 47543cef:

    # mara "Oh ! Le couple parfait !"
    mara "Oh! The perfect couple!"

# game/scenario/salles/4_1.rpy:751
translate english 7bfd6b29:

    # mara "Embrassez-vous, et pas de bisou sur la joue hein !"
    mara "Kiss—and no cheek kisses, okay?!"

# game/scenario/salles/4_1.rpy:756
translate english 25ff4c5d:

    # "J'hésite une seconde. Lysa hausse un sourcil et se penche en avant avec un sourire en coin."
    "I hesitate for a second. Lysa raises an eyebrow and leans in with a crooked smile."

# game/scenario/salles/4_1.rpy:757
translate english f4aea1bd:

    # "Raaah ! Ca ne sert à rien d'y penser !"
    "Gah! No point overthinking it!"

# game/scenario/salles/4_1.rpy:758
translate english 31ed5feb:

    # "Nous nous embrassons rapidement sur la bouche. C’est bref, mais leurs lèvres restent une seconde de trop."
    "We kiss quickly on the lips. It’s brief, but her lips stay there one second too long."

# game/scenario/salles/4_1.rpy:760
translate english 2751b58e:

    # "La salle explose de rires et d’applaudissements légers."
    "The room erupts in laughter and light applause."

# game/scenario/salles/4_1.rpy:765
translate english 05bc050b:

    # julian "Pas mal ! Pas mal du tout !"
    julian "Not bad! Not bad at all!"

# game/scenario/salles/4_1.rpy:766
translate english b8c3d515:

    # julian "J'adore ce jeu !"
    julian "I love this game!"

# game/scenario/salles/4_1.rpy:769
translate english a58832b4:

    # elen "Lysa ! T’as rougi ! C'est trop mimiii !"
    elen "Lysa! You blushed! That’s sooo cuuute!"

# game/scenario/salles/4_1.rpy:772
translate english 0cfe4e7a:

    # lysa "C’est l’alcool, rien de plus. Pas lui."
    lysa "It’s the alcohol, nothing else. Not him."

# game/scenario/salles/4_1.rpy:773
translate english be366f65:

    # lysa "Mais il embrasse pas mal, je m'y attendais pas."
    lysa "But he’s not a bad kisser. I didn’t expect that."

# game/scenario/salles/4_1.rpy:775
translate english 41d8fe0b:

    # noam "Merci… je crois."
    noam "Thanks… I think."

# game/scenario/salles/4_1.rpy:783
translate english fa9e0666:

    # mara "Deuxième round ! On monte le niveau !"
    mara "Second round! Let’s raise the stakes!"

# game/scenario/salles/4_1.rpy:785
translate english b993b656:

    # "La bouteille tourne… s’arrête sur Tomas."
    "The bottle spins… and stops on Tomas."

# game/scenario/salles/4_1.rpy:788
translate english 2287480e:

    # tomas "Euh… Oh non, pourquoi moi ?"
    tomas "Uh… oh no, why me?"

# game/scenario/salles/4_1.rpy:790
translate english 798a48c6:

    # "La bouteille pointe Sael."
    "The bottle points to Sael."

# game/scenario/salles/4_1.rpy:793
translate english 3794d0dd_5:

    # sael "…"
    sael "…"

# game/scenario/salles/4_1.rpy:795
translate english 4b1c8541:

    # mara "Oh putain ! Sael et Tomas !"
    mara "Oh shit! Sael and Tomas!"

# game/scenario/salles/4_1.rpy:796
translate english 28755db9:

    # mara "Allez Sael, sois gentille avec le petit puceau. Un bisou, pas une exécution !"
    mara "Come on, Sael—be nice to the little virgin. A kiss, not an execution!"

# game/scenario/salles/4_1.rpy:801
translate english d2bcb33d:

    # "Tomas est rouge écarlate. Sael reste immobile une seconde, puis se penche lentement."
    "Tomas turns scarlet. Sael stays still for a second, then leans in slowly."

# game/scenario/salles/4_1.rpy:802
translate english 0be2dd3a:

    # "Le baiser est très court, presque chaste, mais Sael pose une main ferme sur la nuque de Tomas pour le garder un instant."
    "The kiss is very short, almost chaste, but Sael places a firm hand on the back of Tomas’s neck to keep him there for a moment."

# game/scenario/salles/4_1.rpy:803
translate english 1d627adb:

    # "Tomas tremble. Sael recule sans un mot."
    "Tomas trembles. Sael pulls back without a word."

# game/scenario/salles/4_1.rpy:804
translate english 37e0c8b1:

    # "La salle retient son souffle, puis éclate de rires et de sifflets."
    "The room holds its breath—then erupts in laughter and whistles."

# game/scenario/salles/4_1.rpy:809
translate english 23699846:

    # elen "Sael ! Comment t’as été douce !"
    elen "Sael! You were so gentle!"

# game/scenario/salles/4_1.rpy:812
translate english 71425771:

    # julian "Tomas, t’es encore en vie ?"
    julian "Tomas, are you still alive?"

# game/scenario/salles/4_1.rpy:816
translate english 8c0c4f0d:

    # tomas "Je… je crois…"
    tomas "I… I think so…"

# game/scenario/salles/4_1.rpy:819
translate english e46144c2:

    # mara "T’as vu ? Même Sael sait embrasser. T’as pas à avoir honte, petit !"
    mara "See? Even Sael knows how to kiss. Nothing to be ashamed of, kid!"

# game/scenario/salles/4_1.rpy:820
translate english a51fd1c1:

    # mara "Ah ! L'heure tourne ! On finit en apothéose !"
    mara "Ah! Time’s running out! Let’s end on a grand finale!"

# game/scenario/salles/4_1.rpy:822
translate english 043efa3b:

    # "La bouteille tourne… s’arrête sur Kael."
    "The bottle spins… and stops on Kael."

# game/scenario/salles/4_1.rpy:828
translate english 672157a6:

    # kael "Moi ?"
    kael "Me?"

# game/scenario/salles/4_1.rpy:830
translate english c004dcb2:

    # "La bouteille tourne une fois encore puis s'arrête..."
    "The bottle spins one more time, then stops…"

# game/scenario/salles/4_1.rpy:831
translate english 5d3219b2:

    # "La bouteille pointe Elias."
    "The bottle points to Elias."

# game/scenario/salles/4_1.rpy:834
translate english e3902139:

    # elias "Euh… Moi ?"
    elias "Uh… me?"

# game/scenario/salles/4_1.rpy:836
translate english 0991ecf8:

    # mara "Oh ! Kael et Elias !"
    mara "Oh! Kael and Elias!"

# game/scenario/salles/4_1.rpy:837
translate english db04c8d6:

    # mara "Allez les garçons, pour le beau jeu ! Un petit bisou, ça va pas vous tuer !"
    mara "Come on, boys—be good sports! A little kiss won’t kill you!"

# game/scenario/salles/4_1.rpy:839
translate english 93822c16:

    # kael "Je… je sais pas si…"
    kael "I… I don’t know if…"

# game/scenario/salles/4_1.rpy:840
translate english a20da589:

    # kael gene "Non vraiment..."
    kael gene "No, seriously…"

# game/scenario/salles/4_1.rpy:842
translate english d3c43d2d:

    # elias "C’est juste un jeu, Kael."
    elias "It’s just a game, Kael."

# game/scenario/salles/4_1.rpy:843
translate english 4215ccbd:

    # elias "On le fait pour l’ambiance. Pas plus. Allez."
    elias "We’re doing it for the vibe. Nothing more. Come on."

# game/scenario/salles/4_1.rpy:845
translate english c2c4c7ce:

    # "Kael hésite, regarde autour de lui cherchant de l'aide du regard. Tout le monde attend, sourire aux lèvres."
    "Kael hesitates, looking around for help with his eyes. Everyone’s waiting, smiling."

# game/scenario/salles/4_1.rpy:846
translate english 39b1bee5:

    # "Il hoche la tête, très lentement."
    "He nods—very slowly."

# game/scenario/salles/4_1.rpy:851
translate english 083c317a:

    # "Ils se penchent l’un vers l’autre. Le baiser est hésitant au début, puis Elias pose une main sur la nuque de Kael pour le stabiliser."
    "They lean toward each other. The kiss is hesitant at first—then Elias places a hand on the back of Kael’s neck to steady him."

# game/scenario/salles/4_1.rpy:852
translate english 1d4bda60:

    # "C’est bref, mais pas chaste. Leurs lèvres restent collées une seconde de plus que nécessaire."
    "It’s brief, but not chaste. Their lips stay together a second longer than necessary."

# game/scenario/salles/4_1.rpy:853
translate english 574aaa41:

    # "Kael recule, rouge, troublé. Elias sourit doucement."
    "Kael pulls back, red and shaken. Elias smiles softly."

# game/scenario/salles/4_1.rpy:855
translate english 80b6b613:

    # elias "Pour le beau jeu…"
    elias "For the spirit of the game…"

# game/scenario/salles/4_1.rpy:857
translate english b5eae8c7:

    # kael "Ouais… pour le beau jeu."
    kael "Yeah… for the spirit of the game."

# game/scenario/salles/4_1.rpy:861
translate english 50c87165:

    # "La salle explose de rires et d’applaudissements. Mara siffle."
    "The room explodes with laughter and applause. Mara whistles."

# game/scenario/salles/4_1.rpy:864
translate english 48e96937:

    # mara "Putain, c’était mignon !"
    mara "Fuck, that was cute!"

# game/scenario/salles/4_1.rpy:865
translate english a0238d7d:

    # mara taquin "On remet ça demain ?"
    mara taquin "Same time tomorrow?"

# game/scenario/salles/4_1.rpy:868
translate english 01993c4d:

    # kael "Par pitié, non !"
    kael "For the love of God, no!"

# game/scenario/salles/4_1.rpy:882
translate english 8f2f0fbc:

    # "La fête s’est terminée tard. Les rires se sont éteints peu à peu."
    "The party ended late. The laughter faded little by little."

# game/scenario/salles/4_1.rpy:883
translate english 9ff1276f:

    # "Les verres sont vides. Les lumières tamisées."
    "The cups are empty. The lights are dim."

# game/scenario/salles/4_1.rpy:884
translate english 516a8bf1:

    # "Je marche dans les couloirs froids du Conclave. Mes pas sont lourds, un peu chancelants."
    "I walk through the Conclave’s cold corridors. My steps are heavy—slightly unsteady."

# game/scenario/salles/4_1.rpy:885
translate english b9260b4d:

    # "L’alcool me chauffe encore les veines. Ma tête tourne doucement."
    "The alcohol still warms my veins. My head spins gently."

# game/scenario/salles/4_1.rpy:887
translate english bc77ed3e:

    # "Je pousse la porte de ma chambre. Elle se referme derrière moi avec un clic discret."
    "I push open my door. It closes behind me with a soft click."

# game/scenario/salles/4_1.rpy:888
translate english 518285f8:

    # "Je m’appuie contre le mur un instant. Le monde tangue légèrement."
    "I lean against the wall for a moment. The world sways a little."

# game/scenario/salles/4_1.rpy:892
translate english 3502c329:

    # "Je m’assois sur le lit. Mes chaussures tombent par terre sans que je les enlève vraiment."
    "I sit on the bed. My shoes drop to the floor without me really taking them off."

# game/scenario/salles/4_1.rpy:893
translate english 0c41c4c0:

    # "Je fixe le plafond. Les veilleuses bleues clignotent doucement."
    "I stare at the ceiling. The blue night lights blink softly."

# game/scenario/salles/4_1.rpy:896
translate english 0879da5f:

    # "La journée défile dans ma tête."
    "The day plays back in my head."

# game/scenario/salles/4_1.rpy:897
translate english 9f63f9a3:

    # "Le vote. Les cris. Le départ de Sael. La fête."
    "The vote. The shouting. Sael leaving. The party."

# game/scenario/salles/4_1.rpy:898
translate english ed0ef103:

    # "On a ri. On a bu. On a fait semblant que tout allait bien."
    "We laughed. We drank. We pretended everything was fine."

# game/scenario/salles/4_1.rpy:899
translate english a5ab285f:

    # "Mais je sens encore le poids de tout ça dans ma poitrine."
    "But I can still feel the weight of it in my chest."

# game/scenario/salles/4_1.rpy:902
translate english 85452378:

    # "Est-ce qu’on a vraiment gagné quelque chose ?"
    "Did we actually win anything?"

# game/scenario/salles/4_1.rpy:903
translate english 35264e17:

    # "Ou est-ce qu’on vient juste de commencer à perdre ?"
    "Or did we just start losing?"

# game/scenario/salles/4_1.rpy:905
translate english 4d5ae2a8:

    # "Je m’allonge. Les draps sont froids contre ma peau chaude."
    "I lie down. The sheets are cold against my hot skin."

# game/scenario/salles/4_1.rpy:909
translate english b181c050:

    # "Mes paupières sont lourdes. L’alcool fait son effet."
    "My eyelids are heavy. The alcohol is doing its job."

# game/scenario/salles/4_1.rpy:910
translate english 205fb5b8:

    # "Je n’ai même pas la force de me déshabiller."
    "I don’t even have the strength to undress."

# game/scenario/salles/4_1.rpy:912
translate english e75a9653:

    # "Le sommeil arrive vite. Brutal."
    "Sleep comes fast. Brutal."

# game/scenario/salles/4_1.rpy:913
translate english ebd43cdf:

    # "Comme une vague qui m’emporte."
    "Like a wave pulling me under."

# game/scenario/salles/4_1.rpy:915
translate english 41ff633f:

    # "Demain sera un autre jour."
    "Tomorrow will be another day."

# game/scenario/salles/4_1.rpy:916
translate english cf663ece:

    # "Et je ne sais pas si j’ai envie de le voir."
    "And I don’t know if I want to see it."

translate english strings:

    # game/scenario/salles/4_1.rpy:712
    old "Accepter de jouer"
    new "Agree to play"

    # game/scenario/salles/4_1.rpy:712
    old "Refuser poliment"
    new "Refuse politely"