# game/scenario/optional_route_encounters_j13_j16.rpy:6
translate english KD_ROUTE_J13_JULIAN_38b99ce3:

    # "Julian me rattrape avant le croisement qui mène à la cafétéria."
    "Julian catches up to me just before the turn toward the cafeteria."

# game/scenario/optional_route_encounters_j13_j16.rpy:10
translate english KD_ROUTE_J13_JULIAN_fb2aa68e:

    # julian "Tu vas déjeuner avec les autres ?"
    julian "Heading to breakfast with the others?"

# game/scenario/optional_route_encounters_j13_j16.rpy:11
translate english KD_ROUTE_J13_JULIAN_a1d508e6:

    # noam "C'était l'idée."
    noam "That was the plan."

# game/scenario/optional_route_encounters_j13_j16.rpy:12
translate english KD_ROUTE_J13_JULIAN_767579eb:

    # julian "Parfait. Ça fait au moins une personne qui ne m'a pas annoncé une catastrophe aujourd'hui."
    julian "Perfect. That's at least one person who hasn't announced a catastrophe to me today."

# game/scenario/optional_route_encounters_j13_j16.rpy:13
translate english KD_ROUTE_J13_JULIAN_defaf0a8:

    # noam fatigue "Laisse-moi finir mon café avant de te répondre."
    noam fatigue "Let me finish my coffee before I answer."

# game/scenario/optional_route_encounters_j13_j16.rpy:14
translate english KD_ROUTE_J13_JULIAN_36fa7e4d:

    # julian hesitation "Ah. À ce point-là ?"
    julian hesitation "Oh. That bad?"

# game/scenario/optional_route_encounters_j13_j16.rpy:15
translate english KD_ROUTE_J13_JULIAN_44994ed6:

    # noam "J'ai mal dormi, c'est tout."
    noam "I just didn't sleep well. That's all."

# game/scenario/optional_route_encounters_j13_j16.rpy:16
translate english KD_ROUTE_J13_JULIAN_48e0f632:

    # julian sourire "Alors je vais éviter mon grand discours sur les vertus du petit-déjeuner."
    julian sourire "Then I'll spare you my grand speech about the virtues of breakfast."

# game/scenario/optional_route_encounters_j13_j16.rpy:17
translate english KD_ROUTE_J13_JULIAN_e7ce6b25:

    # noam taquin "Tu en avais vraiment préparé un ?"
    noam taquin "You actually had one prepared?"

# game/scenario/optional_route_encounters_j13_j16.rpy:18
translate english KD_ROUTE_J13_JULIAN_422049bf:

    # julian "Je suis toujours prêt à prendre la parole."
    julian "I'm always ready to make a speech."

# game/scenario/optional_route_encounters_j13_j16.rpy:26
translate english KD_ROUTE_J13_ELIAS_955707b1:

    # "Elias passe dans le couloir, une boîte de petites pièces sous le bras."
    "Elias walks past carrying a box of small parts under one arm."

# game/scenario/optional_route_encounters_j13_j16.rpy:30
translate english KD_ROUTE_J13_ELIAS_2df2d7c9:

    # elias "Hé, Noam. T'as besoin d'un coup de main ?"
    elias "Hey, Noam. Need a hand?"

# game/scenario/optional_route_encounters_j13_j16.rpy:31
translate english KD_ROUTE_J13_ELIAS_48dc6927:

    # noam "Pourquoi tu me demandes ça ?"
    noam "Why do you ask?"

# game/scenario/optional_route_encounters_j13_j16.rpy:32
translate english KD_ROUTE_J13_ELIAS_12fc3a46:

    # elias "Tu regardes ta tablette comme si elle allait t'exploser à la figure."
    elias "You're looking at your tablet like it's about to blow up in your face."

# game/scenario/optional_route_encounters_j13_j16.rpy:33
translate english KD_ROUTE_J13_ELIAS_4f706bee:

    # noam reflexion "C'est pas un problème technique."
    noam reflexion "It's not a technical problem."

# game/scenario/optional_route_encounters_j13_j16.rpy:34
translate english KD_ROUTE_J13_ELIAS_9cf7941a:

    # elias taquin "Pour une fois ? Je vais noter la date."
    elias taquin "For once? I'm writing down the date."

# game/scenario/optional_route_encounters_j13_j16.rpy:35
translate english KD_ROUTE_J13_ELIAS_53cde6d4:

    # noam "Tu fais que réparer les affaires des autres, ici ?"
    noam "Is fixing other people's stuff all you do around here?"

# game/scenario/optional_route_encounters_j13_j16.rpy:36
translate english KD_ROUTE_J13_ELIAS_6f09ce64:

    # elias fatigue "Disons que ça m'évite de trop réfléchir au reste."
    elias fatigue "Let's just say it stops me thinking too much about everything else."

# game/scenario/optional_route_encounters_j13_j16.rpy:37
translate english KD_ROUTE_J13_ELIAS_f224fbee:

    # noam "Pas bête, comme méthode."
    noam "Not a bad way to do things."

# game/scenario/optional_route_encounters_j13_j16.rpy:38
translate english KD_ROUTE_J13_ELIAS_5b337c20:

    # elias sourire "Si tu changes d'avis, tu sais où trouver l'atelier."
    elias sourire "If you change your mind, you know where the workshop is."

# game/scenario/optional_route_encounters_j13_j16.rpy:46
translate english KD_ROUTE_J14_LYSA_494a1e01:

    # "Lysa arrive en sens inverse et ralentit en me voyant rejoindre les dortoirs."
    "Lysa comes from the opposite direction and slows down when she sees me heading toward the dorms."

# game/scenario/optional_route_encounters_j13_j16.rpy:50
translate english KD_ROUTE_J14_LYSA_e889e81e:

    # lysa "Tu retournes déjà te coucher ?"
    lysa "Going back to bed already?"

# game/scenario/optional_route_encounters_j13_j16.rpy:51
translate english KD_ROUTE_J14_LYSA_cac5ab74:

    # noam "Non. J'ai quelqu'un à voir."
    noam "No. I've got someone to see."

# game/scenario/optional_route_encounters_j13_j16.rpy:52
translate english KD_ROUTE_J14_LYSA_cae5c881:

    # lysa taquin "Mystérieux. Je dois deviner ou tu vas me le dire ?"
    lysa taquin "Mysterious. Am I supposed to guess, or will you tell me?"

# game/scenario/optional_route_encounters_j13_j16.rpy:53
translate english KD_ROUTE_J14_LYSA_767269de:

    # noam "Je vais parler à Sael."
    noam "I'm going to talk to Sael."

# game/scenario/optional_route_encounters_j13_j16.rpy:54
translate english KD_ROUTE_J14_LYSA_bd99d9a2:

    # lysa neutre "Ah. Bon courage, alors."
    lysa neutre "Oh. Good luck, then."

# game/scenario/optional_route_encounters_j13_j16.rpy:55
translate english KD_ROUTE_J14_LYSA_1ab11fed:

    # noam reflexion "Pourquoi ?"
    noam reflexion "Why?"

# game/scenario/optional_route_encounters_j13_j16.rpy:56
translate english KD_ROUTE_J14_LYSA_0d5a3534:

    # lysa "Parce que vous avez tous les deux la tête de gens qui ont une conversation désagréable en retard."
    lysa "Because you both look like you've been putting off a really unpleasant conversation."

# game/scenario/optional_route_encounters_j13_j16.rpy:57
translate english KD_ROUTE_J14_LYSA_9acfd9e6:

    # noam fatigue "C'est pas complètement faux."
    noam fatigue "You're not entirely wrong."

# game/scenario/optional_route_encounters_j13_j16.rpy:58
translate english KD_ROUTE_J14_LYSA_8388db2f:

    # lysa blase "Évite juste de revenir encore plus énervé."
    lysa blase "Just try not to come back even angrier."

# game/scenario/optional_route_encounters_j13_j16.rpy:66
translate english KD_ROUTE_J15_ELEN_13bc84fc:

    # "Elen m'aperçoit près du passage vers l'Observation et lève timidement la main."
    "Elen spots me near the passage to the observation room and gives a tentative wave."

# game/scenario/optional_route_encounters_j13_j16.rpy:70
translate english KD_ROUTE_J15_ELEN_7f7c683f:

    # elen "Tu vas retrouver Kael ?"
    elen "Going to meet Kael?"

# game/scenario/optional_route_encounters_j13_j16.rpy:71
translate english KD_ROUTE_J15_ELEN_a4454ded:

    # noam "Oui. Pourquoi ?"
    noam "Yeah. Why?"

# game/scenario/optional_route_encounters_j13_j16.rpy:72
translate english KD_ROUTE_J15_ELEN_951202a5:

    # elen "Je sais pas trop ce que vous préparez, mais vous aviez pas l'air très détendus."
    elen "I don't really know what you two are planning, but you didn't look exactly relaxed."

# game/scenario/optional_route_encounters_j13_j16.rpy:73
translate english KD_ROUTE_J15_ELEN_7428da0d:

    # noam reflexion "On doit vérifier certaines choses."
    noam reflexion "We've got a few things to check."

# game/scenario/optional_route_encounters_j13_j16.rpy:74
translate english KD_ROUTE_J15_ELEN_7cc6276f:

    # elen "Alors... bon courage."
    elen "Then... good luck."

# game/scenario/optional_route_encounters_j13_j16.rpy:75
translate english KD_ROUTE_J15_ELEN_c479e2cc:

    # noam sourire "C'est gentil."
    noam sourire "That's kind of you."

# game/scenario/optional_route_encounters_j13_j16.rpy:76
translate english KD_ROUTE_J15_ELEN_b7afeb70:

    # elen sourire "Et si ça se passe mal, viens manger avec nous après. Enfin, même si ça se passe bien."
    elen sourire "And if it goes badly, come eat with us afterward. Actually, even if it goes well."

# game/scenario/optional_route_encounters_j13_j16.rpy:77
translate english KD_ROUTE_J15_ELEN_db7e6de8:

    # noam taquin "Je vais essayer de garder les deux options."
    noam taquin "I'll try to keep both options open."

# game/scenario/optional_route_encounters_j13_j16.rpy:78
translate english KD_ROUTE_J15_ELEN_c278686a:

    # elen joie "Ça me va !"
    elen joie "Works for me!"

# game/scenario/optional_route_encounters_j13_j16.rpy:86
translate english KD_ROUTE_J16_JULIAN_d268a9b5:

    # "Julian s'arrête à ma hauteur et m'observe avec une curiosité peu discrète."
    "Julian stops beside me and gives me a rather unsubtle once-over."

# game/scenario/optional_route_encounters_j13_j16.rpy:90
translate english KD_ROUTE_J16_JULIAN_bb1e82a2:

    # julian "Tu fais cette tête depuis combien de temps ?"
    julian "How long have you been making that face?"

# game/scenario/optional_route_encounters_j13_j16.rpy:91
translate english KD_ROUTE_J16_JULIAN_8ae9beea:

    # noam "Quelle tête ?"
    noam "What face?"

# game/scenario/optional_route_encounters_j13_j16.rpy:92
translate english KD_ROUTE_J16_JULIAN_80613578:

    # julian "Celle du type qui se prépare à interroger tout le Conclave."
    julian "The one that says you're about to interrogate the entire Conclave."

# game/scenario/optional_route_encounters_j13_j16.rpy:93
translate english KD_ROUTE_J16_JULIAN_25f6ccfc:

    # noam reflexion "J'ai juste mal dormi."
    noam reflexion "I just slept badly."

# game/scenario/optional_route_encounters_j13_j16.rpy:94
translate english KD_ROUTE_J16_JULIAN_cd8d293d:

    # julian "C'est fou, ici tout le monde dort mal et personne n'a jamais envie d'en parler."
    julian "Funny, isn't it? Nobody sleeps here, and nobody ever wants to talk about why."

# game/scenario/optional_route_encounters_j13_j16.rpy:95
translate english KD_ROUTE_J16_JULIAN_6a9c76c3:

    # noam taquin "Tu tiens à entendre le récit de mes insomnies ?"
    noam taquin "Do you really want the story of my insomnia?"

# game/scenario/optional_route_encounters_j13_j16.rpy:96
translate english KD_ROUTE_J16_JULIAN_3bd2cf9a:

    # julian hesitation "À la réflexion, non."
    julian hesitation "On second thought, no."

# game/scenario/optional_route_encounters_j13_j16.rpy:97
translate english KD_ROUTE_J16_JULIAN_a9d35ed8:

    # noam "Alors on va manger."
    noam "Then let's get something to eat."

# game/scenario/optional_route_encounters_j13_j16.rpy:98
translate english KD_ROUTE_J16_JULIAN_1abfff40:

    # julian sourire "Voilà une proposition que je soutiens sans amendement."
    julian sourire "Now THERE'S a proposal I'd support without amendments."

# game/scenario/optional_route_encounters_j13_j16.rpy:106
translate english KD_ROUTE_J16_TOMAS_82888b9e:

    # "Tomas sort des Archives, sa tablette serrée contre lui."
    "Tomas comes out of the archives, holding his tablet tightly against his chest."

# game/scenario/optional_route_encounters_j13_j16.rpy:110
translate english KD_ROUTE_J16_TOMAS_623de9c9:

    # tomas "Tu viens consulter les dossiers sur M16 ?"
    tomas "Are you here to look up the M16 files?"

# game/scenario/optional_route_encounters_j13_j16.rpy:111
translate english KD_ROUTE_J16_TOMAS_fdcebc0a:

    # noam hesitation "Pourquoi cette question ?"
    noam hesitation "Why do you ask?"

# game/scenario/optional_route_encounters_j13_j16.rpy:112
translate english KD_ROUTE_J16_TOMAS_8a3f472e:

    # tomas "Je t'ai vu regarder vers les Archives. Je pensais que tu cherchais les mêmes documents que nous."
    tomas "I saw you looking toward the archives. I thought you might be after the same records we are."

# game/scenario/optional_route_encounters_j13_j16.rpy:113
translate english KD_ROUTE_J16_TOMAS_eb86ab91:

    # noam "J'ai autre chose à vérifier."
    noam "I've got something else to check."

# game/scenario/optional_route_encounters_j13_j16.rpy:114
translate english KD_ROUTE_J16_TOMAS_30883908:

    # tomas "Ah. Tu veux que je t'aide à retrouver un fichier ?"
    tomas "Oh. Want me to help you find a file?"

# game/scenario/optional_route_encounters_j13_j16.rpy:115
translate english KD_ROUTE_J16_TOMAS_30e8d7bd:

    # noam desaccord "Non, merci. Je préfère regarder tout seul."
    noam desaccord "No, thanks. I'd rather look on my own."

# game/scenario/optional_route_encounters_j13_j16.rpy:116
translate english KD_ROUTE_J16_TOMAS_131b9164:

    # tomas inquiet "D'accord. Je voulais pas être indiscret."
    tomas inquiet "All right. I didn't mean to pry."

# game/scenario/optional_route_encounters_j13_j16.rpy:117
translate english KD_ROUTE_J16_TOMAS_4de4cc36:

    # noam fatigue "Je sais. Désolé."
    noam fatigue "I know. Sorry."

# game/scenario/optional_route_encounters_j13_j16.rpy:118
translate english KD_ROUTE_J16_TOMAS_54fc514a:

    # tomas "Si tu ne trouves pas, le terminal classe les dossiers par date."
    tomas "If you can't find it, the terminal sorts the files by date."

