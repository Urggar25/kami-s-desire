# game/scenario/1_canon.rpy:56
translate english 867d890b:

    # think "Jour un."
    think "Day one."

# game/scenario/1_canon.rpy:57
translate english 8bc21391:

    # think "Enfin, je crois... Tout ce dont je me rappelle, c'est ce foutu caisson et ce mal de crâne qui ne me quitte plus."
    think "At least, I think so... All I remember is that damn pod and this headache that just won't go away."

# game/scenario/1_canon.rpy:63
translate english b2d14fc0:

    # think "Dossier rigide. Métal froid. Air recyclé. Plastique neuf. Finalement, j'ai l'impression de n'avoir jamais quitté Harmonie."
    think "Rigid backrest. Cold metal. Recycled air. Brand-new plastic. Somehow, it feels like I never left Harmony."

# game/scenario/1_canon.rpy:64
translate english 17bf62a7:

    # think "C'est exactement le même niveau de confort... Si on peut appeler ça comme ça."
    think "Exactly the same level of comfort... if you can even call it that."

# game/scenario/1_canon.rpy:68
translate english ee7ba04b:

    # noam "Ma main..."
    noam "My hand..."

# game/scenario/1_canon.rpy:69
translate english 7576e8a2:

    # think "J'ai la tête qui tourne, la bouche sèche, la nuque en vrac. Qu'est-ce qu'ils ont utilisé comme produit pour nous endormir ?!"
    think "My head's spinning, my mouth is dry, and my neck is killing me. What the hell did they use to knock us out?!"

# game/scenario/1_canon.rpy:77
translate english 48ee1469:

    # think "J'étends mes bras devant moi, difficilement, mais j'y parviens."
    think "I force my arms out in front of me. It's a struggle, but I manage."

# game/scenario/1_canon.rpy:78
translate english 9be01c34:

    # think "Tout me semble lointain, comme si je me réveillais d'une anesthésie complète."
    think "Everything feels far away, like I'm coming out of general anesthesia."

# game/scenario/1_canon.rpy:79
translate english 4ec4100d:

    # think "Il y a des sièges en cercle. Un corps sur chacun. Certains remuent, d'autres dorment encore."
    think "The seats form a circle. One body in each. Some are stirring; others are still asleep."

# game/scenario/1_canon.rpy:80
translate english d065f8c3:

    # think "Il n'y a pas beaucoup de bruits, des respirations fortes, des vêtements qui se froissent, une gorge qui racle. Personne n'ose faire davantage de bruit."
    think "There isn't much noise—heavy breathing, clothes rustling, someone clearing their throat. No one dares make any more than that."

# game/scenario/1_canon.rpy:83
translate english d1a5e084:

    # voix "Initialisation en cours..."
    voix "Initialization in progress..."

# game/scenario/1_canon.rpy:84
translate english 2011736e:

    # think "Une voix robotique retentit depuis plus bas. Il y a plusieurs niveaux, peut-être."
    think "A robotic voice rings out from somewhere below. There may be several levels."

# game/scenario/1_canon.rpy:85
translate english bc5d110a:

    # think "Une tablette noire est encastrée dans mon pupitre."
    think "A black tablet is built into my desk."

# game/scenario/1_canon.rpy:91
translate english e83c78a4:

    # think "Voyons voir ce que tu as à m'apprendre."
    think "Let's see what you have to tell me."

# game/scenario/1_canon.rpy:95
translate english cdb3d316:

    # voix "Noam. Accès limité."
    voix "Noam. Restricted access."

# game/scenario/1_canon.rpy:96
translate english d7b7cd85:

    # think "Elle me reconnaît à ma main, ils ont dû prendre nos empreintes."
    think "It recognizes my hand. They must have taken our fingerprints."

# game/scenario/1_canon.rpy:99
translate english 98184fc9:

    # think "La tablette ne m'intéresse pas."
    think "The tablet doesn't interest me."

# game/scenario/1_canon.rpy:100
translate english 6be23410:

    # think "Pas maintenant. Pas avant de comprendre où on est."
    think "Not now. Not until I know where we are."

# game/scenario/1_canon.rpy:102
translate english ab35ed28:

    # think "Je cherche des yeux Lysa. C'est la seule personne ici que je connais. Enfin connaître, je ne connais que son prénom."
    think "I scan the room for Lysa. She's the only person here I know. Well, \"know\"—I only know her first name."

# game/scenario/1_canon.rpy:119
translate english 67a8b6f6:

    # noam inquiet "Lysa… ?"
    noam inquiet "Lysa...?"

# game/scenario/1_canon.rpy:121
translate english d35a3874:

    # lysa blase "Sérieux, arrête de crier !"
    lysa blase "Seriously, stop shouting!"

# game/scenario/1_canon.rpy:123
translate english 237502e6:

    # noam inquiet "Hein ? Mais je crie pas..."
    noam inquiet "What? I'm not shouting..."

# game/scenario/1_canon.rpy:125
translate english 3124851e:

    # lysa blase "Bien sûr que si que tu cries, tu ne t'en rends même pas compte ?"
    lysa blase "Of course you are. You can't even hear yourself?"

# game/scenario/1_canon.rpy:126
translate english 8c2adbb8:

    # lysa blase "Les Sept Dormants ont tenu des siècles. Toi, au bout de dix minutes, et t'as déjà mauvaise mine."
    lysa blase "The Seven Sleepers lasted for centuries. You've been awake ten minutes and you already look half-dead."

# game/scenario/1_canon.rpy:128
translate english 46df573f:

    # noam inquiet "On est où… ?"
    noam inquiet "Where are we...?"

# game/scenario/1_canon.rpy:130
translate english e13e553c:

    # lysa reflexion "Tu vois bien où on est. À ton avis... Le Conclave."
    lysa reflexion "You can see where we are. Where do you think...? The Conclave."

# game/scenario/1_canon.rpy:131
translate english 26c6760a:

    # lysa reflexion "Mais faut dire que je voyais ça d'une façon totalement différente."
    lysa reflexion "Though I have to admit, I pictured it completely differently."

# game/scenario/1_canon.rpy:133
translate english 638a8d04:

    # think "Je regarde autour, en m'efforçant de ne pas parler. Je ne reconnais aucun autre visage. Donc c'est vrai : les douze représentants sont bien réunis dans la même cage."
    think "I look around, trying not to speak. I don't recognize a single other face. So it's true: all twelve representatives really are gathered in the same cage."

# game/scenario/1_canon.rpy:135
translate english 1325db4a:

    # "Un homme se lève d'un bond. Son siège claque au sol."
    "A man springs to his feet. His chair crashes to the floor."

# game/scenario/1_canon.rpy:137
translate english 796707ad:

    # ryn colere "Putain mais on est où là ?!"
    ryn colere "Where the fuck are we?!"

# game/scenario/1_canon.rpy:138
translate english ab97f83d:

    # ryn colere "Qui a fait ça ?!"
    ryn colere "Who did this?!"

# game/scenario/1_canon.rpy:140
translate english 823c1de7:

    # mara rire "Tu veux dire... à part l'IA qui tient le monde en laisse ?"
    mara rire "You mean... besides the AI that keeps the whole world on a leash?"

# game/scenario/1_canon.rpy:141
translate english 08e29fbe:

    # mara taquin "Joli réveil, cela dit. Très viril. Les caméras ont dû adorer."
    mara taquin "Nice entrance, by the way. Very manly. The cameras must've loved it."

# game/scenario/1_canon.rpy:142
translate english 4a1b358f:

    # "Elle fait un mouvement de tête dans une direction, pour montrer une caméra."
    "She tips her head toward one of the cameras."

# game/scenario/1_canon.rpy:144
translate english b9a3aea5:

    # ryn colere "Hein ?! Mais de quoi vous parlez ?"
    ryn colere "What?! What the hell are you talking about?"

# game/scenario/1_canon.rpy:145
translate english 0d60dd18:

    # ryn colere "Je parle de ce qui nous arrive, là, maintenant."
    ryn colere "I'm talking about what's happening to us. Right here, right now."

# game/scenario/1_canon.rpy:146
translate english 65a5ca1d:

    # ryn colere "Qui nous a endormis."
    ryn colere "Who knocked us out."

# game/scenario/1_canon.rpy:147
translate english 35d16e79:

    # ryn colere "Qui nous a trimballés ici."
    ryn colere "Who dragged us here."

# game/scenario/1_canon.rpy:148
translate english ba21abbb:

    # ryn colere "J'en ai rien à foutre de Kami et de ses règles idiotes moi !"
    ryn colere "I don't give a shit about Kami or her stupid rules!"

# game/scenario/1_canon.rpy:150
translate english 501329d7:

    # tomas reflechit "C-Comment ça t'es au courant de rien ..?"
    tomas reflechit "W-What do you mean you don't know anything...?"

# game/scenario/1_canon.rpy:151
translate english 0971d601:

    # tomas reflechit "Tu... Tu as bien entendu l'annonce, non ?!"
    tomas reflechit "You... You heard the announcement, didn't you?!"

# game/scenario/1_canon.rpy:153
translate english f93f9f7d:

    # elen surpris "Aaaaah, je sais même pas depuis combien de temps on était là, c'est quand même nous qu'on a emballés dans des boîtes, non ?"
    elen surpris "Aaaah, I don't even know how long we were in there. We're the ones they packed into boxes, right?"

# game/scenario/1_canon.rpy:154
translate english 4ffd1c4d:

    # elen surpris "Oh ! Vous croyez qu'ils ont prévu à manger ? Parce que le gaz, franchement, ça ouvre l'appétit et—"
    elen surpris "Oh! Do you think they brought food? Because honestly, that gas really works up an appetite, and—"

# game/scenario/1_canon.rpy:156
translate english 9e1e3c4e:

    # ryn colere "Hein ?! Emballé dans des boîtes ? Mais qu'est-ce que vous racontez ? Et qui vous êtes d'abord !"
    ryn colere "What?! Packed into boxes? What the hell are you talking about? And who even are you people?!"

# game/scenario/1_canon.rpy:158
translate english bea6390c:

    # lysa blase "Sérieux ? Comment ça t'es au courant de rien ?"
    lysa blase "Seriously? How do you not know any of this?"

# game/scenario/1_canon.rpy:160
translate english d3fc2751:

    # ryn colere "Vous êtes de mèche avec ceux qui m'ont attaqué ? C'est ça ?!"
    ryn colere "You're working with the people who jumped me, aren't you?!"

# game/scenario/1_canon.rpy:161
translate english 65c96de3:

    # ryn colere "Vous avez de la chance de m'avoir pris dans le dos, sinon je vous aurais eu !"
    ryn colere "You're lucky you took me from behind, or I would've had you!"

# game/scenario/1_canon.rpy:163
translate english e26931e8:

    # mara taquin "Ah parce qu'en plus tu as perdu la bagarre ?!"
    mara taquin "Wait, you lost the fight too?!"

# game/scenario/1_canon.rpy:165
translate english 930329e3:

    # ryn colere "Quoi ?? Qu'est-ce que t'as dit !"
    ryn colere "What?! What did you just say?!"

# game/scenario/1_canon.rpy:167
translate english 11dae6d1:

    # mara taquin "Ouuuh effraaayant !"
    mara taquin "Ooooh, scaaary!"

# game/scenario/1_canon.rpy:169
translate english f08bf752:

    # noam "Bon arrêtez un peu là. Je pense qu'on essaye tous de comprendre ce qui nous arrive."
    noam "All right, enough. I think we're all trying to figure out what's happening to us."

# game/scenario/1_canon.rpy:171
translate english 33313659:

    # think "Je cherche les caméras. Elles sont propres, discrètes, partout. Enfin quelque chose de familier."
    think "I look for the cameras. Clean, discreet, everywhere. Finally, something familiar."

# game/scenario/1_canon.rpy:173
translate english 6a9aa3b3:

    # julian peur "On pourrait presque apprécier le silence, si l'un d'entre nous ne faisait pas que de meugler."
    julian peur "I might almost enjoy the silence if one of us would stop bellowing."

# game/scenario/1_canon.rpy:174
translate english 514d713c:

    # julian reflexion "Kami veut que nous nous sentions seuls. JE refuse de lui offrir ce spectacle."
    julian reflexion "Kami wants us to feel alone. I refuse to give her that satisfaction."

# game/scenario/1_canon.rpy:176
translate english 5cdde3f2:

    # iris inquiet "Tu ne changeras donc jamais."
    iris inquiet "You really never change."

# game/scenario/1_canon.rpy:177
translate english 9fb26d2b:

    # iris blase "On attend quoi ? Un miracle ? Une notice ? Quelqu'un de compétent ? On ne sait même pas ce qu'on doit faire."
    iris blase "What are we waiting for? A miracle? Instructions? Someone competent? We don't even know what we're supposed to do."

# game/scenario/1_canon.rpy:179
translate english 0e3653f6:

    # nyra triste "Si elle voulait nous parler elle pourrait le faire à tout moment."
    nyra triste "If she wanted to talk to us, she could do it at any time."

# game/scenario/1_canon.rpy:180
translate english 6ab4f71b:

    # nyra neutre "Elle est omnipotente après tout."
    nyra neutre "She is omnipotent, after all."

# game/scenario/1_canon.rpy:182
translate english 1e067268:

    # kael calme "Mouais, si elle a envie."
    kael calme "Yeah. If she feels like it."

# game/scenario/1_canon.rpy:183
translate english fd3bb769:

    # kael calme "Si ça se trouve ça la fait marrer de voir douze inconnus enfermés dans une pièce."
    kael calme "For all we know, she's getting a kick out of watching twelve strangers locked in a room."

# game/scenario/1_canon.rpy:185
translate english 82395c0f:

    # elen inquiet "Hein ?? On est enfermés ?!"
    elen inquiet "What?! We're locked in?!"

# game/scenario/1_canon.rpy:186
translate english 0ba3952d:

    # elen inquiet "Mais comment qu'on va faire..."
    elen inquiet "But what are we gonna do...?"

# game/scenario/1_canon.rpy:187
translate english 91c15b81:

    # elen fatigue "Aaaahh ! En plus j'ai envie d'aller faire pipi !"
    elen fatigue "Aaaah! And I really need to pee!"

# game/scenario/1_canon.rpy:189
translate english 26a336a4:

    # ryn reflechit "Et bah retiens-toi. Fais comme tout le monde"
    ryn reflechit "Then hold it. Like everyone else."

# game/scenario/1_canon.rpy:191
translate english c2409ded:

    # mara rire "Facile à dire quand on est un mec. Tu pourrais aller pisser dans un coin de la pièce que y'aurait pas de problème."
    mara rire "Easy for you to say. You're a guy—you could piss in a corner and no one would care."

# game/scenario/1_canon.rpy:193
translate english da5d8326:

    # ryn colere "Quoi ?! C'est pas parce que je suis de Limen que je sais pas me tenir !"
    ryn colere "What?! Just because I'm from Limen doesn't mean I can't behave myself!"

# game/scenario/1_canon.rpy:195
translate english 0529f15c:

    # mara rire "J'adore. Douze pigeons, zéro animateur. Et un susceptible."
    mara rire "I love this. Twelve suckers, no host, and one very touchy man."

# game/scenario/1_canon.rpy:196
translate english d05cadb6:

    # mara taquin "Il est vraiment mal foutu cet enlèvement. Amatrice !"
    mara taquin "This is one badly planned kidnapping. Amateur hour."

# game/scenario/1_canon.rpy:198
translate english 4f5650ae:

    # tomas reflechit "T-Tu sais qu'elle entend tout ce qu'on dit ? Tout le temps."
    tomas reflechit "Y-You know she can hear everything we say, right? All the time."

# game/scenario/1_canon.rpy:199
translate english cb9f541d:

    # tomas reflechit "Le fait qu'on ne la voie pas ne change rien à ce qu'on fait à cause d'elle."
    tomas reflechit "Just because we can't see her doesn't change what she makes us do."

# game/scenario/1_canon.rpy:201
translate english bd346b76:

    # think "D'habitude, Kami adore être présente. Là, c'est comme une salle de classe sans prof."
    think "Normally, Kami loves making her presence known. Right now, it feels like a classroom with no teacher."

# game/scenario/1_canon.rpy:202
translate english 4fe8a28e:

    # think "Sauf qu'ici le prof peut tuer les élèves à tout moment, et à distance."
    think "Except here, the teacher can kill the students at any time. From a distance."

# game/scenario/1_canon.rpy:204
translate english 40486bf3:

    # lysa fatigue "... Silence radio."
    lysa fatigue "...Radio silence."

# game/scenario/1_canon.rpy:206
translate english f5dda635:

    # noam reflexion "Ça veut dire quoi pour toi ?"
    noam reflexion "What does that mean to you?"

# game/scenario/1_canon.rpy:208
translate english 41c5de65:

    # lysa blase "J'en sais rien."
    lysa blase "Hell if I know."

# game/scenario/1_canon.rpy:209
translate english 51de6b06:

    # "Elle se dirige vers la porte puis tente de l'ouvrir."
    "She walks over to the door and tries to open it."

# game/scenario/1_canon.rpy:210
translate english eec437f1:

    # lysa colere "Putain, ça s'ouvre pas."
    lysa colere "Fuck. It won't open."

# game/scenario/1_canon.rpy:212
translate english 178b1a9e:

    # tomas neutre "Tu as une erreur en particulier ?"
    tomas neutre "Are you getting a specific error?"

# game/scenario/1_canon.rpy:214
translate english bd17d543:

    # lysa "Hein ? Euh attends..."
    lysa "Huh? Uh, hold on..."

# game/scenario/1_canon.rpy:215
translate english 05b4fc29:

    # lysa "Lysa, Permission denied..."
    lysa "Lysa. Permission denied..."

# game/scenario/1_canon.rpy:217
translate english d2795ca8:

    # tomas reflechit "D-Donc ça te détecte et... Et il y a un système de permission par personne..."
    tomas reflechit "S-So it detects you and... and permissions are assigned individually..."

# game/scenario/1_canon.rpy:218
translate english ea368ace:

    # tomas raison "On devrait peut-être tous essayer ?"
    tomas raison "Maybe we should all try?"

# game/scenario/1_canon.rpy:220
translate english e881836c:

    # lysa blase "T'en as d'autres des idées de génie ?"
    lysa blase "Got any more brilliant ideas?"

# game/scenario/1_canon.rpy:221
translate english d2523f6e:

    # lysa fatigue "Je vois pas pourquoi l'un d'entre nous aurait des permissions que les autres n'auraient pas."
    lysa fatigue "I don't see why one of us would have permissions the others don't."

# game/scenario/1_canon.rpy:223
translate english 32ac831b:

    # nyra hesitation "Sauf si elle veut créer des tensions dans le groupe dès le début ?"
    nyra hesitation "Unless she wants to turn us against each other from the very beginning?"

# game/scenario/1_canon.rpy:227
translate english a8ce3522:

    # think "Tout le monde se regarde de travers."
    think "Everyone starts eyeing everyone else with suspicion."

# game/scenario/1_canon.rpy:228
translate english 853cf1d9:

    # think "L'un d'entre nous a-t-il la permission d'ouvrir la porte ?"
    think "Does one of us have permission to open the door?"

# game/scenario/1_canon.rpy:230
translate english 6db645c4:

    # elias inquiet "Sinon, on peut tenter de la forcer."
    elias inquiet "Or we could try forcing it."

# game/scenario/1_canon.rpy:232
translate english 2c1f51e3:

    # iris peur "Tu veux nous faire tuer ou quoi ?!"
    iris peur "Are you trying to get us killed?!"

# game/scenario/1_canon.rpy:234
translate english 14d6212c:

    # sael raison "Il n'y a pas le choix."
    sael raison "We don't have a choice."

# game/scenario/1_canon.rpy:235
translate english 8083ccfe:

    # sael raison "Ma grand-mère disait que le premier pas dans le brouillard appartient rarement à celui qui le fait."
    sael raison "My grandmother used to say that the first step into the fog rarely belongs to the person who takes it."

# game/scenario/1_canon.rpy:236
translate english a2e67f91:

    # sael raison "Il faut prendre une décision claire."
    sael raison "We need to make a clear decision."

# game/scenario/1_canon.rpy:238
translate english 3c08d7a4:

    # elen desaccord "Mais attendre, c'est risqué aussi, nooon ?"
    elen desaccord "But waiting is risky too, riiight?"

# game/scenario/1_canon.rpy:239
translate english 9d31b728:

    # elen desaccord "C'est comme laisser un plat au four en espérant qu'il décide tout seul de pas brûler !"
    elen desaccord "It's like leaving food in the oven and hoping it decides not to burn all by itself!"

# game/scenario/1_canon.rpy:241
translate english 0ae7db78:

    # sael "Donc il faut choisir. Soit on tente d'ouvrir la porte."
    sael "Then we choose. Either we try to open the door..."

# game/scenario/1_canon.rpy:242
translate english 06923a7c:

    # sael "Soit on attend."
    sael "Or we wait."

# game/scenario/1_canon.rpy:244
translate english 90d23b9f:

    # think "Mon cœur accélère."
    think "My heart starts racing."

# game/scenario/1_canon.rpy:246
translate english e05ca73f:

    # tuto "Prêt pour un nouveau tutoriel ?"
    tuto "Ready for another tutorial?"

# game/scenario/1_canon.rpy:247
translate english fb67b769:

    # tuto "J'espère bien !"
    tuto "You'd better be!"

# game/scenario/1_canon.rpy:248
translate english 54698e99:

    # tuto "Au cours de votre aventure, vous pourrez faire des choix !"
    tuto "Throughout your adventure, you'll be able to make choices!"

# game/scenario/1_canon.rpy:249
translate english 796e7eff:

    # tuto "Mais attention, tous les choix ne se valent pas !"
    tuto "But be careful—not all choices are created equal!"

# game/scenario/1_canon.rpy:250
translate english c8eff588:

    # tuto "Il y a des choix mineurs qui ont une importance limitée : ils peuvent changer vos relations, ou vous débloquer de petites scènes différentes."
    tuto "Some choices are minor and have limited consequences: they may affect your relationships or unlock small alternate scenes."

# game/scenario/1_canon.rpy:251
translate english 2c47b132:

    # tuto "Et puis il y a les choix CRITIQUES. Qui peuvent changer TOUT LE RESTE de votre aventure ou vous réserver bien des surprises !"
    tuto "Then there are CRITICAL choices. Those can change EVERYTHING that follows in your adventure—or lead to some serious surprises!"

# game/scenario/1_canon.rpy:252
translate english e4fcba60:

    # tuto "Ce choix en est un, alors choisissez bien !"
    tuto "This is one of them, so choose carefully!"

# game/scenario/1_canon.rpy:262
translate english b6463728:

    # "Je mets mes mains à mon cou, il est légèrement douloureux."
    "I bring my hands to my throat. It's slightly sore."

# game/scenario/1_canon.rpy:263
translate english ee59dd4b:

    # think "Quel est ce sentiment ? Qu'est-ce que je faisais déjà ?"
    think "What is this feeling? What was I doing again?"

# game/scenario/1_canon.rpy:264
translate english 1966f73c:

    # think "Ah oui, on hésitait sur la marche à suivre..."
    think "Right. We were trying to decide what to do..."

# game/scenario/1_canon.rpy:266
translate english 9aac5645:

    # "Je prends une grande bouffée d'air, comme si j'allais en avoir besoin."
    "I draw a deep breath, as though I'm going to need it."

# game/scenario/1_canon.rpy:267
translate english 6955f8f4:

    # think "Qu'est ce qui m'arrive ?"
    think "What's happening to me?"

# game/scenario/1_canon.rpy:268
translate english da94aa94:

    # think "Pourquoi j'ai un mauvais présentiment ?"
    think "Why do I have such a bad feeling about this?"

# game/scenario/1_canon.rpy:270
translate english ceb6e208:

    # "Je caresse du bout des doigts la ligne de mon cou."
    "I run my fingertips along the line of my throat."

# game/scenario/1_canon.rpy:271
translate english 6685cc71:

    # think "Cette sensation, d'où venait-elle ?"
    think "Where did that sensation come from?"

# game/scenario/1_canon.rpy:272
translate english c928f7a9:

    # think "Et pourquoi est-elle aussi intense ?"
    think "And why is it so intense?"

# game/scenario/1_canon.rpy:282
translate english 581320dd:

    # noam determine "Raah, on ne peut pas rester là à rien faire !"
    noam determine "Damn it, we can't just stand here doing nothing!"

# game/scenario/1_canon.rpy:283
translate english e4ff2197:

    # think "Les caméras nous regardent, tout le monde nous regarde."
    think "The cameras are watching us. Everyone is watching us."

# game/scenario/1_canon.rpy:285
translate english 998c5269:

    # ryn "Bon bouge de là !"
    ryn "All right, move."

# game/scenario/1_canon.rpy:288
translate english 2460bdd4:

    # think "Il met rapidement sa main sur le capteur. La porte ne s'ouvre pas."
    think "He quickly places his hand on the sensor. The door stays shut."

# game/scenario/1_canon.rpy:290
translate english a71c2a4a:

    # ryn "Raah, moi aussi je peux pas !"
    ryn "Damn it, I can't open it either!"

# game/scenario/1_canon.rpy:291
translate english 90845c3b:

    # ryn "Allez au suivant ! Qu'on termine ça au plus vite."
    ryn "Next! Let's get this over with."

# game/scenario/1_canon.rpy:293
translate english 9f5de280:

    # noam raison "Bon, bah je vais tenter."
    noam raison "All right, I'll give it a try."

# game/scenario/1_canon.rpy:294
translate english d9109847:

    # "Je mets ma main sur la porte puis je vois comme une petite lumière verte qui scanne ma main."
    "I place my hand against the door, and a small green light scans it."

# game/scenario/1_canon.rpy:296
translate english 7a677d82:

    # think "Noam, Permission denied."
    think "Noam. Permission denied."

# game/scenario/1_canon.rpy:297
translate english 2d67b078:

    # noam triste "Fait chier, ça marche pas..."
    noam triste "Shit. It doesn't work..."

# game/scenario/1_canon.rpy:301
translate english b4d520fe:

    # think "Je regarde plus en détail l'écran pour voir s'il y a d'autres indications."
    think "I take a closer look at the screen to see whether it shows anything else."

# game/scenario/1_canon.rpy:302
translate english 8d58ac11:

    # noam surpris "Hein, c'est quoi ça ?"
    noam surpris "Huh? What's that?"

# game/scenario/1_canon.rpy:303
translate english 4211c6fc:

    # think "Sur l'écran il est affiché en petit dans le coin supérieur droit : 3/3"
    think "In tiny text at the top-right corner of the screen, it reads: 3/3."

# game/scenario/1_canon.rpy:305
translate english a62237e2:

    # "Je me retourne face aux autres."
    "I turn back toward the others."

# game/scenario/1_canon.rpy:307
translate english d7ad1e01:

    # noam hesitation "Y'a un chiffre bizarre à côté aussi, il y a écrit 3."
    noam hesitation "There's a weird number beside it too. It says three."

# game/scenario/1_canon.rpy:309
translate english 6f952d14:

    # kael surpris "Hein ? T'en es sûr ?"
    kael surpris "What? Are you sure?"

# game/scenario/1_canon.rpy:310
translate english 1b41c4cf:

    # kael doute "Ça ne pourrait pas être..."
    kael doute "Could it be...?"

# game/scenario/1_canon.rpy:311
translate english ad7b7b8e:

    # kael peur "Oh non..."
    kael peur "Oh no..."

# game/scenario/1_canon.rpy:313
translate english 848cc5b3:

    # noam peur "Quoi qu'est-ce qu'il y a ?!"
    noam peur "What? What is it?!"

# game/scenario/1_canon.rpy:315
translate english d3e7d7a9:

    # "Ma tête commence soudainement à tourner. Quelque chose ne va pas."
    "My head suddenly starts spinning. Something's wrong."

# game/scenario/1_canon.rpy:317
translate english e857f385:

    # "Quel est ce bruit ?"
    "What's that sound?"

# game/scenario/1_canon.rpy:318
translate english 21ea4b38:

    # think "Pourquoi je vois tout flou ?"
    think "Why is everything going blurry?"

# game/scenario/1_canon.rpy:324
translate english a262d40a:

    # think "Ma gorge me brûle..."
    think "My throat is burning..."

# game/scenario/1_canon.rpy:325
translate english e7285683:

    # think "Pourquoi j'ai... j'..."
    think "Why am I... I..."

# game/scenario/1_canon.rpy:327
translate english 7c641778:

    # think "Ma gorge me brûle encore. Exactement comme avant."
    think "My throat burns again. Exactly like before."

# game/scenario/1_canon.rpy:328
translate english 5b2a9521:

    # think "Mon corps reconnaît la panique avant moi."
    think "My body recognizes the panic before I do."

# game/scenario/1_canon.rpy:330
translate english 96aa1086:

    # think "Ma gorge reconnaît la brûlure."
    think "My throat recognizes the burning."

# game/scenario/1_canon.rpy:331
translate english aba01ebd:

    # think "Troisième fois. Même la peur commence à avoir un goût familier."
    think "Third time. Even the fear is starting to taste familiar."

# game/scenario/1_canon.rpy:333
translate english 95f09903:

    # think "Put...a..."
    think "F-fu..."

# game/scenario/1_canon.rpy:340
translate english dc7c03a4:

    # think "Je m'assois à une chaise et ne bouge pas."
    think "I sit down in a chair and don't move."

# game/scenario/1_canon.rpy:357
translate english e44885de:

    # noam doute "On ne sait pas ce qu'on doit faire, il vaut mieux attendre les consignes."
    noam doute "We don't know what we're supposed to do. It's safer to wait for instructions."

# game/scenario/1_canon.rpy:359
translate english 25aa6ee5:

    # julian "Comme tu es arrangeant. Typique du premier de la classe."
    julian "How accommodating of you. Typical teacher's pet."

# game/scenario/1_canon.rpy:361
translate english 9a904d3a:

    # think "Jour un, et on en est déjà là, à se chamailler pour rien."
    think "Day one, and we're already bickering over nothing."

# game/scenario/1_canon.rpy:363
translate english 30f39b5e:

    # noam "Profitons-en pour observer cette salle en détail, on en apprendra peut-être un peu plus."
    noam "We should use the time to examine this room. We might learn something."

# game/scenario/1_canon.rpy:365
translate english e9c2b5e9:

    # kael sourire "Ouais, t'as sans doute raison."
    kael sourire "Yeah. You're probably right."

# game/scenario/1_canon.rpy:491
translate english 79cf789c:

    # "La porte reste fermée."
    "The door remains shut."

# game/scenario/1_canon.rpy:492
translate english 8ba3a4cf:

    # think "Sortir d'ici n'est visiblement pas une option."
    think "Getting out of here clearly isn't an option."

# game/scenario/1_canon.rpy:498
translate english a9cc72d8:

    # "Je pose la main près du capteur."
    "I place my hand near the sensor."

# game/scenario/1_canon.rpy:499
translate english 47aa782a:

    # "Un bip sec répond aussitôt."
    "A sharp beep answers immediately."

# game/scenario/1_canon.rpy:500
translate english 830e5fba:

    # think "Permission denied."
    think "Permission denied."

# game/scenario/1_canon.rpy:501
translate english e68738f0:

    # think "Cette porte aussi est fermée..."
    think "This door is locked too..."

# game/scenario/1_canon.rpy:509
translate english ddb65a7c:

    # "L'écran central du Conclave s'allume faiblement."
    "The Conclave's central screen flickers dimly to life."

# game/scenario/1_canon.rpy:510
translate english a6a879f5:

    # think "On dirait que le système attendait qu'on l'observe."
    think "It's as if the system was waiting for us to notice it."

# game/scenario/1_canon.rpy:523
translate english f37eaeae:

    # lysa blase "Surtout ne touche à rien sans prévenir."
    lysa blase "Whatever you do, don't touch anything without warning us first."

# game/scenario/1_canon.rpy:524
translate english 9dde673a:

    # lysa colere "Ici, une erreur stupide pourrait tous nous tuer."
    lysa colere "One stupid mistake in here could get all of us killed."

# game/scenario/1_canon.rpy:525
translate english 086b8312:

    # noam "Comment tu le sens ?"
    noam "What's your read on this?"

# game/scenario/1_canon.rpy:526
translate english 2a19ae16:

    # lysa blase "Je préfère ne pas y penser. On verra ce que ça donne."
    lysa blase "I'd rather not think about it. We'll see what happens."

# game/scenario/1_canon.rpy:540
translate english 90f60d9d:

    # ryn colere2 "Cette porte me saoule."
    ryn colere2 "I'm sick of this door."

# game/scenario/1_canon.rpy:541
translate english f6c1b62b:

    # ryn colere "Et puis qu'est-ce qu'on fout là d'abord !"
    ryn colere "And what the hell are we even doing here in the first place?!"

# game/scenario/1_canon.rpy:542
translate english 5172e2d5:

    # noam surpris "Hein ? Encore ça ?! Mais qu'est-ce que tu as à dire que tu ne sais pas ce qu'on fait là ?!"
    noam surpris "What? This again?! What do you mean you don't know why we're here?!"

# game/scenario/1_canon.rpy:543
translate english 141cc420:

    # ryn "Et d'abord, c'était quoi votre soi-disant annonce de tout à l'heure ?!"
    ryn "And what was that so-called announcement you were talking about earlier?!"

# game/scenario/1_canon.rpy:544
translate english 0b5f8d29:

    # ryn colere "Réponds-moi ! J'y pige que dalle !"
    ryn colere "Answer me! I don't understand a damn thing!"

# game/scenario/1_canon.rpy:545
translate english 02940c37:

    # noam panique "Mais tu as bien été sélectionné ?"
    noam panique "But you were selected, weren't you?"

# game/scenario/1_canon.rpy:546
translate english 95554634:

    # ryn surpris "Hein ? Sélectionné ? Mais de..."
    ryn surpris "What? Selected? What are you—"

# game/scenario/1_canon.rpy:547
translate english a4dd6401:

    # noam surpris "Attends tu n'as vraiment pas entendu l'annonce ?!"
    noam surpris "Wait. You seriously didn't hear the announcement?!"

# game/scenario/1_canon.rpy:548
translate english 30e081e6:

    # noam panne "Elle a dû être diffusée partout dans le monde ! Sur tous les appareils ! Comment tu as pu passer à côté ?"
    noam panne "It must've been broadcast worldwide! On every device! How could you possibly have missed it?"

# game/scenario/1_canon.rpy:549
translate english 233a848d:

    # ryn "Hein ? Moi j'étais près de la frontière quand on m'a attaqué..."
    ryn "What? I was near the border when I got jumped..."

# game/scenario/1_canon.rpy:550
translate english 3aa84419:

    # noam colere "On t'a attaqué ?!"
    noam colere "You were attacked?!"

# game/scenario/1_canon.rpy:551
translate english e93604ba:

    # ryn colere "Ouais, ces connards m'ont foutu une sorte de serviette sur le nez et je me suis réveillé ici."
    ryn colere "Yeah. Those assholes shoved some kind of cloth over my face, and the next thing I knew, I woke up here."

# game/scenario/1_canon.rpy:552
translate english c2bad97e:

    # ryn triste "Alors j'aimerais comprendre ce qu'il se passe ici !"
    ryn triste "So I'd really like to know what the hell is going on!"

# game/scenario/1_canon.rpy:553
translate english bdde5e75:

    # noam reflechit "C'est assez dur à expliquer, même nous on ne sait pas grand-chose, Kami va sans doute nous en dire plus..."
    noam reflechit "It's hard to explain. Even we don't know much yet. Kami will probably tell us more..."

# game/scenario/1_canon.rpy:554
translate english 32f25130:

    # ryn colere "Donc on doit encore attendre après elle... Génial..."
    ryn colere "So we have to wait around for her again... Great..."

# game/scenario/1_canon.rpy:567
translate english 2280773c:

    # mara taquin "Alors Monsieur je décide pour tout le monde, tu as trouvé une piste ?"
    mara taquin "Well, Mister I-Make-the-Decisions-for-Everyone, found any leads?"

# game/scenario/1_canon.rpy:568
translate english 0eca6ed5:

    # noam reflechit "J'essaie déjà de comprendre où on est."
    noam reflechit "I'm still trying to work out where we are."

# game/scenario/1_canon.rpy:569
translate english 0cfefcd7:

    # mara taquin "Mauvaise nouvelle : on est dans une pièce fermée dans laquelle toutes les sorties sont bloquées."
    mara taquin "Bad news: we're in a sealed room, and every exit is blocked."

# game/scenario/1_canon.rpy:570
translate english 095feacb:

    # mara jaloux "C'est donc avec vous que je vais devoir passer mes trente prochains jours ici ?"
    mara jaloux "So you're the people I'm stuck spending the next thirty days with?"

# game/scenario/1_canon.rpy:571
translate english 469b4a77:

    # mara rire "On devrait pouvoir bien s'amuser !"
    mara rire "We should be able to have some fun!"

# game/scenario/1_canon.rpy:572
translate english 7c29570c:

    # mara taquin "Ou plus, si affinité ?"
    mara taquin "Maybe longer, if we hit it off?"

# game/scenario/1_canon.rpy:573
translate english 4282f5bd:

    # noam peur "Hein ?!"
    noam peur "What?!"

# game/scenario/1_canon.rpy:574
translate english 2cb60fa7:

    # mara rire_profond "Quelle réaction exquise !"
    mara rire_profond "What a delightful reaction!"

# game/scenario/1_canon.rpy:587
translate english 5078bab3:

    # elias reflechit "La ventilation a changé depuis tout à l'heure."
    elias reflechit "The ventilation has changed since earlier."

# game/scenario/1_canon.rpy:588
translate english a679c6ae:

    # elias ecoute "C'est léger, mais c'est certain, c'est plus la même depuis qu'on s'est réveillé."
    elias ecoute "It's subtle, but I'm sure of it. It hasn't sounded the same since we woke up."

# game/scenario/1_canon.rpy:589
translate english 03c8b0ec:

    # noam surpris "Hein ? Comment tu sais ça ?"
    noam surpris "What? How can you tell?"

# game/scenario/1_canon.rpy:590
translate english 2cf68f1c:

    # elias neutre "C'est mon travail de savoir repérer ce genre de petit changement."
    elias neutre "Spotting small changes like that is part of my job."

# game/scenario/1_canon.rpy:591
translate english cf98087b:

    # noam reflechit "Maintenant que tu le dis, c'est vrai que la ventilation n'est plus la même."
    noam reflechit "Now that you mention it, you're right. The ventilation does sound different."

# game/scenario/1_canon.rpy:592
translate english ebafa84e:

    # elias surpris "Ah, tu l'as remarqué toi aussi ?"
    elias surpris "Oh, you noticed too?"

# game/scenario/1_canon.rpy:593
translate english 2fae4240:

    # noam sourire "On m'a souvent dit que j'avais une très bonne ouïe."
    noam sourire "People have always told me I have excellent hearing."

# game/scenario/1_canon.rpy:594
translate english face118e:

    # elias ecoute "Intéressant à savoir !"
    elias ecoute "Good to know!"

# game/scenario/1_canon.rpy:607
translate english 651a9c87:

    # kael reflechit "Si les portes sont bloquées par des permissions, ça veut dire que c'est le même système que sur Orbite."
    kael reflechit "If the doors are permission-locked, then it's the same kind of system we use on Orbit."

# game/scenario/1_canon.rpy:608
translate english ade129f2:

    # noam surpris "Hein ? qu'est-ce que tu racontes ? Tu viens d'Orbite ?"
    noam surpris "What are you talking about? You're from Orbit?"

# game/scenario/1_canon.rpy:609
translate english c97c4480:

    # kael doute "Sur Orbite, tout le monde ne peut pas aller partout, t'imagines si un gamin va dans la salle de pilotage..."
    kael doute "On Orbit, not everyone can go everywhere. Imagine a kid wandering into the cockpit..."

# game/scenario/1_canon.rpy:610
translate english 995a7ece:

    # kael mefiant "Donc on a des systèmes de vérifications des autorisations par empreinte. Et ça ressemble à ce qui est installé sur les portes."
    kael mefiant "So we use fingerprint authorization checks. And this looks a lot like the system installed on these doors."

# game/scenario/1_canon.rpy:611
translate english db8bf2c2:

    # noam panique "Donc on ne pourra jamais passer par ces portes ?"
    noam panique "So we'll never be able to get through them?"

# game/scenario/1_canon.rpy:612
translate english 66509820:

    # kael raison "C'est pas ce que j'ai dit, il suffit qu'on nous donne l'accès et on pourra y accéder."
    kael raison "That's not what I said. Once we're granted access, we'll be able to use them."

# game/scenario/1_canon.rpy:613
translate english c0cfd749:

    # noam neutre "J'espère..."
    noam neutre "I hope so..."

# game/scenario/1_canon.rpy:626
translate english 60f6069e:

    # tomas reflechit "L'écran central... Il n'est pas éteint."
    tomas reflechit "The central screen... It isn't off."

# game/scenario/1_canon.rpy:627
translate english 714e4348:

    # noam surpris "Hein, mais il est tout noir ?"
    noam surpris "What? But it's completely black."

# game/scenario/1_canon.rpy:628
translate english 19344805:

    # tomas hesitation "O-Ouais c'est vrai mais je suis quasiment sûr qu'il n'est pas éteint."
    tomas hesitation "Y-Yeah, that's true, but I'm almost certain it isn't turned off."

# game/scenario/1_canon.rpy:629
translate english ab7f091f:

    # tomas determine "Enfin, je veux dire, regarde..."
    tomas determine "I mean, just look..."

# game/scenario/1_canon.rpy:630
translate english e4d891b8:

    # "Il pointe du doigt des côtés de l'écran."
    "He points to the sides of the screen."

# game/scenario/1_canon.rpy:631
translate english a48c8ac8:

    # tomas hesitation "Déjà il n'y a aucun bouton pour l'allumer ou l'éteindre."
    tomas hesitation "For one thing, there isn't any button to turn it on or off."

# game/scenario/1_canon.rpy:632
translate english 759c28c4:

    # tomas reflechit "Habituellement sur les modèles RX-453, ce modèle de télévision on a des boutons pour pouvoir..."
    tomas reflechit "Normally, RX-453 models—this type of television—have buttons so you can..."

# game/scenario/1_canon.rpy:633
translate english b340ac47:

    # noam peur "Attends quoi ? Tu connais le modèle de la télévision par cœur ?!"
    noam peur "Wait, what? You know the TV model by heart?!"

# game/scenario/1_canon.rpy:634
translate english 20e727d7:

    # noam taquin "T'es une sorte de geek ou quelque chose du genre ?"
    noam taquin "Are you some kind of geek or something?"

# game/scenario/1_canon.rpy:635
translate english e0720afa:

    # tomas gene "Hein ? Moi ? Ah... Non pas vraiment..."
    tomas gene "What? Me? Uh... not really..."

# game/scenario/1_canon.rpy:636
translate english 1141a0cd:

    # tomas gene "C'est juste mon travail de savoir ce genre de choses..."
    tomas gene "It's just part of my job to know that kind of thing..."

# game/scenario/1_canon.rpy:637
translate english 389af239:

    # tomas determine "Enfin bref, pour faire simple d'habitude sur ce modèle il y a des boutons, là il n'y en a pas. Et évidemment on a pas de sortes de télécommande."
    tomas determine "Anyway, the simple version is: this model normally has buttons, but this one doesn't. And obviously, we don't have any kind of remote."

# game/scenario/1_canon.rpy:638
translate english 82f03f50:

    # noam surpris "Et c'est censé vouloir dire quoi ?"
    noam surpris "And what is that supposed to mean?"

# game/scenario/1_canon.rpy:639
translate english c8ef77f7:

    # tomas raison "Qu'on ne peut pas éteindre cet écran. Il est en veille et peut se rallumer à tout moment."
    tomas raison "That we can't turn this screen off. It's in standby mode and could come back on at any moment."

# game/scenario/1_canon.rpy:652
translate english 2cbff75a:

    # iris desaccord "Je déteste les salles où tout le monde fait semblant de réfléchir calmement."
    iris desaccord "I hate rooms where everyone pretends to be thinking calmly."

# game/scenario/1_canon.rpy:653
translate english 3da139c8:

    # iris triste "On est enfermés. Évidemment que tout le monde panique."
    iris triste "We're trapped. Of course everyone is panicking."

# game/scenario/1_canon.rpy:654
translate english ac8c7a4d:

    # noam taquin "Pourquoi ? Tu paniques ?"
    noam taquin "Why? Are you panicking?"

# game/scenario/1_canon.rpy:655
translate english 78f7c872:

    # iris taquin "Moi ? Non. Et puis quoi encore ?! Je dis juste que vous pouvez montrer que vous êtes paniqués !"
    iris taquin "Me? No! As if! I'm just saying you can admit that you're panicking!"

# game/scenario/1_canon.rpy:656
translate english 121ef86b:

    # iris blase "Pas besoin de faire les hypocrites à jouer les durs."
    iris blase "There's no need to play tough and act like hypocrites."

# game/scenario/1_canon.rpy:657
translate english 87ff6fea:

    # iris desaccord "Ce n'est pas ça qui ouvrira ces portes de toute façon."
    iris desaccord "It won't open those doors anyway."

# game/scenario/1_canon.rpy:670
translate english ce26b52a:

    # elen surpris "Tu crois qu'ils ont prévu des pauses dans leur truc ?"
    elen surpris "Do you think they built breaks into this whole thing?"

# game/scenario/1_canon.rpy:671
translate english 87b73032:

    # noam neutre "Des pauses ?"
    noam neutre "Breaks?"

# game/scenario/1_canon.rpy:672
translate english b7848d06:

    # elen triste "Bah oui. Moi, je ne veux pas travailler tout le teeeemps !"
    elen triste "Well, yeah. I don't want to work allll the time!"

# game/scenario/1_canon.rpy:673
translate english 57b34f24:

    # elen peur "Et j'ai besoin de trouver urgemment des toilettes..."
    elen peur "And I urgently need to find a bathroom..."

# game/scenario/1_canon.rpy:674
translate english ff30ce26:

    # noam triste "Je crois que nos envies, Kami s'en contrefout."
    noam triste "I don't think Kami gives a damn what we want."

# game/scenario/1_canon.rpy:675
translate english 7b54a200:

    # elen joie "J'espère au moins qu'il y aura des trucs bons à manger !"
    elen joie "I just hope there's something good to eat!"

# game/scenario/1_canon.rpy:689
translate english 13827742:

    # nyra reflexion "Tout le monde cherche une issue."
    nyra reflexion "Everyone is looking for a way out."

# game/scenario/1_canon.rpy:690
translate english 6ec79a8a:

    # nyra hesitation "Mais personne ne se demande encore pourquoi cette salle existe."
    nyra hesitation "But no one has stopped to ask why this room exists."

# game/scenario/1_canon.rpy:691
translate english ab707eaf:

    # noam "Tu as une idée ?"
    noam "Do you have an idea?"

