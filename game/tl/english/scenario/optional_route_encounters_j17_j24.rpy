# game/scenario/optional_route_encounters_j17_j24.rpy:6
translate english KD_ROUTE_J17_LYSA_6c24fd4d:

    # "Lysa m'aperçoit au croisement. Elle cesse de faire défiler sa tablette."
    "Lysa spots me at the junction and stops scrolling through her tablet."

# game/scenario/optional_route_encounters_j17_j24.rpy:10
translate english KD_ROUTE_J17_LYSA_be6412f4:

    # lysa "T'as la tête de quelqu'un qui va annoncer une catastrophe."
    lysa "You look like you're about to announce a disaster."

# game/scenario/optional_route_encounters_j17_j24.rpy:11
translate english KD_ROUTE_J17_LYSA_fd22eb99:

    # noam fatigue "Tu peux éviter les blagues, aujourd'hui ?"
    noam fatigue "Can you lay off the jokes today?"

# game/scenario/optional_route_encounters_j17_j24.rpy:12
translate english KD_ROUTE_J17_LYSA_658590cc:

    # lysa neutre "D'accord. Qu'est-ce qui se passe ?"
    lysa neutre "Okay. What's going on?"

# game/scenario/optional_route_encounters_j17_j24.rpy:13
translate english KD_ROUTE_J17_LYSA_3c484d6a:

    # noam "Il faut que je parle aux autres de M16."
    noam "I need to talk to the others about M16."

# game/scenario/optional_route_encounters_j17_j24.rpy:14
translate english KD_ROUTE_J17_LYSA_f954a939:

    # lysa reflexion "Tu sais quelque chose qu'on ignore ?"
    lysa reflexion "Do you know something we don't?"

# game/scenario/optional_route_encounters_j17_j24.rpy:15
translate english KD_ROUTE_J17_LYSA_31b5e74c:

    # noam hesitation "Je sais surtout que ce qu'on croit savoir ne tient pas debout."
    noam hesitation "Mostly that what we think we know doesn't add up."

# game/scenario/optional_route_encounters_j17_j24.rpy:16
translate english KD_ROUTE_J17_LYSA_abe7d69e:

    # lysa "Alors dis-leur clairement. On commence tous à en avoir assez des demi-réponses."
    lysa "Then tell them that plainly. We're all getting tired of half-answers."

# game/scenario/optional_route_encounters_j17_j24.rpy:17
translate english KD_ROUTE_J17_LYSA_e34e3993:

    # noam neutre "Je vais essayer."
    noam neutre "I'll try."

# game/scenario/optional_route_encounters_j17_j24.rpy:18
translate english KD_ROUTE_J17_LYSA_2368918e:

    # lysa blase "Essaie surtout de ne pas tout garder pour toi."
    lysa blase "Just try not to keep everything to yourself."

# game/scenario/optional_route_encounters_j17_j24.rpy:26
translate english KD_ROUTE_J18_JULIAN_2f2c8394:

    # "Julian est près de la sortie de la cafétéria. Il me regarde passer, puis m'interpelle."
    "Julian is standing near the cafeteria exit. He watches me go past, then calls out."

# game/scenario/optional_route_encounters_j17_j24.rpy:30
translate english KD_ROUTE_J18_JULIAN_ba0f60ac:

    # julian "Tu cherches quelqu'un ?"
    julian "Looking for someone?"

# game/scenario/optional_route_encounters_j17_j24.rpy:31
translate english KD_ROUTE_J18_JULIAN_17904be3:

    # noam "Elias. Je dois lui demander quelque chose."
    noam "Elias. I need to ask him something."

# game/scenario/optional_route_encounters_j17_j24.rpy:32
translate english KD_ROUTE_J18_JULIAN_4749e112:

    # julian "Tu l'as déjà raté ce matin, non ?"
    julian "You missed him earlier this morning too, didn't you?"

# game/scenario/optional_route_encounters_j17_j24.rpy:33
translate english KD_ROUTE_J18_JULIAN_05d7683e:

    # noam reflexion "Je veux surtout lui parler avant qu'il disparaisse encore dans un atelier."
    noam reflexion "I just want to catch him before he disappears into a workshop again."

# game/scenario/optional_route_encounters_j17_j24.rpy:34
translate english KD_ROUTE_J18_JULIAN_bd299484:

    # julian taquin "Vu le bruit qu'il fait, il devrait être facile à retrouver."
    julian taquin "Judging by the noise he makes, he shouldn't be hard to find."

# game/scenario/optional_route_encounters_j17_j24.rpy:35
translate english KD_ROUTE_J18_JULIAN_82916996:

    # noam "C'est sérieux, Julian."
    noam "This is serious, Julian."

# game/scenario/optional_route_encounters_j17_j24.rpy:36
translate english KD_ROUTE_J18_JULIAN_93644f95:

    # julian neutre "J'avais compris. Tu n'as même pas souri."
    julian neutre "I gathered that. You didn't even smile."

# game/scenario/optional_route_encounters_j17_j24.rpy:37
translate english KD_ROUTE_J18_JULIAN_1d4fba4a:

    # noam fatigue "Désolé."
    noam fatigue "Sorry."

# game/scenario/optional_route_encounters_j17_j24.rpy:38
translate english KD_ROUTE_J18_JULIAN_c407cd81:

    # julian sourire "Va le voir. Je garde mes meilleures plaisanteries pour quand tu reviendras."
    julian sourire "Go talk to him. I'll save my best jokes for when you get back."

# game/scenario/optional_route_encounters_j17_j24.rpy:46
translate english KD_ROUTE_J19_ELEN_ad9b7281:

    # "Elen me rejoint près de la sortie, tandis que les voix des autres résonnent encore derrière elle."
    "Elen catches up with me near the exit, while the others' voices still echo behind her."

# game/scenario/optional_route_encounters_j17_j24.rpy:50
translate english KD_ROUTE_J19_ELEN_d970f7a1:

    # elen "Tu rentres déjà ? Il reste encore du monde."
    elen "Leaving already? There are still people here."

# game/scenario/optional_route_encounters_j17_j24.rpy:51
translate english KD_ROUTE_J19_ELEN_3301f24d:

    # noam "J'ai besoin de me poser un peu."
    noam "I need some time to myself."

# game/scenario/optional_route_encounters_j17_j24.rpy:52
translate english KD_ROUTE_J19_ELEN_34480993:

    # elen "Tu pourrais rester avec nous. Ça te changerait peut-être les idées."
    elen "You could stay with us. It might help take your mind off things."

# game/scenario/optional_route_encounters_j17_j24.rpy:53
translate english KD_ROUTE_J19_ELEN_cf9c5cd0:

    # noam reflexion "Je crois pas que ça suffirait."
    noam reflexion "I don't think that'd be enough."

# game/scenario/optional_route_encounters_j17_j24.rpy:54
translate english KD_ROUTE_J19_ELEN_c1d485d3:

    # elen inquiet "Tu sais, t'es pas obligé de régler tous tes problèmes tout seul."
    elen inquiet "You know, you don't have to solve every problem on your own."

# game/scenario/optional_route_encounters_j17_j24.rpy:55
translate english KD_ROUTE_J19_ELEN_be1bbc08:

    # noam "Je sais. Mais ce soir, j'aimerais juste être tranquille."
    noam "I know. But tonight I'd really like some peace and quiet."

# game/scenario/optional_route_encounters_j17_j24.rpy:56
translate english KD_ROUTE_J19_ELEN_60185ce9:

    # elen sourire "D'accord. Si tu changes d'avis, on sera encore là un moment."
    elen sourire "Okay. If you change your mind, we'll be here a while longer."

# game/scenario/optional_route_encounters_j17_j24.rpy:57
translate english KD_ROUTE_J19_ELEN_1180df3d:

    # noam sourire "Merci, Elen."
    noam sourire "Thanks, Elen."

# game/scenario/optional_route_encounters_j17_j24.rpy:58
translate english KD_ROUTE_J19_ELEN_0be110bb:

    # elen "Essaie au moins de dormir un peu."
    elen "At least try to get some sleep."

