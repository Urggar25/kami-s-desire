    # noam "Tu étais inconsciente."
    noam "You were unconscious."

# game/scenario/8_1_0_0.rpy:311
translate english fea9d87b:

    # iris reflexion "Et presque congelée."
    iris reflexion "And nearly frozen."

# game/scenario/8_1_0_0.rpy:313
translate english 9b4bb586:

    # "Elle relève lentement la tête."
    "She slowly lifts her head."

# game/scenario/8_1_0_0.rpy:315
translate english 95f4c2f9:

    # anya_inconnue surpris "Vous m’avez sortie de là ?"
    anya_inconnue surpris "You got me out of there?"

# game/scenario/8_1_0_0.rpy:317
translate english 46081631_10:

    # noam "Oui."
    noam "Yes."

# game/scenario/8_1_0_0.rpy:319
translate english 0bd0eda5:

    # anya_inconnue inquiet "... Pourquoi ?"
    anya_inconnue inquiet "... Why?"

# game/scenario/8_1_0_0.rpy:321
translate english fea83d57:

    # iris desaccord "Parce qu’on n’allait pas te laisser crever dedans."
    iris desaccord "Because we weren't going to leave you to die in it."

# game/scenario/8_1_0_0.rpy:323
translate english 6b7c1e7c:

    # "Elle regarde Iris quelques secondes."
    "She looks at Iris for a few seconds."

# game/scenario/8_1_0_0.rpy:325
translate english 264e776c:

    # iris gene "Quoi ?"
    iris gene "What?"

# game/scenario/8_1_0_0.rpy:327
translate english e2b71a74:

    # anya_inconnue fatigue "Rien."
    anya_inconnue fatigue "Nothing."

# game/scenario/8_1_0_0.rpy:329
translate english 04f31364:

    # "Elle inspire profondément."
    "She takes a deep breath."

# game/scenario/8_1_0_0.rpy:331
translate english 545e31d6:

    # anya_inconnue fatigue "D’accord..."
    anya_inconnue fatigue "Okay..."

# game/scenario/8_1_0_0.rpy:333
translate english 8dd11123:

    # "Sa respiration ralentit progressivement."
    "Her breathing gradually slows down."

# game/scenario/8_1_0_0.rpy:335
translate english 1fe4dc63:

    # anya_inconnue fatigue "D’accord."
    anya_inconnue fatigue "Okay."

# game/scenario/8_1_0_0.rpy:339
translate english 803ec344:

    # anya_inconnue fatigue "Je m’appelle Anya."
    anya_inconnue fatigue "My name's Anya."

# game/scenario/8_1_0_0.rpy:342
translate english e6a17159:

    # "Elle essuie rapidement son visage."
    "She quickly wipes her face."

# game/scenario/8_1_0_0.rpy:344
translate english 03d0be1e:

    # anya fatigue "Anya Vess."
    anya fatigue "Anya Vess."

# game/scenario/8_1_0_0.rpy:346
translate english aa30fc6b:

    # noam sourire "Noam."
    noam sourire "Noam."

# game/scenario/8_1_0_0.rpy:348
translate english 9223617a:

    # iris desaccord "Elle le sait."
    iris desaccord "She knows that."

# game/scenario/8_1_0_0.rpy:350
translate english 1c7c9f99:

    # noam gene "Oui. C’est vrai."
    noam gene "Right. True."

# game/scenario/8_1_0_0.rpy:352
translate english 6cdb75c3:

    # "Anya laisse échapper un léger souffle qui ressemble presque à un rire nerveux."
    "Anya lets out a faint breath that almost sounds like a nervous laugh."

# game/scenario/8_1_0_0.rpy:354
translate english ed46a7a1:

    # anya fatigue "Ouais. Je sais qui vous êtes."
    anya fatigue "Yeah. I know who you are."

# game/scenario/8_1_0_0.rpy:356
translate english 1df71f10:

    # "Elle regarde autour d’elle."
    "She looks around her."

# game/scenario/8_1_0_0.rpy:358
translate english ae241fd1:

    # anya reflexion "Enfin... plus ou moins."
    anya reflexion "Well... more or less."

# game/scenario/8_1_0_0.rpy:360
translate english 331fd6b1:

    # iris reflexion "Et toi, tu viens d’où exactement ?"
    iris reflexion "And you, where exactly are you from?"

# game/scenario/8_1_0_0.rpy:362
translate english 01293089:

    # anya "Nexus."
    anya "Nexus."

# game/scenario/8_1_0_0.rpy:364
translate english f4d0256a:

    # noam surpris "Nexus ?"
    noam surpris "Nexus?"

# game/scenario/8_1_0_0.rpy:366
translate english 4d99fa30:

    # "Elle acquiesce."
    "She nods."

# game/scenario/8_1_0_0.rpy:368
translate english 5370e925:

    # anya reflexion "Je suis née là-bas. J’y ai toujours vécu."
    anya reflexion "I was born there. Lived there my whole life."

# game/scenario/8_1_0_0.rpy:370
translate english 6be44c57:

    # "Elle marque une pause."
    "She pauses."

# game/scenario/8_1_0_0.rpy:372
translate english 1e2eebba:

    # anya triste "Enfin... jusqu’à l’année dernière."
    anya triste "Well... until last year."

# game/scenario/8_1_0_0.rpy:374
translate english 57f4ba4f:

    # "Son regard descend vers le sol."
    "Her eyes drop to the floor."

# game/scenario/8_1_0_0.rpy:376
translate english f7c8d98f:

    # anya "J’étais à Limen quand Kami a pris le contrôle."
    anya "I was in Limen when Kami took over."

# game/scenario/8_1_0_0.rpy:378
translate english 53b25f99:

    # noam reflexion "Tu étais juste de passage ?"
    noam reflexion "You were just passing through?"

# game/scenario/8_1_0_0.rpy:380
translate english 48672e1e:

    # anya "Je devais rester trois jours."
    anya "I was supposed to stay three days."

# game/scenario/8_1_0_0.rpy:382
translate english 7d0abe78:

    # iris inquiet "..."
    iris inquiet "..."

# game/scenario/8_1_0_0.rpy:384
translate english fce23c70:

    # anya "Trois jours."
    anya "Three days."

# game/scenario/8_1_0_0.rpy:386
translate english 659637c8:

    # "Elle laisse échapper un petit rire sans joie."
    "She lets out a small, joyless laugh."

# game/scenario/8_1_0_0.rpy:388
translate english 8b7e60ab:

    # anya "J’avais emporté trois sous-vêtements, une tablette et même pas mon chargeur principal parce que je pensais que ce serait rapide."
    anya "I'd packed three pairs of underwear, a tablet, and not even my main charger, because I thought it'd be quick."

# game/scenario/8_1_0_0.rpy:390
translate english c1896f3d:

    # anya fatigue "Très bonne préparation pour passer plus d’un an coincée dans un autre district."
    anya fatigue "Excellent preparation for spending over a year stuck in another district."

# game/scenario/8_1_0_0.rpy:392
translate english 69a1e18a:

    # noam "Tu n’as jamais pu rentrer ?"
    noam "You were never able to go home?"

# game/scenario/8_1_0_0.rpy:394
translate english 0da0d3b5:

    # anya "J’ai fait plein de demandes."
    anya "I filed a ton of requests."

# game/scenario/8_1_0_0.rpy:396
translate english dda3322d:

    # anya colere "Transfert exceptionnel. Regroupement familial. Retour vers le district d’origine. Déplacement professionnel. Tout ce que je pouvais cocher dans leurs formulaires."
    anya colere "Exceptional transfer. Family reunification. Return to district of origin. Business travel. Everything I could tick on their forms."

# game/scenario/8_1_0_0.rpy:398
translate english b7af2d54:

    # anya triste "Jamais de réponse."
    anya triste "Never an answer."

# game/scenario/8_1_0_0.rpy:400
translate english 86c70557:

    # "Elle hausse légèrement les épaules."
    "She shrugs slightly."

# game/scenario/8_1_0_0.rpy:402
translate english c692abf6:

    # anya "Pas un refus, rien. Juste... rien."
    anya "Not a refusal, nothing. Just... nothing."

# game/scenario/8_1_0_0.rpy:404
translate english d0b58253:

    # "Iris baisse légèrement les yeux."
    "Iris looks down a little."

# game/scenario/8_1_0_0.rpy:406
translate english 74c13238:

    # anya reflexion "Au début je pensais que ça durerait quelques semaines, puis quelques mois. Et après..."
    anya reflexion "At first I thought it'd last a few weeks, then a few months. And after that..."

# game/scenario/8_1_0_0.rpy:408
translate english 0ad828a0:

    # "Elle souffle."
    "She exhales."

# game/scenario/8_1_0_0.rpy:410
translate english 45b23c09:

    # anya fatigue "J’ai arrêté de compter."
    anya fatigue "I stopped counting."

# game/scenario/8_1_0_0.rpy:412
translate english 09842805:

    # noam reflexion "Et depuis le retour du commerce..."
    noam reflexion "And since trade started up again..."

# game/scenario/8_1_0_0.rpy:414
translate english 27923e2c:

    # "Elle relève les yeux vers moi."
    "She looks back up at me."

# game/scenario/8_1_0_0.rpy:416
translate english 7a8d0cd2:

    # anya "Les conteneurs."
    anya "The containers."

# game/scenario/8_1_0_0.rpy:418
translate english 082094f4:

    # noam "C’est ça."
    noam "Exactly."

# game/scenario/8_1_0_0.rpy:420
translate english a7291072:

    # anya "Depuis que les districts recommencent à échanger des marchandises, il y en a partout : des camions, des dépôts, des zones de chargement..."
    anya "Ever since the districts started trading goods again, they're everywhere: trucks, depots, loading zones..."

# game/scenario/8_1_0_0.rpy:422
translate english be57fd56:

    # anya reflexion "Et forcément, quand quelque chose commence à circuler..."
    anya reflexion "And of course, once something starts moving around..."

# game/scenario/8_1_0_0.rpy:424
translate english 83414617:

    # iris reflexion "... les gens cherchent à circuler avec."
    iris reflexion "... people try to move around with them."

# game/scenario/8_1_0_0.rpy:426
translate english 3155283b:

    # anya "Exactement."
    anya "Exactly."

# game/scenario/8_1_0_0.rpy:428
translate english 40ef6657:

    # "Elle hésite légèrement."
    "She hesitates a little."

# game/scenario/8_1_0_0.rpy:430
translate english afe581b4:

    # anya "J’ai trouvé quelqu’un à Limen."
    anya "I found someone in Limen."

# game/scenario/8_1_0_0.rpy:432
translate english e91731ab:

    # noam reflexion "Un passeur ?"
    noam reflexion "A smuggler?"

# game/scenario/8_1_0_0.rpy:434
translate english 22ccf262:

    # anya desaccord "Un réseau. Je savais pas qui ils étaient et je voulais pas savoir."
    anya desaccord "A network. I didn't know who they were and I didn't want to know."

# game/scenario/8_1_0_0.rpy:436
translate english 23cc0b04:

    # anya "Ils m’ont expliqué qu’un conteneur devait partir vers Nexus, sans être inspecté au départ ni ouvert pendant le trajet."
    anya "They told me a container was leaving for Nexus, no inspection at departure and no opening during the trip."

# game/scenario/8_1_0_0.rpy:438
translate english 6f23b3d8:

    # iris desaccord "Et tu les as crus ?"
    iris desaccord "And you believed them?"

# game/scenario/8_1_0_0.rpy:440
translate english 1d99bccd:

    # anya colere "J’étais enfermée à Limen depuis plus d’un an !"
    anya colere "I'd been locked up in Limen for over a year!"

# game/scenario/8_1_0_0.rpy:442
translate english 6ce7f6ed:

    # "Iris ne répond rien."
    "Iris doesn't answer."

# game/scenario/8_1_0_0.rpy:444
translate english a1182112:

    # anya fatigue "... Oui. Je les ai crus."
    anya fatigue "... Yeah. I believed them."

# game/scenario/8_1_0_0.rpy:446
translate english a561ce30:

    # "Elle ramène ses jambes contre elle."
    "She pulls her legs up against her."

# game/scenario/8_1_0_0.rpy:448
translate english a3fbe5e1:

    # anya reflexion "Je suis entrée dedans pendant le chargement. Il y avait de quoi respirer, de l’eau, une couverture... Ils m’avaient dit quelques heures."
    anya reflexion "I got in during loading. There was air, water, a blanket... They'd told me a few hours."

# game/scenario/8_1_0_0.rpy:450
translate english 646dbcdc:

    # "Elle regarde ses mains."
    "She looks at her hands."

# game/scenario/8_1_0_0.rpy:452
translate english 0d7f3e74:

    # anya triste "Après un moment, il a commencé à faire froid."
    anya triste "After a while, it started getting cold."

# game/scenario/8_1_0_0.rpy:454
translate english f598b066:

    # noam inquiet "Tu te souviens de quelque chose après ça ?"
    noam inquiet "Do you remember anything after that?"

# game/scenario/8_1_0_0.rpy:456
translate english ae324d04:

    # anya reflexion "Pas vraiment. J’ai essayé de taper contre la paroi, puis..."
    anya reflexion "Not really. I tried banging on the wall, and then..."

# game/scenario/8_1_0_0.rpy:458
translate english 1d83ba24:

    # "Elle secoue la tête."
    "She shakes her head."

# game/scenario/8_1_0_0.rpy:460
translate english 15ccc723:

    # anya "Je sais pas. Je me suis réveillée avec elle au-dessus de moi."
    anya "I don't know. I woke up with her on top of me."

# game/scenario/8_1_0_0.rpy:462
translate english 236f0a5a:

    # iris colere "Présenté comme ça, c’est vraiment dégueulasse."
    iris colere "Put like that, it sounds really gross."

# game/scenario/8_1_0_0.rpy:464
translate english 6c258d8d:

    # anya "Tu avais ta main sur ma bouche."
    anya "You had your hand over my mouth."

# game/scenario/8_1_0_0.rpy:466
translate english a1305062:

    # iris colere "Parce que tu hurlais !"
    iris colere "Because you were screaming!"

# game/scenario/8_1_0_0.rpy:468
translate english 81fc5cbf:

    # anya "Je venais de me réveiller kidnappée dans une chambre inconnue !"
    anya "I'd just woken up kidnapped in a room I didn't know!"

# game/scenario/8_1_0_0.rpy:470
translate english 70e9973c:

    # iris "Tu n’as pas été kidnappée !"
    iris "You weren't kidnapped!"

# game/scenario/8_1_0_0.rpy:472
translate english 9b4de341:

    # anya "J’avais aucun moyen de le savoir !"
    anya "I had no way of knowing that!"

# game/scenario/8_1_0_0.rpy:474
translate english 104eb7b9:

    # iris colere "Tu aurais pu attendre cinq secondes avant d’essayer de me casser le nez !"
    iris colere "You could've waited five seconds before trying to break my nose!"

# game/scenario/8_1_0_0.rpy:476
translate english d2d22aed:

    # anya colere "Tu étais SUR MOI !"
    anya colere "You were ON TOP OF ME!"

# game/scenario/8_1_0_0.rpy:478
translate english b26e8e75:

    # noam desaccord "D’accord."
    noam desaccord "All right."

# game/scenario/8_1_0_0.rpy:480
translate english f09dfec2:

    # "Elles se taisent."
    "They both go quiet."

# game/scenario/8_1_0_0.rpy:482
translate english b1831d69:

    # noam fatigue "On va considérer que tout le monde avait de bonnes raisons de paniquer."
    noam fatigue "Let's just say everybody had good reasons to panic."

# game/scenario/8_1_0_0.rpy:484
translate english 03fa12ff_1:

    # iris desaccord "..."
    iris desaccord "..."

# game/scenario/8_1_0_0.rpy:486
translate english 9d2fb6a7:

    # anya desaccord "..."
    anya desaccord "..."

# game/scenario/8_1_0_0.rpy:488
translate english e4cd61a3:

    # noam "Ça vous va ?"
    noam "Works for you?"

# game/scenario/8_1_0_0.rpy:492
translate english 63b9a7de:

    # anya "Non."
    anya "No."

# game/scenario/8_1_0_0.rpy:494
translate english ff46e00d:

    # noam fatigue "Parfait."
    noam fatigue "Perfect."

# game/scenario/8_1_0_0.rpy:496
translate english 09b2ec28:

    # "Un silence un peu absurde s’installe, puis Anya regarde de nouveau vers la porte."
    "A slightly absurd silence settles in, then Anya looks toward the door again."

# game/scenario/8_1_0_0.rpy:498
translate english a2a90e4f:

    # anya reflexion "Pourquoi je suis cachée ?"
    anya reflexion "Why am I being hidden?"

# game/scenario/8_1_0_0.rpy:500
translate english 1e8df67b:

    # "Cette fois, personne ne plaisante."
    "This time, nobody's joking."

# game/scenario/8_1_0_0.rpy:502
translate english 4cd55519:

    # noam "Parce que Kami ne sait pas que tu es ici."
    noam "Because Kami doesn't know you're here."

# game/scenario/8_1_0_0.rpy:504
translate english bf93f115:

    # anya surpris "..."
    anya surpris "..."

# game/scenario/8_1_0_0.rpy:506
translate english c8a4f076:

    # noam "Et on aimerait que ça reste comme ça."
    noam "And we'd like to keep it that way."

# game/scenario/8_1_0_0.rpy:508
translate english d52f486e:

    # anya inquiet "Pourquoi ?"
    anya inquiet "Why?"

# game/scenario/8_1_0_0.rpy:510
translate english c8c4b781:

    # iris reflexion "Parce qu’on n’a aucune idée de ce qu’elle ferait de toi."
    iris reflexion "Because we have no idea what she'd do with you."

# game/scenario/8_1_0_0.rpy:512
translate english 7aa1896e:

    # noam "Tu n’es pas représentante, tu n’étais pas censée être dans cette livraison et, surtout, tu n’étais pas censée entrer dans le Conclave."
    noam "You're not a representative, you weren't supposed to be in that delivery and, above all, you weren't supposed to enter the Conclave."

# game/scenario/8_1_0_0.rpy:514
translate english a788ceaa:

    # anya inquiet "Elle pourrait me tuer ?"
    anya inquiet "She could kill me?"

# game/scenario/8_1_0_0.rpy:516
translate english 3881ecc7:

    # "Je ne réponds pas immédiatement."
    "I don't answer right away."

# game/scenario/8_1_0_0.rpy:518
translate english 7a3388df:

    # iris desaccord "On préfère ne pas vérifier."
    iris desaccord "We'd rather not find out."

# game/scenario/8_1_0_0.rpy:520
translate english 7fecba9e:

    # anya "..."
    anya "..."

# game/scenario/8_1_0_0.rpy:522
translate english 278e404e:

    # noam determine "C’est pour ça qu’on doit être extrêmement prudents. Il y a des caméras et des micros dans presque toutes les pièces ; cette salle de bain est l’un des rares endroits où on peut parler tranquillement."
    noam determine "That's why we have to be extremely careful. There are cameras and mics in almost every room; this bathroom is one of the few places where we can actually talk."

# game/scenario/8_1_0_0.rpy:524
translate english 726c6812:

    # anya reflexion "Et votre chambre ?"
    anya reflexion "And your bedrooms?"

# game/scenario/8_1_0_0.rpy:526
translate english 1d2b87b9:

    # iris "Brouilleur."
    iris "Jammer."

# game/scenario/8_1_0_0.rpy:528
translate english 7fecba9e_1:

    # anya "..."
    anya "..."

# game/scenario/8_1_0_0.rpy:530
translate english 774fd0f8:

    # anya inquiet "Combien de personnes savent que je suis ici ?"
    anya inquiet "How many people know I'm here?"

# game/scenario/8_1_0_0.rpy:532
translate english 0d7b1ccc:

    # noam "Quatre : Iris, Nyra, Tomas et moi."
    noam "Four: Iris, Nyra, Tomas and me."

# game/scenario/8_1_0_0.rpy:534
translate english 69178565:

    # anya "Personne d’autre ?"
    anya "Nobody else?"

# game/scenario/8_1_0_0.rpy:536
translate english fdb1fcf7:

    # noam "Personne."
    noam "Nobody."

# game/scenario/8_1_0_0.rpy:538
translate english 752c3155:

    # "Elle acquiesce lentement."
    "She nods slowly."

