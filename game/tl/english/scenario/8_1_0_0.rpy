    anya_inconnue reflexion "The container..."

# game/scenario/8_1_0_0.rpy:301
translate english be12e304:

    # noam reflexion "C’est comme ça que tu es arrivée ici."
    noam reflexion "That's how you got here."

# game/scenario/8_1_0_0.rpy:303
translate english e5faa069_1:

    # anya_inconnue fatigue "..."
    anya_inconnue fatigue "..."

# game/scenario/8_1_0_0.rpy:305
translate english f595347b:

    # noam "On t’a trouvée hier matin."
    noam "We found you yesterday morning."

# game/scenario/8_1_0_0.rpy:307
translate english bc0dea0f:

    # anya_inconnue surpris "Hier ?"
    anya_inconnue surpris "Yesterday?"

# game/scenario/8_1_0_0.rpy:309
