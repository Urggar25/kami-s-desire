    julian taquin "Five people in agreement? Careful, that looks dangerously like a gathering."

# game/scenario/8_1_0_0.rpy:670
translate english ed915562:

    # mara desaccord "Tu comptes faire cette blague jusqu’au vote ?"
    mara desaccord "Are you going to keep making that joke until the vote?"

# game/scenario/8_1_0_0.rpy:672
