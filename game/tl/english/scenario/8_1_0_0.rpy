translate english 526bea77:

    # "Il lève les yeux et nos regards se croisent."
    "He looks up and our eyes meet."

# game/scenario/8_1_0_0.rpy:774
translate english 75a7f8c4:

    # ryn reflexion "Noam."
    ryn reflexion "Noam."

# game/scenario/8_1_0_0.rpy:776
translate english cd568648:

    # noam hesitation "Ryn."
    noam hesitation "Ryn."

# game/scenario/8_1_0_0.rpy:778
translate english 6e0db5fd:

    # "Il ne semble pas particulièrement nerveux, ni même surpris."
    "He doesn't seem particularly nervous, or even surprised."

