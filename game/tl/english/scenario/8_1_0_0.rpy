    "I slow down a little as I come level with them."

# game/scenario/8_1_0_0.rpy:650
translate english da604360:

    # julian sourire "Ah ! Voilà notre expert constitutionnel."
    julian sourire "Ah! Here's our constitutional expert."

# game/scenario/8_1_0_0.rpy:652
translate english 5a3efcdc:

    # noam taquin "Je regrette déjà d’être venu."
    noam taquin "I already regret coming."

# game/scenario/8_1_0_0.rpy:654
