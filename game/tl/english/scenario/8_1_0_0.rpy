    # think "Non."
    think "No."

# game/scenario/8_1_0_0.rpy:796
translate english fd6fe629_2:

    # "Mon ventre se noue."
    "My stomach knots up."

# game/scenario/8_1_0_0.rpy:798
translate english f1fd2592:

    # think "Ryn n’est pas au courant. Il n’est PAS au courant."
    think "Ryn doesn't know. He does NOT know."

# game/scenario/8_1_0_0.rpy:800
translate english 90a080fb:

    # "Je recompte machinalement."
    "I count again without thinking."

# game/scenario/8_1_0_0.rpy:802
translate english 7c90a880:

    # think "Iris, Nyra, Tomas et moi. C’est tout."
    think "Iris, Nyra, Tomas and me. That's it."

# game/scenario/8_1_0_0.rpy:804
translate english 75ae1c3f:

    # "Je fixe encore la porte."
    "I keep staring at the door."

# game/scenario/8_1_0_0.rpy:806
translate english 990b03f8:

    # think "Alors qu’est-ce qu’il foutait là-dedans ?"
    think "So what the hell was he doing in there?"

