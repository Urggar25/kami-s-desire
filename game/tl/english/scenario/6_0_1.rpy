translate english b15e0021:

    # think "Sael. Oui. C'est elle. Où est-elle ? Elle était là il y a une seconde !"
    think "Sael. Yes, her. Where is she? She was here a second ago!"
# game/scenario/6_0_1.rpy:333
translate english 30b60ade:

    # "Sael est derrière le groupe, elle ne bouge plus. Elle fixe un angle vide du couloir."
    "Sael is behind the group, standing completely still and staring at an empty corner of the hallway."
# game/scenario/6_0_1.rpy:335
translate english 8b1d53e7:

    # noam inquiet "Sael ?"
    noam inquiet "Sael?"
# game/scenario/6_0_1.rpy:338
translate english c47aa2f3:

    # sael reflechit "... J'ai vu quelqu'un. Là-bas."
    sael reflechit "...I saw someone. Over there."
# game/scenario/6_0_1.rpy:342
translate english 62a5948c:

    # noam reflechit "Il n'y a personne. Enfin… je ne vois personne."
    noam reflechit "There's no one there. At least... I don't see anyone."
# game/scenario/6_0_1.rpy:344
translate english 5e8ac0e7:

    # sael triste "... Oui. Tu as sans doute raison…"
    sael triste "...Yes. You're probably right..."
# game/scenario/6_0_1.rpy:350
translate english 8d2cc137:

    # think "Non. Ce n'est pas ça."
    think "No. That's not it."
# game/scenario/6_0_1.rpy:351
translate english 7359a048:

    # "Je recompte tout le monde.."
    "I count everyone again."
# game/scenario/6_0_1.rpy:352
translate english 4d9af40b:

    # think "Ah si, tout le monde est bien là. Pourquoi j'ai eu cette impression tout à coup ?"
    think "Oh. Everyone is here after all. Why did I suddenly get that feeling?"
# game/scenario/6_0_1.rpy:354
translate english a83a3d2a:

    # noam "Bon, on y va. On va essayer de survivre à ce moment."
    noam "All right, let's go. Let's try to survive this."
# game/scenario/6_0_1.rpy:366
translate english c119c0dd:

    # think "Nos corps connaissent déjà le chemin."
    think "Our bodies already know the way."
# game/scenario/6_0_1.rpy:376
translate english de4df1a2:

    # kami "... Ah oui. Vous voilà. Début du débat."
    kami "...Ah, yes. There you are. Debate begins."
# game/scenario/6_0_1.rpy:384
translate english f6e6224b:

    # kami "Vous connaissez déjà comment tout ça fonctionne. Je ne vais pas me répéter inutilement."
    kami "You already know how this works. I won't repeat myself for no reason."
# game/scenario/6_0_1.rpy:388
translate english e35f7466:

    # kami "Alors. Parlez. Débattez."
    kami "So. Speak. Debate."
# game/scenario/6_0_1.rpy:392
translate english fc60b353:

    # "Personne ne parle. Pas une seule tentative."
    "No one speaks. Not a single attempt."
# game/scenario/6_0_1.rpy:393
translate english 2fe658c2:

    # think "À quoi bon ...?"
    think "What's the point...?"
# game/scenario/6_0_1.rpy:397
translate english 25cbb13c:

    # kami "... Intéressant"
    kami "...Interesting."
# game/scenario/6_0_1.rpy:401
translate english e352b0fb:

    # kami "Vous souhaitez déjà sauter à la conclusion sans passer par le processus.."
    kami "You want to skip straight to the conclusion without going through the process."
# game/scenario/6_0_1.rpy:402
translate english b844e455:

    # kami "Sur le principe, ça m'irait mais..."
    kami "In principle, that would suit me, but..."
# game/scenario/6_0_1.rpy:404
translate english 68e82cc7:

    # think "Sa voix bloque sur le mot."
    think "Her voice catches on the word."
# game/scenario/6_0_1.rpy:431
translate english 269b0d91:

    # ryn colere "Putain mais qu'est-ce qui t'arrive ? De toute façon ça sert à rien de débattre ! On connaît déjà la fin !"
    ryn colere "What the fuck is wrong with you? There's no point debating anyway! We already know how this ends!"
# game/scenario/6_0_1.rpy:433
translate english c7c75232:

    # iris colere "Pff, à quoi bon jouer son jeu. Tout ça ne servirait à rien."
    iris colere "Ugh, what's the point of playing her game? None of this would achieve anything."
# game/scenario/6_0_1.rpy:446
translate english d5f90cce:

    # kami "Interaction insuffisante. Les gens n'aiment pas !"
    kami "Insufficient interaction. People don't like it!"
# game/scenario/6_0_1.rpy:450
translate english f1fdfff1:

    # kami "Ajustement en cours."
    kami "Adjustment in progress."
# game/scenario/6_0_1.rpy:454
translate english c502e24a:

    # think "... Là. Ce n'est clairement pas normal."
    think "...There. This is clearly not normal."
# game/scenario/6_0_1.rpy:493
translate english e3d9d0ce:

    # ryn "Elle bugue complet là ?"
    ryn "Is she completely glitching out?"
# game/scenario/6_0_1.rpy:495
translate english 70bb019d:

    # lysa "Ouais, c'est bien ce qu'on disait tout à l'heure."
    lysa "Yeah, that's exactly what we were saying earlier."
# game/scenario/6_0_1.rpy:598
translate english 1df835dd:

    # iris colere "... Elle vient de dire quoi là ?!"
    iris colere "...What did she just say?!"
# game/scenario/6_0_1.rpy:600
translate english 3e888666:

    # ryn reflechit "J-je sais pas, c'était incompréhensible."
    ryn reflechit "I-I don't know. It was impossible to understand."
# game/scenario/6_0_1.rpy:602
translate english 62d60472:

    # mara mefiant "Bien sûr que si, tu as parfaitement compris ce qu'elle a voulu dire."
    mara mefiant "Of course you do. You understood exactly what she meant."
# game/scenario/6_0_1.rpy:608
translate english 256bc9e0:

    # lysa reflechit "Elle a aussi dit voter."
    lysa reflechit "She also said vote."
# game/scenario/6_0_1.rpy:610
translate english 4e18830d:

    # mara rire "Ouais. Après. Trop tard."
    mara rire "Yeah. Afterward. Too late."
# game/scenario/6_0_1.rpy:611
translate english 8296cd40:

    # mara reflechit "Je sais pas exactement ce qu'elle a voulu nous dire, mais clairement, vu son état, moi je prends pas le risque de voter pour un truc qui change les règles du monde."
    mara reflechit "I don't know exactly what she was trying to tell us, but in her condition, I'm definitely not risking a yes vote on something that changes the rules of the world."
# game/scenario/6_0_1.rpy:613
translate english 4fcb5c61:

    # iris colere "Ouais, c'est clair. C'est beaucoup trop dangereux."
    iris colere "Yeah, obviously. It's way too dangerous."
# game/scenario/6_0_1.rpy:615
translate english 71ca4655:

    # tomas reflechit "Peut-être... Qu'il y a un truc qu'on a pas compris dans le texte ?"
    tomas reflechit "Maybe... there's something in the text we didn't understand?"
# game/scenario/6_0_1.rpy:617
translate english c918251a:

    # elen triste "Bof ! On peut pas voter là-dessus ! On sait même pas ce qu'elle a dit !"
    elen triste "No way! We can't vote on this! We don't even know what she said!"
# game/scenario/6_0_1.rpy:619
translate english 1c2514ab:

    # lysa blase "Et pourtant, ils attendent tous notre réponse."
    lysa blase "And yet they're all waiting for our answer."
# game/scenario/6_0_1.rpy:621
translate english 7fa30a61:

    # elen inquiet "Non, mais vraiment— Si Kami bugge pendant qu’elle annonce le texte, qu’est-ce qui se passe si on vote pour ?"
    elen inquiet "No, seriously—if Kami glitches while announcing the text, what happens if we vote yes?"
# game/scenario/6_0_1.rpy:623
translate english 62bef41b:

    # sael colere "On ne sait pas. De toute façon j'avais déjà prévu de voter contre."
    sael colere "We don't know. I was already planning to vote no anyway."
# game/scenario/6_0_1.rpy:624
translate english a90f1d34:

    # sael triste "Vous pouvez faire ce que vous voulez, ce texte ne passera pas."
    sael triste "Do whatever you want. This proposal isn't passing."
# game/scenario/6_0_1.rpy:626
translate english e5fb0b30:

    # ryn colere "Même si ça pourrait aider tes proches ? Tu es vraiment prête à l'assumer devant eux ?!"
    ryn colere "Even if it could help the people you care about? Are you really ready to face them after that?!"
# game/scenario/6_0_1.rpy:628
translate english df8c2f76:

    # mara colere "On ne va pas revenir sur le sujet. Puis avec les trucs chelous qui se passent, c'est une raison de plus pour voter contre."
    mara colere "We're not reopening that argument. And with all this weird stuff happening, it's one more reason to vote no."
# game/scenario/6_0_1.rpy:630
translate english f741c14e:

    # iris triste "Ce changement-là attendra. C'est tout."
    iris triste "That change will have to wait. That's all."
# game/scenario/6_0_1.rpy:632
translate english 0b23a226:

    # ryn triste "M-..."
    ryn triste "M-..."
# game/scenario/6_0_1.rpy:634
translate english 731a619c:

    # sael triste "Un jour, tu comprendras."
    sael triste "One day, you'll understand."
# game/scenario/6_0_1.rpy:653
translate english f6e4ec71:

    # ryn colere "Putain mais pourquoi t'as fait ça ?!"
    ryn colere "Why the fuck did you do that?!"
# game/scenario/6_0_1.rpy:655
translate english e5b80990:

    # noam colere "C'est son choix. Il faut le respecter."
    noam colere "It's her choice. We have to respect it."
# game/scenario/6_0_1.rpy:661
translate english fc77acf5:

    # kami "HEP HEP HEP ! On était pas-pas au moment du vote !"
    kami "HEY, HEY, HEY! We were n-not at the voting stage yet!"
# game/scenario/6_0_1.rpy:662
translate english c7975397:

    # kami ""
    kami ""

# game/scenario/6_0_1.rpy:669
translate english 6c61f920:

    # kami "Bref. Le débat était déjà clos. Finissons-en."
    kami "Anyway. The debate was already closed. Let's get this over with."
# game/scenario/6_0_1.rpy:778
translate english j601_sael_vote_animation_001fa07d:

    # think "Le résultat reste affiché quelques secondes. Il n'a surpris personne."
    think "The result stays on-screen for a few seconds. No one is surprised."
# game/scenario/6_0_1.rpy:783
translate english j601_sael_vote_animation_69b04011:

    # kami "Résultat du vote."
    kami "Voting results."
# game/scenario/6_0_1.rpy:786
translate english j601_sael_vote_animation_4fb61a2d:

    # kami "Ab— Absence d'unanimité. Amendement rejeté."
    kami "No— No unanimity. Amendment rejected."
# game/scenario/6_0_1.rpy:789
translate english j601_sael_vote_animation_fbe00088:

    # kami "La libre circulation entre… demeure interdite."
    kami "Free movement between... remains prohibited."
# game/scenario/6_0_1.rpy:792
translate english j601_sael_vote_animation_b7f30dd6:

    # kami "Statu quo maintenu."
    kami "Status quo maintained."
