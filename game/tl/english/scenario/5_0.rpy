    # elias colere "On a perdu l'alimentation de secours. Là, ça va vraiment nous retomber dessus."
    elias colere "We lost the backup power. Now this is really gonna bite us in the ass."

# game/scenario/5_0.rpy:964
translate english 0d80d546:

    # elias fatigue "C'est mort pour le panneau… mais la sécurité principale tient encore. On peut continuer."
    elias fatigue "The panel's done for... but the main safety system is still holding. We can keep going."

# game/scenario/5_0.rpy:967
translate english 1ee6b9bc:

    # elias colere "Non, pas celui-là !"
    elias colere "No, not that one!"

# game/scenario/5_0.rpy:968
translate english 22bd64b1:

    # elias "Putain… Bon. Bah je sais plus quoi faire pour réparer ça..."
    elias "Fuck... Okay. Well, I have no idea how to fix this anymore..."

# game/scenario/5_0.rpy:971
translate english da16ea51:

    # elias rire "Oh super, t'as géré !"
    elias rire "Oh, awesome! You nailed it!"

# game/scenario/5_0.rpy:973
translate english 0567d770:

    # elias fatigue "C'est moche. Mais ça tient. C'est le principal."
    elias fatigue "It's ugly, but it's holding. That's what matters."

# game/scenario/5_0.rpy:975
translate english 771c8f56:

    # elias inquiet "C'est pété de partout. Mais ça fume moins. Franchement, on prend."
    elias inquiet "It's busted all over, but there's less smoke. Honestly, I'll take it."

# game/scenario/5_0.rpy:980
translate english d0644695:

    # elias "La ventilation tourne. Au moins on va pas étouffer."
    elias "The ventilation's running. At least we won't suffocate."

# game/scenario/5_0.rpy:981
translate english 382e6598:

    # elias fatigue "Mais ouais… on est bloqués pour un moment. C'est chaud, cette salle est censée observer les problèmes, pas en devenir un."
    elias fatigue "But yeah... we're stuck for a while. This is messed up. This room's supposed to monitor problems, not become one."

# game/scenario/5_0.rpy:983
translate english 46d35ca8:

    # "Elias s'assoit par terre, loin du panneau."
    "Elias sits down on the floor, away from the panel."

# game/scenario/5_0.rpy:985
translate english 1e68e3f6:

    # elias neutre "Tu voulais regarder les chiffres de Limen, non ?"
    elias neutre "You wanted to look at Limen's numbers, right?"

# game/scenario/5_0.rpy:987
translate english 15f7b642:

    # "Je m'assieds à côté de lui, dos au mur."
    "I sit beside him with my back against the wall."

# game/scenario/5_0.rpy:989
translate english 73fa6be3:

    # elias inquiet "Tu crois que ça va passer, le vote ?"
    elias inquiet "You think the vote's gonna pass?"

# game/scenario/5_0.rpy:991
translate english 5dada10f:

    # noam "Tu veux savoir si ça peut encore passer. Enfin… je ne vois pas ce qui changerait avant demain."
    noam "You want to know whether it still has a chance. I mean... I don't see what could change before tomorrow."

# game/scenario/5_0.rpy:995
translate english 1308929b:

    # elias inquiet "Sael votera contre."
    elias inquiet "Sael will vote against it."

# game/scenario/5_0.rpy:996
translate english f212221e:

    # elias triste "C'est sûr. Elle croit vraiment que ça ramènera la guerre."
    elias triste "Definitely. She really thinks it'll bring the war back."

# game/scenario/5_0.rpy:998
translate english b8381e58:

    # noam triste "Elle me l'a dit ce matin. Mara aussi d'ailleurs apparemment."
    noam triste "She told me this morning. Apparently Mara will too."

# game/scenario/5_0.rpy:1000
translate english f4b5cac5:

    # elias "… Ah."
    elias "...Oh."

# game/scenario/5_0.rpy:1002
translate english 41a29430:

    # elias fatigue "Alors c'est foutu. C'est chaud."
    elias fatigue "Then we're screwed. That's rough."

# game/scenario/5_0.rpy:1004
translate english 6eaa4de9:

    # noam "Ouais, on ne peut plus rien changer…"
    noam "Yeah. There's nothing we can change anymore..."

# game/scenario/5_0.rpy:1013
translate english 33730476:

    # "Les voyants passent à l'orange. Le panneau de la porte clignote."
    "The indicators turn orange. The door panel starts blinking."

# game/scenario/5_0.rpy:1017
translate english 54f4caca:

    # "La porte s'ouvre dans un déclic."
    "The door clicks open."

# game/scenario/5_0.rpy:1021
translate english 5afe936f:

    # elias fatigue "Ah. Libérés. C'était moins long que prévu."
    elias fatigue "Oh. We're free. That didn't take as long as I expected."

# game/scenario/5_0.rpy:1023
translate english 98ba4d41:

    # "Elias se relève en s'étirant."
    "Elias gets to his feet and stretches."

# game/scenario/5_0.rpy:1025
translate english 56e7edf0:

    # elias "Je vais voir si j'ai cramé un truc important. Enfin, je veux dire plus important que la porte."
    elias "I'm gonna see if I fried anything important. I mean, anything more important than the door."

# game/scenario/5_0.rpy:1027
translate english a00e45c0:

    # think "Quelques touches collent. L'écran latéral est mort."
    think "A few keys are sticky. The side screen is dead."

# game/scenario/5_0.rpy:1029
translate english 6078802b:

    # elias neutre "Rien de trop grave. Enfin je crois."
    elias neutre "Nothing too serious. I think."

# game/scenario/5_0.rpy:1030
translate english 8c041546:

    # elias reflechit "Mais je comprends pas pourquoi ça a fumé autant..."
    elias reflechit "But I don't get why it smoked that much..."

# game/scenario/5_0.rpy:1032
translate english 0676049e:

    # think "Nous nous séparons dans le couloir, avec un vote condamné et une caméra en moins. Bilan mitigé."
    think "We part ways in the hallway with a doomed vote and one less camera. Mixed results."

# game/scenario/5_0.rpy:1044
translate english a722e3e2:

    # think "Puis l'après-midi passe. Elle se termine comme elle a commencé : lourde, lente, sans discussion."
    think "The afternoon passes. It ends the way it began: heavy, slow, and silent."

# game/scenario/5_0.rpy:1045
translate english 171eb44e:

    # "Puis je retourne dans ma chambre."
    "Then I return to my room."

# game/scenario/5_0.rpy:1049
translate english 934a8c75:

    # think "Je m'assieds au bord du lit, pas encore prêt à m'allonger."
    think "I sit on the edge of the bed, not quite ready to lie down."

# game/scenario/5_0.rpy:1050
translate english 3cf0a4ef:

    # think "Tout le monde a raison, d'une certaine façon. Et demain, le vote échouera."
    think "In a way, everyone is right. And tomorrow, the vote will fail."

# game/scenario/5_0.rpy:1053
translate english d8386799:

    # "Je m'allonge."
    "I lie down."

# game/scenario/5_0.rpy:1058
translate english 9e5468f7:

    # think "Plus qu'une nuit. Un matin. Puis le vote."
    think "One more night. One morning. Then the vote."

# game/scenario/5_0.rpy:1060
translate english 158f471c:

    # think "Que peut-on encore faire ? Peut-être que « faire » n'est même plus le bon mot."
    think "What can we still do? Maybe 'do' isn't even the right word anymore."

# game/scenario/5_0.rpy:1061
translate english 4e9e510d:

    # think "Peut-être qu'il faut seulement rester là, sans solution."
    think "Maybe all we can do is stay here, without an answer."

# game/scenario/5_0.rpy:1067
translate english 3dec8ec8:

    # "Une porte s'ouvre dans le couloir. Des pas discrets passent devant ma chambre."
    "A door opens in the hallway. Quiet footsteps pass my room."

# game/scenario/5_0.rpy:1068
translate english d59ccf16:

    # think "Quelqu'un ne dort pas."
    think "Someone isn't asleep."

# game/scenario/5_0.rpy:1086
translate english 97a9422e:

    # think "Je ferme les yeux. Le corps tombe toujours avant la tête."
    think "I close my eyes. The body always gives in before the mind."

# game/scenario/5_0.rpy:1088
translate english 474ffedf:

    # think "Le vote est probablement perdu. Pourtant, m'être levé, avoir frappé aux portes, être resté là…"
    think "The vote is probably lost. And yet, getting up, knocking on doors, staying here..."

# game/scenario/5_0.rpy:1089
translate english 1e0b08bc:

    # think "Ça ne ressemble pas tout à fait à une défaite."
    think "It doesn't quite feel like defeat."

# game/scenario/5_0.rpy:1090
translate english 5935cec0:

    # think "Je me suis battu quand même. Personne ne pourra me le reprocher."
    think "I fought anyway. No one can hold that against me."

# game/scenario/5_0.rpy:1094
translate english 73c1935c:

    # think "Je ne sais pas encore ce que ça veut dire."
    think "I still don't know what that means."

# game/scenario/5_0.rpy:1099
translate english 63f9df78:

    # think "Demain sera difficile. Mais j'y serai quand même."
    think "Tomorrow will be hard. But I'll be there anyway."

# game/scenario/5_0.rpy:1100
translate english b0a0c234:

    # "Puis le sommeil arrive rapidement."
    "Then sleep comes quickly."

# game/scenario/5_0.rpy:1123
translate english f32f3a14:

    # think "Le lit n'est pas défait."
    think "The bed is untouched."

# game/scenario/5_0.rpy:1124
translate english 9a4959f6:

    # think "Il a été refusé."
    think "Rejected."

# game/scenario/5_0.rpy:1125
translate english 120e0be4:

    # sael neutre "Le lit était trop mou."
    sael neutre "The bed was too soft."

# game/scenario/5_0.rpy:1126
translate english c8b4fc23:

    # sael "On dort mal quand le corps oublie le sol."
    sael "You sleep poorly when the body forgets the ground."

# game/scenario/5_0.rpy:1133
translate english 64f4bd27:

    # think "Je ne sais pas si c'est un souvenir, un avertissement ou une prière."
    think "I don't know whether it's a memory, a warning, or a prayer."

# game/scenario/5_0.rpy:1134
translate english e5f43a5c:

    # think "Chez elle, même les morts semblent avoir une fonction."
    think "With her, even the dead seem to serve a purpose."

# game/scenario/5_0.rpy:1135
translate english 411ac6b8:

    # sael neutre "Ne touche pas."
    sael neutre "Don't touch."

# game/scenario/5_0.rpy:1142
translate english e4f2231b:

    # think "Elle n'a pas décoré sa chambre."
    think "She didn't decorate her room."

# game/scenario/5_0.rpy:1143
translate english 34e5c014:

    # think "Elle l'a rendue habitable selon ses propres règles."
    think "She made it livable by her own rules."

# game/scenario/5_0.rpy:1144
translate english a8398e5e:

    # think "Pas confortable. Habitable."
    think "Not comfortable. Livable."

# game/scenario/5_0.rpy:1156
translate english f0461d4f:

    # "J'entrouvre la porte. Une silhouette disparaît au bout du couloir."
    "I crack the door open. A figure disappears at the far end of the hallway."

# game/scenario/5_0.rpy:1157
translate english 373f11e7:

    # think "Trop vite pour un visage. Pas assez pour l'inventer."
    think "Too fast to make out a face. Not fast enough for me to have imagined it."

# game/scenario/5_0.rpy:1159
translate english 7ada339b:

    # think "Le Conclave ne dort pas."
    think "The Conclave doesn't sleep."

# game/scenario/5_0.rpy:1160
translate english 1d6dcb6e:

    # think "Il se déplace à voix basse."
    think "It moves in whispers."

# game/scenario/5_0.rpy:1168
translate english 7fe765b3:

    # think "Je reste immobile. Les pas ralentissent derrière la porte."
    think "I remain still. The footsteps slow down outside the door."

# game/scenario/5_0.rpy:1171
translate english f0ed04be:

    # julian "Je voulais aider."
    julian "I wanted to help."

# game/scenario/5_0.rpy:1173
translate english 2eda82dc:

    # julian "Non. Trop faible."
    julian "No. Too weak."

# game/scenario/5_0.rpy:1174
translate english 438ae7a4:

    # julian "J'ai porté une idée que vous n'étiez pas prêts à comprendre."
    julian "I championed an idea you weren't ready to understand."

# game/scenario/5_0.rpy:1176
translate english f62ab2f2:

    # elias fatigue "C'est moche."
    elias fatigue "It's ugly."

# game/scenario/5_0.rpy:1178
translate english 9080d56f:

    # elias "Mais ça tient."
    elias "But it's holding."

# game/scenario/5_0.rpy:1179
translate english 579be592:

    # elias "Faut que ça tienne jusqu'à demain, c'est tout."
    elias "It only needs to hold until tomorrow. That's all."

# game/scenario/5_0.rpy:1181
translate english 40acc4e3:

    # think "Puis les pas s'éloignent."
    think "Then the footsteps recede."

# game/scenario/5_0.rpy:1187
translate english 4e398d34:

    # think "Je pourrais me lever."
    think "I could get up."

# game/scenario/5_0.rpy:1188
translate english 20861aa9:

    # think "Je pourrais ouvrir."
    think "I could open the door."

# game/scenario/5_0.rpy:1189
translate english 6a679412:

    # think "Mais ce soir, je n'ai plus la force de devenir utile."
    think "But tonight, I don't have the strength to be useful anymore."

