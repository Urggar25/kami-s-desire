# Jour 6_0_1 — Branche statu quo post-accident café
default j601_vote_noam = "abstention"
default j601_signal_result = False
default j601_qte_hits = 0
default j601_kami_irritation = 0

label day6_0_1_start:
    scene black with fade
    "08:00."
    "Le réveil de Noam est brutal, sans cause précise, comme une chute intérieure."
    "Le plafond lui paraît plus bas. Le silence, plus lourd."
    "Une vibration bleue fend l'air."
    "Kami se matérialise, mais l'image accroche: un pixel mort, puis deux, puis une légère torsion du visage."
    "Kami: "Debout. Vote de circulation à quatorze heures. Prépare-toi.""
    "Sa voix tombe par à-coups, comme si un mot sur trois avait été comprimé."
    "Kami: "Et évite de compliquer la maintenance aujourd'hui. J'ai déjà assez de vos conneries à réparer.""
    "Elle coupe la transmission sans attendre de réponse."
    "Noam reste assis un instant, les paumes ouvertes, incapable de dire s'il a rêvé l'agressivité de son ton."
    "08:30. Cafétéria."
    "La salle n'a rien changé, et pourtant tout semble déplacé de quelques centimètres."
    "Elias saisit son verre, hésite, le perd. Le liquide éclabousse la table dans un bruit net."
    "Personne ne rit."
    "Mara essuie automatiquement. Elen observe les néons puis souffle: "Kami n'est vraiment pas dans son assiette aujourd'hui.""
    "Lysa hausse les épaules, mais son regard confirme la même crainte."
    "Aucun temps libre n'est accordé."
    "Les annonces internes redirigent le groupe vers le Conclave."
    "14:00. Conclave."
    "Le débat commence, compact, presque administratif."
    "Iris vote contre avant même les arguments."
    "Sael confirme qu'elle fera de même."
    "La proposition perd sa possibilité d'unanimité en quelques secondes."
    "Kami tente de reprendre la main, mais sa présence se déphase: syllabes coupées, textures qui clignotent."
    $ j601_signal_result = renpy.call("j601_play_signal_instable")
    "La stabilisation se termine dans un claquement numérique sec."
    if j601_signal_result:
        "Le canal tient, mais Kami paraît vexée d'avoir eu besoin d'aide."
        $ j601_kami_irritation += 1
    else:
        "Le canal s'effondre brièvement. Kami revient plus froide encore."
        $ j601_kami_irritation += 2
    $ j601_qte_hits = renpy.call("j601_play_fracture_qte")
    if j601_qte_hits >= 4:
        "Noam repère chaque lapsus. Plus il comprend, plus Kami se crispe."
        $ j601_kami_irritation += 2
    elif j601_qte_hits >= 2:
        "Noam capte une partie des failles, suffisamment pour la déstabiliser."
        $ j601_kami_irritation += 1
    else:
        "Les glitches passent trop vite. Kami reprend l'initiative, sèche."
    menu:
        "Choix de Noam":
            "Voter POUR":
                $ j601_vote_noam = "pour"
            "Voter CONTRE":
                $ j601_vote_noam = "contre"
            "S'ABSTENIR":
                $ j601_vote_noam = "abstention"
    "Le dépouillement confirme l'échec de la motion."
    "Statu quo maintenu."
    "Le retour aux chambres se fait sans heurts, sans discussion, avec cette fatigue qui ressemble à une défaite."
    "Noam s'allonge."
    "Dans la pénombre, une pensée persiste: quelque chose a changé chez Kami."
    "Il ne sait pas quoi. Pas encore."
