    xsize 420
    yfill True
    background "gui/overlay/main_menu.png"

style main_menu_vbox:
    xalign 1.0
    xoffset -30
    xmaximum 1200
    yalign 1.0
    yoffset -30

style main_menu_text:
    properties gui.text_properties("main_menu", accent=True)

style main_menu_title:
    properties gui.text_properties("title")

style main_menu_version:
    properties gui.text_properties("version")


################################################################################
## Menu de jeu
################################################################################

transform game_menu_content_in:
    alpha 0.0
    yoffset 18
    easeout 0.28 alpha 1.0 yoffset 0

screen game_menu(title, scroll=None, yinitial=0.0, spacing=0):
    style_prefix "game_menu"

    # Fond sombre unifié
    if main_menu:
        add gui.main_menu_background
    else:
        add gui.game_menu_background

    # Voile sombre par-dessus le fond
    add Solid("#080d12cc")
    add Solid("#5cd3ff22", ysize=2) ypos 118
    add Solid("#ffffff10", ysize=1) ypos 176
    text "KAMI.CORE // ARCHIVES DU CONCLAVE":
        style "game_menu_meta"
        xpos 74
        ypos 126

    frame:
        style "game_menu_outer_frame"

        hbox:

            # Colonne navigation
            frame:
                style "game_menu_navigation_frame"

                # Ligne verticale de séparation
                frame:
                    background Solid("#122030")
                    xsize 1
                    yfill True
                    xalign 1.0

            frame:
                style "game_menu_content_frame"
                at game_menu_content_in

                if scroll == "viewport":
                    viewport:
                        yinitial yinitial
                        scrollbars "vertical"
                        mousewheel True
                        draggable True
                        pagekeys True
                        side_yfill True
                        vbox:
                            spacing spacing
                            transclude

                elif scroll == "vpgrid":
                    vpgrid:
                        cols 1
                        yinitial yinitial
                        scrollbars "vertical"
                        mousewheel True
                        draggable True
                        pagekeys True
                        side_yfill True
                        spacing spacing
                        transclude

                else:
                    transclude

    use navigation

    textbutton _("Retour"):
        style "return_button"
        action Jump("kd_close_game_menu")

    label title

    if main_menu:
        key "game_menu" action NullAction()


label kd_close_game_menu:
    $ main_menu = False
    $ renpy.context()._main_menu = False
    $ renpy.play(config.exit_sound)
    $ renpy.transition(config.exit_transition)
    return


