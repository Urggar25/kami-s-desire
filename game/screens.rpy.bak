transform memory_fade(duration_in=1.5, hold=2.2, duration_out=1.5):
    xalign 0.5
    yalign 0.5
    fit "cover"

    alpha 0.0
    zoom 1.035
    matrixcolor SaturationMatrix(0.0)

    parallel:
        ease duration_in alpha 1.0
        pause hold
        ease duration_out alpha 0.0

    parallel:
        ease (duration_in + hold + duration_out) zoom 1.0
