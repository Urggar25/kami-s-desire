label _18_0_1_1_0_REVEIL_DECISION:
    call MAYBE_PLAY_SCRIPTED_DOOR("chambre", "bg_chambre")
    scene bg_chambre at adaptive_fullscreen with fade
    play music "music/bgm_cold_metadata.mp3" fadein 1.5
    "Au matin, la grille est immobile. Une vis depasse pourtant de deux tours."
    noam reflexion "Une trace physique."
    kami "Bonjour, Noam."
    noam "Tu tombes bien."
    kami "Je te recommande de ne pas toucher au systeme d'aeration."
    noam "Tu tombes vraiment bien."
    kami "Toute degradation sera enregistree."
    noam "Mes souvenirs aussi, apparemment."
    kami "Cette formulation ne t'aide pas."
    noam "Elle m'aide a ne pas oublier."
    kami "Tu n'es pas autorise a demonter cette grille."
    noam determine "Alors je vais demander de l'aide."
    kami "A qui ?"
    noam "Tu verras."
    kami "Je vois deja."
    noam "Pas dans les murs."
    "Son silence vaut mieux qu'un aveu."
    jump _18_0_1_1_0_MARA

label _18_0_1_1_0_MARA:
    call MAYBE_PLAY_SCRIPTED_DOOR("cafeteria", "bg_cafeteria")
    scene bg_cafeteria at adaptive_fullscreen with dissolve
    $ showGroup([("noam", "determine", 0.27), ("mara", "fatigue", 0.67)])
    mara "Non."
    noam "Je n'ai encore rien demande."
    mara "Tu as la tete de quelqu'un qui va demander un tournevis et une mauvaise decision."
    noam "J'ai besoin d'un tournevis."
    mara agace "Evidemment."
    noam "Quelqu'un etait dans mon mur."
    mara mefiant "Ca, c'est la mauvaise decision."
    noam "Il m'a repondu. Deux coups."
    mara "Une canalisation."
    noam "Les canalisations comprennent le francais ?"
    mara taquin "Dans ton district, peut-etre."
    noam colere "Mara."
    mara stress "Je sais. Pardon."
    noam "La vis a bouge. Kami m'a ordonne de rester loin."
    mara reflexion "Elle a vraiment dit loin ?"
    noam "Deux fois."
    mara "Et tu veux ouvrir."
    noam "Je veux verifier."
    mara "C'est ce que disent tous les gens juste avant de liberer un parasite spatial."
    noam "Tu viens ?"
    mara "Pourquoi moi ?"
    noam "Parce que tu sais demonter des choses."
    mara "Je sais casser des choses avec methode. Nuance."
    noam "Parce que Tomas signalerait chaque violation."
    mara "Il nous ferait signer une decharge."
    noam "Et parce que tu m'as cru hier."
    mara mefiant "Je n'ai pas dit ca."
    noam "Tu as propose le rendez-vous."
    mara "Auquel tu n'es pas venu."
    noam fatigue "J'etais un peu occupe par la personne dans mon mur."
    mara "Nous t'avons attendu vingt minutes."
    noam "Je suis desole."
    mara colere "J'ai cru que tu avais encore disparu."
    noam "Je ne disparais pas volontairement."
    mara "C'est justement ce qui m'inquiete."
    noam "Aide-moi."
    mara fatigue "Tu sais demander gentiment quand tu es accule."
    noam "S'il te plait."
    mara "Je deteste cette version polie."
    noam "Elle fonctionne ?"
    mara agace "Retrouve-moi en maintenance dans dix minutes."
    noam sourire "Merci."
    mara colere "Je n'ai pas dit oui."
    noam "Tu as dit ou et quand."
    mara "Va-t'en avant que je change la grammaire."
    jump _18_0_1_1_0_DEMONTAGE

label _18_0_1_1_0_DEMONTAGE:
    call MAYBE_PLAY_SCRIPTED_DOOR("chambre", "bg_chambre")
    scene bg_chambre at adaptive_fullscreen with dissolve
    play music "music/bgm_fatal_assembly.mp3" fadein 1.5
    $ showGroup([("noam", "inquiet", 0.28), ("mara", "reflexion", 0.66)])
    mara "Bloque la porte."
    noam "Avec quoi ?"
    mara "La chaise."
    noam "Kami peut l'ouvrir."
    mara "Oui, mais elle devra faire du bruit. Le bruit, c'est du temps."
    noam "Tu as apporte combien d'outils ?"
    mara "Assez pour nier toute premeditation."
    noam "C'est une trousse complete."
    mara "Chut. Tiens la lampe."
    noam "Comme ca ?"
    mara agace "Si tu veux eclairer mon coude, parfait. Plus haut."
    noam "La vis est rayee."
    mara reflexion "Des deux cotes."
    noam inquiet "Donc quelqu'un l'a tournee depuis l'interieur."
    mara "Ou quelque chose."
    noam "Tu n'aides pas."
    mara taquin "Je suis venue avec les outils. Le soutien emotionnel etait en option."
    play sound sfx_metal_clank volume 0.5
    mara "Premiere vis."
    noam "Tu fais ca souvent ?"
    mara "Demonter une aeration dans la chambre d'un type paranoiaque ? Premiere fois."
    noam "Demonter des appareils."
    mara "Mon Clone detestait les objets fermes."
    noam "Ton Clone ?"
    mara "Il ouvrait tout pour comprendre. Ensuite, il remontait mal."
    noam "Tu dis il."
    mara mefiant "Je dis ce que je veux."
    noam "Hier tu ne voulais pas parler de lui."
    mara colere "Et aujourd'hui non plus. Lampe."
    noam "D'accord."
    play sound sfx_metal_clank volume 0.5
    mara "Deuxieme vis."
    noam "Il en manque une."
    mara "Non. Elle est la."
    noam "Ou ?"
    mara "Derriere le lit. Tombee vers l'exterieur."
    noam inquiet "La personne l'a poussee dans la chambre."
    mara "On ne sait pas si c'est une personne."
    noam "Arrete de dire ca."
    mara "Je refuse de transformer une hypothese en visage."
    noam "Tu as peur aussi."
    mara stress "Evidemment que j'ai peur."
    noam "Tu le caches bien."
    mara "Je parle beaucoup. Ca occupe la place."
    noam "Merci d'etre venue."
    mara fatigue "Ne rends pas ca tendre, je tiens un tournevis."
    play sound sfx_metal_clank volume 0.7
    "La grille se detache. Une haleine froide sort du conduit."
    noam "Il y a des traces."
    mara reflexion "Trois griffures sur le bord."
    noam "Et cette poussiere est tassee."
    mara "Quelqu'un a pose la main ici."
    noam "Une petite main."
    mara "Ou un gant serre."
    noam "Regarde au fond."
    mara "Des fibres rouges."
    noam "Du tissu ?"
    mara "Probablement. Et une marque de semelle."
    noam surpris "On peut vraiment passer ?"
    mara "En rampant. Si on aime manquer d'air et prendre de mauvaises decisions."
    noam "Donc oui."
    mara "Donc physiquement oui. Intelligemment non."
    kami "Reculez."
    mara rire_profond "Bonjour, Kami."
    kami "Ce conduit presente un risque."
    noam "Quel risque ?"
    kami "Coupures, chute, hypoxie, blocage, deces."
    mara "Tu as oublie poussiere dans les cheveux."
    kami "Replacez la grille."
    noam "Qui est passe ici ?"
    kami "Personne."
    mara "La semelle n'est pas d'accord."
    kami "Vous interpretez des marques de maintenance."
    noam "Les robots portent des chaussures ?"
    kami "Replacez la grille."
    mara colere "Tu radotes. C'est mauvais signe pour une deesse."
    kami "Mara."
    mara vide "Quoi ?"
    kami "Ton Clone disait la meme chose."
    "Le tournevis tombe."
    noam inquiet "Mara ?"
    mara vide "Elle ment."
    kami "Replacez la grille."
    mara colere_noire "Sors de ma tete !"
    play sound sfx_glitch volume 0.8
    "La voix se coupe."
    noam "Comment pouvait-elle savoir ?"
    mara stress "Je n'ai jamais raconte ca ici."
    noam "A personne ?"
    mara "A personne."
    noam "Alors les dossiers contiennent plus que nos souvenirs modifies."
    mara mefiant "Ou elle etait deja la avant."
    noam "Avant le Conclave ?"
    mara "Avant nous."
    jump _18_0_1_1_0_TRACES

label _18_0_1_1_0_TRACES:
    call MAYBE_PLAY_SCRIPTED_DOOR("maintenance", "bg_maintenance")
    scene bg_maintenance at adaptive_fullscreen with dissolve
    $ showGroup([("noam", "reflexion", 0.28), ("mara", "mefiant", 0.66)])
    mara "Pose les fibres dans ce sachet."
    noam "Tu as aussi des sachets de preuve ?"
    mara "J'ai vole des sachets. Le mot preuve est ton probleme."
    noam "La fibre est rouge sombre."
    mara "Aucun de nous ne porte ce textile aujourd'hui."
    noam "Aujourd'hui."
    mara "Ne commence pas."
    noam "On devrait prevenir Tomas."
    mara "Pas encore."
    noam "Pourquoi ?"
    mara "Parce que des qu'on partage une information, elle devient un souvenir collectif."
    noam "Et ?"
    mara "Et si demain je ne me souviens plus du conduit, je veux voir si toi tu t'en souviens sans aide."
    noam "Tu me testes."
    mara "Je nous teste."
    noam "D'accord."
    mara "On ecrit chacun une phrase. On les scelle."
    noam "Quelle phrase ?"
    mara "Pas la meme. Sinon l'un peut contaminer l'autre."
    noam "Tu as reflechi a ca vite."
    mara fatigue "Mon Clone et moi faisions ca."
    noam "Pourquoi ?"
    mara vide "Parce qu'a la fin, aucun de nous ne savait lequel copiait l'autre."
    noam "Mara..."
    mara colere "Pas maintenant."
    noam "D'accord."
    mara "Demain matin, cafeteria. Ne relis pas ta phrase avant."
    noam "Et la grille ?"
    mara "Je l'ai remise avec une vis differente."
    noam "Laquelle ?"
    mara taquin "Si je te le dis, le test est nul."
    noam sourire "Tu prends gout aux protocoles."
    mara agace "Repete ca et je te laisse ramper seul."
    noam "Tu envisages de venir ?"
    mara mefiant "J'envisage de t'empecher de mourir dans un tuyau."
    noam "Ca ressemble a oui."
    mara "Ca ressemble a une menace."
    "Elle ferme le sachet. A travers le plastique, les fibres rouges ressemblent a un fil coupe dans une histoire que personne ne se rappelle avoir vecue."
    call end_day("19") from _call_end_day_19
    jump _19_0_1_1_0_BARRICADE
