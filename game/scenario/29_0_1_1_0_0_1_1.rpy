# JOUR 29 — LE PRIX D'UNE PLACE
# Route secrète / choix Julian du J28. Nuit du 28 au 29, puis matin, après-midi et soir.
# Noam reste l'original ; ses interlocuteurs du laboratoire le prennent pour son double.
# La création du double de Julian ne restaure pas l'original.
define zero_j29 = Character("Zero", color="#bdc9e8")
default j29_julian_original_dead = False
default j29_julian_double_awake = False
default j29_zero_offer_heard = False

label _29_0_1_1_0_0_1_1_REVEIL:
    $ current_day = 29
    $ day_id = 29
    $ current_period = "Nuit"
    $ cafeteria_food_level = "null"
    $ j29_julian_original_dead = False
    $ j29_julian_double_awake = False
    $ j29_zero_offer_heard = False
    scene bg_laboratoire at adaptive_fullscreen with dissolve
    play music "music/bgm_cold_metadata.mp3" fadein 1.0
    "Je regarde encore ma tablette. Iris a dit oui à mon double. J'ai essayé de lui répondre au moins quatre fois, mais j'ai tout effacé."
    "Je la pose sur la banquette. Un bruit me fait lever la tête. La grille du laboratoire vient de s'ouvrir."
    $ showGroup([("mara", "fatigue", 0.18), ("sael", "mefiant", 0.43), ("noam", "inquiet", 0.79)])
    mara fatigue "Ah, t'es encore debout ? Tant mieux, on te cherchait."
    noam reflexion "Pourquoi ? Il est quelle heure ?"
    mara neutre "Presque minuit. Tu viens ? Kael veut qu'on se retrouve."
    noam inquiet "Maintenant ?"
    sael raison "Oui. Il faut qu'on parle de Julian."
    "Je remets aussitôt la tablette dans ma poche."
    noam hesitation "Quoi, Julian ? On devait pas attendre demain ?"
    mara agace "Bah justement, demain, ça commence dans dix minutes. On va pas perdre toute la journée."
    noam inquiet "Vous avez trouvé ses affaires ?"
    sael neutre "Nyra s'en charge. Viens, on t'explique."
    $ hideGroup()
    "Je les suis jusqu'à la table. Elias est déjà là, penché sur les pièces qu'on a ramenées. Kael parle avec Nyra devant le terminal."
    $ showGroup([("kael", "calme", 0.12), ("elias", "fatigue", 0.35), ("nyra", "neutre", 0.59), ("noam", "inquiet", 0.84)])
    kael calme "Bon. On fait deux équipes. Elias, Nyra et moi, on reste ici pour préparer la fabrication."
    elias fatigue "Et avant qu'on me demande : non, ça sera pas prêt dans dix minutes. J'ai encore tout un tas de vérifications à faire."
    nyra raison "Tu as les composants. Il reste l'objet personnel et les derniers réglages."
    elias agace "Oui, je sais ce qu'il me reste, merci."
    noam reflexion "Et nous ?"
    kael neutre "Toi, Mara et Sael, vous vous occupez de Julian."
    noam surpris "Comment ça, on s'en occupe ?"
    kael reflexion "On doit faire ça avant le départ. Si on attend demain soir, il sera trop tard."
    noam inquiet "Je pensais que vous vouliez juste fabriquer son double d'abord."
    nyra raison "À quoi bon fabriquer une copie si l'original reste là pour la croiser ?"
    noam colere "Attends, mais vous avez dit hier qu'on préparerait le plan ! Pas qu'on irait le tuer cette nuit !"
    kael calme "Noam, baisse d'un ton."
    noam colere "Non ! Julian a rien fait, il était encore avec tout le monde à la cafétéria !"
    elias fatigue "Hé, crie pas, putain. On est juste derrière les conduits."
    nyra reflexion "Il fallait bien décider d'un moment."
    noam colere "Vous avez décidé sans moi ?"
    kael raison "On s'est organisés. On voulait te prévenir avant de bouger."
    noam agace "Ah, merci ! Sympa de me prévenir."
    "Kael regarde Elias, puis Nyra. Il a compris que je ne suis pas prêt à laisser passer ça."
    kael calme "Tu peux ne pas y aller. Personne va te forcer à tenir Julian."
    noam inquiet "Mais Mara et Sael vont quand même y aller ?"
    kael neutre "Oui."
    noam colere "Donc ça change rien !"
    elias fatigue "Noam, je suis pas plus ravi que toi, mais on a plus de temps."
    noam raison "Mais il pourrait juste rester ici, non ? Il prendrait pas la navette, il ferait de mal à personne !"
    nyra raison "Et comment tu expliques la disparition d'un représentant à Kami ?"
    noam hesitation "J'en sais rien, mais..."
    kael calme "On n'a pas une solution pour tout. Là, il faut qu'on avance."
    "Je regarde leurs visages. Aucun n'a l'air heureux de ce qu'on prépare. Aucun n'a l'air décidé à arrêter non plus."
    noam fatigue "D'accord... J'y vais avec elles."
    kael surpris "T'es sûr ?"
    noam raison "Oui. Je veux être là."
    kael neutre "Comme tu veux. Mais écoute Sael si elle te demande quelque chose."
    $ hideGroup()
    # Durée estimée du bloc : 3 min.

label _29_0_1_1_0_0_1_1_PREPARATION:
    scene bg_laboratoire at adaptive_fullscreen with dissolve
    "Sael étale son matériel sur une table libre. Mara ferme la grille et vérifie que personne ne se trouve dans le couloir."
    $ showGroup([("sael", "reflexion", 0.21), ("mara", "neutre", 0.48), ("noam", "inquiet", 0.80)])
    sael raison "Il faut que ça se passe sans bruit. C'est le seul point sur lequel tout le monde est d'accord."
    mara neutre "Et sans qu'on se retrouve avec quelqu'un qui hurle dans les dortoirs, tant qu'à faire."
    noam inquiet "Tu comptes faire quoi, exactement ?"
    "Sael sort un torchon plié, un petit flacon et une seringue contenant un liquide transparent."
    noam surpris "C'est quoi, ça ?"
    sael neutre "Un produit anesthésiant, et autre chose pour l'empêcher de se débattre."
    noam peur "La seringue ?"
    sael fatigue "Oui. C'est du curare. Et non, c'est pas une méthode propre ou rassurante. Je vais pas te mentir là-dessus."
    mara reflexion "Mais il sera endormi avant, non ?"
    sael colere "Mara, c'est pas une opération à la con où tu lui mets un tissu sur le nez et tout se passe bien. Il peut se réveiller, il peut souffrir et ça peut dégénérer. Vous comprenez ?"
    noam inquiet "Alors pourquoi tu prépares ça ?"
    sael raison "Parce que je préfère être là plutôt que de laisser quelqu'un improviser avec un couteau. Ça veut pas dire que je trouve ça acceptable."
    mara agace "Bon, c'est bon, j'ai compris. Tu crois que je suis contente ?"
    sael neutre "Non. Je veux juste qu'on sache ce qu'on fait."
    noam colere "Mais vous parlez de tuer Julian ! C'est pas un colis qu'on doit déplacer !"
    mara colere "Tu vas me le répéter combien de fois ? On a tous compris !"
    noam colere "Bah j'ai pas l'impression !"
    mara agace "C'est toi qui l'as choisi hier !"
    noam peur "J'ai choisi Julian parce que je voulais pas qu'on s'en prenne à Iris ! Je pensais qu'on aurait encore le temps de réfléchir !"
    mara fatigue "Eh ben non. On l'a plus, ce temps-là."
    "Sael referme sa trousse et nous regarde."
    sael raison "Noam, si tu viens, tu fais ce que je te dis. Je veux pas que ça parte en bagarre dans sa chambre."
    noam inquiet "Je veux pas qu'il meure."
    sael fatigue "Moi non plus, j'ai pas envie de faire ça."
    noam colere "Mais tu vas le faire !"
    sael raison "Oui."
    "Elle ne cherche pas à se justifier davantage. Ça m'énerve presque plus que si elle s'était mise à crier."
    mara neutre "Bon. On y va ou on passe encore une heure ici ?"
    noam reflexion "Il dort où, Julian, cette nuit ?"
    mara raison "Dans sa chambre. Il a dit à Elen qu'il était crevé après le dîner."
    sael mefiant "Et il est seul ?"
    mara neutre "J'ai vérifié. Elen est retournée dans son dortoir."
    noam peur "Vous l'avez surveillé depuis tout à l'heure ?"
    mara agace "Bah oui. Tu voulais qu'on se pointe sans savoir s'il est là ?"
    sael neutre "On passe par les conduits. On n'ouvre pas sa porte depuis le couloir."
    noam reflexion "Il y a vraiment un accès jusque dans sa chambre ?"
    mara neutre "Elias a vérifié. C'est pas très confortable, mais on peut passer."
    sael raison "Alors on y va. Et pas un mot dans les couloirs."
    $ hideGroup()
    scene bg_conduit_reseau at adaptive_fullscreen with dissolve
    $ flashlight_on(0)
    "Mara avance la première. Sael suit avec sa trousse, et je rampe derrière elles."
    "Au bout de quelques mètres, Mara s'arrête pour dégager son pied d'un câble."
    mara agace "Putain, je déteste ces trucs."
    sael mefiant "Moins fort."
    mara neutre "Oui, maman."
    noam inquiet "On pourrait encore faire demi-tour."
    mara fatigue "Noam..."
    noam raison "Je dis juste qu'on peut."
    sael raison "Je sais."
    "Elles continuent. Moi aussi, parce que je veux encore croire que je vais réussir à les arrêter."
    $ flashlight_off()
    # Durée estimée du bloc : 3 min.

label _29_0_1_1_0_0_1_1_JULIAN:
    scene bg_conduit_reseau at adaptive_fullscreen with dissolve
    $ flashlight_on(0)
    "On arrive devant une grille. De l'autre côté, il y a une chambre plongée dans le noir."
    "Je distingue Julian sur son lit. Il dort sur le côté, un bras sorti de sa couverture."
    mara neutre "C'est bon. Il dort."
    sael mefiant "Attends. Je vérifie qu'on n'entend personne."
    "Je voudrais lui dire de se rendormir, à elle aussi, et qu'on oublie tout ça."
    noam inquiet "Sael..."
    sael fatigue "Quoi ?"
    noam raison "On est pas obligés. On peut encore lui parler."
    mara agace "Et lui raconter quoi ? Que ses copains sont des copies et qu'on a décidé de le remplacer ?"
    noam colere "Au moins il aurait le choix !"
    mara neutre "Et il ferait quoi, Noam ? Il courrait prévenir Kami. Puis il dirait aux autres qu'on existe."
    sael mefiant "Stop. Pas ici."
    "Mara ouvre discrètement la grille. Je me retrouve à l'intérieur sans avoir le temps de trouver une nouvelle excuse."
    $ flashlight_off()
    scene bg_chambre_julian at adaptive_fullscreen with dissolve
    $ showGroup([("sael", "mefiant", 0.18), ("mara", "inquiet", 0.47), ("noam", "peur", 0.83)])
    "Julian respire profondément. Il a laissé un livre ouvert sur le bord de son lit."
    "Sael avance. Mara reste près de la grille."
    noam inquiet "Attends."
    sael mefiant "Noam, pas maintenant."
    noam raison "Je veux lui parler."
    mara agace "Mais t'es pas sérieux ?"
    noam colere "Laissez-moi juste lui parler !"
    sael raison "Et tu lui dis quoi ?"
    noam hesitation "Je sais pas ! Je lui dis de pas monter dans la navette... qu'il faut qu'il..."
    "Je m'arrête. Je suis en train d'inventer n'importe quoi."
    mara fatigue "Tu vois ?"
    "Sael me fait signe de rester près de la grille et s'approche du lit."
    "Je la regarde sortir le torchon. Julian bouge un peu dans son sommeil."
    noam peur "Sael, non."
    "Je m'avance et lui attrape le poignet."
    sael colere "Lâche-moi."
    noam colere "Arrête. S'il te plaît, arrête."
    mara inquiet "Noam, putain, lâche-la !"
    noam raison "On peut pas juste le tuer ! Vous l'avez entendu parler aujourd'hui ? Il a des projets, il veut rentrer chez lui !"
    sael fatigue "Je sais."
    noam colere "Alors pourquoi tu fais ça ?!"
    "Julian remue dans son lit. Il ouvre les yeux à moitié."
    julian fatigue "Hein... ?"
    "Je lâche Sael. Julian essaie de se redresser."
    julian surpris "Noam ? Qu'est-ce que tu fais là ?"
    noam peur "Julian..."
    julian fatigue "C'est quoi, cette heure ? Il se passe un truc ?"
    "Son regard passe de moi à Mara, puis à Sael."
    julian inquiet "Attendez... qui est là ?"
    mara peur "Merde."
    julian inquiet "Noam, réponds-moi !"
    noam colere "Julian, bouge pas !"
    "Julian tente de reculer. Sael intervient avant qu'il puisse atteindre le bord du lit."
    scene black with vpunch
    "Je me jette vers eux, mais Mara me retient par le bras. Je me débats et je lui demande de me lâcher."
    noam peur "LÂCHE-MOI !"
    mara colere "Arrête de bouger !"
    julian peur "Qu'est-ce que vous faites ?! Noam !"
    "J'entends sa voix, puis des bruits étouffés. Sael me tourne le dos."
    "Je cherche à me dégager. Mara serre les dents. Je finis par la repousser."
    scene bg_chambre_julian at adaptive_fullscreen with dissolve
    "Sael est penchée sur Julian. La seringue est dans sa main. Elle ne me regarde pas."
    noam peur "Non, non, non..."
    "Julian ne bouge presque plus. Ses yeux restent ouverts."
    noam colere "Sael ! Fais quelque chose !"
    sael peur "Noam, recule."
    noam colere "Mais aide-le !"
    sael triste "Je peux pas."
    noam peur "Quoi ? Comment ça, tu peux pas ?!"
    "Je me penche vers Julian. Il essaie de bouger une main. Puis plus rien."
    noam peur "Julian ? Hé, Julian ! Regarde-moi !"
    "Sael m'écarte doucement. Elle vérifie son état, longtemps."
    mara inquiet "Sael ?"
    sael triste "C'est terminé."
    mara peur "T'es sûre ?"
    sael fatigue "Oui."
    "Je fixe Julian. Il a toujours le même visage que tout à l'heure, quand il m'a demandé pourquoi j'étais là."
    noam colere "Vous l'avez tué."
    mara fatigue "Noam..."
    noam colere "Vous l'avez tué devant moi !"
    mara colere "Arrête de crier !"
    noam colere "Tu veux que je fasse quoi, Mara ? Que je te dise bravo ?!"
    "Mara ouvre la bouche, puis détourne les yeux."
    sael triste "Il faut qu'on sorte."
    noam agace "Tu veux même pas rester avec lui ?"
    sael fatigue "On peut pas le laisser comme ça, je sais. Mais si quelqu'un nous trouve ici, ça sera encore pire."
    noam colere "Pour qui ? Pour vous ?"
    sael raison "Pour tout le monde. Et je vais pas prétendre que ça change ce qu'on vient de faire."
    "Sael range son matériel sans rien ajouter. Mara nous montre l'accès au conduit."
    noam fatigue "Il m'a reconnu. Il m'a demandé ce que je faisais là."
    mara triste "Je sais."
    noam colere "Non, tu sais pas."
    mara fatigue "Si, Noam. J'étais là."
    "Je voudrais encore dire quelque chose. J'arrive pas."
    $ hideGroup()
    scene bg_conduit_reseau at adaptive_fullscreen with dissolve
    $ flashlight_on(0)
    "Sur le chemin du retour, personne ne parle. Mara s'arrête deux fois pour vérifier qu'on la suit."
    "Je garde les yeux devant moi. Je repense à la voix de Julian quand il s'est réveillé."
    $ flashlight_off()
    # Durée estimée du bloc : 4 min.

label _29_0_1_1_0_0_1_1_RETOUR_NUIT:
    scene bg_laboratoire at adaptive_fullscreen with dissolve
    play music "music/bgm_cold_metadata.mp3" fadein 0.6
    "On revient au laboratoire. Elias s'est endormi sur sa chaise. Kael et Nyra attendent près de la machine."
    $ showGroup([("kael", "calme", 0.17), ("sael", "triste", 0.39), ("mara", "fatigue", 0.61), ("noam", "colere", 0.85)])
    kael inquietude "C'est fait ?"
    sael fatigue "Oui."
    noam colere "Tu peux être un peu plus précis, Kael ? Tu veux savoir s'il est mort ? Oui, il est mort !"
    kael inquietude "Noam..."
    noam colere "Il s'est réveillé. Il m'a parlé. Et elles l'ont tué pendant que j'étais juste à côté."
    mara colere "Arrête de dire ça comme si on l'avait fait pour s'amuser !"
    noam colere "J'ai pas dit que vous vous amusiez ! Ça change quoi ?!"
    nyra raison "On peut discuter de ça demain. Maintenant il faut..."
    noam colere "Non, Nyra ! On va pas discuter de ça demain !"
    "Elias se réveille d'un coup."
    elias fatigue "Putain... qu'est-ce qui se passe ?"
    mara fatigue "C'est bon, Elias. Julian..."
    elias inquiet "Ah. Merde."
    noam agace "C'est tout ce que t'as à dire ?"
    elias fatigue "Tu veux que je dise quoi ?!"
    noam colere "J'en sais rien ! Quelque chose !"
    "Sael pose sa trousse sur la table. Elle garde les mains dessus."
    sael triste "Laissez-le. Il a raison d'être en colère."
    mara agace "Et toi, tu vas t'y mettre aussi ?"
    sael fatigue "J'ai dit qu'il avait raison d'être en colère. J'ai pas dit qu'on pouvait revenir en arrière."
    kael calme "On arrête. On est tous crevés. Elias, tu pourras lancer le programme au matin ?"
    elias fatigue "Ouais. Si Nyra m'a rapporté ce qu'il faut."
    nyra neutre "Je m'en occupe."
    noam inquiet "Son corps, vous allez en faire quoi ?"
    "Personne ne répond immédiatement."
    sael raison "Je vais m'en occuper avec Mara. Pas maintenant. On attend que le couloir soit vide."
    noam colere "D'accord. Donc on le cache et après on fabrique un autre Julian, c'est ça ?"
    kael calme "C'est ce qu'on avait prévu."
    noam fatigue "Ouais. Je sais."
    "Je vais m'asseoir sur la banquette. Je crois que je pourrais dormir, mais chaque fois que je ferme les yeux, je revois Julian me regarder."
    $ j29_julian_original_dead = True
    $ hideGroup()
    scene black with dissolve
    pause 0.6
    # Durée estimée du bloc : 2 min.

label _29_0_1_1_0_0_1_1_MATIN:
    $ current_period = "Matin"
    scene bg_laboratoire at adaptive_fullscreen with dissolve
    play music "music/bgm_quiet_routine.mp3" fadein 0.8
    "Quand je relève la tête, il fait jour. Je me suis assoupi assis, sans même enlever mes chaussures."
    "Mara parle avec Elias devant la machine. Sael n'est plus là."
    $ showGroup([("mara", "fatigue", 0.20), ("elias", "reflechit", 0.46), ("noam", "fatigue", 0.80)])
    elias fatigue "Non, cette pièce-là va à gauche. Si tu la branches de l'autre côté, ça va juste me faire recommencer."
    mara agace "Bah tu me l'as donnée sans rien me dire !"
    elias fatigue "Parce que je pensais que tu savais lire les marques."
    mara neutre "Et moi je pensais que tu savais dire gauche et droite."
    "Elias me voit et pose son outil."
    elias neutre "Hé. T'as dormi un peu ?"
    noam fatigue "Je sais pas."
    mara fatigue "Sael est repartie vers les dortoirs. Elle a dit qu'elle reviendrait."
    noam inquiet "Pourquoi ?"
    mara reflexion "Elle avait des choses à vérifier."
    noam agace "Des choses à vérifier ?"
    mara fatigue "Noam, j'ai pas envie de repartir là-dessus maintenant."
    noam raison "Et moi j'ai pas envie qu'on fasse comme si rien s'était passé."
    elias fatigue "Personne fait comme si rien s'était passé."
    noam colere "Vous êtes en train de vous engueuler parce que Mara a mal branché un câble !"
    mara colere "Parce que si on le monte mal, tout ce qu'on a fait aura servi à rien !"
    noam peur "Tu parles de Julian ?"
    mara fatigue "Ouais, je parle de Julian !"
    "Elle se passe une main sur les yeux."
    mara triste "J'ai pas dormi. J'arrête pas de repenser à sa tête. Mais là, Elias a besoin que je l'aide et j'essaie juste de faire un truc utile."
    noam fatigue "..."
    elias neutre "On va y arriver. Enfin... normalement."
    noam reflexion "Et Nyra ?"
    elias raison "Elle est allée chercher l'objet. Je sais pas comment elle s'y prend."
    noam inquiet "Vous avez déjà fouillé sa chambre ?"
    mara neutre "Pas nous. Elle avait dit qu'elle connaissait un accès."
    noam colere "Même mort, vous pouvez pas lui foutre la paix."
    elias fatigue "Noam, je te comprends, mais..."
    noam colere "Non, arrête. J'ai pas envie d'entendre un 'mais'."
    "Elias acquiesce. Pour une fois, il ne trouve rien à répondre."
    $ hideGroup()
    "Je prends ma tablette. Aucun nouveau message d'Iris. Elle doit être avec mon double."
    "Je pense à Julian, qui plaisantait avec eux hier soir, puis je range l'écran."
    # Durée estimée du bloc : 2 min.

label _29_0_1_1_0_0_1_1_PREPARATION_MACHINE:
    $ current_period = "Midi"
    scene bg_laboratoire at adaptive_fullscreen with dissolve
    "Vers midi, Nyra revient avec un petit objet enveloppé dans du tissu."
    $ showGroup([("nyra", "neutre", 0.16), ("elias", "reflechit", 0.42), ("tomas", "reflexion", 0.63), ("noam", "inquiet", 0.86)])
    nyra raison "J'ai trouvé."
    elias joie "Ah, enfin ! C'est bien à lui ?"
    nyra neutre "Oui. Il le gardait dans sa chambre."
    noam inquiet "C'est quoi ?"
    "Elle ouvre le tissu. À l'intérieur, il y a un accessoire personnel de Julian, celui qu'il avait souvent avec lui."
    noam reflexion "Et tu l'as pris où, exactement ?"
    nyra raison "Dans ses affaires. Pourquoi ?"
    noam agace "Parce qu'hier encore il aurait pu te demander de pas y toucher."
    tomas fatigue "Noam..."
    noam raison "Non, je sais, je sais. Vous allez me dire que c'est trop tard."
    nyra neutre "Je voulais juste qu'on puisse terminer."
    elias neutre "Bon. Pose-le ici, mais le mets pas encore dans le lecteur. Il faut d'abord que je finisse les réglages."
    tomas raison "Je peux vérifier la correspondance des données avant le démarrage."
    elias fatigue "Ouais. Fais ça. Moi j'en peux plus de lire des chiffres."
    "Tomas s'installe. Il me lance un regard, mais ne me pose pas de questions."
    noam reflexion "Vous êtes sûrs qu'il va se souvenir de tout ?"
    elias raison "Si les données sont bonnes, ouais. Normalement il devrait être pareil."
    noam inquiet "Normalement ?"
    elias agace "Bah quoi ? J'ai pas fabriqué une centaine de Julian, moi !"
    nyra raison "On va le vérifier ensemble."
    noam raison "Et quand il va demander où il est ?"
    tomas fatigue "On lui expliquera."
    noam colere "Comme vous avez expliqué à Julian qu'il allait mourir ?"
    "Tomas baisse les yeux vers son écran."
    tomas raison "Non. Pas comme ça."
    elias fatigue "Écoute... j'ai encore du boulot. Vous pouvez vous engueuler dehors ?"
    nyra neutre "On ne s'engueule pas."
    elias agace "Bah ça y ressemble vachement."
    "Je recule et les laisse travailler."
    $ hideGroup()
    "Pendant un moment, je reste près de la grille. Les autres passent avec des outils, des câbles, des documents. Personne ne me demande d'aider."
    # Durée estimée du bloc : 2 min.

label _29_0_1_1_0_0_1_1_NAISSANCE:
    $ current_period = "Après-midi"
    scene bg_laboratoire at adaptive_fullscreen with dissolve
    play music "music/bgm_cold_metadata.mp3" fadein 0.7
    "Elias nous appelle en début d'après-midi. Le programme a terminé sa première phase."
    $ showGroup([("elias", "fatigue", 0.12), ("nyra", "reflexion", 0.32), ("mara", "inquiet", 0.54), ("noam", "inquiet", 0.81)])
    elias neutre "Bon. Ça y est. Mais personne touche à rien tant que j'ai pas ouvert."
    mara surpris "Il est là ?"
    elias raison "Ouais. Enfin, le corps est là. Pour le reste, on va voir."
    noam inquiet "Qu'est-ce que ça veut dire ?"
